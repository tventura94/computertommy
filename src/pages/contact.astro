---
import '@fortawesome/fontawesome-free/css/all.min.css';
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ThemeToggleButton from '../components/ThemeToggleButton.astro';
import astroLogo from '../assets/computertommylogo.svg';
import background from '../assets/background.svg';
import tradesRoofer from '../assets/trades/roofer.jpg';

const contactJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'ContactPage',
	name: 'Contact | Computer Tommy',
	url: 'https://computertommy.com/contact/',
	description:
		'Send a message or reach Computer Tommy by email or phone for Asheville web design and small business sites.',
};
---

<Layout
	title="Contact | Computer Tommy"
	description="Send a message through the form, or email and call for Asheville web design, fast sites, and small business builds."
	canonical="https://computertommy.com/contact/"
	image="/computertommylogo.png"
	jsonLd={contactJsonLd}
>
	<div class="themed-subpage">
		<img class="bg-blur" src={background.src} alt="" fetchpriority="high" />
		<img src="/paint-trip.png" alt="" class="contact-trip-bg" aria-hidden="true" />
		<main class="page">
			<section class="section hero-section">
				<div class="hero-nav">
					<a href="/" class="logo-link">
						<img src={astroLogo.src} width="115" height="48" alt="Computer Tommy Home" />
					</a>
					<div class="hero-nav-end">
						<ThemeToggleButton />
						<a href="/" class="btn-outline btn-small" aria-label="Back to home">
							<i class="fas fa-arrow-left"></i>
							<span>Home</span>
						</a>
					</div>
				</div>

				<div class="hero-content">
					<span class="section-eyebrow">Get in touch</span>
					<h1 class="hero-title">Contact</h1>
					<p class="hero-desc">
						Send a note about your project, timeline, or questions. I read every message and reply directly. You can also email or call if you prefer.
					</p>
					<div class="hero-direct-contact" aria-label="Email and phone">
						<a class="hero-direct-link" href="mailto:letsbuild@computertommy.com">
							<i class="fas fa-envelope" aria-hidden="true"></i>
							<span>letsbuild@computertommy.com</span>
						</a>
						<a class="hero-direct-link" href="tel:+15083802013">
							<i class="fas fa-phone" aria-hidden="true"></i>
							<span>(508) 380-2013</span>
						</a>
					</div>
				</div>

				<div class="crumbs-wrap">
					<Breadcrumbs variant="dark" items={[{ href: '/', label: 'Home' }]} current="Contact" />
				</div>
			</section>

			<section class="section contact-form-section" aria-labelledby="contact-form-heading">
				<h2 class="visually-hidden" id="contact-form-heading">Send a message</h2>
				<div class="contact-form-card">
					<div class="contact-form-card__grid">
						<div class="contact-form-card__form-wrap">
							<form
								class="contact-netlify-form"
								name="contact"
								method="POST"
								data-netlify="true"
								netlify-honeypot="bot-field"
								action="/thank-you/"
							>
								<input type="hidden" name="form-name" value="contact" />
								<p class="hp-field">
									<label>
										Do not fill this in: <input name="bot-field" type="text" tabindex="-1" autocomplete="off" />
									</label>
								</p>

								<div class="form-field">
									<label for="contact-name">Name</label>
									<input id="contact-name" name="name" type="text" autocomplete="name" required />
								</div>

								<div class="form-field">
									<label for="contact-email">Email</label>
									<input id="contact-email" name="email" type="email" autocomplete="email" required />
								</div>

								<div class="form-field">
									<label for="contact-phone">Phone <span class="field-hint">(optional)</span></label>
									<input id="contact-phone" name="phone" type="tel" autocomplete="tel" />
								</div>

								<div class="form-field">
									<label for="contact-message">How can I help?</label>
									<textarea id="contact-message" name="message" rows="6" required></textarea>
								</div>

								<button type="submit" class="btn-solid">Send message</button>
							</form>
						</div>
						<div
							class="contact-form-card__visual"
							style={`--contact-visual-bg: url(${tradesRoofer.src})`}
							aria-hidden="true"
						></div>
					</div>
				</div>
			</section>

			<section class="section section-alt direct-section" aria-labelledby="direct-heading">
				<div class="contact-direct-card">
					<h2 class="direct-title" id="direct-heading">Email or phone</h2>
					<p class="direct-lede">
						Same inbox and number for project questions, timelines, and follow ups.
					</p>
					<ul class="direct-list">
						<li>
							<span class="direct-label">Email</span>
							<a href="mailto:letsbuild@computertommy.com">letsbuild@computertommy.com</a>
						</li>
						<li>
							<span class="direct-label">Phone</span>
							<a href="tel:+15083802013">(508) 380-2013</a>
						</li>
					</ul>
				</div>
			</section>
		</main>
	</div>
	<Footer />
</Layout>

<style>
	.bg-blur {
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		z-index: 0;
		filter: blur(120px);
		opacity: 0.16;
		pointer-events: none;
	}

	/* Full-bleed paint trip: landscape brush stroke on black, reads as atmosphere */
	.contact-trip-bg {
		position: fixed;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center 38%;
		z-index: 0;
		pointer-events: none;
		opacity: 0.5;
		mix-blend-mode: lighten;
		transform: translateY(6vh);
	}

	.hero-nav-end {
		display: flex;
		align-items: center;
		gap: 0.65rem;
	}

	.page {
		position: relative;
		z-index: 1;
	}

	.section {
		max-width: 960px;
		margin: 0 auto;
		padding: 0 1.5rem 4rem;
	}

	.hero-section {
		padding-top: 2rem;
		padding-bottom: 0.5rem;
	}

	.hero-nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 2rem;
	}

	.logo-link {
		display: inline-flex;
		opacity: 0.92;
		text-decoration: none;
	}

	.logo-link:hover {
		opacity: 1;
	}

	.hero-content {
		max-width: 720px;
	}

	.section-eyebrow {
		display: inline-block;
		font-family: var(--font-display);
		font-size: 1.2rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--text-muted);
		margin-bottom: 0.5rem;
	}

	.hero-title {
		font-family: var(--font-display);
		font-weight: 400;
		text-transform: uppercase;
		letter-spacing: 0.02em;
		margin: 0;
		font-size: clamp(2.4rem, 8vw, 4.25rem);
		line-height: 0.95;
		word-wrap: break-word;
		overflow-wrap: break-word;
	}

	.hero-desc {
		color: var(--text-muted);
		font-size: clamp(1rem, 2vw, 1.15rem);
		line-height: 1.55;
		max-width: 640px;
		margin: 1rem 0 0;
	}

	.hero-direct-contact {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.65rem 1.35rem;
		margin-top: 1.35rem;
		max-width: 640px;
	}

	.hero-direct-link {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		font-size: clamp(0.95rem, 1.8vw, 1.05rem);
		font-weight: 600;
		color: var(--accent);
		text-decoration: none;
		line-height: 1.35;
	}

	.hero-direct-link:hover {
		text-decoration: underline;
	}

	.hero-direct-link i {
		font-size: 0.95em;
		opacity: 0.95;
	}

	.btn-outline {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.55rem;
		padding: 0.6rem 1rem;
		font-size: 0.86rem;
		border-radius: var(--radius);
		text-decoration: none;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.03em;
		background: transparent;
		color: var(--text);
		border: 1px solid var(--border);
		transition: background 0.25s, color 0.25s, border-color 0.25s, transform 0.15s;
	}

	.btn-outline:hover {
		background: var(--text);
		color: var(--bg);
		border-color: var(--text);
		transform: translateY(-1px);
	}

	.btn-solid {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.55rem;
		padding: 0.78rem 1.6rem;
		border-radius: var(--radius);
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.03em;
		font-size: 0.9rem;
		cursor: pointer;
		font-family: inherit;
		border: 1px solid var(--text);
		background: var(--text);
		color: var(--bg);
		transition: background 0.25s, color 0.25s, border-color 0.25s, transform 0.15s;
		margin-top: 0.25rem;
	}

	.btn-solid:hover {
		background: transparent;
		color: var(--text);
		transform: translateY(-1px);
	}

	.crumbs-wrap {
		margin-top: 1.2rem;
		padding-top: 1rem;
		border-top: 1px solid var(--border);
	}

	.section.contact-form-section {
		max-width: 1100px;
	}

	.contact-form-section {
		padding-top: 0.5rem;
	}

	.contact-form-card {
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		overflow: hidden;
		box-shadow: 0 16px 48px rgba(0, 0, 0, 0.25);
		padding: 0;
	}

	html[data-theme='light'] .contact-form-card {
		box-shadow: 0 12px 40px rgba(0, 0, 0, 0.08);
	}

	.contact-form-card__grid {
		display: grid;
		grid-template-columns: 1fr;
		grid-template-rows: auto minmax(200px, 32vw);
		align-items: stretch;
	}

	.contact-form-card__form-wrap {
		padding: 1.75rem 1.5rem 2rem;
		min-width: 0;
	}

	.contact-form-card__visual {
		position: relative;
		margin: 0;
		min-height: 0;
		background-color: #1a1d24;
		background-image: var(--contact-visual-bg);
		background-size: cover;
		background-position: center 28%;
		background-repeat: no-repeat;
		border-top: 1px solid var(--border);
	}

	.contact-form-card__visual::after {
		content: '';
		position: absolute;
		inset: 0;
		pointer-events: none;
		background: linear-gradient(
			180deg,
			rgba(0, 0, 0, 0.12) 0%,
			transparent 35%,
			rgba(0, 0, 0, 0.18) 100%
		);
	}

	html[data-theme='light'] .contact-form-card__visual::after {
		background: linear-gradient(
			180deg,
			rgba(255, 255, 255, 0.1) 0%,
			transparent 40%,
			rgba(0, 0, 0, 0.12) 100%
		);
	}

	.contact-netlify-form {
		display: flex;
		flex-direction: column;
		gap: 1.15rem;
		max-width: 36rem;
	}

	@media (min-width: 900px) {
		.contact-form-card__grid {
			grid-template-columns: minmax(0, 1fr) minmax(280px, 44%);
			grid-template-rows: minmax(420px, 1fr);
		}

		.contact-form-card__form-wrap {
			padding: 1.85rem 1.75rem 2rem 2rem;
		}

		.contact-form-card__visual {
			min-height: min(620px, 82vh);
			border-top: none;
			border-left: 1px solid var(--border);
			background-position: center 22%;
		}
	}

	.hp-field {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	.form-field {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
	}

	.form-field label {
		font-size: 0.8rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--text-muted);
	}

	.field-hint {
		font-weight: 500;
		text-transform: none;
		letter-spacing: 0;
		font-size: 0.85em;
		opacity: 0.85;
	}

	.form-field input,
	.form-field textarea {
		box-sizing: border-box;
		width: 100%;
		padding: 0.75rem 0.9rem;
		border-radius: var(--radius-sm);
		border: 1px solid var(--border);
		background: var(--bg);
		color: var(--text);
		font-family: inherit;
		font-size: 1rem;
		line-height: 1.45;
	}

	.form-field textarea {
		resize: vertical;
		min-height: 8rem;
	}

	.form-field input:focus,
	.form-field textarea:focus {
		outline: none;
		border-color: var(--accent);
		box-shadow: 0 0 0 1px var(--accent);
	}

	.section-alt {
		max-width: none;
		background: var(--surface);
		padding-top: 3rem;
		padding-bottom: 4rem;
		border-top: 1px solid var(--border);
	}

	.direct-section > * {
		max-width: 960px;
		margin-left: auto;
		margin-right: auto;
		padding-left: 1.5rem;
		padding-right: 1.5rem;
	}

	.contact-direct-card {
		background: var(--bg);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		padding: 1.75rem 1.5rem 1.85rem;
	}

	html[data-theme='light'] .contact-direct-card {
		background: rgba(255, 255, 255, 0.85);
	}

	.direct-title {
		font-family: var(--font-display);
		font-weight: 400;
		text-transform: uppercase;
		letter-spacing: 0.04em;
		font-size: 1.5rem;
		margin: 0 0 0.5rem;
		color: var(--text);
	}

	.direct-lede {
		margin: 0 0 1.25rem;
		color: var(--text-muted);
		font-size: 1rem;
		line-height: 1.5;
	}

	.direct-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.direct-list li {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.5rem 1rem;
	}

	.direct-label {
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--text-muted);
		min-width: 4.5rem;
	}

	.direct-list a {
		color: var(--accent);
		font-weight: 600;
		text-decoration: none;
		font-size: 1.05rem;
	}

	.direct-list a:hover {
		text-decoration: underline;
	}

	.visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	@media (max-width: 768px) {
		.contact-trip-bg {
			object-position: center 35%;
			opacity: 0.42;
			transform: translateY(5vh);
		}

		.section {
			padding: 0 1rem 3rem;
		}

		.hero-section {
			padding-top: 1.4rem;
		}

		.hero-nav {
			margin-bottom: 1.35rem;
		}

		.contact-form-card__grid {
			grid-template-rows: auto minmax(180px, 40vw);
		}

		.contact-form-card__form-wrap {
			padding: 1.35rem 1.15rem 1.6rem;
		}
	}
</style>
