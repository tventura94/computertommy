<script>
	function loadCaseStudyIframes() {
		document.querySelectorAll<HTMLIFrameElement>('.case-iframe').forEach((iframe) => {
			const src = iframe.getAttribute('data-src');
			if (src && !iframe.src) iframe.src = src;
		});
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', () => {
			setTimeout(loadCaseStudyIframes, 150);
		});
	} else {
		setTimeout(loadCaseStudyIframes, 150);
	}
</script>
