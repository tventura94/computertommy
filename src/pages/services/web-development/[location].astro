---
import '@fortawesome/fontawesome-free/css/all.min.css';
import Layout from '../../../layouts/Layout.astro';
import Footer from '../../../components/Footer.astro';
import { getNearbyLocations, locations } from '../../../data/locations';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import ThemeToggleButton from '../../../components/ThemeToggleButton.astro';
import astroLogo from '../../../assets/computertommylogo.svg';
import background from '../../../assets/background.svg';
import { getEntry } from 'astro:content';
import { portfolioItems } from '../../../data/portfolio';
import type { PortfolioItem } from '../../../data/portfolio';

type LocationContent = {
	h1?: string;
	heroSubtitle?: string;
	introBullets?: string[];
	painPoints?: string[];
	processSteps?: string[];
	faqs?: { q: string; a: string }[];
	caseStudySlugs?: string[];
	internalLinks?: { href: string; label: string }[];
};

export function getStaticPaths() {
	return locations.map((location) => ({
		params: { location: location.slug },
		props: { location },
	}));
}

const { location } = Astro.props as { location: (typeof locations)[number] };

const entry = await getEntry('web_dev_locations', location.slug);
const rendered = entry ? await entry.render() : null;
const MarkdownContent = rendered?.Content;
const fm = entry?.data as LocationContent | undefined;

const defaultModules = {
	heroSubtitle: 'Fast, clean websites: no builders, no bloat, no monthly fees.',
	introBullets: [
		'Modern design that fits your business',
		'Mobile-first and fast loading',
		'Basic SEO setup (titles/meta + indexing basics)',
		'Contact form + clear calls-to-action',
		'One-time build: you own it',
	],
	painPoints: ['Your current site looks dated or loads slow on mobile', 'You want leads, not a complicated platform'],
	processSteps: [
		'10-minute call to confirm pages + goal',
		'You send logo/photos/copy (or I help)',
		'I build and share a preview quickly',
		'Quick tweaks, then launch',
	],
	faqs: [
		{
			q: 'Is this a monthly service?',
			a: 'No. It is a one-time build. You own the site when we are done.',
		},
		{
			q: 'Can you help with copy and photos?',
			a: 'Yep. Send what you have and I’ll help fill gaps so it still looks clean and professional.',
		},
	],
};

const h1 = fm?.h1 ?? `Web design in ${location.city}, ${location.regionLabel}`;
const heroSubtitle = fm?.heroSubtitle ?? location.seo?.description ?? defaultModules.heroSubtitle;
const introBullets = fm?.introBullets ?? defaultModules.introBullets;
const painPoints = fm?.painPoints ?? defaultModules.painPoints;
const processSteps = fm?.processSteps ?? defaultModules.processSteps;
const faqs = fm?.faqs ?? defaultModules.faqs;
const internalLinks = fm?.internalLinks ?? [];
const serviceName = h1.includes('|') ? h1.split('|')[0].trim() : h1;

const nearby = getNearbyLocations(location.slug, 4);

const title = location.seo?.title ?? `${h1} | Computer Tommy`;
const description = location.seo?.description ?? heroSubtitle;
const canonical = `https://computertommy.com/services/web-development/${location.slug}/`;

const caseStudies = (fm?.caseStudySlugs ?? [])
	.map((slug: string) => portfolioItems.find((p) => p.slug === slug))
	.filter((p): p is PortfolioItem => Boolean(p));

const localBusinessId = 'https://computertommy.com/#localbusiness';
const phoneDisplay = '(508) 380-2013';
const phoneHref = 'tel:+15083802013';

const breadcrumbSchema = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Home', item: 'https://computertommy.com/' },
		{ '@type': 'ListItem', position: 2, name: 'Services', item: 'https://computertommy.com/services/' },
		{ '@type': 'ListItem', position: 3, name: 'Web development', item: 'https://computertommy.com/services/web-development/' },
		{ '@type': 'ListItem', position: 4, name: `${location.city}, ${location.regionLabel}`, item: canonical },
	],
};

const serviceSchema = {
	'@context': 'https://schema.org',
	'@type': 'Service',
	name: serviceName,
	serviceType: 'Web design and development',
	provider: { '@id': localBusinessId },
	areaServed: {
		'@type': 'AdministrativeArea',
		name: `${location.city}, ${location.regionLabel}`,
	},
	url: canonical,
	description,
};

const caseStudyItemListSchema =
	caseStudies.length
		? {
				'@context': 'https://schema.org',
				'@type': 'ItemList',
				name: `Web development examples in ${location.city}, ${location.regionLabel}`,
				itemListElement: caseStudies.map((c, idx) => ({
					'@type': 'ListItem',
					position: idx + 1,
					item: {
						'@type': 'CreativeWork',
						name: c.title,
						url: c.url,
						description: `${c.whatTheyNeeded} ${c.result}`.trim(),
					},
				})),
			}
		: null;

// Only emit FAQ schema when the FAQ content is truly page-specific (not default fallback).
const faqSchema =
	fm?.faqs?.length
		? {
				'@context': 'https://schema.org',
				'@type': 'FAQPage',
				mainEntity: fm.faqs.map((item) => ({
					'@type': 'Question',
					name: item.q,
					acceptedAnswer: {
						'@type': 'Answer',
						text: item.a,
					},
				})),
			}
		: null;

const jsonLd = [
	breadcrumbSchema,
	serviceSchema,
	...(caseStudyItemListSchema ? [caseStudyItemListSchema] : []),
	...(faqSchema ? [faqSchema] : []),
];
---

<Layout title={title} description={description} canonical={canonical} jsonLd={jsonLd}>
	<div id="loc-page" class="themed-subpage">
		<img class="bg-blur" src={background.src} alt="" fetchpriority="high" />
		<main class="loc-main">
			<section class="section hero-section">
				<div class="hero-nav">
					<a href="/" class="logo-link">
						<img src={astroLogo.src} width="115" height="48" alt="Computer Tommy Homepage" />
					</a>
					<div class="hero-nav-end">
						<ThemeToggleButton />
						<a href="/services/web-development/" class="btn-outline btn-small">
							<i class="fas fa-arrow-left" aria-hidden="true"></i>
							<span>Web development</span>
						</a>
					</div>
				</div>
				<div class="hero-content">
					<span class="section-eyebrow">Web development in {location.city}, {location.regionLabel}</span>
					<h1 class="hero-title">{h1}</h1>
					<p class="hero-desc">{heroSubtitle}</p>
					<p class="hero-contact">
						Need web development in {location.city}, {location.regionLabel}?{' '}
						<a href={phoneHref}>Call or text {phoneDisplay}</a> for a free estimate.
					</p>
					<div class="hero-actions">
						<a class="btn-solid" href="/contact/">Get a {location.city} quote</a>
						<a class="btn-outline" href={phoneHref}>Call or text {phoneDisplay}</a>
					</div>
				</div>
				<div class="crumbs-wrap">
					<Breadcrumbs
						variant="dark"
						items={[
							{ href: '/', label: 'Home' },
							{ href: '/services/', label: 'Services' },
							{ href: '/services/web-development/', label: 'Web development' },
						]}
						current={`${location.city}, ${location.regionLabel}`}
					/>
				</div>
			</section>

			<section class="section" aria-labelledby="included-heading">
				<div class="section-header">
					<span class="section-eyebrow">What is included</span>
					<h2 class="section-title" id="included-heading">What you get</h2>
				</div>
				<ul class="checklist">
					{introBullets.map((b) => (
						<li>
							<i class="fas fa-check checklist-icon" aria-hidden="true"></i>
							<span>{b}</span>
						</li>
					))}
				</ul>
			</section>

			<section class="section section-alt" aria-labelledby="process-heading">
				<div class="section-header">
					<span class="section-eyebrow">Process</span>
					<h2 class="section-title" id="process-heading">How it works</h2>
					<p class="section-lead">
						A simple, low-friction process that keeps the project moving and gets your site live without dragging things out.
					</p>
				</div>
				<div class="process-grid">
					{processSteps.map((s, idx) => (
						<div class="process-step">
							<span class="step-num">{String(idx + 1).padStart(2, '0')}</span>
							<h4>Step {idx + 1}</h4>
							<p>{s}</p>
						</div>
					))}
				</div>
			</section>

			<section class="section" aria-labelledby="local-context-heading">
				<div class="section-header">
					<span class="section-eyebrow">Local context</span>
					<h2 class="section-title" id="local-context-heading">Why businesses in {location.city} hire us</h2>
				</div>
				<div class="two-col">
					<div class="prose-block">
						<h3 class="prose-block-title">Common pain points</h3>
						<ul class="prose-list">
							{painPoints.map((p) => <li>{p}</li>)}
						</ul>
					</div>
					<div class="prose-block prose-block--accent">
						<h3 class="prose-block-title">Serving your area</h3>
						<ul class="prose-list">
							{location.proof?.localOffer ? <li><strong>Local offer:</strong> {location.proof.localOffer}</li> : null}
							{location.proof?.counties?.length ? <li><strong>Counties:</strong> {location.proof.counties.join(', ')}</li> : null}
							{location.proof?.serviceRadiusMiles ? (
								<li>
									<strong>Service radius:</strong> about {location.proof.serviceRadiusMiles} miles
								</li>
							) : null}
							{location.proof?.landmarks?.length ? <li><strong>Landmarks:</strong> {location.proof.landmarks.join(', ')}</li> : null}
						</ul>
						{location.notes?.length ? <p class="area-note">{location.notes.join(' ')}</p> : null}
					</div>
				</div>
			</section>

			{MarkdownContent ? (
				<section class="section section-alt prose-section">
					<div class="section-inner prose-wrap">
						<MarkdownContent />
					</div>
				</section>
			) : null}

			{caseStudies.length ? (
				<section class="section" aria-labelledby="portfolio-heading">
					<div class="section-header">
						<span class="section-eyebrow">Portfolio</span>
						<h2 class="section-title" id="portfolio-heading">Example work</h2>
					</div>
					<div class="case-grid">
						{caseStudies.map((c) => (
							<article class="case-card">
								<div class="case-preview">
									<iframe
										title={`Live preview of ${c.title}`}
										data-src={c.url}
										class="case-iframe"
										aria-hidden="true"
										tabindex="-1"
										loading="lazy"
									/>
								</div>
								<div class="case-body">
									<span class="case-category">{c.category}</span>
									<h3>{c.title}</h3>
									<p class="case-need">{c.whatTheyNeeded}</p>
									<p class="case-result">{c.result}</p>
									<a
										class="case-link"
										href={c.url}
										target="_blank"
										rel="noopener noreferrer"
										aria-label={`Visit ${c.title} (opens in a new tab)`}
									>
										Visit site <span aria-hidden="true">&rarr;</span>
									</a>
								</div>
							</article>
						))}
					</div>
				</section>
			) : null}

			{faqs?.length ? (
				<section class="section section-alt faq-section" aria-labelledby="faq-heading">
					<div class="section-header">
						<span class="section-eyebrow">Questions</span>
						<h2 class="section-title" id="faq-heading">Frequently asked questions</h2>
					</div>
					<dl class="faq-list">
						{faqs.map((item) => (
							<div class="faq-item">
								<dt>{item.q}</dt>
								<dd>{item.a}</dd>
							</div>
						))}
					</dl>
				</section>
			) : null}

			<section class="section cta-section">
				<div class="cta-inner">
					<h2>Need web development in {location.city}, {location.regionLabel}?</h2>
					<p class="cta-text">
						Call or text {phoneDisplay} for a free estimate, or send a quick project note and I will follow up within 24 hours.
					</p>
					<div class="cta-actions">
						<a class="btn-solid" href={phoneHref}>Call or text {phoneDisplay}</a>
						<a class="btn-outline" href="/contact/">Request a quote</a>
					</div>
				</div>
			</section>

			{internalLinks.length || nearby.length ? (
				<section class="section section-alt nearby-section">
					<div class="section-inner">
						{internalLinks.length ? (
							<div class="nearby-block">
								<h2 class="nearby-title">Next</h2>
								<ul class="city-link-list">
									{internalLinks.map((l) => (
										<li>
											<a href={l.href}>{l.label}</a>
										</li>
									))}
								</ul>
							</div>
						) : null}
						{nearby.length ? (
							<div class="nearby-block">
								<h2 class="nearby-title">Nearby areas</h2>
								<ul class="city-link-list">
									{nearby.map((n) => (
										<li>
											<a href={`/services/web-development/${n.slug}/`}>{n.city}, {n.regionLabel}</a>
										</li>
									))}
								</ul>
							</div>
						) : null}
					</div>
				</section>
			) : null}
		</main>
	</div>

	<Footer />
</Layout>

<style>
	/* Scoped to location pages: matches WebDev / Welcome dark system */
	.bg-blur {
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		z-index: 0;
		filter: blur(120px);
		opacity: 0.16;
		pointer-events: none;
	}

	.hero-nav-end {
		display: flex;
		align-items: center;
		gap: 0.65rem;
	}

	.loc-main {
		position: relative;
		z-index: 1;
	}

	.section {
		max-width: 1100px;
		margin: 0 auto;
		padding: 4rem 1.5rem;
	}

	.section.section-alt {
		max-width: none;
		width: 100%;
		margin-left: 0;
		margin-right: 0;
		padding: 4rem 0;
		background: var(--surface);
	}

	.section.section-alt > .section-header,
	.section.section-alt > .process-grid,
	.section.section-alt > .faq-list,
	.section.section-alt > .section-inner {
		max-width: 1100px;
		margin-left: auto;
		margin-right: auto;
		padding-left: 1.5rem;
		padding-right: 1.5rem;
	}

	.section-inner {
		max-width: 1100px;
		margin: 0 auto;
	}

	.hero-section {
		padding-top: 2rem;
	}

	.hero-nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 2rem;
	}

	.logo-link {
		display: inline-flex;
		opacity: 0.92;
		text-decoration: none;
	}

	.logo-link:hover {
		opacity: 1;
	}

	.hero-content {
		max-width: 900px;
	}

	.section-eyebrow {
		display: inline-block;
		font-family: var(--font-display);
		font-size: 1.15rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--text-muted);
		margin-bottom: 0.5rem;
	}

	.hero-title,
	.section-title {
		font-family: var(--font-display);
		font-weight: 400;
		text-transform: uppercase;
		letter-spacing: 0.02em;
		margin: 0;
		word-wrap: break-word;
		overflow-wrap: break-word;
	}

	.hero-title {
		font-size: clamp(2rem, 7vw, 4.25rem);
		line-height: 0.98;
	}

	.section-title {
		font-size: clamp(1.85rem, 5vw, 3.25rem);
		line-height: 1;
	}

	.hero-desc {
		color: var(--text-muted);
		font-size: clamp(1rem, 2vw, 1.25rem);
		line-height: 1.55;
		max-width: 700px;
		margin: 1rem 0 1rem;
	}

	.hero-contact {
		margin: 0 0 1.25rem;
		color: var(--text-muted);
		font-size: 0.98rem;
		line-height: 1.55;
		max-width: 640px;
	}

	.hero-contact a {
		color: var(--accent);
		font-weight: 600;
		text-decoration: none;
	}

	.hero-contact a:hover {
		text-decoration: underline;
	}

	.section-header {
		max-width: 760px;
		margin-bottom: 2rem;
	}

	.section-lead {
		color: var(--text-muted);
		font-size: clamp(0.98rem, 1.6vw, 1.1rem);
		line-height: 1.6;
		margin: 0.75rem 0 0;
		max-width: 720px;
	}

	.btn-solid,
	.btn-outline {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.55rem;
		padding: 0.78rem 1.6rem;
		border-radius: var(--radius);
		text-decoration: none;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.03em;
		font-size: 0.9rem;
		transition: background 0.25s, color 0.25s, border-color 0.25s, transform 0.15s;
	}

	.btn-solid {
		background: var(--text);
		color: var(--bg);
		border: 1px solid var(--text);
	}

	.btn-solid:hover {
		background: transparent;
		color: var(--text);
		transform: translateY(-1px);
	}

	.btn-outline {
		background: transparent;
		color: var(--text);
		border: 1px solid var(--border);
	}

	.btn-outline:hover {
		background: var(--text);
		color: var(--bg);
		border-color: var(--text);
		transform: translateY(-1px);
	}

	.btn-small {
		padding: 0.6rem 1rem;
		font-size: 0.86rem;
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}

	.crumbs-wrap {
		margin-top: 1.2rem;
		padding-top: 1rem;
		border-top: 1px solid var(--border);
	}

	.checklist {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 0.65rem;
		max-width: 52rem;
	}

	.checklist li {
		display: flex;
		gap: 0.75rem;
		align-items: flex-start;
		padding: 0.85rem 1rem;
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: var(--radius-sm);
		font-size: 0.98rem;
		line-height: 1.5;
		color: var(--text-muted);
	}

	.checklist-icon {
		color: var(--accent);
		margin-top: 0.15rem;
		flex-shrink: 0;
	}

	.process-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
		gap: 0.6rem;
	}

	.process-step {
		background: var(--bg);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		padding: 1.35rem;
	}

	.step-num {
		display: block;
		font-size: 1.75rem;
		font-weight: 800;
		color: var(--accent);
		letter-spacing: -0.03em;
		margin-bottom: 0.35rem;
		line-height: 1;
	}

	.process-step h4 {
		margin: 0 0 0.45rem;
		font-size: 0.95rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.04em;
		color: var(--text-muted);
	}

	.process-step p {
		margin: 0;
		color: var(--text-muted);
		font-size: 0.95rem;
		line-height: 1.5;
	}

	.two-col {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1rem;
		align-items: start;
	}

	.prose-block {
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		padding: 1.35rem 1.5rem;
	}

	.prose-block--accent {
		border-color: rgba(249, 115, 22, 0.35);
		background: rgba(249, 115, 22, 0.06);
	}

	.prose-block-title {
		font-family: var(--font-display);
		font-size: 1.35rem;
		font-weight: 400;
		text-transform: uppercase;
		letter-spacing: 0.02em;
		margin: 0 0 0.85rem;
	}

	.prose-list {
		margin: 0;
		padding-left: 1.15rem;
		color: var(--text-muted);
		line-height: 1.55;
	}

	.prose-list li {
		margin-bottom: 0.5rem;
	}

	.prose-list strong {
		color: var(--text);
	}

	.area-note {
		margin: 1rem 0 0;
		font-size: 0.92rem;
		color: var(--text-muted);
		line-height: 1.55;
	}

	.prose-section .prose-wrap {
		max-width: 760px;
		color: var(--text-muted);
		line-height: 1.7;
		font-size: 1.02rem;
	}

	.prose-wrap :global(h2),
	.prose-wrap :global(h3) {
		font-family: var(--font-display);
		text-transform: uppercase;
		font-weight: 400;
		letter-spacing: 0.02em;
		color: var(--text);
		margin: 1.5rem 0 0.75rem;
	}

	.prose-wrap :global(h2:first-child),
	.prose-wrap :global(h3:first-child) {
		margin-top: 0;
	}

	.prose-wrap :global(p) {
		margin: 0 0 1rem;
	}

	.prose-wrap :global(a) {
		color: var(--accent);
		text-decoration: none;
		font-weight: 500;
	}

	.prose-wrap :global(a:hover) {
		text-decoration: underline;
	}

	.prose-wrap :global(ul),
	.prose-wrap :global(ol) {
		margin: 0 0 1rem;
		padding-left: 1.25rem;
	}

	.case-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.75rem;
	}

	.case-card {
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		overflow: hidden;
		display: flex;
		flex-direction: column;
		transition: border-color 0.2s, transform 0.2s;
	}

	.case-card:hover {
		border-color: rgba(255, 255, 255, 0.18);
