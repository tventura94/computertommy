---
import '@fortawesome/fontawesome-free/css/all.min.css';
import Layout from '../../../layouts/Layout.astro';
import Footer from '../../../components/Footer.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import ThemeToggleButton from '../../../components/ThemeToggleButton.astro';
import astroLogo from '../../../assets/computertommylogo.svg';
import background from '../../../assets/background.svg';

type SeoServiceContent = {
	h1?: string;
	heroSubtitle?: string;
	introBullets?: string[];
	p1?: string;
	p2?: string;
	faqs?: { q: string; a: string }[];
	internalLinks?: { href: string; label: string }[];
};

export async function getStaticPaths() {
	const { getCollection } = await import('astro:content');
	const entries = (await (getCollection as unknown as (collection: string) => Promise<{ slug: string }[]>)(
		'seo_services',
	)) as { slug: string }[];
	return entries.map((entry) => ({
		params: { slug: entry.slug },
	}));
}

const { slug } = Astro.params as { slug: string };
const { getEntry } = await import('astro:content');
const entry = (await (getEntry as unknown as (collection: string, id: string) => Promise<any>)('seo_services', slug)) as
	| { data: SeoServiceContent; render: () => Promise<{ Content: any }> }
	| undefined;
const data = entry?.data;
const rendered = entry ? await entry.render() : null;
const MarkdownContent = rendered?.Content;

const h1 = data?.h1 ?? 'SEO service';
const heroSubtitle = data?.heroSubtitle ?? 'Practical local SEO help for service businesses.';
const introBullets = data?.introBullets ?? [];
const p1 = data?.p1;
const p2 = data?.p2;
const faqs = data?.faqs ?? [];
const internalLinks = data?.internalLinks ?? [];

const title = `${h1} | Local SEO | Computer Tommy`;
const description = data?.heroSubtitle ?? `${h1}. Local SEO for service providers, Computer Tommy.`;
const canonical = `https://computertommy.com/services/seo/${slug}/`;
---

<Layout title={title} description={description} canonical={canonical}>
	<div class="themed-subpage">
		<img class="bg-blur" src={background.src} alt="" fetchpriority="high" />
		<img src="/paint-splat.png" alt="" class="paint-strikes-bg" aria-hidden="true" />
		<main class="page">
			<section class="hero section">
				<div class="hero-nav">
					<a href="/" class="logo-link">
						<img src={astroLogo.src} width="115" height="48" alt="Computer Tommy Homepage" />
					</a>
					<div class="hero-nav-end">
						<ThemeToggleButton />
						<a href="/services/seo/" class="btn-outline btn-small" aria-label="Back to SEO services">
							<i class="fas fa-arrow-left"></i>
							<span>SEO</span>
						</a>
					</div>
				</div>

				<div class="hero-content">
					<span class="section-eyebrow">Local SEO service</span>
					<h1 class="hero-title">{h1}</h1>
					<p class="hero-desc">{heroSubtitle}</p>
					<div class="hero-actions">
						<a href="/contact/" class="btn-solid">Get in touch</a>
						<a href="/services/seo/" class="btn-outline">All SEO services</a>
					</div>
				</div>

				<div class="crumbs-wrap">
					<Breadcrumbs
						variant="dark"
						items={[
							{ href: '/', label: 'Home' },
							{ href: '/services/', label: 'Services' },
							{ href: '/services/seo/', label: 'SEO' },
						]}
						current={h1}
					/>
				</div>
			</section>

			{introBullets.length ? (
				<section class="section" aria-labelledby="included-heading">
					<div class="section-header">
						<span class="section-eyebrow">Deliverables</span>
						<h2 class="section-title" id="included-heading">What is included</h2>
					</div>
					<ul class="checklist">
						{introBullets.map((b) => (
							<li>
								<i class="fas fa-check checklist-icon" aria-hidden="true"></i>
								<span>{b}</span>
							</li>
						))}
					</ul>
				</section>
			) : null}

			{p1 || p2 ? (
				<section class="section section-alt" aria-labelledby="intro-heading">
					<div class="section-header">
						<span class="section-eyebrow">Overview</span>
						<h2 class="section-title" id="intro-heading">Is this the right fit?</h2>
					</div>
					<div class="opinion-card">
						{p1 ? <p class="intro-p">{p1}</p> : null}
						{p2 ? <p class="intro-p">{p2}</p> : null}
					</div>
				</section>
			) : null}

			{MarkdownContent ? (
				<section class="section" aria-labelledby="detail-heading">
					<div class="section-header">
						<span class="section-eyebrow">Details</span>
						<h2 class="section-title" id="detail-heading">How it works in practice</h2>
					</div>
					<div class="md-wrap">
						<MarkdownContent />
					</div>
				</section>
			) : null}

			{faqs.length ? (
				<section class="section section-alt faq-section" aria-labelledby="faq-heading">
					<div class="section-header">
						<span class="section-eyebrow">FAQ</span>
						<h2 class="section-title" id="faq-heading">Questions about this service</h2>
					</div>
					<dl class="faq-list">
						{faqs.map((item) => (
							<div class="faq-item">
								<dt>{item.q}</dt>
								<dd>{item.a}</dd>
							</div>
						))}
					</dl>
				</section>
			) : null}

			{internalLinks.length ? (
				<section class="section link-actions" aria-labelledby="next-heading">
					<h2 class="section-title section-title--sm" id="next-heading">Next steps</h2>
					<div class="link-row">
						{internalLinks.map((l) => (
							<a
								class:list={{ 'link-pill': true, 'link-pill--primary': l.href === '/contact/' }}
								href={l.href}
							>
								{l.label}
							</a>
						))}
					</div>
				</section>
			) : null}

			<section class="section cta-section">
				<div class="cta-inner">
					<h2>Want this scoped for your market?</h2>
					<p class="cta-lead">Tell me what you sell, where you operate, and what a booked job looks like. I will reply with clear next steps.</p>
					<a href="/contact/" class="btn-solid">Contact</a>
				</div>
			</section>
		</main>
	</div>

	<Footer />
</Layout>

<style>
	.bg-blur {
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		z-index: 0;
		filter: blur(120px);
		opacity: 0.16;
		pointer-events: none;
	}

	.paint-strikes-bg {
		position: fixed;
		left: 38%;
		top: 8%;
		width: min(230vw, 2400px);
		height: auto;
		max-width: none;
		z-index: 0;
		pointer-events: none;
		opacity: 0.2;
		mix-blend-mode: lighten;
		transform: translateX(-50%) rotate(-3deg);
	}

	.hero-nav-end {
		display: flex;
		align-items: center;
		gap: 0.65rem;
	}

	.page {
		position: relative;
		z-index: 1;
	}

	.section {
		max-width: 900px;
		margin: 0 auto;
		padding: 3rem 1.5rem;
	}

	.section-alt {
		max-width: none;
		background: var(--surface);
	}

	.section-alt > * {
		max-width: 900px;
		margin-left: auto;
		margin-right: auto;
	}

	.hero {
		padding-top: 2rem;
	}

	.hero-nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 2rem;
	}

	.logo-link {
		display: inline-flex;
		opacity: 0.92;
		text-decoration: none;
	}

	.logo-link:hover {
		opacity: 1;
	}

	.hero-content {
		max-width: 900px;
	}

	.section-eyebrow {
		display: inline-block;
		font-family: var(--font-display);
		font-size: 1.2rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--text-muted);
		margin-bottom: 0.5rem;
	}

	.hero-title,
	.section-title {
		font-family: var(--font-display);
		font-weight: 400;
		text-transform: uppercase;
		letter-spacing: 0.02em;
		margin: 0;
		word-wrap: break-word;
		overflow-wrap: break-word;
	}

	.hero-title {
		font-size: clamp(2.2rem, 7vw, 4.25rem);
		line-height: 0.95;
	}

	.section-title {
		font-size: clamp(1.85rem, 5vw, 3rem);
		line-height: 1;
	}

	.section-title--sm {
		font-size: clamp(1.5rem, 3.5vw, 2.25rem);
		margin-bottom: 0.75rem;
	}

	.section-header {
		max-width: 760px;
		margin-bottom: 1.5rem;
	}

	.hero-desc {
		color: var(--text-muted);
		font-size: clamp(1rem, 2vw, 1.25rem);
		line-height: 1.55;
		max-width: 700px;
		margin: 1rem 0 1.5rem;
	}

	.btn-solid,
	.btn-outline {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.55rem;
		padding: 0.78rem 1.6rem;
		border-radius: var(--radius);
		text-decoration: none;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.03em;
		font-size: 0.9rem;
		transition: background 0.25s, color 0.25s, border-color 0.25s, transform 0.15s;
	}

	.btn-solid {
		background: var(--text);
		color: var(--bg);
		border: 1px solid var(--text);
	}

	.btn-solid:hover {
		background: transparent;
		color: var(--text);
		transform: translateY(-1px);
	}

	.btn-outline {
		background: transparent;
		color: var(--text);
		border: 1px solid var(--border);
	}

	.btn-outline:hover {
		background: var(--text);
		color: var(--bg);
		border-color: var(--text);
		transform: translateY(-1px);
	}

	.btn-small {
		padding: 0.6rem 1rem;
		font-size: 0.86rem;
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}

	.crumbs-wrap {
		margin-top: 1.2rem;
		padding-top: 1rem;
		border-top: 1px solid var(--border);
	}

	.checklist {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 0.65rem;
	}

	.checklist li {
		display: flex;
		gap: 0.75rem;
		align-items: flex-start;
		padding: 0.85rem 1rem;
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: var(--radius-sm);
		font-size: 0.98rem;
		line-height: 1.5;
		color: var(--text-muted);
	}

	.checklist-icon {
		color: var(--accent);
		margin-top: 0.15rem;
		flex-shrink: 0;
	}

	.opinion-card {
		border: 1px solid var(--border);
		border-radius: var(--radius);
		padding: 1.5rem 1.75rem;
		background: var(--bg);
	}

	.intro-p {
		margin: 0 0 1rem;
		font-size: clamp(1rem, 1.6vw, 1.08rem);
		line-height: 1.65;
		color: var(--text-muted);
	}

	.intro-p:last-child {
		margin-bottom: 0;
	}

	.md-wrap {
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		padding: 1.5rem 1.65rem;
	}

	.md-wrap :global(h2) {
		font-family: var(--font-display);
		font-weight: 400;
		text-transform: uppercase;
		letter-spacing: 0.02em;
		font-size: clamp(1.35rem, 3vw, 1.85rem);
		margin: 1.75rem 0 0.75rem;
		line-height: 1.1;
		color: var(--text);
	}

	.md-wrap :global(h2:first-child) {
		margin-top: 0;
	}

	.md-wrap :global(h3) {
		font-size: 1.08rem;
		font-weight: 700;
		margin: 1.35rem 0 0.5rem;
		color: var(--text);
	}

	.md-wrap :global(p) {
		margin: 0 0 0.85rem;
		color: var(--text-muted);
		line-height: 1.65;
		font-size: 0.98rem;
	}

	.md-wrap :global(p:last-child) {
		margin-bottom: 0;
	}

	.md-wrap :global(ul),
	.md-wrap :global(ol) {
		margin: 0 0 1rem;
		padding-left: 1.25rem;
		color: var(--text-muted);
		line-height: 1.6;
		font-size: 0.98rem;
	}

	.md-wrap :global(li) {
		margin-bottom: 0.4rem;
	}

	.md-wrap :global(a) {
		color: var(--accent);
		font-weight: 600;
		text-decoration: none;
	}

	.md-wrap :global(a:hover) {
		text-decoration: underline;
	}

	.md-wrap :global(strong) {
		color: var(--text);
		font-weight: 700;
	}

	.md-wrap :global(code) {
		font-size: 0.88em;
		background: rgba(255, 255, 255, 0.08);
		padding: 0.12em 0.4em;
		border-radius: 6px;
		color: var(--text);
	}

	.md-wrap :global(pre) {
		margin: 0 0 1rem;
		padding: 1rem;
		border-radius: var(--radius-sm);
		background: var(--bg);
		border: 1px solid var(--border);
		overflow-x: auto;
		font-size: 0.88rem;
	}

	.md-wrap :global(pre code) {
		background: none;
		padding: 0;
	}

	.md-wrap :global(blockquote) {
		margin: 0 0 1rem;
		padding: 0.75rem 1rem;
		border-left: 3px solid var(--accent);
		background: rgba(249, 115, 22, 0.06);
		color: var(--text-muted);
		font-size: 0.95rem;
	}

	.faq-list {
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.faq-item {
		border: 1px solid var(--border);
		border-radius: var(--radius);
		background: var(--bg);
		padding: 1.15rem 1.35rem;
	}

	.faq-item dt {
		font-weight: 700;
		font-size: 1.02rem;
		margin: 0 0 0.5rem;
		color: var(--text);
	}

	.faq-item dd {
		margin: 0;
		color: var(--text-muted);
		line-height: 1.55;
		font-size: 0.97rem;
	}

	.link-actions {
		padding-top: 2rem;
		padding-bottom: 1rem;
	}

	.link-row {
		display: flex;
		flex-wrap: wrap;
		gap: 0.65rem;
	}

	.link-pill {
		display: inline-flex;
		align-items: center;
		padding: 0.65rem 1.1rem;
		border-radius: 999px;
		border: 1px solid var(--border);
		background: var(--surface);
		color: var(--text);
		text-decoration: none;
		font-weight: 600;
		font-size: 0.9rem;
		transition: border-color 0.2s, background 0.2s;
	}

	.link-pill:hover {
		border-color: rgba(249, 115, 22, 0.45);
	}

	.link-pill--primary {
		background: var(--text);
		color: var(--bg);
		border-color: var(--text);
	}

	.link-pill--primary:hover {
		background: transparent;
		color: var(--text);
	}

	.cta-section {
		text-align: center;
		padding-bottom: 4rem;
	}

	.cta-inner {
		max-width: 640px;
		margin: 0 auto;
		border: 1px solid var(--border);
		background: var(--surface);
		border-radius: var(--radius);
		padding: 2rem 1.5rem;
	}

	.cta-inner h2 {
		font-family: var(--font-display);
		font-weight: 400;
		text-transform: uppercase;
		letter-spacing: 0.02em;
		font-size: clamp(1.75rem, 5vw, 3rem);
		line-height: 1;
		margin: 0 0 0.65rem;
	}

	.cta-lead {
		margin: 0 auto 1.25rem;
		color: var(--text-muted);
		font-size: 0.98rem;
		line-height: 1.55;
		max-width: 480px;
	}

	@media (max-width: 768px) {
		.paint-strikes-bg {
			top: 4%;
			left: 36%;
			width: 290vw;
			transform: translateX(-50%) rotate(-2deg);
			opacity: 0.14;
		}

		.section {
			padding: 2.5rem 1rem;
		}

		.hero {
			padding-top: 1.4rem;
		}

		.hero-nav {
			margin-bottom: 1.3rem;
		}

		.hero-actions {
			flex-direction: column;
			align-items: stretch;
		}

		.btn-solid,
		.btn-outline {
			min-height: 46px;
		}
	}
</style>
