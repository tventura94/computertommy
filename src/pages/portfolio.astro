---
import '@fortawesome/fontawesome-free/css/all.min.css';
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ThemeToggleButton from '../components/ThemeToggleButton.astro';
import astroLogo from '../assets/computertommylogo.svg';
import background from '../assets/background.svg';
import { portfolioItems } from '../data/portfolio';

type FilterGroup = 'business' | 'music' | 'other';

function groupOf(category: string): FilterGroup {
	if (category === 'Service site' || category === 'Business site') return 'business';
	if (category === 'Band site') return 'music';
	return 'other';
}

const accentByGroup: Record<FilterGroup, string> = {
	business: 'var(--accent)',
	music: 'var(--accent-pink)',
	other: 'var(--accent-purple)',
};

const totalCount = 50;
const businessCount = portfolioItems.filter((p) => groupOf(p.category) === 'business').length;
const musicCount = portfolioItems.filter((p) => groupOf(p.category) === 'music').length;
const otherCount = portfolioItems.filter((p) => groupOf(p.category) === 'other').length;

const filters: { id: 'all' | FilterGroup; label: string; count: number }[] = [
	{ id: 'all', label: 'All work', count: totalCount },
	{ id: 'business', label: 'Service businesses', count: businessCount },
	{ id: 'music', label: 'Bands and music', count: musicCount },
	{ id: 'other', label: 'Other', count: otherCount },
];

const ctaInsertAfter = Math.min(5, Math.max(2, portfolioItems.length - 3));
---

<Layout
	title="Portfolio | Computer Tommy"
	description="Sites built for local service businesses, bands, and small brands. Fast pages, clear offers, no agency retainers."
	canonical="https://computertommy.com/portfolio/"
	image="/computertommylogo.png"
>
	<div class="themed-subpage">
		<img class="bg-blur" src={background.src} alt="" fetchpriority="high" />
		<img src="/portfolio/bg-img-ct.png" alt="" class="portfolio-brush-bg" aria-hidden="true" />

		<main class="page">
			<!-- HERO -->
			<section class="hero">
				<div class="hero-nav">
					<a href="/" class="logo-link">
						<img src={astroLogo.src} width="115" height="48" alt="Computer Tommy Home" />
					</a>
					<div class="hero-nav-end">
						<ThemeToggleButton />
						<a href="/" class="btn-ghost" aria-label="Back to home">
							<i class="fas fa-arrow-left"></i>
							<span>Home</span>
						</a>
					</div>
				</div>

				<div class="hero-inner">
					<div class="hero-aurora hero-aurora--a" aria-hidden="true"></div>
					<div class="hero-aurora hero-aurora--b" aria-hidden="true"></div>

					<div class="hero-content">
						<span class="eyebrow">
							<span class="eyebrow-dot"></span>
							The portfolio · {totalCount} projects
						</span>
						<h1 class="hero-title">
							Real sites for <span class="title-mark">service businesses</span>
							that need to show up on Google.
						</h1>
						<p class="hero-desc">
							Every project on this page was built by one person. <b>All sites</b> are ranked on Google within three months. None are stuck behind agency contracts. Take a look, then let's build yours.
						</p>
						<div class="hero-actions">
							<a href="/contact/" class="btn-solid">
								<span>Start a project</span>
								<i class="fas fa-arrow-right" aria-hidden="true"></i>
							</a>
							<a href="/#simple-pricing" class="btn-outline">See pricing</a>
						</div>
					</div>

					<dl class="hero-stats" aria-label="Track record">
						<div class="stat">
							<dt class="stat-num">{totalCount}<span class="stat-suffix">+</span></dt>
							<dd class="stat-label">Sites shipped</dd>
						</div>
						<div class="stat">
							<dt class="stat-num">3<span class="stat-suffix">mo</span></dt>
							<dd class="stat-label">Rank target</dd>
						</div>
						<div class="stat">
							<dt class="stat-num">100<span class="stat-suffix">%</span></dt>
							<dd class="stat-label">Client owned</dd>
						</div>
						<div class="stat">
							<dt class="stat-num">0</dt>
							<dd class="stat-label">Long contracts</dd>
						</div>
					</dl>
				</div>

				<div class="crumbs-wrap">
					<Breadcrumbs variant="dark" items={[{ href: '/', label: 'Home' }]} current="Portfolio" />
				</div>
			</section>

			<!-- FILTERS + GRID -->
			<section class="work" aria-labelledby="work-heading">
				<div class="work-head">
					<h2 class="visually-hidden" id="work-heading">Portfolio projects</h2>
					<div class="filter-bar" role="tablist" aria-label="Filter portfolio by category">
						{filters.map((f, i) => (
							<button
								type="button"
								class={`filter-pill${i === 0 ? ' is-active' : ''}`}
								data-filter={f.id}
								role="tab"
								aria-selected={i === 0 ? 'true' : 'false'}
							>
								<span class="filter-pill-label">{f.label}</span>
								<span class="filter-pill-count">{f.count}</span>
							</button>
						))}
					</div>
					<p class="filter-note">Click a card to open the live site in a new tab.</p>
				</div>

				<div class="portfolio-grid" data-grid>
					{portfolioItems.map((item, idx) => {
						const group = groupOf(item.category);
						return (
							<>
								<article
									class="portfolio-card"
									data-group={group}
									style={`--card-accent: ${accentByGroup[group]};`}
								>
									<a class="card-shell" href={item.url} target="_blank" rel="noopener noreferrer" aria-label={`Visit ${item.title}`}>
										<div class={`preview-wrap${(item.previewPosition ?? 'top') === 'top' ? ' preview-wrap--top' : ''}${item.previewFit === 'contain' ? ' preview-wrap--contain' : ''}`}>
											{item.previewImage ? (
												<img
													src={item.previewImage}
													alt={`Preview of ${item.title}`}
													class="preview-img preview-img--static"
													loading="lazy"
												/>
											) : (
												<iframe
													title={`Live preview of ${item.title}`}
													data-src={item.url}
													class="preview-iframe"
													aria-hidden="true"
													tabindex="-1"
													loading="lazy"
												/>
											)}
											<span class="card-num">{String(idx + 1).padStart(2, '0')}</span>
											<span class="card-visit">
												Visit site
												<i class="fas fa-arrow-right" aria-hidden="true"></i>
											</span>
										</div>

										<div class="card-body">
											<div class="card-meta">
												<span class="category-tag">{item.serviceType ?? item.category}</span>
												<span class="card-host">{item.url.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '')}</span>
											</div>
											<h3 class="card-title">{item.title}</h3>
											<div class="card-story">
												<p class="story-line story-line--need">
													<span class="story-label">Needed</span>
													<span class="story-text">{item.whatTheyNeeded}</span>
												</p>
												<p class="story-line story-line--shipped">
													<span class="story-label">Shipped</span>
													<span class="story-text">{item.result}</span>
												</p>
											</div>
										</div>
									</a>
								</article>

								{idx === ctaInsertAfter && (
									<article class="portfolio-cta-card" data-group="all">
										<div class="cta-card-grain" aria-hidden="true"></div>
										<span class="cta-card-eyebrow">Spot a fit?</span>
										<h3 class="cta-card-title">Your business could be next on this page.</h3>
										<p class="cta-card-text">If any of these look like the kind of site you want, tell me about your business. I'll send back a plan and a quote within a day.</p>
										<a href="/contact/" class="cta-card-btn">
											<span>Get a quote</span>
											<i class="fas fa-arrow-right" aria-hidden="true"></i>
										</a>
									</article>
								)}
							</>
						);
					})}
				</div>

				<p class="empty-state" data-empty hidden>No projects in that category yet. Try "All work".</p>
			</section>

			<!-- CLOSING CTA -->
			<section class="end-cta-section" aria-labelledby="end-cta-heading">
				<div class="end-cta">
					<div class="end-cta-bg" aria-hidden="true"></div>
					<div class="end-cta-rule" aria-hidden="true"></div>

					<div class="end-cta-content">
						<span class="eyebrow eyebrow--centered">
							<span class="eyebrow-dot"></span>
							Ready to ship?
						</span>
						<h2 class="end-cta-title" id="end-cta-heading">
							Let's get your business <span class="title-underline">on Google</span>.
						</h2>
						<p class="end-cta-desc">
							Tell me a little about your business. I'll respond with a plan, a real quote, and a timeline. No agencies, no upsells, no monthly retainer trap.
						</p>
						<div class="end-cta-actions">
							<a href="/contact/" class="btn-solid btn-lg">
								<span>Start a project</span>
								<i class="fas fa-arrow-right" aria-hidden="true"></i>
							</a>
							<a href="/#simple-pricing" class="btn-outline btn-lg">See pricing</a>
						</div>
						<ul class="trust-row" aria-label="What you get">
							<li><i class="fas fa-check" aria-hidden="true"></i>One builder, no middlemen</li>
							<li><i class="fas fa-check" aria-hidden="true"></i>Rank target in 3 months</li>
							<li><i class="fas fa-check" aria-hidden="true"></i>You own the site</li>
						</ul>
					</div>
				</div>
			</section>
		</main>
	</div>
	<Footer />
</Layout>

<style>
	.bg-blur {
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		z-index: 0;
		filter: blur(120px);
		opacity: 0.14;
		pointer-events: none;
	}

	.portfolio-brush-bg {
		position: fixed;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
		z-index: 0;
		pointer-events: none;
		opacity: 0.42;
		mix-blend-mode: lighten;
	}

	.page {
		position: relative;
		z-index: 1;
	}

	/* ═══════════════════════════════════════
	   Hero
	   ═══════════════════════════════════════ */
	.hero {
		max-width: 1180px;
		margin: 0 auto;
		padding: 2rem 1.5rem 1.25rem;
	}

	.hero-nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 2.25rem;
	}

	.hero-nav-end {
		display: flex;
		align-items: center;
		gap: 0.65rem;
	}

	.logo-link {
		display: inline-flex;
		opacity: 0.92;
		text-decoration: none;
	}

	.logo-link:hover {
		opacity: 1;
	}

	.btn-ghost {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.55rem 0.95rem;
		font-size: 0.82rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		border-radius: 999px;
		background: transparent;
		color: var(--text);
		border: 1px solid var(--border);
		text-decoration: none;
		transition: background 0.25s, border-color 0.25s, transform 0.15s;
	}

	.btn-ghost:hover {
		background: var(--text);
		color: var(--bg);
		border-color: var(--text);
		transform: translateY(-1px);
	}

	.hero-inner {
		position: relative;
		display: grid;
		grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
		gap: 2.5rem;
		align-items: end;
		padding: 2.5rem;
		border: 1px solid var(--border);
		border-radius: calc(var(--radius) * 1.4);
		background:
			linear-gradient(165deg, color-mix(in srgb, var(--surface) 90%, transparent) 0%, var(--surface) 100%);
		overflow: hidden;
		isolation: isolate;
	}

	.hero-aurora {
		position: absolute;
		border-radius: 50%;
		filter: blur(110px);
		pointer-events: none;
		z-index: 0;
	}

	.hero-aurora--a {
		top: -120px;
		left: -120px;
		width: 460px;
		height: 460px;
		background: var(--accent);
		opacity: 0.22;
	}

	.hero-aurora--b {
		bottom: -160px;
		right: -120px;
		width: 460px;
		height: 460px;
		background: var(--accent-purple);
		opacity: 0.16;
	}

	.hero-content,
	.hero-stats {
		position: relative;
		z-index: 1;
	}

	.eyebrow {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-family: var(--font-display);
		font-size: 0.95rem;
		letter-spacing: 0.18em;
		color: var(--text-muted);
		text-transform: uppercase;
		margin-bottom: 1rem;
	}

	.eyebrow--centered {
		justify-content: center;
	}

	.eyebrow-dot {
		display: inline-block;
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: var(--accent);
		box-shadow: 0 0 12px color-mix(in srgb, var(--accent) 60%, transparent);
	}

	.hero-title {
		font-family: var(--font-display);
		font-weight: 400;
		text-transform: uppercase;
		letter-spacing: 0.005em;
		margin: 0;
		font-size: clamp(2.5rem, 6.2vw, 5.25rem);
		line-height: 0.92;
		color: var(--text);
	}

	.title-mark {
		background: linear-gradient(120deg, var(--accent), var(--accent-pink));
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
	}

	.title-underline {
		position: relative;
		display: inline-block;
		white-space: nowrap;
	}

	.title-underline::after {
		content: '';
		position: absolute;
		left: -2%;
		right: -2%;
		bottom: 0.05em;
		height: 0.18em;
		background: linear-gradient(90deg, transparent, var(--accent) 15%, var(--accent-pink) 85%, transparent);
		border-radius: 999px;
		opacity: 0.85;
	}

	.hero-desc {
		color: var(--text-muted);
		font-size: clamp(1rem, 1.4vw, 1.18rem);
		line-height: 1.6;
		max-width: 56ch;
		margin: 1.25rem 0 0;
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 1.75rem;
	}

	.btn-solid {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		padding: 0.9rem 1.6rem;
		font-size: 0.95rem;
		font-weight: 500;
		font-family: var(--font);
		text-transform: uppercase;
		letter-spacing: 0.05em;
		border-radius: 999px;
		background: var(--text);
		color: var(--bg);
		border: 1px solid var(--text);
		text-decoration: none;
		transition: background 0.25s, color 0.25s, transform 0.15s, box-shadow 0.25s;
	}

	.btn-solid:hover {
		background: var(--accent);
		color: #fff;
		border-color: var(--accent);
		transform: translateY(-1px);
		box-shadow: 0 14px 32px -10px color-mix(in srgb, var(--accent) 55%, transparent);
	}

	.btn-solid i {
		transition: transform 0.25s cubic-bezier(0.2, 0.8, 0.2, 1);
	}

	.btn-solid:hover i {
		transform: translateX(3px);
	}

	.btn-outline {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		padding: 0.9rem 1.6rem;
		font-size: 0.95rem;
		font-weight: 500;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		border-radius: 999px;
		background: transparent;
		color: var(--text);
		border: 1px solid var(--border);
		text-decoration: none;
		transition: background 0.25s, color 0.25s, border-color 0.25s, transform 0.15s;
	}

	.btn-outline:hover {
		background: var(--text);
		color: var(--bg);
		border-color: var(--text);
		transform: translateY(-1px);
	}

	.btn-lg {
		padding: 1.05rem 2rem;
		font-size: 1rem;
	}

	.hero-stats {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1.25rem 0.5rem;
		align-self: end;
		padding: 0;
		margin: 0;
	}

	.stat {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
		padding-left: 1rem;
		border-left: 2px solid color-mix(in srgb, var(--accent) 55%, transparent);
	}

	.stat-num {
		font-family: var(--font-display);
		font-size: clamp(2.4rem, 4vw, 3.4rem);
		line-height: 0.9;
		color: var(--text);
		letter-spacing: -0.01em;
		margin: 0;
	}

	.stat-suffix {
		font-size: 0.45em;
		color: var(--accent);
		margin-left: 0.15em;
		letter-spacing: 0.04em;
	}

	.stat-label {
		font-family: var(--font);
		font-size: 0.78rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--text-muted);
		margin: 0;
	}

	.crumbs-wrap {
		margin-top: 1.5rem;
		padding-top: 1rem;
		border-top: 1px solid var(--border);
	}

	/* ═══════════════════════════════════════
	   Filter bar + work head
	   ═══════════════════════════════════════ */
	.work {
		max-width: 1180px;
		margin: 0 auto;
		padding: 1.5rem 1.5rem 3.5rem;
	}

	.work-head {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 1.5rem;
	}

	.filter-bar {
		display: inline-flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		padding: 0.35rem;
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: 999px;
	}

	.filter-pill {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.55rem 1rem;
		font-family: var(--font);
		font-size: 0.85rem;
		font-weight: 500;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		border-radius: 999px;
		border: none;
		background: transparent;
		color: var(--text-muted);
		cursor: pointer;
		transition: background 0.2s, color 0.2s;
	}

	.filter-pill:hover {
		color: var(--text);
	}

	.filter-pill.is-active {
		background: var(--text);
		color: var(--bg);
	}

	.filter-pill-count {
		display: inline-block;
		min-width: 1.4em;
		padding: 0.05em 0.45em;
		font-size: 0.7rem;
		font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
		text-align: center;
		border-radius: 999px;
		background: color-mix(in srgb, currentColor 12%, transparent);
		color: inherit;
	}

	.filter-note {
		margin: 0;
		font-size: 0.85rem;
		color: var(--text-muted);
	}

	/* ═══════════════════════════════════════
	   Grid + cards
	   ═══════════════════════════════════════ */
	.portfolio-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr));
		gap: 1.25rem;
		width: 100%;
	}

	.portfolio-card {
		--card-accent: var(--accent);
		position: relative;
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		overflow: hidden;
		display: flex;
		flex-direction: column;
		isolation: isolate;
		transition:
			transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1),
			border-color 0.3s,
			box-shadow 0.35s;
	}

	.portfolio-card::before {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		height: 3px;
		background: linear-gradient(90deg, var(--card-accent), transparent 75%);
		z-index: 2;
		opacity: 0.85;
	}

	.portfolio-card:hover {
		border-color: color-mix(in srgb, var(--card-accent) 55%, var(--border));
		transform: translateY(-4px);
		box-shadow: 0 22px 56px -22px color-mix(in srgb, var(--card-accent) 55%, transparent);
	}

	.card-shell {
		display: flex;
		flex-direction: column;
		flex: 1;
		color: inherit;
		text-decoration: none;
	}

	.preview-wrap {
		position: relative;
		width: 100%;
		aspect-ratio: 16 / 10;
		background: #0a0a0d;
		overflow: hidden;
		border-bottom: 1px solid var(--border);
	}

	.preview-img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: top center;
		z-index: 1;
		transition: transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1);
	}

	.preview-img--static {
		object-position: top center;
	}

	.preview-wrap--top .preview-img {
		object-position: top center;
	}

	.preview-wrap--contain .preview-img {
		object-fit: contain;
		object-position: top center;
	}

	.preview-iframe {
		position: absolute;
		inset: 0;
		width: 200%;
		height: 200%;
		border: none;
		z-index: 0;
		pointer-events: none;
		transform: scale(0.5);
		transform-origin: top left;
	}

	.portfolio-card:hover .preview-img {
		transform: scale(1.04);
	}

	.card-num {
		position: absolute;
		top: 0.75rem;
		left: 0.85rem;
