---
import '@fortawesome/fontawesome-free/css/all.min.css';
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ThemeToggleButton from '../components/ThemeToggleButton.astro';
import astroLogo from '../assets/computertommylogo.svg';
import background from '../assets/background.svg';
import { portfolioItems } from '../data/portfolio';
---

<Layout
	title="Portfolio | Computer Tommy"
	description="Sites built for local service businesses, bands, and small brands. Fast pages, clear offers, no agency retainers."
	canonical="https://computertommy.com/portfolio/"
	image="/computertommylogo.png"
>
	<div class="themed-subpage">
		<img class="bg-blur" src={background.src} alt="" fetchpriority="high" />
		<img src="/portfolio/bg-img-ct.png" alt="" class="portfolio-brush-bg" aria-hidden="true" />
		<main class="page">
			<section class="hero section">
				<div class="hero-nav">
					<a href="/" class="logo-link">
						<img src={astroLogo.src} width="115" height="48" alt="Computer Tommy Home" />
					</a>
					<div class="hero-nav-end">
						<ThemeToggleButton />
						<a href="/" class="btn-outline btn-small" aria-label="Back to home">
							<i class="fas fa-arrow-left"></i>
							<span>Home</span>
						</a>
					</div>
				</div>

				<div class="hero-content">
					<span class="section-eyebrow">Selected work</span>
					<h1 class="hero-title">Sites we have built</h1>
					<p class="hero-desc">
						What each client needed, what shipped, and how visitors get to a clear next step. One builder, fixed scopes when it makes sense, and no surprise monthly trap on the builds listed here.
					</p>
				</div>

				<div class="crumbs-wrap">
					<Breadcrumbs variant="dark" items={[{ href: '/', label: 'Home' }]} current="Portfolio" />
				</div>
			</section>

			<section class="section grid-section" aria-labelledby="work-heading">
				<h2 class="visually-hidden" id="work-heading">Portfolio projects</h2>
				<div class="portfolio-grid">
					{portfolioItems.map((item) => (
						<article class="portfolio-card">
							<div class="preview-wrap">
								{item.previewImage ? (
									<img
										src={item.previewImage}
										alt={`Preview of ${item.title}`}
										class="preview-img preview-img--static"
									/>
								) : (
									<iframe
										title={`Live preview of ${item.title}`}
										data-src={item.url}
										class="preview-iframe"
										aria-hidden="true"
										tabindex="-1"
									/>
								)}
							</div>
							<div class="card-body">
								<span class="category">{item.category}</span>
								<h3 class="card-title">{item.title}</h3>
								<p class="need">{item.whatTheyNeeded}</p>
								<p class="result">{item.result}</p>
								<a href={item.url} target="_blank" rel="noopener noreferrer" class="card-link">
									Visit site <i class="fas fa-external-link-alt" aria-hidden="true"></i>
								</a>
							</div>
						</article>
					))}
				</div>
			</section>
		</main>
	</div>
	<Footer />
</Layout>

<style>
	.bg-blur {
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		z-index: 0;
		filter: blur(120px);
		opacity: 0.14;
		pointer-events: none;
	}

	.portfolio-brush-bg {
		position: fixed;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
		z-index: 0;
		pointer-events: none;
		opacity: 0.42;
		mix-blend-mode: lighten;
	}

	.hero-nav-end {
		display: flex;
		align-items: center;
		gap: 0.65rem;
	}

	.page {
		position: relative;
		z-index: 1;
	}

	.section {
		max-width: 1100px;
		margin: 0 auto;
		padding: 0 1.5rem 4rem;
	}

	.hero {
		padding-top: 2rem;
		padding-bottom: 1rem;
	}

	.hero-nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 2rem;
	}

	.logo-link {
		display: inline-flex;
		opacity: 0.92;
		text-decoration: none;
	}

	.logo-link:hover {
		opacity: 1;
	}

	.hero-content {
		max-width: 900px;
	}

	.section-eyebrow {
		display: inline-block;
		font-family: var(--font-display);
		font-size: 1.2rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--text-muted);
		margin-bottom: 0.5rem;
	}

	.hero-title {
		font-family: var(--font-display);
		font-weight: 400;
		text-transform: uppercase;
		letter-spacing: 0.02em;
		margin: 0;
		font-size: clamp(2.4rem, 8vw, 5rem);
		line-height: 0.95;
		word-wrap: break-word;
		overflow-wrap: break-word;
	}

	.hero-desc {
		color: var(--text-muted);
		font-size: clamp(1rem, 2vw, 1.2rem);
		line-height: 1.55;
		max-width: 720px;
		margin: 1rem 0 0;
	}

	.btn-outline {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.55rem;
		padding: 0.6rem 1rem;
		font-size: 0.86rem;
		border-radius: var(--radius);
		text-decoration: none;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.03em;
		background: transparent;
		color: var(--text);
		border: 1px solid var(--border);
		transition: background 0.25s, color 0.25s, border-color 0.25s, transform 0.15s;
	}

	.btn-outline:hover {
		background: var(--text);
		color: var(--bg);
		border-color: var(--text);
		transform: translateY(-1px);
	}

	.crumbs-wrap {
		margin-top: 1.2rem;
		padding-top: 1rem;
		border-top: 1px solid var(--border);
	}

	.grid-section {
		padding-top: 0.5rem;
	}

	.portfolio-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr));
		gap: 1.25rem;
		width: 100%;
	}

	.portfolio-card {
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		overflow: hidden;
		display: flex;
		flex-direction: column;
		transition: border-color 0.2s, transform 0.2s, box-shadow 0.2s;
	}

	.portfolio-card:hover {
		border-color: rgba(249, 115, 22, 0.35);
		transform: translateY(-3px);
		box-shadow: 0 12px 40px rgba(0, 0, 0, 0.35);
	}

	.preview-wrap {
		position: relative;
		width: 100%;
		aspect-ratio: 16 / 10;
		background: #0a0a0d;
		overflow: hidden;
		border-bottom: 1px solid var(--border);
	}

	.preview-img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		z-index: 1;
	}

	.preview-img--static {
		object-position: top center;
	}

	.preview-iframe {
		position: absolute;
		inset: 0;
		width: 200%;
		height: 200%;
		border: none;
		z-index: 0;
		pointer-events: none;
		transform: scale(0.5);
		transform-origin: top left;
	}

	.card-body {
		padding: 1.2rem 1.35rem 1.35rem;
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		flex: 1;
	}

	.category {
		font-size: 0.72rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--accent);
		font-weight: 700;
	}

	.card-title {
		font-family: var(--font-display);
		font-weight: 400;
		text-transform: uppercase;
		letter-spacing: 0.02em;
		font-size: 1.35rem;
		line-height: 1.15;
		margin: 0;
		color: var(--text);
	}

	.card-body .need,
	.card-body .result {
		font-size: 0.92rem;
		color: var(--text-muted);
		line-height: 1.55;
		margin: 0.15rem 0 0 0;
	}

	.card-body .result {
		font-weight: 600;
		color: rgba(255, 255, 255, 0.78);
	}

	.card-link {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		color: var(--accent);
		text-decoration: none;
		font-weight: 600;
		font-size: 0.88rem;
		text-transform: uppercase;
		letter-spacing: 0.04em;
		margin-top: 0.65rem;
		transition: gap 0.2s ease, color 0.2s ease;
	}

	.card-link:hover {
		gap: 0.65rem;
		color: #fb923c;
	}

	.card-link i {
		font-size: 0.75em;
	}

	.visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	@media (max-width: 768px) {
		.portfolio-brush-bg {
			opacity: 0.32;
		}

		.section {
			padding: 0 1rem 3rem;
		}

		.hero {
			padding-top: 1.4rem;
		}

		.hero-nav {
			margin-bottom: 1.35rem;
		}
	}
</style>

<script>
	window.history.scrollRestoration = 'manual';
	window.scrollTo(0, 0);

	function holdScrollToTop() {
		const start = Date.now();
		const duration = 1000;
		function tick() {
			if (Date.now() - start > duration) return;
			if (window.scrollY !== 0) window.scrollTo(0, 0);
			requestAnimationFrame(tick);
		}
		requestAnimationFrame(tick);
	}

	function loadIframes() {
		document.querySelectorAll<HTMLIFrameElement>('.preview-iframe').forEach((iframe) => {
			const src = iframe.getAttribute('data-src');
			if (src && !iframe.src) iframe.src = src;
		});
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', () => {
			holdScrollToTop();
			setTimeout(loadIframes, 150);
		});
	} else {
		holdScrollToTop();
		setTimeout(loadIframes, 150);
	}

	document.querySelectorAll<HTMLImageElement>('.preview-img').forEach((img) => {
		img.addEventListener('error', () => {
			img.style.display = 'none';
		});
	});
</script>
