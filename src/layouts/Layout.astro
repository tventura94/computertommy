
---
import logo from '../assets/computertommylogo.svg';

const {
	title = 'Computer Tommy: Professional Website Design and Development',
	description = 'Fast, clean websites and practical tooling for local businesses. 72-hour turnaround, no monthly fees.',
	canonical,
	image,
	jsonLd,
} = Astro.props as {
	title?: string;
	description?: string;
	canonical?: string;
	/** Open Graph image URL (absolute, or path like /og.png). Falls back to logo. */
	image?: string;
	jsonLd?: unknown | unknown[];
};

const siteUrl = 'https://computertommy.com';
const logoUrl = new URL(logo.src, siteUrl).toString();
const ogUrl = canonical ?? siteUrl + '/';
const ogImage = image
	? image.startsWith('http') ? image : new URL(image, siteUrl).toString()
	: logoUrl;

const localBusinessSchema = {
	'@context': 'https://schema.org',
	'@type': 'LocalBusiness',
	'@id': 'https://computertommy.com/#localbusiness',
	name: 'Computer Tommy',
	url: 'https://computertommy.com',
	image: logoUrl,
	priceRange: '$300-$2500',
	telephone: '+1-508-380-2013',
	address: {
		'@type': 'PostalAddress',
		streetAddress: '49 Joyner Ave',
		addressLocality: 'Asheville',
		addressRegion: 'NC',
		postalCode: '28806',
		addressCountry: 'US',
	},
	sameAs: ['https://instagram.com/computertommy'],
};

const jsonLdArray = jsonLd
	? Array.isArray(jsonLd)
		? jsonLd
		: [jsonLd]
	: [];
---

<!doctype html>

<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		{canonical ? <link rel="canonical" href={canonical} /> : null}
		<!-- Open Graph -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={ogUrl} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:site_name" content="Computer Tommy" />
		<!-- Twitter Card -->
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
		<script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
		{jsonLdArray.map((schema) => (
			<script type="application/ld+json" set:html={JSON.stringify(schema)} />
		))}
	</head>
	<body>
		<slot />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
