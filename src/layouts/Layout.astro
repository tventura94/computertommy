---
import '../styles/global.css';

const {
	title = 'Computer Tommy: Professional Website Design and Development',
	description = 'Fast, clean websites and practical tooling for local businesses. No monthly fees.',
	canonical,
	image,
	jsonLd,
	noIndex = false,
} = Astro.props as {
	title?: string;
	description?: string;
	canonical?: string;
	/** Open Graph image URL (absolute, or path like /og.png). Falls back to logo. */
	image?: string;
	jsonLd?: unknown | unknown[];
	/** When true, add robots noindex,nofollow and omit SEO meta/og/json-ld. */
	noIndex?: boolean;
};

const siteUrl = 'https://computertommy.com';
const socialImageUrl = new URL('/computertommylogo.png', siteUrl).toString();
const pathname = Astro.url.pathname;
const pathWithTrailingSlash =
	pathname === '' || pathname === '/'
		? '/'
		: pathname.endsWith('/')
			? pathname
			: pathname + '/';
const canonicalUrl = canonical ?? (siteUrl + pathWithTrailingSlash);
const ogUrl = canonicalUrl;
const ogImage = image
	? image.startsWith('http') ? image : new URL(image, siteUrl).toString()
	: socialImageUrl;

const localBusinessSchema = {
	'@context': 'https://schema.org',
	'@type': 'LocalBusiness',
	'@id': 'https://computertommy.com/#localbusiness',
	name: 'Computer Tommy',
	url: 'https://computertommy.com',
	image: socialImageUrl,
	priceRange: '$300-$2500',
	telephone: '+1-508-380-2013',
	address: {
		'@type': 'PostalAddress',
		streetAddress: '49 Joyner Ave',
		addressLocality: 'Asheville',
		addressRegion: 'NC',
		postalCode: '28806',
		addressCountry: 'US',
	},
	sameAs: ['https://instagram.com/computertommy'],
};

const jsonLdArray = jsonLd
	? Array.isArray(jsonLd)
		? jsonLd
		: [jsonLd]
	: [];
---

<!doctype html>

<html lang="en">
	<head>
		<script is:inline>
			(function () {
				try {
					var h = document.documentElement;
					var s = localStorage.getItem('theme');
					if (s === 'light' || (!s && window.matchMedia('(prefers-color-scheme: light)').matches)) {
						h.setAttribute('data-theme', 'light');
					} else {
						h.removeAttribute('data-theme');
					}
				} catch (e) {}
			})();
		</script>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		{noIndex ? (
			<meta name="robots" content="noindex, nofollow" />
		) : (
			<>
				<meta name="description" content={description} />
				{canonical ? <link rel="canonical" href={canonical} /> : null}
				<!-- Open Graph -->
				<meta property="og:type" content="website" />
				<meta property="og:url" content={ogUrl} />
				<meta property="og:title" content={title} />
				<meta property="og:description" content={description} />
				<meta property="og:image" content={ogImage} />
				<meta property="og:site_name" content="Computer Tommy" />
				<!-- Twitter Card -->
				<meta name="twitter:card" content="summary" />
				<meta name="twitter:title" content={title} />
				<meta name="twitter:description" content={description} />
				<meta name="twitter:image" content={ogImage} />
				<script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
				{jsonLdArray.map((schema) => (
					<script type="application/ld+json" set:html={JSON.stringify(schema)} />
				))}
			</>
		)}
		<!-- Google tag: always loaded for detection; consent mode = no cookies until user accepts -->
		<script
			is:inline
			define:vars={{ gaId: 'G-FJV8XHXV48' }}
		>
			window.dataLayer = window.dataLayer || [];
			function gtag(){dataLayer.push(arguments);}
			window.gtag = gtag;
			gtag('consent', 'default', { analytics_storage: 'denied', ad_storage: 'denied' });
			gtag('js', new Date());
			// Send page_view manually so we can fire it precisely after consent.
			gtag('config', gaId, { send_page_view: false });
		</script>
		<script async src="https://www.googletagmanager.com/gtag/js?id=G-FJV8XHXV48"></script>
		
<!-- Meta Pixel Code -->
<script is:inline>
	!function(f,b,e,v,n,t,s)
	{if(f.fbq)return;n=f.fbq=function(){n.callMethod?
	n.callMethod.apply(n,arguments):n.queue.push(arguments)};
	if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
	n.queue=[];t=b.createElement(e);t.async=!0;
	t.src=v;s=b.getElementsByTagName(e)[0];
	s.parentNode.insertBefore(t,s)}(window, document,'script',
	'https://connect.facebook.net/en_US/fbevents.js');

	window.META_PIXEL_ID = '2087040128902511';
	fbq('init', window.META_PIXEL_ID);
	fbq('track', 'PageView');

	window.metaSha256 = async function (value) {
		if (!value || !window.crypto || !window.crypto.subtle) return null;
		var encoded = new TextEncoder().encode(value);
		var buffer = await window.crypto.subtle.digest('SHA-256', encoded);
		return Array.from(new Uint8Array(buffer))
			.map(function (byte) {
				return byte.toString(16).padStart(2, '0');
			})
			.join('');
	};

	window.metaNormalizeEmail = function (email) {
		return (email || '').trim().toLowerCase();
	};

	window.metaNormalizePhone = function (phone) {
		var digits = (phone || '').replace(/\D/g, '');
		if (!digits) return '';
		if (digits.length === 10) return '1' + digits;
		if (digits.length === 11 && digits.charAt(0) === '1') return digits;
		return digits;
	};

	window.metaNormalizeNamePart = function (part) {
		return (part || '').trim().toLowerCase().replace(/[^a-z]/g, '');
	};

	window.metaBuildAdvancedMatching = async function (raw) {
		var match = {};
		if (!raw) return match;

		var email = window.metaNormalizeEmail(raw.email);
		if (email) {
			var hashedEmail = await window.metaSha256(email);
			if (hashedEmail) {
				match.em = hashedEmail;
				match.external_id = hashedEmail;
			}
		}

		var phone = window.metaNormalizePhone(raw.phone);
		if (phone) {
			var hashedPhone = await window.metaSha256(phone);
			if (hashedPhone) match.ph = hashedPhone;
		}

		var name = (raw.name || '').trim();
		if (name) {
			var parts = name.toLowerCase().split(/\s+/).filter(Boolean);
			var firstName = window.metaNormalizeNamePart(parts[0]);
			var lastName = window.metaNormalizeNamePart(parts.slice(1).join(' '));
			if (firstName) match.fn = await window.metaSha256(firstName);
			if (lastName) match.ln = await window.metaSha256(lastName);
		}

		var hashedCountry = await window.metaSha256('us');
		if (hashedCountry) match.country = hashedCountry;

		return match;
	};

	window.trackMetaContact = async function (eventParams, rawUser) {
		if (typeof window.fbq !== 'function') return;

		var params = eventParams || {};
		var eventId =
			'contact_' + Date.now().toString(36) + '_' + Math.random().toString(36).slice(2, 10);

		try {
			var match = await window.metaBuildAdvancedMatching(rawUser);
			if (match && Object.keys(match).length > 0) {
				fbq('init', window.META_PIXEL_ID, match);
			}
		} catch (e) {}

		fbq('track', 'Contact', params, { eventID: eventId });
	};
</script>
	<noscript><img height="1" width="1" style="display:none"
	src="https://www.facebook.com/tr?id=2087040128902511&ev=PageView&noscript=1"
	/></noscript>
	<!-- End Meta Pixel Code -->
	</head>
	<body>
		<slot />

		<!-- Cookie consent: floating card at bottom, doesn't block the page -->
		<div id="cookie-consent-modal" class="cookie-consent" aria-hidden="true">
			<div class="cookie-consent-inner">
				<p class="cookie-consent-text">
					We use cookies for analytics to improve the site. Do you accept?
				</p>
				<div class="cookie-consent-actions">
					<button type="button" id="cookie-accept" class="cookie-btn cookie-btn-accept">OK</button>
					<button type="button" id="cookie-reject" class="cookie-btn cookie-btn-reject">No thanks</button>
				</div>
			</div>
		</div>

		<script is:inline>
			(function () {
				var CONSENT_KEY = 'cookie-consent';
				var modal = document.getElementById('cookie-consent-modal');
				var acceptBtn = document.getElementById('cookie-accept');
				var rejectBtn = document.getElementById('cookie-reject');

				function grantConsent() {
					if (typeof window.gtag === 'function') {
						window.gtag('consent', 'update', { analytics_storage: 'granted', ad_storage: 'granted' });
					}
				}

				function sendPageView() {
					if (typeof window.gtag === 'function') {
						window.gtag('event', 'page_view', {
							page_path: window.location.pathname,
							page_location: window.location.href,
						});
					}
				}

				function hideModal() {
					if (modal) {
						modal.classList.remove('cookie-consent-visible');
						setTimeout(function () { modal.style.display = 'none'; }, 350);
					}
				}

				function onAccept() {
					try { localStorage.setItem(CONSENT_KEY, 'accepted'); } catch (e) {}
					grantConsent();
					sendPageView();
					hideModal();
				}

				function onReject() {
					try { localStorage.setItem(CONSENT_KEY, 'rejected'); } catch (e) {}
					hideModal();
				}

				var consent = '';
				try { consent = localStorage.getItem(CONSENT_KEY) || ''; } catch (e) {}

				if (consent === 'accepted') {
					grantConsent();
					sendPageView();
					hideModal();
				} else if (consent === 'rejected') {
					hideModal();
				} else {
					if (modal) {
						modal.style.display = 'block';
						modal.setAttribute('aria-hidden', 'false');
						modal.classList.add('cookie-consent-visible');
					}
					if (acceptBtn) acceptBtn.addEventListener('click', onAccept);
					if (rejectBtn) rejectBtn.addEventListener('click', onReject);
				}
			})();
		</script>
		<script is:inline>
			document.addEventListener('astro:after-swap', function () {
				if (typeof window.gtag === 'function') {
					window.gtag('event', 'page_view', {
						page_path: window.location.pathname,
						page_location: window.location.href,
					});
				}
			});
		</script>
		<script is:inline>
			(function () {
				document.addEventListener('click', function (e) {
					var btn = e.target.closest('[data-theme-toggle]');
					if (!btn) return;
					var h = document.documentElement;
					if (h.getAttribute('data-theme') === 'light') {
						h.removeAttribute('data-theme');
						localStorage.setItem('theme', 'dark');
					} else {
						h.setAttribute('data-theme', 'light');
						localStorage.setItem('theme', 'light');
					}
				});
			})();
		</script>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}

	/* Floating card at bottom: slide-up, doesn't block the page */
	.cookie-consent {
		display: none;
		position: fixed;
		bottom: 1.25rem;
		left: 1.25rem;
		right: 1.25rem;
		z-index: 9999;
		font-family: Inter, Roboto, 'Helvetica Neue', 'Arial Nova', 'Nimbus Sans', Arial, sans-serif;
		pointer-events: none;
	}
	.cookie-consent-inner {
		pointer-events: auto;
		max-width: 420px;
		margin: 0 0 0 auto;
		padding: 1rem 1.25rem;
		background: rgba(255, 255, 255, 0.92);
		backdrop-filter: blur(12px);
		border: 1px solid rgba(0, 0, 0, 0.06);
		border-radius: 14px;
		box-shadow: 0 4px 24px rgba(0, 0, 0, 0.1), 0 0 0 1px rgba(255, 255, 255, 0.5) inset;
		transform: translateY(120%);
		opacity: 0;
		transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.25s ease;
	}
	.cookie-consent-visible .cookie-consent-inner {
		transform: translateY(0);
		opacity: 1;
	}
	.cookie-consent-text {
		margin: 0 0 0.875rem 0;
		font-size: 0.9375rem;
		line-height: 1.45;
		color: #334155;
		letter-spacing: -0.01em;
	}
	.cookie-consent-actions {
		display: flex;
		gap: 0.5rem;
		flex-wrap: wrap;
	}
	.cookie-btn {
		padding: 0.5rem 1rem;
		font-size: 0.9rem;
		font-weight: 500;
		border-radius: 8px;
		cursor: pointer;
		border: none;
		font-family: inherit;
		transition: transform 0.15s ease, box-shadow 0.15s ease, color 0.15s ease, background 0.15s ease;
	}
	.cookie-btn:hover {
		transform: translateY(-1px);
	}
	.cookie-btn-accept {
		background: linear-gradient(135deg, #3245ff 0%, #6366f1 100%);
		color: white;
		box-shadow: 0 2px 12px rgba(50, 69, 255, 0.35);
	}
	.cookie-btn-accept:hover {
		box-shadow: 0 4px 16px rgba(50, 69, 255, 0.4);
	}
	.cookie-btn-reject {
		background: transparent;
		color: #64748b;
	}
	.cookie-btn-reject:hover {
		color: #334155;
		background: rgba(0, 0, 0, 0.04);
	}
	@media (min-width: 480px) {
		.cookie-consent {
			left: auto;
			right: 1.5rem;
			bottom: 1.5rem;
		}
		.cookie-consent-inner {
			margin: 0 0 0 auto;
		}
	}
</style>
