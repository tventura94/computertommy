---
export type Crumb = { href: string; label: string };

const { items, current } = Astro.props as {
	items: Crumb[];
	current?: string;
};
---

<nav class="breadcrumbs" aria-label="Breadcrumb">
	<ol>
		{items.map((item) => (
			<li>
				<a href={item.href}>{item.label}</a>
			</li>
		))}
		{current ? (
			<li aria-current="page">
				<span>{current}</span>
			</li>
		) : null}
	</ol>
</nav>

<style>
	.breadcrumbs {
		margin: 0.75rem 0 1rem;
	}

	.breadcrumbs ol {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.45rem;
		color: #64748b;
		font-family: Inter, Roboto, 'Helvetica Neue', 'Arial Nova', 'Nimbus Sans', Arial, sans-serif;
		font-size: 0.95rem;
	}

	.breadcrumbs li {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
	}

	.breadcrumbs li + li::before {
		content: "/";
		color: #94a3b8;
	}

	.breadcrumbs a {
		color: #3245ff;
		text-decoration: none;
		font-weight: 600;
	}

	.breadcrumbs a:hover {
		text-decoration: underline;
	}

	.breadcrumbs span {
		color: #475569;
		font-weight: 600;
	}
</style>

