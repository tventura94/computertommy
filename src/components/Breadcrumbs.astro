---
export type Crumb = { href: string; label: string };

const { items, current, variant = 'default' } = Astro.props as {
	items: Crumb[];
	current?: string;
	/** Use on dark pages (matches portfolio / service hub styling). */
	variant?: 'default' | 'dark';
};

const isDark = variant === 'dark';
---

<nav class:list={['breadcrumbs', isDark && 'breadcrumbs--dark']} aria-label="Breadcrumb">
	<ol>
		{items.map((item) => (
			<li>
				<a href={item.href}>{item.label}</a>
			</li>
		))}
		{current ? (
			<li aria-current="page">
				<span>{current}</span>
			</li>
		) : null}
	</ol>
</nav>

<style>
	.breadcrumbs {
		margin: 0.75rem 0 1rem;
	}

	.breadcrumbs ol {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.45rem;
		color: #64748b;
		font-family: Inter, Roboto, 'Helvetica Neue', 'Arial Nova', 'Nimbus Sans', Arial, sans-serif;
		font-size: 0.95rem;
	}

	.breadcrumbs li {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
	}

	.breadcrumbs li + li::before {
		content: '/';
		color: #94a3b8;
	}

	.breadcrumbs a {
		color: #3245ff;
		text-decoration: none;
		font-weight: 600;
	}

	.breadcrumbs a:hover {
		text-decoration: underline;
	}

	.breadcrumbs span {
		color: #475569;
		font-weight: 600;
	}

	/* Dark pages (portfolio, service hubs, SEO slug, location pages) */
	.breadcrumbs--dark {
		margin: 0;
	}

	.breadcrumbs--dark ol {
		color: rgba(255, 255, 255, 0.65);
		font-family: 'Outfit Variable', 'Outfit', Inter, system-ui, sans-serif;
	}

	.breadcrumbs--dark a {
		color: #f97316;
	}

	.breadcrumbs--dark a:hover {
		text-decoration: underline;
	}

	.breadcrumbs--dark span {
		color: #f0f0f5;
	}

	.breadcrumbs--dark li + li::before {
		color: rgba(255, 255, 255, 0.28);
	}

	:global(html[data-theme='light']) .breadcrumbs.breadcrumbs--dark ol {
		color: rgba(0, 0, 0, 0.55);
		font-family: 'Outfit Variable', 'Outfit', Inter, system-ui, sans-serif;
	}

	:global(html[data-theme='light']) .breadcrumbs.breadcrumbs--dark a {
		color: #c2410c;
	}

	:global(html[data-theme='light']) .breadcrumbs.breadcrumbs--dark a:hover {
		text-decoration: underline;
	}

	:global(html[data-theme='light']) .breadcrumbs.breadcrumbs--dark span {
		color: #14141a;
	}

	:global(html[data-theme='light']) .breadcrumbs.breadcrumbs--dark li + li::before {
		color: rgba(0, 0, 0, 0.22);
	}
</style>
