---
import '@fortawesome/fontawesome-free/css/all.min.css';
import astroLogo from '../assets/computertommylogo.svg';
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
    <div class="footer-grid">
        <div class="footer-card footer-contact-card">
            <div class="footer-contact-top">
                <span class="footer-eyebrow">Interested in working together?</span>
                <div class="footer-contact-links">
                    <div class="footer-contact-group">
                        <span class="footer-contact-label">(Email)</span>
                        <a href="mailto:letsbuild@computertommy.com" class="footer-contact-value">letsbuild@computertommy.com</a>
                    </div>
                    <div class="footer-contact-group">
                        <span class="footer-contact-label">(Phone)</span>
                        <a href="tel:5083802013" class="footer-contact-value">508 380 2013</a>
                    </div>
                </div>
            </div>
            <div class="footer-social-row">
                <a href="https://www.facebook.com/profile.php?id=61587740431665" class="footer-social-btn" aria-label="Facebook" target="_blank" rel="noopener noreferrer">
                    <i class="fab fa-facebook-f" aria-hidden="true"></i>
                </a>
                <a href="https://www.instagram.com/computer_tommy/" class="footer-social-btn" aria-label="Instagram" target="_blank" rel="noopener noreferrer">
                    <i class="fab fa-instagram" aria-hidden="true"></i>
                </a>
            </div>
        </div>

        <div class="footer-card footer-nav-card">
            <span class="footer-nav-label">Explore</span>
            <nav>
                <ul class="footer-nav-list">
                    <li><a href="/">Home</a></li>
                    <li><a href="/services/">Services</a></li>
                    <li><a href="/portfolio/">Portfolio</a></li>
                    <li><a href="/about/">About</a></li>
                    <li><a href="/contact/">Contact</a></li>
                </ul>
            </nav>
            <div class="footer-link-columns">
                <div class="footer-link-col">
                    <span class="footer-col-label">Services</span>
                    <ul>
                        <li><a href="/services/web-development/">Web Development</a></li>
                        <li><a href="/services/seo/">SEO</a></li>
                        <li><a href="/services/ai/">AI</a></li>
                        <li><a href="/services/tooling/">Tooling</a></li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="footer-card footer-bottom-bar">
            <div class="footer-brand">
                <a href="/" class="footer-logo">
                    <img src={astroLogo.src} width="88" height="36" alt="Computer Tommy" />
                </a>
                <span class="footer-copy">&copy; {currentYear} Computer Tommy</span>
            </div>
            <nav class="footer-legal">
                <a href="/contact/">FAQ</a>
            </nav>
        </div>
    </div>
</footer>

<style>
    .site-footer {
        --bg: #0b0b0f;
        --surface: #141419;
        --border: rgba(255, 255, 255, 0.08);
        --text: #f0f0f5;
        --text-muted: rgba(255, 255, 255, 0.55);
        --accent: #f97316;
        --radius: 16px;
        --font: 'Outfit Variable', 'Outfit', Inter, system-ui, sans-serif;
        --font-display: 'Bebas Neue', Impact, sans-serif;

        font-family: var(--font);
        background: var(--bg);
        color: var(--text);
        padding: 0;
        box-sizing: border-box;
    }

    .site-footer *, .site-footer *::before, .site-footer *::after {
        box-sizing: inherit;
    }

    .footer-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1px;
        background: var(--border);
    }

    .footer-card {
        background: var(--bg);
        padding: 2.5rem 3rem;
    }

    /* Contact card (left) */
    .footer-contact-card {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        gap: 2rem;
    }

    .footer-contact-top {
        display: flex;
        flex-direction: column;
        gap: 2rem;
    }

    .footer-eyebrow {
        font-family: var(--font-display);
        font-size: 1.25rem;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: var(--text-muted);
    }

    .footer-contact-links {
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
    }

    .footer-contact-group {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
    }

    .footer-contact-label {
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--text-muted);
        font-weight: 500;
    }

    .footer-contact-value {
        font-family: var(--font-display);
        font-size: clamp(1.5rem, 3vw, 2.5rem);
        color: var(--text);
        text-decoration: none;
        text-transform: uppercase;
        letter-spacing: 0.02em;
        transition: color 0.2s;
        line-height: 1.1;
    }

    .footer-contact-value:hover {
        color: var(--text-muted);
    }

    .footer-social-row {
        display: flex;
        gap: 0.5rem;
    }

    .footer-social-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 44px;
        height: 44px;
        border-radius: var(--radius);
        border: 1px solid var(--border);
        color: var(--text);
        text-decoration: none;
        font-size: 1.1rem;
        transition: background 0.2s, color 0.2s, border-color 0.2s;
    }

    .footer-social-btn:hover {
        background: var(--text);
        color: var(--bg);
        border-color: var(--text);
    }

    /* Nav card (right) */
    .footer-nav-card {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    .footer-nav-label {
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--text-muted);
        font-weight: 500;
    }

    .footer-nav-list {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .footer-nav-list li {
        border-bottom: 1px solid rgba(255, 255, 255, 0.04);
    }

    .footer-nav-list a {
        font-family: var(--font-display);
        font-size: 1.5rem;
        text-transform: uppercase;
        letter-spacing: 0.03em;
        color: var(--text);
        text-decoration: none;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0.6rem 0;
        transition: color 0.2s;
    }

    .footer-nav-list a:hover {
        color: var(--text-muted);
    }

    .footer-link-columns {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.5rem;
        margin-top: 0.5rem;
    }

    .footer-link-col {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .footer-col-label {
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--text-muted);
        font-weight: 600;
        margin-bottom: 0.25rem;
    }

    .footer-link-col ul {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .footer-link-col li {
        margin-bottom: 0.3rem;
    }

    .footer-link-col a {
        color: var(--text-muted);
        text-decoration: none;
        font-size: 0.9rem;
        transition: color 0.2s;
    }

    .footer-link-col a:hover {
        color: var(--text);
    }

    /* Bottom bar */
    .footer-bottom-bar {
        grid-column: 1 / -1;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1.25rem 3rem;
    }

    .footer-brand {
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .footer-logo {
        display: inline-flex;
        transition: opacity 0.2s;
    }

    .footer-logo:hover {
        opacity: 0.8;
    }

    .footer-logo img {
        height: 28px;
        width: auto;
    }

    .footer-copy {
        font-size: 0.85rem;
        color: var(--text-muted);
        text-transform: uppercase;
        letter-spacing: 0.04em;
    }

    .footer-legal {
        display: flex;
        gap: 1.5rem;
    }

    .footer-legal a {
        font-size: 0.85rem;
        color: var(--text-muted);
        text-decoration: none;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        transition: color 0.2s;
    }

    .footer-legal a:hover {
        color: var(--text);
    }

    @media (max-width: 768px) {
        .footer-grid {
            grid-template-columns: 1fr;
        }

        .footer-card {
            padding: 2rem 1.5rem;
        }

        .footer-contact-value {
            font-size: 1.5rem;
        }

        .footer-nav-list a {
            font-size: 1.25rem;
        }

        .footer-link-columns {
            grid-template-columns: 1fr;
            gap: 1.25rem;
        }

        .footer-bottom-bar {
            flex-direction: column;
            gap: 1rem;
            text-align: center;
            padding: 1.25rem 1.5rem;
        }

        .footer-brand {
            flex-direction: column;
            gap: 0.5rem;
        }

        .footer-legal {
            flex-wrap: wrap;
            justify-content: center;
        }
    }
</style>
