---
import '@fortawesome/fontawesome-free/css/all.min.css';
import astroLogo from '../assets/computertommylogo.svg';
import background from '../assets/background.svg';
import ThemeToggleButton from './ThemeToggleButton.astro';

const features = [
	'A clean, responsive site that actually looks good',
	'Contact form so venues and fans can reach you',
	'Seated.com integration for shows and tickets',
	'Optional newsletter signup',
	'YouTube, Bandcamp, Spotify, wherever you live',
	'Social and music links in one place',
];

const featureColors = ['orange', 'pink', 'yellow', 'green', 'purple', 'orange'] as const;
---

<div class="page-wrapper band-page">
	<img class="bg-blur" src={background.src} alt="" fetchpriority="high" />

	<div class="hero-bg" aria-hidden="true">
		<img src="/portfolio/bg-img-ct.png" alt="" class="hero-bg-img" />
	</div>

	<section class="hero">
		<div class="hero-nav">
			<a href="/" class="logo-link">
				<img src={astroLogo.src} width="130" height="52" alt="Computer Tommy home" />
			</a>
			<ThemeToggleButton />
		</div>

		<div class="hero-inner">
			<div class="hero-headline-wrap">
				<h1 class="hero-title">
					Your band's site.<br />One price. Done.
				</h1>
				<span class="badge badge-pink">For musicians</span>
				<span class="badge badge-yellow">One-time</span>
				<span class="badge badge-green">You own it</span>
			</div>

			<div class="hero-foot">
				<p class="hero-desc">
					Most low- to mid-tier bands never hit enough traffic to outgrow free hosting. So we charge a single small fee. You get a proper site, and you're set.
				</p>

				<article class="band-price-card plan-card plan-card--orange">
					<span class="plan-name">Band site package</span>
					<div class="plan-price">
						<span class="plan-price-amount">$300</span>
						<span class="plan-price-cadence">one-time</span>
					</div>
					<p class="band-price-note">You own it. No monthly anything.</p>
				</article>

				<div class="hero-actions">
					<a href="#band-contact" class="btn-solid">Get your band site &rarr;</a>
					<a href="/portfolio/" class="btn-outline">See portfolio</a>
				</div>
			</div>
		</div>
	</section>

	<section class="section section--alt" id="band-includes">
		<div class="section-header">
			<span class="section-eyebrow">What you get</span>
			<h2 class="section-title">Everything a band site needs.</h2>
			<p class="section-desc">
				Built to look sharp, load fast, and send fans and bookers where they need to go.
				<a href="/portfolio/" class="band-portfolio-link">See band and service sites we have built &rarr;</a>
			</p>
		</div>

		<ul class="band-feature-grid">
			{features.map((text, i) => (
				<li class:list={['band-feature', `band-feature--${featureColors[i]}`]}>
					<span class="band-feature-mark" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
					<p>{text}</p>
				</li>
			))}
		</ul>
	</section>

	<section class="section">
		<div class="section-center">
			<span class="section-eyebrow">Why so cheap?</span>
			<h2 class="section-title">No fluff. No monthly trap.</h2>
			<p class="band-why-text">
				We're not cutting corners. We're cutting the stuff bands don't need. No big CMS, no ongoing maintenance. Your traffic fits comfortably on free-tier hosting. You pay once, we build it, you own it. That's it.
			</p>
		</div>
	</section>

	<section class="section section--alt band-contact-section" id="band-contact" aria-labelledby="band-contact-heading">
		<img src="/paint-trip.png" alt="" class="cta-bg" />
		<div class="band-contact-inner">
			<header class="band-contact-header">
				<img class="cta-icon" src={astroLogo.src} alt="" />
				<span class="section-eyebrow">Get started</span>
				<h2 class="section-title" id="band-contact-heading">Your $300 band site starts here.</h2>
				<p class="band-contact-lead">
					Send a quick message about your band. I will get back within one business day. The form is already set for the one-time $300 package.
				</p>
			</header>

			<div class="band-form-card">
				<form
					class="band-form"
					name="contact"
					method="POST"
					data-netlify="true"
					netlify-honeypot="bot-field"
					action="/thank-you/"
				>
					<input type="hidden" name="form-name" value="contact" />
					<input type="hidden" name="plan" value="Band site — $300 one-time" />
					<p class="hp-field">
						<label>
							Do not fill this in: <input name="bot-field" type="text" tabindex="-1" autocomplete="off" />
						</label>
					</p>

					<div class="form-row form-row--two">
						<div class="form-field">
							<label for="band-contact-name">Your name</label>
							<input id="band-contact-name" name="name" type="text" autocomplete="name" required />
						</div>
						<div class="form-field">
							<label for="band-contact-email">Email</label>
							<input id="band-contact-email" name="email" type="email" autocomplete="email" required />
						</div>
					</div>

					<div class="form-field">
						<label for="band-contact-phone">
							Phone <span class="field-hint">(optional)</span>
						</label>
						<input id="band-contact-phone" name="phone" type="tel" autocomplete="tel" />
					</div>

					<div class="form-field">
						<label for="band-contact-message">Tell me about your band</label>
						<textarea
							id="band-contact-message"
							name="message"
							rows="5"
							placeholder="Band name, genre, links to your music, shows coming up, and anything you want on the site."
							required
						></textarea>
					</div>

					<button type="submit" class="btn-submit">
						<span>Send message for $300 band site</span>
						<i class="fas fa-arrow-right" aria-hidden="true"></i>
					</button>

					<p class="form-foot">
						Prefer to talk? Call <a href="tel:5083802013">508 380 2013</a> or email
						<a href="mailto:letsbuild@computertommy.com">letsbuild@computertommy.com</a>.
					</p>
				</form>
			</div>
		</div>
	</section>
</div>

<style>
	/* Design tokens (match Welcome homepage) */
	:global(html:has(.band-page)) {
		scroll-behavior: smooth;
	}

	.page-wrapper {
		--bg: #0b0b0f;
		--surface: #141419;
		--border: rgba(255, 255, 255, 0.08);
		--text: #f0f0f5;
		--text-muted: rgba(255, 255, 255, 0.55);
		--accent: #f97316;
		--accent-green: #4ade80;
		--accent-pink: #f472b6;
		--accent-yellow: #facc15;
		--accent-purple: #a78bfa;
		--radius: 16px;
		--radius-sm: 10px;
		--font: 'Outfit Variable', 'Outfit', system-ui, sans-serif;
		--font-display: 'Bebas Neue', Impact, sans-serif;

		font-family: var(--font);
		background: var(--bg);
		color: var(--text);
		min-height: 100vh;
		position: relative;
		overflow-x: clip;
		box-sizing: border-box;
	}

	.page-wrapper *,
	.page-wrapper *::before,
	.page-wrapper *::after {
		box-sizing: inherit;
	}

	.bg-blur {
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		z-index: 0;
		filter: blur(120px);
		opacity: 0.15;
		pointer-events: none;
	}

	.hero-bg {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		z-index: 0;
		pointer-events: none;
	}

	.hero-bg-img {
		width: 100%;
		height: auto;
		opacity: 0.3;
	}

	.hero {
		position: relative;
		z-index: 1;
		max-width: 1100px;
		margin: 0 auto;
		padding: 2rem 1.5rem 4rem;
		display: flex;
		flex-direction: column;
		gap: 2.5rem;
	}

	.hero-nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	.logo-link {
		display: inline-flex;
		align-items: center;
		text-decoration: none;
		opacity: 0.92;
		transition: opacity 0.2s;
	}

	.logo-link:hover {
		opacity: 1;
	}

	.hero-inner {
		display: flex;
		flex-direction: column;
		gap: 2.5rem;
	}

	.hero-headline-wrap {
		position: relative;
	}

	.hero-title {
		font-family: var(--font-display);
		font-size: clamp(3rem, 9vw, 7.5rem);
		font-weight: 400;
		line-height: 0.95;
		letter-spacing: 0.02em;
		color: var(--text);
		margin: 0;
		text-transform: uppercase;
	}

	.badge {
		position: absolute;
		font-family: var(--font-display);
		font-weight: 400;
		font-size: clamp(1rem, 2.5vw, 1.75rem);
		padding: 0.2em 0.6em;
		border-radius: 6px;
		color: #000;
		z-index: 2;
		pointer-events: none;
		letter-spacing: 0.04em;
	}

	.badge-pink {
		background: var(--accent-pink);
		top: -2.5rem;
		left: 0;
		transform: rotate(-12deg);
	}

	.badge-yellow {
		background: var(--accent-yellow);
		top: -1rem;
		right: 2rem;
		transform: rotate(10deg);
	}

	.badge-green {
		background: var(--accent-green);
		bottom: 0;
		right: 12%;
		transform: rotate(-6deg);
	}

	.hero-foot {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
		max-width: 640px;
	}

	.hero-desc {
		font-size: clamp(1rem, 2vw, 1.35rem);
		color: var(--text-muted);
		line-height: 1.55;
		margin: 0;
	}

	.band-price-card {
		max-width: 420px;
		margin: 0;
	}

	.band-price-note {
		margin: 0;
		font-size: 1rem;
		color: var(--text-muted);
		line-height: 1.5;
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}

	.btn-solid {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.8rem 2rem;
		font-size: 1rem;
		font-weight: 500;
		font-family: var(--font);
		text-decoration: none;
		text-transform: uppercase;
		letter-spacing: 0.03em;
		border-radius: var(--radius);
		background: var(--text);
		color: var(--bg);
		border: 1px solid var(--text);
		transition: background 0.3s, color 0.3s, transform 0.15s;
	}

	.btn-solid:hover {
		background: transparent;
		color: var(--text);
		transform: translateY(-1px);
	}

	.btn-outline {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.8rem 2rem;
		font-size: 1rem;
		font-weight: 500;
		font-family: var(--font);
		text-decoration: none;
		text-transform: uppercase;
		letter-spacing: 0.03em;
		border-radius: var(--radius);
		background: transparent;
		color: var(--text);
		border: 1px solid var(--border);
		transition: background 0.3s, color 0.3s, border-color 0.3s, transform 0.15s;
	}

	.btn-outline:hover {
		background: var(--text);
		color: var(--bg);
		border-color: var(--text);
		transform: translateY(-1px);
	}

	.btn-lg {
		padding: 1rem 2.5rem;
		font-size: 1.125rem;
	}

	.section {
		position: relative;
		z-index: 1;
		max-width: 1100px;
		margin: 0 auto;
		padding: 5rem 1.5rem;
	}

	.section--alt {
		background: var(--surface);
		max-width: none;
		padding-left: 0;
		padding-right: 0;
	}

	.section--alt > * {
		max-width: 1100px;
		margin-left: auto;
		margin-right: auto;
		padding-left: 1.5rem;
		padding-right: 1.5rem;
	}

	.section-header {
		max-width: 760px;
		margin-bottom: 2.5rem;
	}

	.section-eyebrow {
		display: inline-block;
		font-family: var(--font-display);
		font-size: 1.25rem;
		font-weight: 400;
		color: var(--text-muted);
		text-transform: uppercase;
		letter-spacing: 0.06em;
		margin-bottom: 0.75rem;
	}

	.section-title {
		font-family: var(--font-display);
		font-size: clamp(2.5rem, 6vw, 5rem);
		font-weight: 400;
		line-height: 1;
		letter-spacing: 0.02em;
		color: var(--text);
		margin: 0 0 1rem;
		text-transform: uppercase;
	}

	.section-desc {
		font-size: clamp(1rem, 2vw, 1.35rem);
		color: var(--text-muted);
		line-height: 1.55;
		margin: 0;
		max-width: 600px;
	}

	.band-portfolio-link {
		display: inline-block;
		margin-top: 0.75rem;
		font-weight: 600;
		color: var(--accent);
		text-decoration: none;
	}

	.band-portfolio-link:hover {
		text-decoration: underline;
	}

	#band-contact {
		scroll-margin-top: 1.5rem;
	}

	.section-center {
		text-align: center;
		max-width: 720px;
		margin: 0 auto;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1.25rem;
	}

	.section-center .section-title {
		margin-bottom: 0;
	}

	.band-why-text {
		font-size: clamp(1.05rem, 2vw, 1.35rem);
		color: var(--text-muted);
		line-height: 1.65;
		margin: 0;
	}

	/* Plan-style price card */
	.plan-card {
		--plan-color: var(--accent);
		--plan-shadow: rgba(249, 115, 22, 0.35);
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		padding: 1.75rem 1.5rem;
		transition: border-color 0.3s ease, box-shadow 0.3s ease, transform 0.3s ease;
	}

	.plan-card::before {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		height: 4px;
		background: var(--plan-color);
		border-radius: var(--radius) var(--radius) 0 0;
		pointer-events: none;
	}

	.plan-card:hover {
		border-color: var(--plan-color);
		box-shadow: 0 24px 60px -16px var(--plan-shadow);
		transform: translateY(-2px);
	}

	.plan-card--orange {
		--plan-color: var(--accent);
		--plan-shadow: rgba(249, 115, 22, 0.45);
	}

	.plan-name {
		font-family: var(--font-display);
		font-size: 1.15rem;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--plan-color);
		line-height: 1;
	}

	.plan-price {
		display: flex;
		align-items: baseline;
		gap: 0.35rem;
	}

	.plan-price-amount {
		font-family: var(--font-display);
		font-size: clamp(2.75rem, 8vw, 4rem);
		font-weight: 400;
		color: var(--text);
		letter-spacing: 0.01em;
		line-height: 1;
	}

	.plan-price-cadence {
		font-size: 1.1rem;
		font-weight: 500;
		color: var(--text-muted);
		text-transform: uppercase;
		letter-spacing: 0.04em;
	}

	/* Feature grid */
	.band-feature-grid {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		gap: 1rem;
	}

	.band-feature {
		--feat-color: var(--accent);
		position: relative;
		background: var(--bg);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		padding: 1.35rem 1.25rem 1.35rem 1.1rem;
		display: flex;
		align-items: flex-start;
		gap: 1rem;
		overflow: hidden;
		transition: border-color 0.25s ease, transform 0.2s ease;
	}

	.band-feature::before {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		height: 3px;
		background: var(--feat-color);
	}

	.band-feature:hover {
		border-color: var(--feat-color);
		transform: translateY(-2px);
	}

	.band-feature--orange { --feat-color: var(--accent); }
	.band-feature--pink   { --feat-color: var(--accent-pink); }
	.band-feature--yellow { --feat-color: var(--accent-yellow); }
	.band-feature--green  { --feat-color: var(--accent-green); }
	.band-feature--purple { --feat-color: var(--accent-purple); }

	.band-feature-mark {
		font-family: var(--font-display);
		font-size: 1.5rem;
		line-height: 1;
		color: var(--feat-color);
		flex-shrink: 0;
		letter-spacing: 0.06em;
	}

	.band-feature p {
		margin: 0;
		font-size: 1.05rem;
		line-height: 1.55;
		color: var(--text);
	}

	/* Contact form */
	.band-contact-section {
		position: relative;
		overflow: visible;
		isolation: isolate;
	}

	.cta-bg {
		position: absolute;
		top: 50%;
		left: 50%;
		transform: translate(-50%, -50%);
		width: 90%;
		max-width: 800px;
		height: auto;
		opacity: 0.25;
		pointer-events: none;
		z-index: 0;
	}

	.band-contact-inner {
		position: relative;
		z-index: 1;
		max-width: 640px;
		margin: 0 auto;
		display: flex;
		flex-direction: column;
		gap: 2rem;
	}

	.band-contact-header {
		text-align: center;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.75rem;
	}

	.band-contact-header .section-title {
		margin-bottom: 0;
	}

	.band-contact-lead {
		margin: 0;
		color: var(--text-muted);
		font-size: 1.05rem;
		line-height: 1.6;
		max-width: 520px;
	}

	.cta-icon {
		width: 6rem;
		height: auto;
		opacity: 0.9;
	}

	.band-form-card {
		background: var(--bg);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		padding: 1.85rem 1.5rem 2rem;
		box-shadow: 0 18px 50px -20px rgba(0, 0, 0, 0.4);
	}

	.band-form {
		display: flex;
		flex-direction: column;
		gap: 1.35rem;
	}

	.form-row {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1.35rem;
	}

	@media (min-width: 640px) {
		.form-row--two {
			grid-template-columns: 1fr 1fr;
			gap: 1.25rem;
		}
	}

	.hp-field {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	.form-field {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.form-field label {
		font-size: 0.95rem;
		font-weight: 600;
		color: var(--text);
	}

	.field-hint {
		font-weight: 400;
		font-size: 0.88em;
		color: var(--text-muted);
	}

	.form-field input,
	.form-field textarea {
		width: 100%;
		padding: 0.9rem 1rem;
		border-radius: var(--radius-sm);
		border: 1px solid var(--border);
		background: var(--surface);
		color: var(--text);
		font-family: inherit;
		font-size: 1rem;
		line-height: 1.5;
		transition: border-color 0.18s ease, box-shadow 0.18s ease;
	}

	.form-field textarea {
		resize: vertical;
		min-height: 8rem;
	}

	.form-field input:focus,
	.form-field textarea:focus {
		outline: none;
		border-color: var(--accent);
		box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 22%, transparent);
	}

	.btn-submit {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.65rem;
		padding: 1rem 1.5rem;
		border-radius: var(--radius);
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.04em;
		font-size: 1rem;
		cursor: pointer;
		font-family: inherit;
		border: 1px solid var(--accent);
		background: var(--accent);
		color: #0b0b0f;
		transition: background 0.2s ease, transform 0.15s ease, box-shadow 0.2s ease;
		box-shadow: 0 14px 30px -14px rgba(249, 115, 22, 0.55);
		align-self: stretch;
	}

	.btn-submit:hover {
		transform: translateY(-1px);
		opacity: 0.95;
	}

	.btn-submit i {
		transition: transform 0.2s ease;
	}

	.btn-submit:hover i {
		transform: translateX(3px);
	}

	.form-foot {
		margin: 0;
		font-size: 0.92rem;
		color: var(--text-muted);
		line-height: 1.55;
		text-align: center;
	}

	.form-foot a {
		color: var(--accent);
		font-weight: 600;
		text-decoration: none;
	}

	.form-foot a:hover {
		text-decoration: underline;
	}

	@media (max-width: 768px) {
		.hero {
			padding: 1.5rem 1rem 3rem;
		}

		.logo-link img {
			width: 100px;
