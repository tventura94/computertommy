---
import '@fortawesome/fontawesome-free/css/all.min.css';
import astroLogo from '../assets/computertommylogo.svg';
import background from '../assets/background.svg';
import ThemeToggleButton from './ThemeToggleButton.astro';
import { portfolioItems } from '../data/portfolio';

const bandSites = portfolioItems.filter((p) => p.category === 'Band site');
const midBand = Math.ceil(bandSites.length / 2);
const bandRowA = bandSites.slice(0, midBand);
const bandRowB = bandSites.slice(midBand);
const bandRowSecond = bandRowB.length > 0 ? bandRowB : bandRowA;

function portfolioStyleHost(url: string) {
	return url.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');
}

function bandMarbleCardNum(site: (typeof bandSites)[number]) {
	const n = bandSites.findIndex((s) => s.slug === site.slug) + 1;
	return String(Math.max(1, n)).padStart(2, '0');
}

const bandMarbleRows: { sites: typeof bandSites; drift: 'left' | 'right' }[] = [
	{ sites: bandRowA, drift: 'left' },
	{ sites: bandRowSecond, drift: 'right' },
];

const features = [
	{
		color: 'orange',
		icon: 'fa-wand-magic-sparkles',
		title: 'Professional design',
		body: 'A clean, responsive site that actually looks good on every screen.',
	},
	{
		color: 'pink',
		icon: 'fa-envelope',
		title: 'Contact form',
		body: 'Venues and fans can reach you without hunting for a DM or a buried link.',
	},
	{
		color: 'yellow',
		icon: 'fa-ticket',
		title: 'Shows and tickets',
		body: 'Seated.com integration so people see where you are playing and grab tickets.',
	},
	{
		color: 'green',
		icon: 'fa-newspaper',
		title: 'Newsletter signup',
		body: 'Optional list building for drops, tour dates, and whatever you send next.',
	},
	{
		color: 'purple',
		icon: 'fa-music',
		title: 'Your music, linked',
		body: 'YouTube, Bandcamp, Spotify, and the rest, wherever your catalog lives.',
	},
	{
		color: 'orange',
		icon: 'fa-link',
		title: 'One link hub',
		body: 'Socials and music in one place so new listeners do not bounce around.',
	},
] as const;
---

<div class="page-wrapper band-page">
	<img class="bg-blur" src={background.src} alt="" fetchpriority="high" />

	<div class="hero-bg" aria-hidden="true">
		<img src="/portfolio/bg-img-ct.png" alt="" class="hero-bg-img" />
	</div>

	<section class="hero">
		<div class="hero-nav">
			<a href="/" class="logo-link">
				<img src={astroLogo.src} width="130" height="52" alt="Computer Tommy home" />
			</a>
			<ThemeToggleButton />
		</div>

		<div class="hero-inner">
			<div class="hero-headline-wrap">
				<h1 class="hero-title">
					Your band's site.<br />One price. Done.
				</h1>
				<span class="badge badge-pink">For musicians</span>
				<span class="badge badge-yellow">One-time</span>
				<span class="badge badge-green">You own it</span>
			</div>

			<div class="hero-foot">
				<p class="hero-desc">
					Most low- to mid-tier bands never hit enough traffic to outgrow free hosting. So we charge a single small fee. You get a proper site, and you're set.
				</p>

				<article class="band-price-card" aria-label="Band site package, three hundred dollars one-time">
					<div class="band-price-aura" aria-hidden="true"></div>
					<div class="band-price-aura band-price-aura--b" aria-hidden="true"></div>
					<div class="band-price-frame">
						<span class="band-price-badge">One price · no monthly trap</span>
						<p class="band-price-label">Band site package</p>
						<div class="band-price-display">
							<span class="band-price-currency" aria-hidden="true">$</span>
							<span class="band-price-value">300</span>
						</div>
						<p class="band-price-cadence">one-time</p>
						<ul class="band-price-perks">
							<li>You own it</li>
							<li>Full build included</li>
							<li>Free-tier hosting ready</li>
						</ul>
					</div>
				</article>

				<div class="hero-actions">
					<a href="#band-contact" class="btn-solid">Get your band site &rarr;</a>
					<a href="/portfolio/" class="btn-outline">See portfolio</a>
				</div>
			</div>
		</div>
	</section>

	{bandSites.length > 0 && (
		<section class="band-showcase-marble" aria-labelledby="band-showcase-heading">
		<div class="band-showcase-inner">
			<p class="band-showcase-eyebrow" id="band-showcase-heading">Live band sites</p>
			<p class="band-showcase-tagline">
				A few artists already live. Click a tile to open the site.
			</p>
		</div>

		<div class="band-marble-grid" data-marquee-pause>
			{
				bandMarbleRows.map(({ sites, drift }) => (
					<div class="band-marble-row-wrap">
						<div class:list={['band-marble-row', drift === 'left' ? 'band-marble-row--left' : 'band-marble-row--right']}>
							<div class="band-marble-strip">
								{sites.map((site) => (
									<article class="band-tile-card" style="--card-accent: var(--accent-pink);">
										<a
											class="card-shell"
											href={site.url}
											target="_blank"
											rel="noopener noreferrer"
											aria-label={`Visit ${site.title}`}
										>
											<div class="preview-wrap" data-live-preview={site.url}>
												{site.previewImage ? (
													<img
														src={site.previewImage}
														alt={`Preview of ${site.title}`}
														class="preview-img preview-img--static"
														loading="lazy"
													/>
												) : (
													<iframe
														title={`Live preview of ${site.title}`}
														data-src={site.url}
														class="preview-iframe"
														aria-hidden="true"
														tabindex="-1"
														loading="lazy"
													/>
												)}
												<span class="card-num" aria-hidden="true">{bandMarbleCardNum(site)}</span>
												<span class="card-visit">
													Visit site
													<i class="fas fa-arrow-right" aria-hidden="true"></i>
												</span>
											</div>
											<div class="card-body">
												<div class="card-meta">
													<span class="category-tag">Band site</span>
													<span class="card-host">{portfolioStyleHost(site.url)}</span>
												</div>
												<h3 class="card-title">{site.title}</h3>
											</div>
										</a>
									</article>
								))}
								{sites.map((site) => (
									<article
										class="band-tile-card"
										style="--card-accent: var(--accent-pink);"
										data-band-marble-clone
										aria-hidden="true"
									>
										<a class="card-shell" href={site.url} target="_blank" rel="noopener noreferrer" tabindex="-1">
											<div class="preview-wrap" data-live-preview={site.url}>
												{site.previewImage ? (
													<img
														src={site.previewImage}
														alt=""
														class="preview-img preview-img--static"
														loading="lazy"
													/>
												) : (
													<iframe
														title={`Live preview of ${site.title}`}
														data-src={site.url}
														class="preview-iframe"
														aria-hidden="true"
														tabindex="-1"
														loading="lazy"
													/>
												)}
												<span class="card-num" aria-hidden="true">{bandMarbleCardNum(site)}</span>
												<span class="card-visit">
													Visit site
													<i class="fas fa-arrow-right" aria-hidden="true"></i>
												</span>
											</div>
											<div class="card-body">
												<div class="card-meta">
													<span class="category-tag">Band site</span>
													<span class="card-host">{portfolioStyleHost(site.url)}</span>
												</div>
												<h3 class="card-title">{site.title}</h3>
											</div>
										</a>
									</article>
								))}
							</div>
						</div>
					</div>
				))
			}
		</div>
	</section>
	)}

	<section class="section section--alt band-includes-section" id="band-includes">
		<div class="section-header band-includes-header">
			<span class="section-eyebrow">What you get</span>
			<h2 class="section-title">Everything a band site needs.</h2>
			<p class="section-desc">
				Built to look sharp, load fast, and send fans and bookers where they need to go.
				<a href="/portfolio/" class="band-portfolio-link">See band and service sites we have built &rarr;</a>
			</p>
		</div>

		<div class="band-features" data-band-features>
			<div class="band-features-stage" aria-live="polite">
				<ul class="band-features-slides">
					{features.map((feature, i) => (
						<li
							class:list={['band-feature', `band-feature--${feature.color}`, i === 0 && 'is-active']}
							data-feature-slide
							aria-hidden={i !== 0 ? 'true' : 'false'}
						>
							<span class="band-feature-mark" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
							<div class="band-feature-icon" aria-hidden="true">
								<i class:list={['fas', feature.icon]}></i>
							</div>
							<h3 class="band-feature-title">{feature.title}</h3>
							<p class="band-feature-body">{feature.body}</p>
						</li>
					))}
				</ul>
			</div>

			<div class="band-features-controls">
				<button type="button" class="band-features-btn" data-feature-prev aria-label="Previous benefit">
					<i class="fas fa-arrow-left" aria-hidden="true"></i>
				</button>
				<div class="band-features-dots" role="tablist" aria-label="Choose a benefit">
					{features.map((feature, i) => (
						<button
							type="button"
							class:list={['band-features-dot', i === 0 && 'is-active']}
							data-feature-dot={i}
							role="tab"
							aria-selected={i === 0 ? 'true' : 'false'}
							aria-label={`${feature.title}, benefit ${i + 1} of ${features.length}`}
						/>
					))}
				</div>
				<button type="button" class="band-features-btn" data-feature-next aria-label="Next benefit">
					<i class="fas fa-arrow-right" aria-hidden="true"></i>
				</button>
			</div>
		</div>
	</section>

	<section class="section">
		<div class="section-center">
			<span class="section-eyebrow">Why so cheap?</span>
			<h2 class="section-title">No fluff. No monthly trap.</h2>
			<p class="band-why-text">
				We're not cutting corners. We're cutting the stuff bands don't need. No big CMS, no ongoing maintenance. Your traffic fits comfortably on free-tier hosting. You pay once, we build it, you own it. That's it.
			</p>
		</div>
	</section>

	<section class="section section--alt band-contact-section" id="band-contact" aria-labelledby="band-contact-heading">
		<img src="/paint-trip.png" alt="" class="cta-bg" />
		<div class="band-contact-inner">
			<header class="band-contact-header">
				<img class="cta-icon" src={astroLogo.src} alt="" />
				<span class="section-eyebrow">Get started</span>
				<h2 class="section-title" id="band-contact-heading">Your $300 band site starts here.</h2>
				<p class="band-contact-lead">
					Send a quick message about your band. I will get back within one business day. The form is already set for the one-time $300 package.
				</p>
			</header>

			<div class="band-form-card">
				<form
					class="band-form"
					name="band-site"
					method="POST"
					data-netlify="true"
					netlify-honeypot="bot-field"
					action="/thank-you/"
				>
					<input type="hidden" name="form-name" value="band-site" />
					<input type="hidden" name="plan" value="Band site — $300 one-time" />
					<p class="hp-field">
						<label>
							Do not fill this in: <input name="bot-field" type="text" tabindex="-1" autocomplete="off" />
						</label>
					</p>

					<div class="form-row form-row--two">
						<div class="form-field">
							<label for="band-contact-name">Your name</label>
							<input id="band-contact-name" name="name" type="text" autocomplete="name" required />
						</div>
						<div class="form-field">
							<label for="band-contact-email">Email</label>
							<input id="band-contact-email" name="email" type="email" autocomplete="email" required />
						</div>
					</div>

					<div class="form-field">
						<label for="band-contact-phone">
							Phone <span class="field-hint">(optional)</span>
						</label>
						<input id="band-contact-phone" name="phone" type="tel" autocomplete="tel" />
					</div>

					<div class="form-field">
						<label for="band-contact-message">Tell me about your band</label>
						<textarea
							id="band-contact-message"
							name="message"
							rows="5"
							placeholder="Band name, genre, links to your music, shows coming up, and anything you want on the site."
							required
						></textarea>
					</div>

					<button type="submit" class="btn-submit">
						<span>Send message for $300 band site</span>
						<i class="fas fa-arrow-right" aria-hidden="true"></i>
					</button>

					<p class="form-foot">
						Prefer to talk? Call <a href="tel:5083802013">508 380 2013</a> or email
						<a href="mailto:letsbuild@computertommy.com">letsbuild@computertommy.com</a>.
					</p>
				</form>
			</div>
		</div>
	</section>
</div>

<script is:inline>
	(function () {
		var root = document.querySelector('[data-band-features]');
		if (!root) return;

		var slides = Array.prototype.slice.call(root.querySelectorAll('[data-feature-slide]'));
		var dots = Array.prototype.slice.call(root.querySelectorAll('[data-feature-dot]'));
		var prevBtn = root.querySelector('[data-feature-prev]');
		var nextBtn = root.querySelector('[data-feature-next]');
		var index = 0;
		var timer = null;
		var intervalMs = 5500;
		var autoplayEnabled =
			slides.length > 1 &&
			!window.matchMedia('(prefers-reduced-motion: reduce)').matches;

		function show(nextIndex) {
			index = (nextIndex + slides.length) % slides.length;

			slides.forEach(function (slide, i) {
				var active = i === index;
				slide.classList.toggle('is-active', active);
				slide.setAttribute('aria-hidden', active ? 'false' : 'true');
			});

			dots.forEach(function (dot, i) {
				var active = i === index;
				dot.classList.toggle('is-active', active);
				dot.setAttribute('aria-selected', active ? 'true' : 'false');
			});
		}

		function stopAutoplay() {
			if (timer) {
				clearInterval(timer);
				timer = null;
			}
		}

		function startAutoplay() {
			stopAutoplay();
			if (!autoplayEnabled || document.hidden) return;
			timer = setInterval(function () {
				show(index + 1);
			}, intervalMs);
		}

		function restartAutoplay() {
			stopAutoplay();
			startAutoplay();
		}

		if (prevBtn) {
			prevBtn.addEventListener('click', function () {
				show(index - 1);
				restartAutoplay();
			});
		}

		if (nextBtn) {
			nextBtn.addEventListener('click', function () {
				show(index + 1);
				restartAutoplay();
			});
		}

		dots.forEach(function (dot, i) {
			dot.addEventListener('click', function () {
				show(i);
				restartAutoplay();
			});
		});

		root.addEventListener('mouseenter', stopAutoplay);
		root.addEventListener('mouseleave', startAutoplay);
		root.addEventListener('focusin', stopAutoplay);
		root.addEventListener('focusout', function (e) {
			if (!root.contains(e.relatedTarget)) startAutoplay();
		});

		document.addEventListener('visibilitychange', function () {
			if (document.hidden) stopAutoplay();
			else startAutoplay();
		});

		startAutoplay();
	})();
</script>

<script is:inline>
	(function () {
		var root = document.querySelector('.band-showcase-marble');
		if (!root) return;

		function loadBandMarbleIframes() {
			root.querySelectorAll('.preview-iframe').forEach(function (iframe) {
				var src = iframe.getAttribute('data-src');
				if (src && !iframe.getAttribute('src')) iframe.setAttribute('src', src);
			});
		}

		function boot() {
			setTimeout(function () {
				loadBandMarbleIframes();
				root.querySelectorAll('.preview-img').forEach(function (img) {
					img.addEventListener('error', function () {
						img.style.display = 'none';
					});
				});
			}, 150);
		}

		if (document.readyState === 'loading') {
			document.addEventListener('DOMContentLoaded', boot);
		} else {
			boot();
		}
	})();
</script>

<style>
	/* Design tokens (match Welcome homepage) */
	:global(html:has(.band-page)) {
		scroll-behavior: smooth;
	}

	.page-wrapper {
		--bg: #0b0b0f;
		--surface: #141419;
		--border: rgba(255, 255, 255, 0.08);
		--text: #f0f0f5;
		--text-muted: rgba(255, 255, 255, 0.55);
		--accent: #f97316;
		--accent-green: #4ade80;
		--accent-pink: #f472b6;
		--accent-yellow: #facc15;
		--accent-purple: #a78bfa;
		--radius: 16px;
		--radius-sm: 10px;
		--font: 'Outfit Variable', 'Outfit', system-ui, sans-serif;
		--font-display: 'Bebas Neue', Impact, sans-serif;

		font-family: var(--font);
		background: var(--bg);
		color: var(--text);
		min-height: 100vh;
		position: relative;
		overflow-x: clip;
		box-sizing: border-box;
	}

	.page-wrapper *,
	.page-wrapper *::before,
	.page-wrapper *::after {
		box-sizing: inherit;
	}

	.bg-blur {
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		z-index: 0;
		filter: blur(120px);
		opacity: 0.15;
		pointer-events: none;
	}

	.hero-bg {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		z-index: 0;
		pointer-events: none;
	}

	.hero-bg-img {
		width: 100%;
		height: auto;
		opacity: 0.3;
	}

	.hero {
		position: relative;
		z-index: 1;
		max-width: 1100px;
		margin: 0 auto;
		padding: 2rem 1.5rem 4rem;
		display: flex;
		flex-direction: column;
		gap: 2.5rem;
	}

	.hero-nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	.logo-link {
		display: inline-flex;
		align-items: center;
		text-decoration: none;
		opacity: 0.92;
		transition: opacity 0.2s;
	}

	.logo-link:hover {
		opacity: 1;
	}

	.hero-inner {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 2.5rem;
		width: 100%;
		text-align: center;
	}

	.hero-headline-wrap {
		position: relative;
		width: 100%;
		max-width: 900px;
		margin: 0 auto;
		padding-top: 2.5rem;
	}

	.hero-title {
		font-family: var(--font-display);
		font-size: clamp(3rem, 9vw, 7.5rem);
		font-weight: 400;
		line-height: 0.95;
		letter-spacing: 0.02em;
		color: var(--text);
		margin: 0 auto;
		text-transform: uppercase;
		text-align: center;
	}

	.badge {
		position: absolute;
		font-family: var(--font-display);
		font-weight: 400;
		font-size: clamp(1rem, 2.5vw, 1.75rem);
		padding: 0.2em 0.6em;
		border-radius: 6px;
		color: #000;
		z-index: 2;
		pointer-events: none;
		letter-spacing: 0.04em;
	}

	.badge-pink {
		background: var(--accent-pink);
		top: -0.5rem;
		left: 8%;
		transform: rotate(-12deg);
	}

	.badge-yellow {
		background: var(--accent-yellow);
		top: -0.25rem;
		right: 8%;
		transform: rotate(10deg);
	}

	.badge-green {
		background: var(--accent-green);
		bottom: -0.25rem;
		left: 50%;
		right: auto;
		transform: translateX(-50%) rotate(-6deg);
	}

	.hero-foot {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1.75rem;
		width: 100%;
		max-width: 720px;
		margin: 0 auto;
		text-align: center;
	}

	.hero-desc {
		font-size: clamp(1rem, 2vw, 1.35rem);
		color: var(--text-muted);
		line-height: 1.55;
		margin: 0 auto;
		max-width: 540px;
	}

	.band-price-card {
		--price-glow: rgba(249, 115, 22, 0.55);
		position: relative;
		width: 100%;
		max-width: min(580px, 100%);
		margin: 0.5rem auto 0;
		padding: 3px;
		border-radius: calc(var(--radius) + 10px);
		background: linear-gradient(
			135deg,
			var(--accent) 0%,
			var(--accent-pink) 35%,
			var(--accent-yellow) 70%,
			var(--accent) 100%
		);
		box-shadow:
			0 0 0 1px rgba(255, 255, 255, 0.06) inset,
			0 40px 100px -35px var(--price-glow),
			0 8px 32px -12px rgba(0, 0, 0, 0.65);
		transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.35s ease;
	}

	.band-price-card:hover {
		transform: translateY(-6px) scale(1.01);
		box-shadow:
			0 0 0 1px rgba(255, 255, 255, 0.1) inset,
			0 52px 120px -40px var(--price-glow),
			0 16px 48px -16px rgba(0, 0, 0, 0.7);
	}

	.band-price-aura {
		position: absolute;
		width: 55%;
		height: 55%;
		top: -18%;
		right: -12%;
		border-radius: 50%;
		background: radial-gradient(circle, color-mix(in srgb, var(--accent) 45%, transparent), transparent 68%);
		filter: blur(28px);
		opacity: 0.85;
		pointer-events: none;
		animation: band-price-pulse 6s ease-in-out infinite;
	}

	.band-price-aura--b {
		top: auto;
		bottom: -22%;
		right: auto;
		left: -14%;
		width: 50%;
		height: 50%;
		background: radial-gradient(circle, color-mix(in srgb, var(--accent-pink) 40%, transparent), transparent 70%);
		animation-delay: -3s;
	}

	@keyframes band-price-pulse {
		0%,
		100% {
			opacity: 0.65;
			transform: scale(1);
		}
		50% {
			opacity: 1;
			transform: scale(1.08);
		}
	}

	.band-price-frame {
		position: relative;
		z-index: 1;
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: 0.65rem;
		padding: clamp(1.75rem, 4vw, 2.75rem) clamp(1.25rem, 3vw, 2.25rem) clamp(2rem, 4vw, 2.5rem);
		border-radius: calc(var(--radius) + 7px);
		background:
			linear-gradient(165deg, rgba(255, 255, 255, 0.04), transparent 42%),
			linear-gradient(var(--surface), var(--surface));
		overflow: hidden;
	}

	.band-price-frame::after {
		content: '';
		position: absolute;
		inset: 0;
		background: linear-gradient(
			105deg,
			transparent 40%,
			rgba(255, 255, 255, 0.06) 50%,
			transparent 60%
		);
		pointer-events: none;
	}

	.band-price-badge {
		font-family: var(--font-display);
		font-size: clamp(0.95rem, 2vw, 1.15rem);
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: #0b0b0f;
		background: linear-gradient(90deg, var(--accent-yellow), var(--accent));
		padding: 0.45rem 1rem;
		border-radius: 999px;
		box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 25%, transparent);
	}

	.band-price-label {
		margin: 0.35rem 0 0;
		font-family: var(--font-display);
		font-size: clamp(1.25rem, 2.5vw, 1.65rem);
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--accent);
		line-height: 1;
	}

	.band-price-display {
		display: flex;
		align-items: flex-start;
		justify-content: center;
		gap: 0.08em;
		margin: 0.15rem 0 0;
		line-height: 0.85;
	}

	.band-price-currency {
		font-family: var(--font-display);
		font-size: clamp(2.5rem, 8vw, 4rem);
		font-weight: 400;
		color: var(--accent);
		margin-top: 0.35em;
		opacity: 0.95;
	}

	.band-price-value {
		font-family: var(--font-display);
		font-size: clamp(5.5rem, 22vw, 9.5rem);
		font-weight: 400;
		letter-spacing: -0.02em;
		background: linear-gradient(
			180deg,
			var(--text) 0%,
			color-mix(in srgb, var(--text) 75%, var(--accent)) 100%
		);
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
		text-shadow: none;
		filter: drop-shadow(0 8px 28px rgba(249, 115, 22, 0.35));
	}

	.band-price-cadence {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(1.35rem, 3vw, 2rem);
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: var(--text-muted);
	}

	.band-price-perks {
		list-style: none;
		margin: 1rem 0 0;
		padding: 1rem 0 0;
		border-top: 1px solid var(--border);
		width: 100%;
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.5rem;
	}

	.band-price-perks li {
		font-size: 0.82rem;
		font-weight: 600;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		padding: 0.45rem 0.85rem;
		border-radius: 999px;
		border: 1px solid color-mix(in srgb, var(--accent) 35%, var(--border));
		background: color-mix(in srgb, var(--accent) 10%, var(--bg));
		color: var(--text);
	}

	@media (prefers-reduced-motion: reduce) {
		.band-price-aura {
			animation: none;
		}

		.band-price-card:hover {
			transform: none;
		}
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.75rem;
		width: 100%;
	}

	.btn-solid {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.8rem 2rem;
		font-size: 1rem;
		font-weight: 500;
		font-family: var(--font);
		text-decoration: none;
		text-transform: uppercase;
		letter-spacing: 0.03em;
		border-radius: var(--radius);
		background: var(--text);
		color: var(--bg);
		border: 1px solid var(--text);
		transition: background 0.3s, color 0.3s, transform 0.15s;
	}

	.btn-solid:hover {
		background: transparent;
		color: var(--text);
		transform: translateY(-1px);
	}

	.btn-outline {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.8rem 2rem;
		font-size: 1rem;
		font-weight: 500;
		font-family: var(--font);
		text-decoration: none;
		text-transform: uppercase;
		letter-spacing: 0.03em;
		border-radius: var(--radius);
		background: transparent;
		color: var(--text);
		border: 1px solid var(--border);
		transition: background 0.3s, color 0.3s, border-color 0.3s, transform 0.15s;
	}

	.btn-outline:hover {
		background: var(--text);
		color: var(--bg);
		border-color: var(--text);
		transform: translateY(-1px);
	}

	.btn-lg {
		padding: 1rem 2.5rem;
		font-size: 1.125rem;
	}

	/* ─── Band portfolio marble rails ─── */
	.band-showcase-marble {
		position: relative;
		z-index: 1;
		padding: 2.75rem 0 3.25rem;
		overflow: hidden;
		background:
			radial-gradient(ellipse 90% 55% at 50% 0%, rgba(249, 115, 22, 0.07), transparent 55%),
			radial-gradient(ellipse 60% 40% at 10% 60%, rgba(244, 114, 182, 0.06), transparent 50%),
			radial-gradient(ellipse 50% 35% at 92% 40%, rgba(167, 139, 250, 0.06), transparent 45%),
			linear-gradient(175deg, #1a1a22 0%, var(--surface) 45%, #12121a 100%);
		border-block: 1px solid rgba(255, 255, 255, 0.06);
	}

	.band-showcase-marble::before {
		content: '';
		position: absolute;
		inset: 0;
		background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.11'/%3E%3C/svg%3E");
		opacity: 0.35;
		mix-blend-mode: overlay;
		pointer-events: none;
	}

	.band-showcase-inner {
		position: relative;
		text-align: center;
		padding: 0 1.5rem 1.75rem;
		max-width: 640px;
		margin: 0 auto;
	}

	.band-showcase-eyebrow {
		font-family: var(--font-display);
		font-size: clamp(1.2rem, 2.5vw, 1.5rem);
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: rgba(255, 255, 255, 0.45);
		margin: 0;
	}

	.band-showcase-tagline {
		margin: 0.5rem 0 0;
		font-size: 1.05rem;
		color: var(--text-muted);
		line-height: 1.5;
	}

	.band-marble-grid {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 1.1rem;
		mask-image: linear-gradient(90deg, transparent 0%, #000 6%, #000 94%, transparent 100%);
	}

	.band-marble-row-wrap {
		overflow: hidden;
		padding-block: 0.15rem;
	}

	.band-marble-row {
		position: relative;
		width: 100%;
	}

	.band-marble-strip {
		display: flex;
		gap: 1.25rem;
		width: max-content;
		padding-inline: 1rem;
		will-change: transform;
	}

	/* Portfolio-matching project cards (same structure as src/pages/portfolio.astro) */
	.band-showcase-marble .band-tile-card {
		--card-accent: var(--accent-pink);
		position: relative;
		flex: 0 0 auto;
		width: min(340px, 88vw);
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		overflow: hidden;
		display: flex;
		flex-direction: column;
		isolation: isolate;
		transition:
			transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1),
			border-color 0.3s,
			box-shadow 0.35s;
	}

	.band-showcase-marble .band-tile-card::before {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		height: 3px;
		background: linear-gradient(90deg, var(--card-accent), transparent 75%);
		z-index: 2;
		opacity: 0.85;
	}

	.band-showcase-marble .band-tile-card:hover {
		border-color: color-mix(in srgb, var(--card-accent) 55%, var(--border));
		transform: translateY(-4px);
		box-shadow: 0 22px 56px -22px color-mix(in srgb, var(--card-accent) 55%, transparent);
	}

	.band-showcase-marble .band-tile-card .card-shell {
		display: flex;
		flex-direction: column;
		flex: 1;
		color: inherit;
		text-decoration: none;
	}

	.band-showcase-marble .band-tile-card .preview-wrap {
		position: relative;
		width: 100%;
		aspect-ratio: 16 / 10;
		background: #0a0a0d;
		overflow: hidden;
		border-bottom: 1px solid var(--border);
	}

	.band-showcase-marble .band-tile-card .preview-img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		z-index: 1;
		transition: transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1);
	}

	.band-showcase-marble .band-tile-card .preview-img--static {
		object-position: top center;
	}

	.band-showcase-marble .band-tile-card .preview-iframe {
		position: absolute;
		inset: 0;
		width: 200%;
		height: 200%;
		border: none;
		z-index: 0;
		pointer-events: none;
		transform: scale(0.5);
		transform-origin: top left;
	}

	.band-showcase-marble .band-tile-card:hover .preview-img {
		transform: scale(1.04);
	}

	.band-showcase-marble .band-tile-card .card-num {
		position: absolute;
		top: 0.75rem;
		left: 0.85rem;
		z-index: 2;
		font-family: var(--font-display);
		font-size: 1.65rem;
		line-height: 0.9;
		color: var(--card-accent);
		letter-spacing: -0.02em;
		text-shadow: 0 2px 14px rgba(0, 0, 0, 0.55);
		pointer-events: none;
	}

	.band-showcase-marble .band-tile-card .card-visit {
		position: absolute;
		bottom: 0.85rem;
		right: 0.85rem;
		z-index: 2;
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.5rem 0.9rem;
		font-family: var(--font-display);
		font-size: 0.85rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: #fff;
		background: var(--card-accent);
		border-radius: 999px;
		opacity: 0;
		transform: translateY(8px);
		transition:
			opacity 0.3s ease,
			transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
		box-shadow: 0 8px 22px -8px color-mix(in srgb, var(--card-accent) 70%, transparent);
		pointer-events: none;
	}

	.band-showcase-marble .band-tile-card .card-visit i {
		font-size: 0.8em;
	}

	.band-showcase-marble .band-tile-card:hover .card-visit {
		opacity: 1;
		transform: translateY(0);
	}

	.band-showcase-marble .band-tile-card .card-body {
		padding: 1.25rem 1.4rem 1.5rem;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		flex: 1;
	}

	.band-showcase-marble .band-tile-card .card-meta {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
	}

	.band-showcase-marble .band-tile-card .category-tag {
		font-family: var(--font);
		font-size: 0.68rem;
		font-weight: 600;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		padding: 0.25rem 0.6rem;
		border-radius: 999px;
		background: color-mix(in srgb, var(--card-accent) 14%, transparent);
		color: var(--card-accent);
		border: 1px solid color-mix(in srgb, var(--card-accent) 28%, transparent);
	}

	.band-showcase-marble .band-tile-card .card-host {
		font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
		font-size: 0.72rem;
		letter-spacing: 0.01em;
		color: var(--text-muted);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
		flex: 1;
		text-align: right;
		min-width: 0;
	}

	.band-showcase-marble .band-tile-card .card-title {
		font-family: var(--font-display);
		font-weight: 400;
		text-transform: uppercase;
		letter-spacing: 0.02em;
		font-size: 1.55rem;
		line-height: 1;
		margin: 0;
		color: var(--text);
	}

	.band-marble-row--left .band-marble-strip {
		animation: band-marble-drift-l 75s linear infinite;
	}

	.band-marble-row--right .band-marble-strip {
		animation: band-marble-drift-r 85s linear infinite;
	}

	.band-marble-grid:hover .band-marble-strip,
	.band-marble-grid:focus-within .band-marble-strip {
		animation-play-state: paused;
	}

	@keyframes band-marble-drift-l {
		from {
			transform: translateX(0);
		}
		to {
			transform: translateX(-50%);
		}
	}

	@keyframes band-marble-drift-r {
		from {
			transform: translateX(-50%);
		}
		to {
			transform: translateX(0);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.band-marble-row--left .band-marble-strip,
		.band-marble-row--right .band-marble-strip {
			animation: none;
		}
	}

	.section {
		position: relative;
		z-index: 1;
		max-width: 1100px;
		margin: 0 auto;
		padding: 5rem 1.5rem;
	}

	.section--alt {
		background: var(--surface);
		max-width: none;
		padding-left: 0;
		padding-right: 0;
	}

	.section--alt > * {
		max-width: 1100px;
		margin-left: auto;
		margin-right: auto;
		padding-left: 1.5rem;
		padding-right: 1.5rem;
	}

	.section-header {
		max-width: 760px;
		margin-bottom: 2.5rem;
	}

	.section-eyebrow {
		display: inline-block;
		font-family: var(--font-display);
		font-size: 1.25rem;
		font-weight: 400;
		color: var(--text-muted);
		text-transform: uppercase;
		letter-spacing: 0.06em;
		margin-bottom: 0.75rem;
	}

	.section-title {
		font-family: var(--font-display);
		font-size: clamp(2.5rem, 6vw, 5rem);
		font-weight: 400;
		line-height: 1;
		letter-spacing: 0.02em;
		color: var(--text);
		margin: 0 0 1rem;
		text-transform: uppercase;
	}

	.section-desc {
		font-size: clamp(1rem, 2vw, 1.35rem);
		color: var(--text-muted);
		line-height: 1.55;
		margin: 0;
		max-width: 600px;
	}

	.band-portfolio-link {
		display: inline-block;
		margin-top: 0.75rem;
		font-weight: 600;
		color: var(--accent);
		text-decoration: none;
	}

	.band-portfolio-link:hover {
		text-decoration: underline;
	}

	#band-contact {
		scroll-margin-top: 1.5rem;
	}

	.section-center {
		text-align: center;
		max-width: 720px;
		margin: 0 auto;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1.25rem;
	}

	.section-center .section-title {
		margin-bottom: 0;
	}

	.band-why-text {
		font-size: clamp(1.05rem, 2vw, 1.35rem);
		color: var(--text-muted);
		line-height: 1.65;
		margin: 0;
	}

	/* Plan-style price card */
	.plan-card {
		--plan-color: var(--accent);
		--plan-shadow: rgba(249, 115, 22, 0.35);
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		padding: 1.75rem 1.5rem;
		transition: border-color 0.3s ease, box-shadow 0.3s ease, transform 0.3s ease;
	}

	.plan-card::before {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		height: 4px;
		background: var(--plan-color);
		border-radius: var(--radius) var(--radius) 0 0;
		pointer-events: none;
	}

	.plan-card:hover {
		border-color: var(--plan-color);
		box-shadow: 0 24px 60px -16px var(--plan-shadow);
		transform: translateY(-2px);
	}

	.plan-card--orange {
		--plan-color: var(--accent);
		--plan-shadow: rgba(249, 115, 22, 0.45);
	}

	.plan-name {
		font-family: var(--font-display);
		font-size: 1.15rem;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--plan-color);
		line-height: 1;
	}

	.plan-price {
		display: flex;
		align-items: baseline;
		gap: 0.35rem;
	}

	.plan-price-amount {
		font-family: var(--font-display);
		font-size: clamp(2.75rem, 8vw, 4rem);
		font-weight: 400;
		color: var(--text);
		letter-spacing: 0.01em;
		line-height: 1;
	}

	.plan-price-cadence {
		font-size: 1.1rem;
		font-weight: 500;
		color: var(--text-muted);
		text-transform: uppercase;
		letter-spacing: 0.04em;
	}

	/* What you get — one card at a time */
	.band-includes-section .section-header {
		text-align: center;
		margin-left: auto;
		margin-right: auto;
	}

	.band-includes-header .section-desc {
		margin-left: auto;
		margin-right: auto;
	}

	.band-features {
		max-width: 720px;
		margin: 0 auto;
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
	}

	.band-features-stage {
		position: relative;
		min-height: clamp(320px, 48vh, 400px);
	}

	.band-features-slides {
		list-style: none;
		margin: 0;
		padding: 0;
		position: relative;
		height: 100%;
		min-height: inherit;
	}

	.band-feature {
		--feat-color: var(--accent);
		position: absolute;
		inset: 0;
		z-index: 0;
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: 1.15rem;
		padding: 2.25rem 1.75rem 2rem;
		border-radius: calc(var(--radius) + 6px);
		border: 1px solid color-mix(in srgb, var(--feat-color) 32%, var(--border));
		background:
			linear-gradient(155deg, color-mix(in srgb, var(--feat-color) 16%, transparent), transparent 50%),
			var(--bg);
		box-shadow:
			0 0 0 1px rgba(255, 255, 255, 0.05) inset,
			0 28px 70px -28px rgba(0, 0, 0, 0.6),
			0 0 40px -16px color-mix(in srgb, var(--feat-color) 38%, transparent);
		overflow: hidden;
		opacity: 0;
		visibility: hidden;
		transform: translateY(12px) scale(0.98);
		transition:
			opacity 0.4s ease,
			transform 0.45s cubic-bezier(0.22, 1, 0.36, 1),
			visibility 0.4s ease;
		pointer-events: none;
	}

	.band-feature.is-active {
		opacity: 1;
		visibility: visible;
		transform: translateY(0) scale(1);
		pointer-events: auto;
		z-index: 1;
	}

	.band-feature::before {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		height: 4px;
		background: linear-gradient(90deg, var(--feat-color), color-mix(in srgb, var(--feat-color) 15%, transparent));
	}

	.band-feature--orange { --feat-color: var(--accent); }
	.band-feature--pink   { --feat-color: var(--accent-pink); }
	.band-feature--yellow { --feat-color: var(--accent-yellow); }
	.band-feature--green  { --feat-color: var(--accent-green); }
	.band-feature--purple { --feat-color: var(--accent-purple); }

	.band-feature-mark {
		position: absolute;
		top: 0.35rem;
		right: 0.85rem;
		font-family: var(--font-display);
		font-size: clamp(3.5rem, 14vw, 6.5rem);
		line-height: 0.85;
		letter-spacing: 0.04em;
		color: transparent;
		-webkit-text-stroke: 1px color-mix(in srgb, var(--feat-color) 38%, transparent);
		opacity: 0.5;
