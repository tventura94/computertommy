---
import { portfolioItems } from '../../data/portfolio';

const serviceSites = portfolioItems.filter(
	(p) => p.category === 'Service site' || p.category === 'Business site',
);

function styleCategory(category: string) {
	if (category === 'Service site' || category === 'Business site') return 'Local service';
	return category;
}
---

{serviceSites.length > 0 && (
	<section class="seo-showcase" aria-labelledby="seo-showcase-heading">
		<div class="seo-showcase-inner">
			<p class="seo-showcase-eyebrow" id="seo-showcase-heading">Live local service sites</p>
			<h2 class="seo-showcase-title">The standard of work behind the rankings.</h2>
			<p class="seo-showcase-tagline">
				Real businesses we have built and rank. Click any tile to open the live site.
			</p>
		</div>

		<div class="showcase-grid">
			{serviceSites.map((site, i) => (
				<article class="showcase-card" data-reveal style={`--col: ${i % 3}`}>
					<a
						class="card-shell"
						href={site.url}
						target="_blank"
						rel="noopener noreferrer"
						aria-label={`Visit ${site.title}`}
					>
						<div class="preview-wrap">
							{site.previewImage ? (
								<img
									src={site.previewImage}
									alt={`Preview of ${site.title}`}
									class="preview-img"
									loading="lazy"
								/>
							) : (
								<iframe
									title={`Live preview of ${site.title}`}
									data-src={site.url}
									class="preview-iframe"
									aria-hidden="true"
									tabindex="-1"
									loading="lazy"
								/>
							)}
							<span class="card-visit">
								Visit site
								<i class="fas fa-arrow-right" aria-hidden="true"></i>
							</span>
						</div>
						<div class="card-body">
							<h3 class="card-title">{site.title}</h3>
							<span class="card-category">{styleCategory(site.category)}</span>
						</div>
					</a>
				</article>
			))}
		</div>
	</section>
)}

<script is:inline>
	(function () {
		var root = document.querySelector('.seo-showcase');
		if (!root) return;

		function loadIframes() {
			root.querySelectorAll('.preview-iframe').forEach(function (iframe) {
				var src = iframe.getAttribute('data-src');
				if (src && !iframe.getAttribute('src')) iframe.setAttribute('src', src);
			});
		}

		function reveal() {
			var cards = Array.prototype.slice.call(root.querySelectorAll('[data-reveal]'));
			if (!('IntersectionObserver' in window)) {
				cards.forEach(function (c) {
					c.classList.add('is-visible');
				});
				return;
			}
			var io = new IntersectionObserver(
				function (entries) {
					entries.forEach(function (entry) {
						if (entry.isIntersecting) {
							var col = parseInt(entry.target.style.getPropertyValue('--col'), 10) || 0;
							entry.target.style.transitionDelay = col * 90 + 'ms';
							entry.target.classList.add('is-visible');
							io.unobserve(entry.target);
						}
					});
				},
				{ threshold: 0.15, rootMargin: '0px 0px -8% 0px' },
			);
			cards.forEach(function (c) {
				io.observe(c);
			});
		}

		function boot() {
			setTimeout(function () {
				loadIframes();
				root.querySelectorAll('.preview-img').forEach(function (img) {
					img.addEventListener('error', function () {
						img.style.display = 'none';
					});
				});
			}, 150);
			reveal();
		}

		if (document.readyState === 'loading') {
			document.addEventListener('DOMContentLoaded', boot);
		} else {
			boot();
		}
	})();
</script>

<style>
	.seo-showcase {
		position: relative;
		z-index: 1;
		max-width: 1180px;
		margin: 0 auto;
		padding: 5rem 1.5rem;
	}

	.seo-showcase-inner {
		text-align: center;
		max-width: 720px;
		margin: 0 auto 3rem;
	}

	.seo-showcase-eyebrow {
		font-family: var(--font-display);
		font-size: 1.25rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--accent-teal);
		margin: 0 0 0.6rem;
	}

	.seo-showcase-title {
		font-family: var(--font-display);
		font-size: clamp(2.5rem, 6vw, 5rem);
		font-weight: 400;
		line-height: 1;
		letter-spacing: 0.02em;
		text-transform: uppercase;
		color: var(--text);
		margin: 0 0 1rem;
		text-wrap: balance;
	}

	.seo-showcase-tagline {
		margin: 0 auto;
		max-width: 540px;
		font-size: clamp(1rem, 2vw, 1.15rem);
		color: var(--text-muted);
		line-height: 1.55;
	}

	.showcase-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1.5rem;
	}

	.showcase-card {
		opacity: 0;
		transform: translateY(26px);
		transition:
			opacity 0.7s cubic-bezier(0.2, 0.8, 0.2, 1),
			transform 0.7s cubic-bezier(0.2, 0.8, 0.2, 1);
	}

	.showcase-card.is-visible {
		opacity: 1;
		transform: translateY(0);
	}

	.card-shell {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		color: inherit;
		text-decoration: none;
	}

	.preview-wrap {
		position: relative;
		width: 100%;
		aspect-ratio: 4 / 3;
		background: #0a0b0e;
		overflow: hidden;
		border-radius: calc(var(--radius) + 2px);
		border: 1px solid var(--border);
		box-shadow: 0 28px 64px -36px rgba(0, 0, 0, 0.85);
		transition:
			border-color 0.3s ease,
			transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1),
			box-shadow 0.4s ease;
	}

	.card-shell:hover .preview-wrap {
		transform: translateY(-5px);
		border-color: color-mix(in srgb, var(--accent-teal) 50%, var(--border));
		box-shadow: 0 36px 80px -34px color-mix(in srgb, var(--accent-teal) 40%, rgba(0, 0, 0, 0.9));
	}

	.preview-img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: top center;
		z-index: 1;
		transition: transform 0.7s cubic-bezier(0.2, 0.8, 0.2, 1);
	}

	.preview-iframe {
		position: absolute;
		inset: 0;
		width: 200%;
		height: 200%;
		border: none;
		z-index: 0;
		pointer-events: none;
		transform: scale(0.5);
		transform-origin: top left;
	}

	.card-shell:hover .preview-img {
		transform: scale(1.05);
	}

	.card-visit {
		position: absolute;
		bottom: 0.9rem;
		right: 0.9rem;
		z-index: 2;
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.5rem 0.9rem;
		font-family: var(--font-display);
		font-size: 0.85rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: #f4f8f9;
		background: var(--accent-teal);
		border-radius: 999px;
		opacity: 0;
		transform: translateY(8px);
		transition:
			opacity 0.3s ease,
			transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
		box-shadow: 0 8px 22px -8px color-mix(in srgb, var(--accent-teal) 70%, transparent);
		pointer-events: none;
	}

	.card-visit i {
		font-size: 0.8em;
	}

	.card-shell:hover .card-visit {
		opacity: 1;
		transform: translateY(0);
	}

	.card-body {
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
		padding: 0 0.25rem;
	}

	.card-title {
		font-family: var(--font-display);
		font-weight: 400;
		text-transform: uppercase;
		letter-spacing: 0.03em;
		font-size: clamp(1.4rem, 2.4vw, 1.75rem);
		line-height: 1;
		margin: 0;
		color: var(--text);
	}

	.card-category {
		font-size: 0.92rem;
		color: var(--text-muted);
		letter-spacing: 0.01em;
	}

	@media (prefers-reduced-motion: reduce) {
		.showcase-card {
			opacity: 1;
			transform: none;
			transition: none;
		}
	}

	@media (max-width: 900px) {
		.showcase-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 600px) {
		.seo-showcase {
			padding: 4rem 1rem;
		}

		.showcase-grid {
			grid-template-columns: 1fr;
			gap: 1.75rem;
		}
	}
</style>
