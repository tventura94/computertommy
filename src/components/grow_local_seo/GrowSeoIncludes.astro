---
type Inclusion = {
	kicker: string;
	kind: 'metric' | 'quality';
	title: string;
	body: string;
	accent: 'teal' | 'gold' | 'slate';
	visual:
		| 'website'
		| 'listings'
		| 'content'
		| 'gbp'
		| 'funnel'
		| 'responses'
		| 'rank'
		| 'onpage'
		| 'backlinks';
};

const inclusions: Inclusion[] = [
	{
		kicker: 'New',
		kind: 'quality',
		title: 'Custom website, built and hosted',
		body: 'A fast, modern site we design, build, and host for you. The foundation everything else ranks on.',
		accent: 'teal',
		visual: 'website',
	},
	{
		kicker: '70+',
		kind: 'metric',
		title: 'Local business listings online',
		body: 'Clean, consistent citations across the directories Google expects to see for a real local business.',
		accent: 'gold',
		visual: 'listings',
	},
	{
		kicker: '1 new',
		kind: 'metric',
		title: 'SEO page or blog post every month',
		body: 'Fresh, targeted content aimed at the services, towns, and searches that can turn into calls.',
		accent: 'slate',
		visual: 'content',
	},
	{
		kicker: '5+',
		kind: 'metric',
		title: 'Google Business posts every month',
		body: 'Your profile stays active with service-focused posts instead of sitting untouched.',
		accent: 'teal',
		visual: 'gbp',
	},
	{
		kicker: 'More',
		kind: 'quality',
		title: 'Reviews through a customer review funnel',
		body: 'A simple outreach flow that turns completed jobs into more Google reviews without adding work to your day.',
		accent: 'gold',
		visual: 'funnel',
	},
	{
		kicker: 'Managed',
		kind: 'quality',
		title: 'Review responses in your voice',
		body: 'I respond to new reviews so your profile looks active, professional, and cared for.',
		accent: 'slate',
		visual: 'responses',
	},
	{
		kicker: 'Tracked',
		kind: 'quality',
		title: 'Monthly rank tracking report',
		body: 'See where you are moving, which pages are working, and what to push on next.',
		accent: 'teal',
		visual: 'rank',
	},
	{
		kicker: 'Tuned',
		kind: 'quality',
		title: 'On-page SEO from real performance data',
		body: 'Titles, headings, internal structure, schema, and copy get tuned based on what the data shows.',
		accent: 'gold',
		visual: 'onpage',
	},
];
---

<section class="scroll-funnel" id="growth-includes" style={`--steps: ${inclusions.length}`}>
	<div class="funnel-sticky">
		<div class="funnel-head">
			<span class="funnel-eyebrow">A website, plus monthly SEO</span>
		</div>

		<div class="funnel-stage">
			{inclusions.map((item, i) => (
				<article
					class="funnel-step"
					data-step={i}
					style={`--step-accent: var(--accent-${item.accent})`}
				>
					<div class="step-text">
						<span class="step-rule" aria-hidden="true"></span>
						<span class:list={['step-kicker', `step-kicker--${item.kind}`]}>{item.kicker}</span>
						<h3 class="step-title">{item.title}</h3>
						<p class="step-body">{item.body}</p>
					</div>

					<div class="step-visual" aria-hidden="true">
						<span class="step-index">{String(i + 1).padStart(2, '0')}</span>

						{item.visual === 'website' && (
							<div class="mock mock-site">
								<div class="site-bar pop">
									<span class="site-logo"></span>
									<span class="site-nav"><span></span><span></span><span></span></span>
									<span class="site-btn">Call</span>
								</div>
								<div class="site-hero pop">
									<div class="site-h1"></div>
									<div class="site-h1 site-h1--short"></div>
									<div class="site-sub"></div>
									<span class="site-cta">Get a quote</span>
								</div>
								<div class="site-cards pop">
									<span></span><span></span><span></span>
								</div>
							</div>
						)}

						{item.visual === 'listings' && (
							<div class="mock mock-listings">
								<div class="mock-cap pop">
									<i class="fas fa-circle-check"></i> 70+ verified listings
								</div>
								<div class="brand-grid">
									<div class="brand-tile pop"><i class="fa-brands fa-google b-google"></i><span>Google</span></div>
									<div class="brand-tile pop"><i class="fa-brands fa-apple b-apple"></i><span>Maps</span></div>
									<div class="brand-tile pop"><i class="fa-brands fa-yelp b-yelp"></i><span>Yelp</span></div>
									<div class="brand-tile pop"><i class="fa-brands fa-microsoft b-bing"></i><span>Bing</span></div>
									<div class="brand-tile pop"><i class="fa-brands fa-facebook b-facebook"></i><span>Facebook</span></div>
									<div class="brand-tile brand-tile--more pop"><strong>+65</strong><span>more</span></div>
								</div>
							</div>
						)}

						{item.visual === 'content' && (
							<div class="mock mock-browser">
								<div class="browser-bar pop">
									<span class="dot"></span><span class="dot"></span><span class="dot"></span>
									<span class="url"><i class="fas fa-lock"></i> yoursite.com/roof-repair</span>
								</div>
								<div class="browser-body">
									<span class="tag-badge pop">NEW PAGE</span>
									<div class="doc-h1 pop"></div>
									<div class="doc-line pop"></div>
									<div class="doc-line doc-line--short pop"></div>
									<div class="doc-block pop"></div>
								</div>
							</div>
						)}

						{item.visual === 'gbp' && (
							<div class="mock mock-post">
								<div class="post-head pop">
									<span class="post-avatar"><i class="fa-brands fa-google b-google"></i></span>
									<span class="post-meta"><strong>Your Business</strong><small>Posted just now</small></span>
								</div>
								<div class="post-img pop"><i class="fas fa-image"></i></div>
								<div class="post-text pop">
									<div class="doc-line"></div>
									<div class="doc-line doc-line--short"></div>
								</div>
								<div class="post-cta pop">Book online</div>
							</div>
						)}

						{item.visual === 'funnel' && (
							<div class="mock mock-funnel">
								<div class="funnel-score pop">
									<strong>5.0</strong>
									<span class="stars"><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i></span>
								</div>
								<div class="funnel-row funnel-row--1 pop"><i class="fas fa-check"></i> Job completed</div>
								<div class="funnel-row funnel-row--2 pop"><i class="fas fa-paper-plane"></i> Review request sent</div>
								<div class="funnel-row funnel-row--3 pop"><i class="fas fa-star"></i> New 5-star review</div>
							</div>
						)}

						{item.visual === 'responses' && (
							<div class="mock mock-reply">
								<div class="review-card pop">
									<span class="stars"><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i></span>
									<p>"Showed up on time and did great work."</p>
									<small>— Sarah M.</small>
								</div>
								<div class="owner-reply pop">
									<span class="post-avatar post-avatar--owner"><i class="fas fa-screwdriver-wrench"></i></span>
									<div class="reply-bubble">
										<strong>Owner response</strong>
										<p>"Thanks, Sarah! It was a pleasure. We appreciate you."</p>
									</div>
								</div>
							</div>
						)}

						{item.visual === 'rank' && (
							<div class="mock mock-rank">
								<div class="rank-chart pop">
									<span style="--h: 34%"></span>
									<span style="--h: 48%"></span>
									<span style="--h: 42%"></span>
									<span style="--h: 66%"></span>
									<span style="--h: 78%"></span>
									<span style="--h: 96%"></span>
								</div>
								<div class="rank-row pop">
									<span class="kw">roofing near me</span>
									<span class="pos"><s>#7</s> <i class="fas fa-arrow-up"></i> #3</span>
								</div>
								<div class="rank-row pop">
									<span class="kw">metal roof install</span>
									<span class="pos"><s>#12</s> <i class="fas fa-arrow-up"></i> #5</span>
								</div>
							</div>
						)}

						{item.visual === 'onpage' && (
							<div class="mock mock-code">
								<div class="code-line pop"><span class="tk-punc">&lt;</span><span class="tk-tag">title</span><span class="tk-punc">&gt;</span><span class="tk-str">Roof Repair in Charlotte</span></div>
								<div class="code-line pop"><span class="tk-punc">&lt;</span><span class="tk-tag">meta</span> <span class="tk-attr">description</span><span class="tk-punc">=</span><span class="tk-str">"Fast local roofers..."</span></div>
								<div class="code-line pop"><span class="tk-punc">&lt;</span><span class="tk-tag">h1</span><span class="tk-punc">&gt;</span><span class="tk-str">Trusted Roofers</span></div>
								<div class="code-check pop"><i class="fas fa-circle-check"></i> Schema added</div>
								<div class="code-check pop"><i class="fas fa-circle-check"></i> Headings fixed</div>
							</div>
						)}

						{item.visual === 'backlinks' && (
							<div class="mock mock-links">
								<div class="link-center pop"><i class="fas fa-globe"></i> Your site</div>
								<div class="link-web">
									<span class="link-chip pop"><i class="fas fa-handshake"></i> Partner</span>
									<span class="link-chip pop"><i class="fas fa-list"></i> Directory</span>
									<span class="link-chip pop"><i class="fas fa-building-columns"></i> Chamber</span>
									<span class="link-chip pop"><i class="fas fa-truck"></i> Supplier</span>
								</div>
							</div>
						)}
					</div>
				</article>
			))}
		</div>

		<div class="funnel-rail" aria-hidden="true">
			{inclusions.map((item, i) => (
				<span
					class="rail-tick"
					data-tick={i}
					style={`--step-accent: var(--accent-${item.accent})`}
				></span>
			))}
		</div>
	</div>
</section>

<script is:inline>
	(function () {
		var section = document.querySelector('.scroll-funnel');
		if (!section) return;

		var steps = Array.prototype.slice.call(section.querySelectorAll('.funnel-step'));
		var ticks = Array.prototype.slice.call(section.querySelectorAll('.rail-tick'));
		if (!steps.length) return;

		var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		var mobile = window.matchMedia && window.matchMedia('(max-width: 760px)').matches;
		if (reduce || mobile) return;

		section.classList.add('is-js');
		var ticking = false;

		function update() {
			var rect = section.getBoundingClientRect();
			var vh = window.innerHeight || document.documentElement.clientHeight;
			var total = rect.height - vh;
			var progress = total > 0 ? (0 - rect.top) / total : 0;
			progress = Math.max(0, Math.min(0.9999, progress));
			var idx = Math.floor(progress * steps.length);
			if (idx >= steps.length) idx = steps.length - 1;
			if (idx < 0) idx = 0;

			for (var i = 0; i < steps.length; i++) {
				steps[i].classList.toggle('is-active', i === idx);
				steps[i].classList.toggle('is-past', i < idx);
			}
			for (var j = 0; j < ticks.length; j++) {
				ticks[j].classList.toggle('is-on', j <= idx);
			}
			ticking = false;
		}

		function onScroll() {
			if (!ticking) {
				window.requestAnimationFrame(update);
				ticking = true;
			}
		}

		window.addEventListener('scroll', onScroll, { passive: true });
		window.addEventListener('resize', onScroll);
		update();
	})();
</script>

<style>
	.scroll-funnel {
		position: relative;
		z-index: 1;
		height: calc(var(--steps) * 62vh + 38vh);
	}

	.funnel-sticky {
		position: sticky;
		top: 0;
		min-height: 100vh;
		display: flex;
		flex-direction: column;
		justify-content: center;
		max-width: 1180px;
		margin: 0 auto;
		padding: 4rem 1.5rem;
		overflow: hidden;
	}

	.funnel-head {
		margin-bottom: 2.5rem;
	}

	.funnel-eyebrow {
		display: inline-block;
		font-family: var(--font-display);
		font-size: clamp(1rem, 2.2vw, 1.35rem);
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--accent-teal);
		padding-bottom: 0.6rem;
		border-bottom: 1px solid color-mix(in srgb, var(--accent-teal) 35%, transparent);
	}

	.funnel-stage {
		position: relative;
		width: 100%;
		max-width: 1120px;
	}

	.funnel-step {
		display: grid;
		grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
		align-items: center;
		gap: clamp(1.5rem, 5vw, 4rem);
	}

	.step-text {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.85rem;
	}

	.step-rule {
		position: relative;
		z-index: 1;
		width: 64px;
		height: 4px;
		border-radius: 999px;
		background: var(--step-accent);
		box-shadow: 0 0 24px -2px color-mix(in srgb, var(--step-accent) 60%, transparent);
	}

	.step-kicker {
		position: relative;
		z-index: 1;
		font-family: var(--font-display);
		line-height: 0.85;
		letter-spacing: 0.005em;
		text-transform: uppercase;
	}

	.step-kicker--metric {
		font-size: clamp(3rem, 7vw, 5.5rem);
		color: var(--step-accent);
		text-shadow: 0 10px 40px color-mix(in srgb, var(--step-accent) 45%, transparent);
	}

	.step-kicker--quality {
		font-size: clamp(2.4rem, 6vw, 4.5rem);
		color: color-mix(in srgb, var(--step-accent) 18%, transparent);
		-webkit-text-stroke: 1.5px var(--step-accent);
	}

	.step-title {
		position: relative;
		z-index: 1;
		font-family: var(--font-display);
		font-weight: 400;
		font-size: clamp(2.1rem, 4.6vw, 3.8rem);
		line-height: 0.98;
		letter-spacing: 0.01em;
		text-transform: uppercase;
		color: var(--text);
		margin: 0.2rem 0 0;
		text-wrap: balance;
	}

	.step-body {
		position: relative;
		z-index: 1;
		margin: 0.4rem 0 0;
		max-width: 46ch;
		font-size: clamp(1.05rem, 2vw, 1.4rem);
		line-height: 1.5;
		color: var(--text-muted);
		padding-left: 1.1rem;
		border-left: 2px solid color-mix(in srgb, var(--step-accent) 45%, transparent);
	}

	/* ── Visual panel shell ── */
	.step-visual {
		position: relative;
		aspect-ratio: 5 / 4;
		border-radius: calc(var(--radius) + 8px);
		overflow: hidden;
		background:
			radial-gradient(ellipse 80% 70% at 75% 12%, color-mix(in srgb, var(--step-accent) 26%, transparent), transparent 60%),
			linear-gradient(160deg, color-mix(in srgb, var(--step-accent) 13%, var(--surface)), var(--surface) 72%);
		border: 1px solid color-mix(in srgb, var(--step-accent) 28%, var(--border));
		box-shadow:
			0 40px 90px -45px color-mix(in srgb, var(--step-accent) 55%, transparent),
			inset 0 1px 0 rgba(255, 255, 255, 0.05);
	}

	.step-visual::before {
		content: '';
		position: absolute;
		inset: 0;
		background-image:
			linear-gradient(color-mix(in srgb, var(--step-accent) 12%, transparent) 1px, transparent 1px),
			linear-gradient(90deg, color-mix(in srgb, var(--step-accent) 12%, transparent) 1px, transparent 1px);
		background-size: 38px 38px;
		mask-image: radial-gradient(ellipse 90% 90% at 30% 80%, #000, transparent 75%);
		opacity: 0.45;
		pointer-events: none;
	}

	.step-index {
		position: absolute;
		top: -0.2em;
		right: 0.06em;
		z-index: 0;
		font-family: var(--font-display);
		font-size: clamp(7rem, 18vw, 12rem);
		line-height: 0.8;
		letter-spacing: -0.02em;
		color: transparent;
		-webkit-text-stroke: 1.5px color-mix(in srgb, var(--step-accent) 38%, transparent);
		opacity: 0.4;
		pointer-events: none;
		user-select: none;
	}

	.mock {
		position: absolute;
		inset: 0;
		z-index: 2;
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
		padding: clamp(1rem, 2.5vw, 1.6rem);
		justify-content: center;
	}

	/* shared bits */
	.doc-line {
		height: 9px;
		border-radius: 999px;
		background: color-mix(in srgb, var(--text) 22%, transparent);
	}

	.doc-line--short {
		width: 60%;
	}

	.stars {
		color: #f5b301;
		font-size: 0.8rem;
		letter-spacing: 1px;
	}

	.post-avatar {
		display: grid;
		place-items: center;
		width: 2.1rem;
		height: 2.1rem;
		border-radius: 50%;
		background: #fff;
		flex: 0 0 auto;
		font-size: 0.95rem;
	}

	.post-avatar--owner {
		background: var(--step-accent);
		color: #fff;
	}

	/* ── Listings (brand logos) ── */
	.mock-cap {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		align-self: flex-start;
		font-size: 0.82rem;
		font-weight: 700;
		color: var(--text);
		background: color-mix(in srgb, var(--surface) 70%, #000);
		border: 1px solid color-mix(in srgb, var(--step-accent) 35%, var(--border));
		padding: 0.4rem 0.7rem;
		border-radius: 999px;
	}

	.mock-cap i {
		color: var(--step-accent);
	}

	.brand-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 0.55rem;
	}

	.brand-tile {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 0.3rem;
		padding: 0.7rem 0.4rem;
		border-radius: 12px;
		background: #ffffff;
		box-shadow: 0 10px 24px -16px rgba(0, 0, 0, 0.8);
	}

	.brand-tile i {
		font-size: 1.5rem;
	}

	.brand-tile span {
		font-size: 0.68rem;
		font-weight: 600;
		color: #3a3a3a;
	}

	.brand-tile--more {
		background: color-mix(in srgb, var(--step-accent) 22%, var(--surface));
		color: var(--text);
	}

	.brand-tile--more strong {
		font-family: var(--font-display);
		font-size: 1.35rem;
		color: var(--text);
	}

	.brand-tile--more span {
		color: var(--text-muted);
	}

	/* ── Website mock ── */
	.mock-site {
		gap: 0;
		padding: clamp(0.9rem, 2.2vw, 1.4rem);
	}

	.mock-site > * {
		background: color-mix(in srgb, var(--surface) 88%, #000);
	}

	.site-bar {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		padding: 0.6rem 0.8rem;
		border-radius: 10px 10px 0 0;
		border: 1px solid var(--border);
		border-bottom: 0;
	}

	.site-logo {
		width: 1.5rem;
		height: 1.5rem;
		border-radius: 6px;
		background: var(--step-accent);
		flex: 0 0 auto;
	}

	.site-nav {
		display: flex;
		gap: 0.4rem;
		margin-left: auto;
	}

	.site-nav span {
		width: 22px;
		height: 6px;
		border-radius: 999px;
		background: color-mix(in srgb, var(--text) 22%, transparent);
	}

	.site-btn {
		font-size: 0.62rem;
		font-weight: 800;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		color: #06110a;
		background: var(--step-accent);
		padding: 0.3rem 0.55rem;
		border-radius: 6px;
	}

	.site-hero {
		display: flex;
		flex-direction: column;
		gap: 0.55rem;
		padding: 1.1rem 0.9rem 1.2rem;
		border: 1px solid var(--border);
		border-bottom: 0;
	}

	.site-h1 {
		height: 16px;
		width: 85%;
		border-radius: 5px;
		background: color-mix(in srgb, var(--text) 78%, transparent);
	}

	.site-h1--short {
		width: 55%;
		background: var(--step-accent);
	}

	.site-sub {
		height: 8px;
		width: 70%;
		border-radius: 999px;
		background: color-mix(in srgb, var(--text) 20%, transparent);
		margin-top: 0.15rem;
	}

	.site-cta {
		align-self: flex-start;
		margin-top: 0.35rem;
		font-size: 0.7rem;
		font-weight: 800;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: #06110a;
		background: var(--step-accent);
		padding: 0.45rem 0.85rem;
		border-radius: 999px;
	}

	.site-cards {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 0.5rem;
		padding: 0.8rem;
		border-radius: 0 0 10px 10px;
		border: 1px solid var(--border);
	}

	.site-cards span {
		height: 34px;
		border-radius: 8px;
		background: color-mix(in srgb, var(--step-accent) 16%, transparent);
		border: 1px solid color-mix(in srgb, var(--step-accent) 28%, var(--border));
	}

