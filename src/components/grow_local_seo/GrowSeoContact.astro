---
import astroLogo from '../../assets/computertommylogo.svg';
---

<section class="growth-contact-section" id="growth-contact" aria-labelledby="growth-contact-heading">
	<img src="/paint-trip.png" alt="" class="cta-bg" aria-hidden="true" />
	<div class="contact-inner">
		<header class="contact-header">
			<img class="cta-icon" src={astroLogo.src} alt="" />
			<span class="section-eyebrow">Get started</span>
			<h2 class="section-title" id="growth-contact-heading">Start Growth Local SEO.</h2>
			<p class="contact-lead">
				Send a few details about your business and service area. I will reply with a plan for your website and monthly local SEO.
			</p>
		</header>

		<div class="form-card">
			<form
				class="growth-form"
				name="contact"
				method="POST"
				data-netlify="true"
				netlify-honeypot="bot-field"
				action="/thank-you/"
			>
				<input type="hidden" name="form-name" value="contact" />
				<input type="hidden" name="plan" value="Growth Local SEO — $679/mo" />
				<p class="hp-field">
					<label>
						Do not fill this in: <input name="bot-field" type="text" tabindex="-1" autocomplete="off" />
					</label>
				</p>

				<div class="form-row form-row--two">
					<div class="form-field">
						<label for="growth-contact-name">Your name</label>
						<input id="growth-contact-name" name="name" type="text" autocomplete="name" required />
					</div>
					<div class="form-field">
						<label for="growth-contact-email">Email</label>
						<input id="growth-contact-email" name="email" type="email" autocomplete="email" required />
					</div>
				</div>

				<div class="form-field">
					<label for="growth-contact-phone">Phone <span class="field-hint">(optional)</span></label>
					<input id="growth-contact-phone" name="phone" type="tel" autocomplete="tel" />
				</div>

				<fieldset class="form-field form-field--website-status">
					<legend style="margin-bottom: .5rem;">Do you already have a website?</legend>
					<div class="website-status-choices">
						<label class="website-status-choice">
							<input
								type="radio"
								name="website_status"
								value="needs-website"
								required
								data-website-toggle
							/>
							<span class="website-status-label">I need a website included</span>
						</label>
						<label class="website-status-choice">
							<input
								type="radio"
								name="website_status"
								value="has-website"
								data-website-toggle
							/>
							<span class="website-status-label">I already have one</span>
						</label>
					</div>
				</fieldset>

				<div class="form-field website-url-field" id="growth-website-url-field" hidden>
					<label for="growth-contact-website">
						Your website <span class="field-hint">(optional)</span>
					</label>
					<input
						id="growth-contact-website"
						name="website"
						type="url"
						placeholder="https://yourbusiness.com"
						autocomplete="url"
					/>
				</div>

				<div class="form-field">
					<label for="growth-contact-message">What are you trying to rank for?</label>
					<textarea
						id="growth-contact-message"
						name="message"
						rows="5"
						placeholder="Tell me your business type, city/service area, competitors, and what you want more calls for."
						required
					></textarea>
				</div>

				<button type="submit" class="btn-submit">
					<span>Send Growth SEO inquiry</span>
					<i class="fas fa-arrow-right" aria-hidden="true"></i>
				</button>

				<p class="form-foot">
					Prefer to talk? Call <a href="tel:5083802013">508 380 2013</a> or email
					<a href="mailto:letsbuild@computertommy.com">letsbuild@computertommy.com</a>.
				</p>
			</form>
			<script is:inline>
				(function () {
					var form = document.querySelector('#growth-contact .growth-form');
					if (!form) return;

					var urlField = document.getElementById('growth-website-url-field');
					var websiteInput = document.getElementById('growth-contact-website');
					var radios = form.querySelectorAll('input[data-website-toggle]');

					function syncWebsiteField() {
						var selected = form.querySelector('input[name="website_status"]:checked');
						var showUrl = selected && selected.value === 'has-website';

						if (urlField) urlField.hidden = !showUrl;
						if (websiteInput && !showUrl) websiteInput.value = '';
					}

					radios.forEach(function (radio) {
						radio.addEventListener('change', syncWebsiteField);
					});

					syncWebsiteField();
				})();
			</script>
		</div>
	</div>
</section>

<style>
	.growth-contact-section {
		position: relative;
		z-index: 1;
		padding: 5rem 1.5rem 6rem;
		overflow: hidden;
	}

	.cta-bg {
		position: absolute;
		inset: auto 0 0 auto;
		width: min(760px, 95vw);
		opacity: 0.14;
		transform: rotate(7deg) translate(12%, 8%);
		pointer-events: none;
	}

	.contact-inner {
		position: relative;
		z-index: 1;
		max-width: 980px;
		margin: 0 auto;
		display: grid;
		grid-template-columns: minmax(0, 0.88fr) minmax(0, 1.12fr);
		gap: 2rem;
		align-items: start;
	}

	.contact-header {
		position: sticky;
		top: 2rem;
	}

	.cta-icon {
		width: 58px;
		height: auto;
		margin-bottom: 1rem;
		filter: drop-shadow(0 12px 28px rgba(0, 0, 0, 0.45));
	}

	.section-eyebrow {
		display: inline-block;
		font-family: var(--font-display);
		font-size: 1.25rem;
		color: var(--accent-teal);
		text-transform: uppercase;
		letter-spacing: 0.08em;
		margin-bottom: 0.75rem;
	}

	.section-title {
		font-family: var(--font-display);
		font-size: clamp(2.75rem, 6vw, 5rem);
		font-weight: 400;
		line-height: 1;
		letter-spacing: 0.02em;
		color: var(--text);
		margin: 0 0 1rem;
		text-transform: uppercase;
	}

	.contact-lead {
		margin: 0;
		color: var(--text-muted);
		font-size: 1.08rem;
		line-height: 1.65;
		max-width: 44ch;
	}

	.form-card {
		border-radius: calc(var(--radius) + 8px);
		padding: 1px;
		background: linear-gradient(
			135deg,
			color-mix(in srgb, var(--accent-teal) 45%, transparent),
			color-mix(in srgb, var(--accent-slate) 40%, transparent)
		);
		box-shadow: 0 32px 90px -42px rgba(0, 0, 0, 0.85);
	}

	.growth-form {
		border-radius: calc(var(--radius) + 7px);
		background:
			linear-gradient(145deg, rgba(255, 255, 255, 0.05), transparent 42%),
			var(--surface);
		padding: clamp(1.25rem, 3vw, 2rem);
		border: 1px solid rgba(255, 255, 255, 0.04);
	}

	.hp-field {
		position: absolute;
		left: -9999px;
		opacity: 0;
		pointer-events: none;
	}

	.form-row {
		display: grid;
		gap: 1rem;
		margin-bottom: 1rem;
	}

	.form-row--two {
		grid-template-columns: repeat(2, minmax(0, 1fr));
	}

	.form-field {
		display: flex;
		flex-direction: column;
		gap: 0.45rem;
		margin-bottom: 1rem;
	}

	.form-row .form-field {
		margin-bottom: 0;
	}

	label,
	legend {
		font-size: 0.78rem;
		font-weight: 800;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--text);
	}

	.form-field--website-status {
		border: 0;
		padding: 0;
		margin: 0 0 1rem;
		min-width: 0;
		display: flex;
		flex-direction: column;
		gap: 0.65rem;
	}

	.website-status-choices {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.6rem;
	}

	.website-status-choice {
		position: relative;
		display: flex;
		align-items: center;
		min-height: 3.25rem;
		padding: 0.85rem 1rem;
		border: 1px solid var(--border);
		border-radius: var(--radius-sm);
		background: color-mix(in srgb, var(--bg) 78%, #fff);
		cursor: pointer;
		transition: border-color 0.2s, box-shadow 0.2s, background 0.2s, transform 0.15s;
	}

	.website-status-choice input {
		position: absolute;
		opacity: 0;
		pointer-events: none;
		width: 1px;
		height: 1px;
	}

	.website-status-label {
		font-size: 0.92rem;
		font-weight: 600;
		letter-spacing: 0.01em;
		text-transform: none;
		color: var(--text);
		line-height: 1.35;
	}

	.website-status-choice:hover {
		border-color: color-mix(in srgb, var(--accent-teal) 55%, var(--border));
		transform: translateY(-1px);
	}

	.website-status-choice:focus-within,
	.website-status-choice:has(input:checked) {
		border-color: color-mix(in srgb, var(--accent-teal) 65%, var(--border));
		background: color-mix(in srgb, var(--accent-teal) 10%, var(--bg));
		box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent-teal) 14%, transparent);
	}

	.website-url-field[hidden] {
		display: none;
	}

	.field-hint {
		color: var(--text-muted);
		font-weight: 600;
	}

	input,
	textarea {
		width: 100%;
		border: 1px solid var(--border);
		border-radius: var(--radius-sm);
		background: color-mix(in srgb, var(--bg) 78%, #fff);
		color: var(--text);
		font: inherit;
		padding: 0.9rem 1rem;
		outline: none;
		transition: border-color 0.2s, box-shadow 0.2s, background 0.2s;
	}

	textarea {
		resize: vertical;
		min-height: 140px;
	}

	input:focus,
	textarea:focus {
		border-color: color-mix(in srgb, var(--accent-teal) 55%, var(--border));
		box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent-teal) 14%, transparent);
		background: color-mix(in srgb, var(--bg) 65%, #fff);
	}

	.btn-submit {
		width: 100%;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.55rem;
		border: 0;
		border-radius: var(--radius);
		background: var(--text);
		color: var(--bg);
		font: inherit;
		font-weight: 800;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		padding: 0.95rem 1.25rem;
		cursor: pointer;
		transition: transform 0.15s, background 0.25s, color 0.25s;
	}

	.btn-submit:hover {
		transform: translateY(-1px);
		background: var(--accent-teal);
		color: #f4f8f9;
	}

	.form-foot {
		margin: 1rem 0 0;
		font-size: 0.92rem;
		color: var(--text-muted);
		line-height: 1.55;
		text-align: center;
	}

	.form-foot a {
		color: var(--text);
		font-weight: 700;
		text-decoration: none;
	}

	.form-foot a:hover {
		color: var(--accent-teal);
	}

	@media (max-width: 820px) {
		.contact-inner {
			grid-template-columns: 1fr;
		}

		.contact-header {
			position: static;
			text-align: center;
		}

		.contact-lead {
			margin: 0 auto;
		}
	}

	@media (max-width: 560px) {
		.growth-contact-section {
			padding: 4rem 1rem 5rem;
		}

		.form-row--two,
		.website-status-choices {
			grid-template-columns: 1fr;
		}
	}
</style>
