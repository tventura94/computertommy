---
import type { PortfolioItem } from '../../data/portfolio';

interface Props {
	sites: PortfolioItem[];
}

const { sites } = Astro.props;

function host(url: string) {
	return url.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');
}
---

<div class="deal-carousel" aria-label="Portfolio preview carousel">
	<p class="deal-carousel-label">
		<span class="deal-carousel-dot" aria-hidden="true"></span>
		Live sites we have built
	</p>

	<div class="deal-carousel-viewport" data-deal-marquee>
		<div class="deal-carousel-track">
			{sites.map((site) => (
				<article class="deal-card">
					<a
						class="deal-card-link"
						href={site.url}
						target="_blank"
						rel="noopener noreferrer"
						aria-label={`Visit ${site.title}`}
					>
						<div class="deal-card-preview">
							{site.previewImage ? (
								<img
									src={site.previewImage}
									alt={`Preview of ${site.title}`}
									class="deal-card-img"
									loading="lazy"
									decoding="async"
								/>
							) : (
								<div class="deal-card-fallback">
									<span>{site.title}</span>
								</div>
							)}
							<span class="deal-card-visit">
								Visit
								<i class="fas fa-arrow-up-right-from-square" aria-hidden="true"></i>
							</span>
						</div>
						<div class="deal-card-meta">
							<span class="deal-card-type">{site.serviceType ?? site.category}</span>
							<span class="deal-card-host">{host(site.url)}</span>
						</div>
					</a>
				</article>
			))}
			{sites.map((site) => (
				<article class="deal-card" aria-hidden="true" data-deal-clone>
					<a
						class="deal-card-link"
						href={site.url}
						target="_blank"
						rel="noopener noreferrer"
						tabindex="-1"
					>
						<div class="deal-card-preview">
							{site.previewImage ? (
								<img
									src={site.previewImage}
									alt=""
									class="deal-card-img"
									loading="lazy"
									decoding="async"
								/>
							) : (
								<div class="deal-card-fallback">
									<span>{site.title}</span>
								</div>
							)}
							<span class="deal-card-visit">
								Visit
								<i class="fas fa-arrow-up-right-from-square" aria-hidden="true"></i>
							</span>
						</div>
						<div class="deal-card-meta">
							<span class="deal-card-type">{site.serviceType ?? site.category}</span>
							<span class="deal-card-host">{host(site.url)}</span>
						</div>
					</a>
				</article>
			))}
		</div>
	</div>
</div>

<style>
	.deal-carousel {
		display: flex;
		flex-direction: column;
		gap: 0.65rem;
		min-width: 0;
		height: auto;
		width: 100%;
		padding-bottom: 0.25rem;
	}

	.deal-carousel-label {
		margin: 0;
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		align-self: center;
		font-size: 0.72rem;
		font-weight: 800;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--deal-muted);
	}

	.deal-carousel-dot {
		width: 0.45rem;
		height: 0.45rem;
		border-radius: 50%;
		background: var(--deal-mint);
		box-shadow: 0 0 12px var(--deal-mint);
		animation: deal-pulse 2s ease-in-out infinite;
	}

	@keyframes deal-pulse {
		0%,
		100% {
			opacity: 1;
		}
		50% {
			opacity: 0.45;
		}
	}

	.deal-carousel-viewport {
		flex: none;
		min-height: 11.5rem;
		height: clamp(11.5rem, 28vw, 18rem);
		overflow: hidden;
		border-radius: 0;
		border: 0;
		border-block: 1px solid var(--deal-border);
		background:
			linear-gradient(145deg, color-mix(in srgb, var(--deal-gold) 6%, transparent), transparent 40%),
			var(--deal-surface);
		mask-image: none;
		width: 100%;
	}

	.deal-carousel-track {
		display: flex;
		gap: 0.85rem;
		width: max-content;
		padding: 0.75rem clamp(1rem, 3vw, 2rem);
		height: 100%;
		align-items: stretch;
		animation: deal-marquee 55s linear infinite;
		will-change: transform;
	}

	.deal-carousel-viewport:hover .deal-carousel-track,
	.deal-carousel-viewport:focus-within .deal-carousel-track {
		animation-play-state: paused;
	}

	@keyframes deal-marquee {
		from {
			transform: translateX(0);
		}
		to {
			transform: translateX(-50%);
		}
	}

	.deal-card {
		flex: 0 0 auto;
		width: clamp(200px, 22vw, 300px);
		height: 100%;
	}

	.deal-card-link {
		display: flex;
		flex-direction: column;
		height: 100%;
		text-decoration: none;
		color: inherit;
		border-radius: var(--deal-radius);
		overflow: hidden;
		border: 1px solid var(--deal-border);
		background: var(--deal-bg);
		transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
	}

	.deal-card-link:hover {
		transform: translateY(-3px);
		border-color: color-mix(in srgb, var(--deal-gold) 45%, var(--deal-border));
		box-shadow: 0 16px 40px -18px color-mix(in srgb, var(--deal-gold) 40%, transparent);
	}

	.deal-card-preview {
		position: relative;
		flex: 1;
		min-height: 0;
		overflow: hidden;
		background: #0e141c;
	}

	.deal-card-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: top center;
		transition: transform 0.5s ease;
	}

	.deal-card-link:hover .deal-card-img {
		transform: scale(1.04);
	}

	.deal-card-fallback {
		display: grid;
		place-items: center;
		height: 100%;
		padding: 1rem;
		text-align: center;
		font-weight: 700;
		color: var(--deal-muted);
	}

	.deal-card-visit {
		position: absolute;
		right: 0.55rem;
		bottom: 0.55rem;
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		padding: 0.35rem 0.55rem;
		border-radius: 999px;
		background: rgba(8, 12, 18, 0.82);
		border: 1px solid rgba(255, 255, 255, 0.12);
		font-size: 0.68rem;
		font-weight: 800;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: #fff;
		opacity: 0;
		transform: translateY(4px);
		transition: opacity 0.2s ease, transform 0.2s ease;
	}

	.deal-card-link:hover .deal-card-visit {
		opacity: 1;
		transform: translateY(0);
	}

	.deal-card-meta {
		display: flex;
		flex-direction: column;
		gap: 0.1rem;
		padding: 0.4rem 0.55rem 0.45rem;
		flex-shrink: 0;
	}

	.deal-card-type {
		font-size: 0.62rem;
		font-weight: 800;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--deal-gold);
	}

	.deal-card-host {
		font-size: 0.68rem;
		color: var(--deal-muted);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	@media (prefers-reduced-motion: reduce) {
		.deal-carousel-track {
			animation: none;
		}

		.deal-carousel-dot {
			animation: none;
		}
	}
</style>
