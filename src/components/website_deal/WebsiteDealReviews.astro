---
import { googleReviews, reviewInitials } from '../../data/googleReviews';
---

<section class="deal-reviews" aria-labelledby="deal-reviews-heading">
	<div class="deal-reviews-header">
		<p class="deal-reviews-eyebrow">
			<i class="fa-brands fa-google" aria-hidden="true"></i>
			Google Reviews
		</p>
		<h2 class="deal-reviews-title" id="deal-reviews-heading">Don't take my word for it.</h2>
		<p class="deal-reviews-sub">All 5-star reviews from real clients.</p>
	</div>

	<div class="deal-reviews-band" data-deal-reviews-marquee>
		<div class="deal-reviews-track">
			{googleReviews.map((review) => (
				<article class="deal-review-card">
					<div class="deal-review-stars" aria-label="5 out of 5 stars">
						<i class="fas fa-star"></i>
						<i class="fas fa-star"></i>
						<i class="fas fa-star"></i>
						<i class="fas fa-star"></i>
						<i class="fas fa-star"></i>
					</div>
					<blockquote class="deal-review-quote">
						<p>"{review.quote}"</p>
					</blockquote>
					<footer class="deal-review-foot">
						<span class="deal-review-avatar" aria-hidden="true">{reviewInitials(review.name)}</span>
						<span class="deal-review-id">
							<strong>{review.name}</strong>
							{review.context ? <span>{review.context}</span> : null}
						</span>
					</footer>
				</article>
			))}
			{googleReviews.map((review) => (
				<article class="deal-review-card" aria-hidden="true" data-deal-review-clone>
					<div class="deal-review-stars" aria-hidden="true">
						<i class="fas fa-star"></i>
						<i class="fas fa-star"></i>
						<i class="fas fa-star"></i>
						<i class="fas fa-star"></i>
						<i class="fas fa-star"></i>
					</div>
					<blockquote class="deal-review-quote">
						<p>"{review.quote}"</p>
					</blockquote>
					<footer class="deal-review-foot">
						<span class="deal-review-avatar" aria-hidden="true">{reviewInitials(review.name)}</span>
						<span class="deal-review-id">
							<strong>{review.name}</strong>
							{review.context ? <span>{review.context}</span> : null}
						</span>
					</footer>
				</article>
			))}
		</div>
	</div>
</section>

<style>
	.deal-reviews {
		position: relative;
		z-index: 1;
		padding: clamp(2.5rem, 5vw, 3.5rem) 0 clamp(2rem, 4vw, 3rem);
		border-bottom: 1px solid var(--deal-border);
		background:
			radial-gradient(ellipse 80% 60% at 50% 0%, color-mix(in srgb, var(--deal-gold) 7%, transparent), transparent 60%),
			var(--deal-bg);
		overflow: hidden;
	}

	.deal-reviews-header {
		max-width: 52rem;
		margin: 0 auto 1.5rem;
		padding: 0 clamp(1rem, 3vw, 2rem);
		text-align: center;
	}

	.deal-reviews-eyebrow {
		margin: 0 0 0.5rem;
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		font-size: 0.72rem;
		font-weight: 800;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--deal-muted);
	}

	.deal-reviews-eyebrow i {
		color: #4285f4;
	}

	.deal-reviews-title {
		margin: 0 0 0.45rem;
		font-family: var(--deal-font-display);
		font-size: clamp(1.85rem, 4.5vw, 2.75rem);
		font-weight: 800;
		line-height: 1.05;
		letter-spacing: -0.02em;
	}

	.deal-reviews-sub {
		margin: 0;
		color: var(--deal-muted);
		font-size: 1rem;
	}

	.deal-reviews-band {
		overflow: hidden;
		mask-image: linear-gradient(90deg, transparent 0%, #000 6%, #000 94%, transparent 100%);
	}

	.deal-reviews-band:hover .deal-reviews-track,
	.deal-reviews-band:focus-within .deal-reviews-track {
		animation-play-state: paused;
	}

	.deal-reviews-track {
		display: flex;
		gap: 1rem;
		width: max-content;
		padding: 0.35rem clamp(1rem, 3vw, 2rem) 0.5rem;
		animation: deal-reviews-marquee 90s linear infinite;
		will-change: transform;
	}

	@keyframes deal-reviews-marquee {
		from {
			transform: translateX(0);
		}
		to {
			transform: translateX(-50%);
		}
	}

	.deal-review-card {
		flex: 0 0 auto;
		width: min(88vw, 22rem);
		display: flex;
		flex-direction: column;
		gap: 0.85rem;
		padding: 1.15rem 1.2rem 1.2rem;
		border-radius: calc(var(--deal-radius) + 2px);
		border: 1px solid var(--deal-border);
		background: var(--deal-surface);
		box-shadow: 0 16px 40px -28px rgba(0, 0, 0, 0.45);
	}

	.deal-review-stars {
		display: inline-flex;
		gap: 0.15rem;
		color: #fbbc05;
		font-size: 0.78rem;
	}

	.deal-review-quote {
		margin: 0;
		flex: 1;
	}

	.deal-review-quote p {
		margin: 0;
		font-size: 0.95rem;
		line-height: 1.6;
		color: var(--deal-text);
		display: -webkit-box;
		-webkit-line-clamp: 6;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.deal-review-foot {
		display: flex;
		align-items: center;
		gap: 0.65rem;
		margin-top: auto;
		padding-top: 0.35rem;
		border-top: 1px solid var(--deal-border);
	}

	.deal-review-avatar {
		width: 2.2rem;
		height: 2.2rem;
		border-radius: 50%;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		font-size: 0.72rem;
		font-weight: 800;
		letter-spacing: 0.02em;
		background: color-mix(in srgb, var(--deal-gold) 16%, transparent);
		color: var(--deal-gold);
		flex-shrink: 0;
	}

	.deal-review-id {
		display: flex;
		flex-direction: column;
		gap: 0.1rem;
		min-width: 0;
	}

	.deal-review-id strong {
		font-size: 0.9rem;
		font-weight: 700;
	}

	.deal-review-id span {
		font-size: 0.78rem;
		color: var(--deal-muted);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	@media (prefers-reduced-motion: reduce) {
		.deal-reviews-track {
			animation: none;
		}
	}
</style>
