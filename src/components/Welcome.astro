(function() {
	if (!('IntersectionObserver' in window)) return;
	function observe(selector, options) {
		var sections = document.querySelectorAll(selector);
		if (!sections.length) return;
		var obs = new IntersectionObserver(function(entries) {
			entries.forEach(function(e) {
				if (e.isIntersecting) {
					e.target.classList.add('is-visible');
					obs.unobserve(e.target);
				}
			});
		}, options);
		sections.forEach(function(s) { obs.observe(s); });
	}
	/* About block: require more of the section in view so “Who you’re working with” doesn’t animate while still below the fold. */
	observe('.fade-in-section', { threshold: 0.35, rootMargin: '0px 0px -12% 0px' });
	observe('.slide-in-section', { threshold: 0.15 });
})();
</script>

<script is:inline>
(function() {
	/* Sticky stack layout only. Scroll-driven scale() was removed — it rescale’d card text every frame and looked like “wiggling”. */
	var StackCards = function(element) {
		this.element = element;
		this.items = this.element.getElementsByClassName('js-stack-cards__item');
		setStackCards(this);
		initStackCardsResize(this);
	};

	function initStackCardsResize(element) {
		element.element.addEventListener('resize-stack-cards', function() {
			setStackCards(element);
		});
	}

	function setStackCards(element) {
		element.marginY = getComputedStyle(element.element).getPropertyValue('--stack-cards-gap');
		getIntegerFromProperty(element);

		if (isNaN(element.marginY)) {
			element.element.style.paddingBottom = '0px';
		} else {
			element.element.style.paddingBottom = (element.marginY * (element.items.length - 1)) + 'px';
		}

		for (var i = 0; i < element.items.length; i++) {
			if (isNaN(element.marginY)) {
				element.items[i].style.transform = 'none';
			} else {
				element.items[i].style.transform = 'translateY(' + element.marginY * i + 'px)';
			}
		}
	}

	function getIntegerFromProperty(element) {
		var node = document.createElement('div');
		node.setAttribute('style', 'opacity:0; visibility: hidden; position: absolute; height:' + element.marginY);
		element.element.appendChild(node);
		element.marginY = parseInt(getComputedStyle(node).getPropertyValue('height'));
		element.element.removeChild(node);
	}

	var stackCards = document.getElementsByClassName('js-stack-cards');

	if (stackCards.length > 0) {
		var stackCardsArray = [];
		for (var i = 0; i < stackCards.length; i++) {
			(function(i) {
				stackCardsArray.push(new StackCards(stackCards[i]));
			})(i);
		}

		var resizingId = false;
		var customEvent = new CustomEvent('resize-stack-cards');

		window.addEventListener('resize', function() {
			clearTimeout(resizingId);
			resizingId = setTimeout(function() {
				for (var j = 0; j < stackCardsArray.length; j++) {
					stackCardsArray[j].element.dispatchEvent(customEvent);
				}
			}, 500);
		});
	}
}());
</script>

