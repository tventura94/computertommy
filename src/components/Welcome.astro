---
import astroLogo from '../assets/computertommylogo.svg';
import background from '../assets/background.svg';
import { portfolioItems } from '../data/portfolio';

const featuredSlugs = ['strudel-construction', 'noble-cleaning-solutions', 'frontline-medical-travel'];
const featuredWork = featuredSlugs
	.map((slug) => portfolioItems.find((p) => p.slug === slug))
	.filter((p): p is NonNullable<typeof p> => Boolean(p));
---

<div class="page-wrapper" id="page-wrapper">
	<img class="bg-blur" src={background.src} alt="" fetchpriority="high" />

	<!-- HERO -->
	<div class="hero-bg">
		<img src="/portfolio/bg-img-ct.png" alt="" class="hero-bg-img" />
	</div>
	<section class="hero">
		<div class="hero-nav">
			<a href="/" class="logo-link">
				<img src={astroLogo.src} width="130" height="52" alt="ComputerTommy home" />
			</a>
			<button class="theme-toggle" type="button" data-theme-toggle aria-label="Toggle light and dark theme">
				<svg class="theme-icon theme-icon--sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
				<svg class="theme-icon theme-icon--moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
			</button>
		</div>

		<div class="hero-inner">
			<div class="hero-headline-wrap">
				<h1 class="hero-title">
					Local SEO and websites that get you ranking on Google in 3 months.
				</h1>
				<span class="badge badge-pink">RANKINGS</span>
				<span class="badge badge-yellow">MONTHLY</span>
				<span class="badge badge-green">PERSONAL</span>
			</div>

			<div class="hero-foot">
				<p class="hero-desc">
					Flat-fee website maintenance and local SEO for service businesses. Start with technical upkeep and on-page cleanup, or move into full Google Business Profile, content, and rankings work. Based in Asheville, NC.
				</p>
				<div class="hero-actions">
					<a href="/contact/" class="btn-solid">Start ranking &rarr;</a>
					<a href="#simple-pricing" class="btn-outline">See plans</a>
					<a href="/portfolio/" class="btn-outline">Portfolio</a>
				</div>
			</div>
		</div>
	</section>

	<!-- ABOUT -->
	<section class="section" id="about-tom">
		<div class="section-center fade-in-section">
			<span class="section-eyebrow fade-in-child" style="--delay:0">
				<svg class="eyebrow-icon" viewBox="0 0 120 120" fill="currentColor"><path d="M114.44 54.69H71.9l30.08-30.08a5.03 5.03 0 0 0 0-7.12 5.03 5.03 0 0 0-7.12 0L64.78 47.57V5.04c0-2.78-2.25-5.04-5.04-5.04S54.7 2.25 54.7 5.04v42.53L24.62 17.49a5.027 5.027 0 0 0-7.12 0 5.03 5.03 0 0 0 0 7.12l30.08 30.08H5.04C2.26 54.69 0 56.94 0 59.73s2.25 5.04 5.04 5.04h42.53L17.49 94.85a5.027 5.027 0 0 0 0 7.12 5.027 5.027 0 0 0 7.12 0l30.08-30.08v42.54c0 2.78 2.25 5.04 5.04 5.04s5.04-2.25 5.04-5.04V71.89l30.08 30.08a5.03 5.03 0 0 0 7.12 0 5.027 5.027 0 0 0 0-7.12L71.89 64.77h42.53c2.78 0 5.04-2.25 5.04-5.04s-2.25-5.04-5.04-5.04z"/></svg>
				Who you're working with.
			</span>
			<p class="about-text fade-in-child" style="--delay:1">
				I'm <span class="bio-name">Tom</span>, a web developer and local SEO guy in <span class="bio-pin"><svg class="bio-pin-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0C7.03 0 3 4.03 3 9c0 6.75 9 15 9 15s9-8.25 9-15c0-4.97-4.03-9-9-9zm0 12.5a3.5 3.5 0 1 1 0-7 3.5 3.5 0 0 1 0 7z"/></svg>Asheville, NC</span>, working directly with local service businesses. <span class="bio-strike" style="--strike-delay:0.35s">No middleman.</span> <span class="bio-strike" style="--strike-delay:0.6s">No agency layers.</span> You work with <span class="bio-circle">one person, me</span>. I build the site, run your local SEO every month, and aim to have you ranking on <span class="bio-google" aria-label="Google"><span class="bio-google__l" style="--g-color:#4285F4">G</span><span class="bio-google__l" style="--g-color:#EA4335">o</span><span class="bio-google__l" style="--g-color:#FBBC05">o</span><span class="bio-google__l" style="--g-color:#4285F4">g</span><span class="bio-google__l" style="--g-color:#34A853">l</span><span class="bio-google__l" style="--g-color:#EA4335">e</span></span> <span class="bio-mark" style="--mark-delay:1s">within 3 months</span>. <span class="bio-trade" style="--trade-delay:1.2s; --trade-color: var(--accent)">Remodelers</span>, <span class="bio-trade" style="--trade-delay:1.3s; --trade-color: var(--accent-pink)">plumbers</span>, <span class="bio-trade" style="--trade-delay:1.4s; --trade-color: var(--accent-green)">electricians</span>, <span class="bio-trade" style="--trade-delay:1.5s; --trade-color: var(--accent-purple)">pressure washers</span>, and the rest of the trades.
			</p>
		</div>
	</section>

	<!-- SERVICES -->
	<section class="section" id="services">
		<div class="section-header">
			<span class="section-eyebrow">
				<svg class="eyebrow-icon" viewBox="0 0 120 120" fill="currentColor"><path d="M114.44 54.69H71.9l30.08-30.08a5.03 5.03 0 0 0 0-7.12 5.03 5.03 0 0 0-7.12 0L64.78 47.57V5.04c0-2.78-2.25-5.04-5.04-5.04S54.7 2.25 54.7 5.04v42.53L24.62 17.49a5.027 5.027 0 0 0-7.12 0 5.03 5.03 0 0 0 0 7.12l30.08 30.08H5.04C2.26 54.69 0 56.94 0 59.73s2.25 5.04 5.04 5.04h42.53L17.49 94.85a5.027 5.027 0 0 0 0 7.12 5.027 5.027 0 0 0 7.12 0l30.08-30.08v42.54c0 2.78 2.25 5.04 5.04 5.04s5.04-2.25 5.04-5.04V71.89l30.08 30.08a5.03 5.03 0 0 0 7.12 0 5.027 5.027 0 0 0 0-7.12L71.89 64.77h42.53c2.78 0 5.04-2.25 5.04-5.04s-2.25-5.04-5.04-5.04z"/></svg>
				Our services.
			</span>
			<h2 class="section-title">What I do.</h2>
			<p class="section-desc">Monthly local SEO and websites built for service businesses that need to actually show up on Google.</p>
		</div>

		<ul class="stack-cards js-stack-cards">
			<li class="stack-cards__item js-stack-cards__item">
				<a href="/services/web-development/" class="svc-card svc-card--orange">
					<div class="svc-card-content">
						<div class="svc-card-head">
							<span class="svc-mark">01 / 04</span>
							<span class="svc-icon" aria-hidden="true">
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
							</span>
						</div>
						<div class="svc-card-text">
							<h3>Web Development</h3>
							<p>Custom websites built for local service businesses, included in every monthly plan. Fast, clear, and built to convert visitors into calls.</p>
						</div>
						<div class="svc-card-foot">
							<ul class="svc-tags">
								<li>Included in plan</li>
								<li>Hosting</li>
								<li>Performance</li>
							</ul>
							<span class="svc-cta">
								Explore
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
							</span>
						</div>
					</div>
					<div class="svc-card-img">
						<img src="https://images.unsplash.com/photo-1498050108023-c5249f4df085?auto=format&fit=crop&q=80&w=1000" alt="Web Development" loading="lazy" />
					</div>
				</a>
			</li>

			<li class="stack-cards__item js-stack-cards__item">
				<a href="/services/seo/" class="svc-card svc-card--pink">
					<div class="svc-card-content">
						<div class="svc-card-head">
							<span class="svc-mark">02 / 04</span>
							<span class="svc-icon" aria-hidden="true">
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><polyline points="8.5 11 11 13.5 14 10"/></svg>
							</span>
						</div>
						<div class="svc-card-text">
							<h3>Local SEO</h3>
							<p>Monthly SEO work aimed at getting you ranking on Google within 3 months. GBP optimization, content, on-page fixes, and review growth.</p>
						</div>
						<div class="svc-card-foot">
							<ul class="svc-tags">
								<li>Rank in 3 months</li>
								<li>GBP</li>
								<li>Content</li>
							</ul>
							<span class="svc-cta">
								Explore
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
							</span>
						</div>
					</div>
					<div class="svc-card-img">
						<img src="https://images.unsplash.com/photo-1542744173-8e7e53415bb0?auto=format&fit=crop&q=80&w=1000" alt="SEO Optimization" loading="lazy" />
					</div>
				</a>
			</li>

			<li class="stack-cards__item js-stack-cards__item">
				<a href="/services/tooling/" class="svc-card svc-card--yellow">
					<div class="svc-card-content">
						<div class="svc-card-head">
							<span class="svc-mark">03 / 04</span>
							<span class="svc-icon" aria-hidden="true">
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
							</span>
						</div>
						<div class="svc-card-text">
							<h3>Tooling</h3>
							<p>Forms, quote flows, dashboards, and automations that save your team time and turn more visitors into actual jobs.</p>
						</div>
						<div class="svc-card-foot">
							<ul class="svc-tags">
								<li>Forms</li>
								<li>Dashboards</li>
								<li>Automation</li>
							</ul>
							<span class="svc-cta">
								Explore
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
							</span>
						</div>
					</div>
					<div class="svc-card-img">
						<img src="https://images.unsplash.com/photo-1551288049-bebda4e38f71?auto=format&fit=crop&q=80&w=1000" alt="Tooling" loading="lazy" />
					</div>
				</a>
			</li>

			<li class="stack-cards__item js-stack-cards__item">
				<a href="/services/ai/" class="svc-card svc-card--green">
					<div class="svc-card-content">
						<div class="svc-card-head">
							<span class="svc-mark">04 / 04</span>
							<span class="svc-icon" aria-hidden="true">
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="16" rx="3"/><path d="M9 9h6v6H9z"/><path d="M9 2v3"/><path d="M15 2v3"/><path d="M9 19v3"/><path d="M15 19v3"/><path d="M19 9h3"/><path d="M19 15h3"/><path d="M2 9h3"/><path d="M2 15h3"/></svg>
							</span>
						</div>
						<div class="svc-card-text">
							<h3>AI Workflows</h3>
							<p>Practical AI built into your business. Lead capture, customer follow-ups, content help, and workflows that save real hours.</p>
						</div>
						<div class="svc-card-foot">
							<ul class="svc-tags">
								<li>Chatbots</li>
								<li>Follow-ups</li>
								<li>Workflows</li>
							</ul>
							<span class="svc-cta">
								Explore
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
							</span>
						</div>
					</div>
					<div class="svc-card-img">
						<img src="https://images.unsplash.com/photo-1677442136019-21780ecad995?auto=format&fit=crop&q=80&w=1000" alt="AI" loading="lazy" />
					</div>
				</a>
			</li>
		</ul>

	</section>

	<!-- HOW IT WORKS -->
	<section class="section slide-in-section" id="how-it-works">
		<img src="/paint-strikes.png" alt="" class="process-bg" />
		<div class="section-header slide-in-left">
			<span class="section-eyebrow">
				<svg class="eyebrow-icon" viewBox="0 0 120 120" fill="currentColor"><path d="M114.44 54.69H71.9l30.08-30.08a5.03 5.03 0 0 0 0-7.12 5.03 5.03 0 0 0-7.12 0L64.78 47.57V5.04c0-2.78-2.25-5.04-5.04-5.04S54.7 2.25 54.7 5.04v42.53L24.62 17.49a5.027 5.027 0 0 0-7.12 0 5.03 5.03 0 0 0 0 7.12l30.08 30.08H5.04C2.26 54.69 0 56.94 0 59.73s2.25 5.04 5.04 5.04h42.53L17.49 94.85a5.027 5.027 0 0 0 0 7.12 5.027 5.027 0 0 0 7.12 0l30.08-30.08v42.54c0 2.78 2.25 5.04 5.04 5.04s5.04-2.25 5.04-5.04V71.89l30.08 30.08a5.03 5.03 0 0 0 7.12 0 5.027 5.027 0 0 0 0-7.12L71.89 64.77h42.53c2.78 0 5.04-2.25 5.04-5.04s-2.25-5.04-5.04-5.04z"/></svg>
				How it works.
			</span>
			<h2 class="section-title">No agency runaround.</h2>
			<p class="section-desc">A clear path from first message to ranking on Google. Same person every step.</p>
		</div>

		<ol class="process-flow">
			<li class="process-step scale-in-child step--orange" style="--delay:0">
				<div class="step-badge">
					<svg class="step-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
				</div>
				<span class="step-number">01</span>
				<h4>You reach out</h4>
				<p>Send a quick message. No phone tag. No forms with twenty fields.</p>
			</li>
			<li class="process-step scale-in-child step--pink" style="--delay:1">
				<div class="step-badge">
					<svg class="step-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
				</div>
				<span class="step-number">02</span>
				<h4>We pick your plan</h4>
				<p>Quick call to size up your market and pick the right monthly tier.</p>
			</li>
			<li class="process-step scale-in-child step--yellow" style="--delay:2">
				<div class="step-badge">
					<svg class="step-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
				</div>
				<span class="step-number">03</span>
				<h4>Site goes live</h4>
				<p>Website, hosting, and Google Business Profile up and running fast.</p>
			</li>
			<li class="process-step scale-in-child step--green" style="--delay:3">
				<div class="step-badge">
					<svg class="step-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 3v18h18"/><polyline points="7 14 12 9 16 13 21 8"/></svg>
				</div>
				<span class="step-number">04</span>
				<h4>Monthly SEO work</h4>
				<p>Content, GBP posts, on-page fixes, reviews, and rank tracking every month.</p>
			</li>
			<li class="process-step scale-in-child step--purple" style="--delay:4">
				<div class="step-badge">
					<svg class="step-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6z"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09a1.65 1.65 0 0 0-1-1.51 1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09a1.65 1.65 0 0 0 1.51-1 1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
				</div>
				<span class="step-number">05</span>
				<h4>Ranking in 3 months</h4>
				<p>Visible on Google for your local searches. Calls and leads start coming in.</p>
			</li>
		</ol>
	</section>

	<!-- TESTIMONIALS -->
	<section class="section slide-in-section testimonials-section" id="testimonials">
		<div class="testimonials-glow" aria-hidden="true"></div>
		<img src="/paint-splat.png" alt="" class="testimonials-bg" />
		<div class="section-header slide-in-left">
			<span class="section-eyebrow">
				<svg class="eyebrow-icon" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z" fill="#4285F4"/><path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/><path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18A10.96 10.96 0 0 0 1 12c0 1.77.42 3.45 1.18 4.93l3.66-2.84z" fill="#FBBC05"/><path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/></svg>
				Google Reviews.
			</span>
			<h2 class="section-title">Don't take my word for it.</h2>
			<p class="section-desc">All 5-star reviews on Google.</p>
		</div>

		<div class="reviews-grid">
			<div class="review-card scale-in-child" style="--delay:0">
				<div class="review-inner">
