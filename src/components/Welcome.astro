---
import astroLogo from '../assets/computertommylogo.svg';
import background from '../assets/background.svg';
import { locations } from '../data/locations';
import { portfolioItems } from '../data/portfolio';

const featuredWork = portfolioItems.filter((p) =>
	['notle-client', 'Kiefer Property Solutions', 'paintball-sample-site'].includes(p.slug)
);
---

<div class="page-wrapper">
	<img class="bg-blur" src={background.src} alt="" fetchpriority="high" />

	<!-- HERO -->
	<div class="hero-bg">
		<img src="/portfolio/bg-img-ct.png" alt="" class="hero-bg-img" />
	</div>
	<section class="hero">
		<a href="/" class="logo-link">
			<img src={astroLogo.src} width="130" height="52" alt="ComputerTommy home" />
		</a>

		<div class="hero-inner">
			<div class="hero-headline-wrap">
				<h1 class="hero-title">
					Professional web developer for local businesses.
				</h1>
				<span class="badge badge-pink">NO FEES</span>
				<span class="badge badge-yellow">FAST</span>
				<span class="badge badge-green">PERSONAL</span>
			</div>

			<div class="hero-foot">
				<p class="hero-desc">
					One-time build. No monthly fees. Real dude. Easy process. You own the site. Based in Asheville, NC.
				</p>
				<div class="hero-actions">
					<a href="/contact/" class="btn-solid">Tell me what you need &rarr;</a>
					<a href="/services/" class="btn-outline">Services</a>
					<a href="/portfolio/" class="btn-outline">Portfolio</a>
				</div>
			</div>
		</div>
	</section>

	<!-- ABOUT -->
	<section class="section" id="about-tom">
		<div class="section-center fade-in-section">
			<span class="section-eyebrow fade-in-child" style="--delay:0">
				<svg class="eyebrow-icon" viewBox="0 0 120 120" fill="currentColor"><path d="M114.44 54.69H71.9l30.08-30.08a5.03 5.03 0 0 0 0-7.12 5.03 5.03 0 0 0-7.12 0L64.78 47.57V5.04c0-2.78-2.25-5.04-5.04-5.04S54.7 2.25 54.7 5.04v42.53L24.62 17.49a5.027 5.027 0 0 0-7.12 0 5.03 5.03 0 0 0 0 7.12l30.08 30.08H5.04C2.26 54.69 0 56.94 0 59.73s2.25 5.04 5.04 5.04h42.53L17.49 94.85a5.027 5.027 0 0 0 0 7.12 5.027 5.027 0 0 0 7.12 0l30.08-30.08v42.54c0 2.78 2.25 5.04 5.04 5.04s5.04-2.25 5.04-5.04V71.89l30.08 30.08a5.03 5.03 0 0 0 7.12 0 5.027 5.027 0 0 0 0-7.12L71.89 64.77h42.53c2.78 0 5.04-2.25 5.04-5.04s-2.25-5.04-5.04-5.04z"/></svg>
				Who you're working with.
			</span>
			<p class="about-text fade-in-child" style="--delay:1">
				I'm Tom — a web developer in <a href="/services/web-development/asheville-nc/">Asheville, NC</a> who works directly with local service businesses. No middleman. No agency layers. You work with one person, me. You can ask questions. You get direct answers. I build websites for remodelers, plumbers, electricians, pressure washers, and other local service providers.
			</p>
		</div>
	</section>

	<!-- SERVICES -->
	<section class="section" id="services">
		<div class="section-header">
			<span class="section-eyebrow">
				<svg class="eyebrow-icon" viewBox="0 0 120 120" fill="currentColor"><path d="M114.44 54.69H71.9l30.08-30.08a5.03 5.03 0 0 0 0-7.12 5.03 5.03 0 0 0-7.12 0L64.78 47.57V5.04c0-2.78-2.25-5.04-5.04-5.04S54.7 2.25 54.7 5.04v42.53L24.62 17.49a5.027 5.027 0 0 0-7.12 0 5.03 5.03 0 0 0 0 7.12l30.08 30.08H5.04C2.26 54.69 0 56.94 0 59.73s2.25 5.04 5.04 5.04h42.53L17.49 94.85a5.027 5.027 0 0 0 0 7.12 5.027 5.027 0 0 0 7.12 0l30.08-30.08v42.54c0 2.78 2.25 5.04 5.04 5.04s5.04-2.25 5.04-5.04V71.89l30.08 30.08a5.03 5.03 0 0 0 7.12 0 5.027 5.027 0 0 0 0-7.12L71.89 64.77h42.53c2.78 0 5.04-2.25 5.04-5.04s-2.25-5.04-5.04-5.04z"/></svg>
				Our services.
			</span>
			<h2 class="section-title">What I do.</h2>
			<p class="section-desc">Website work built for local service businesses that need something fast, clear, and professional.</p>
		</div>

		<ul class="stack-cards js-stack-cards">
			<li class="stack-cards__item js-stack-cards__item">
				<a href="/services/web-development/" class="svc-card">
					<div class="svc-card-content">
						<div class="svc-card-text">
							<h3>Web Development</h3>
							<p>Custom websites built for local businesses that need something fast, clear, and professional without dealing with an agency.</p>
						</div>
						<ul class="svc-tags">
							<li>Custom Sites</li>
							<li>Responsive</li>
							<li>Performance</li>
						</ul>
					</div>
					<div class="svc-card-img">
						<img src="https://images.unsplash.com/photo-1498050108023-c5249f4df085?auto=format&fit=crop&q=80&w=1000" alt="Web Development" loading="lazy" />
					</div>
				</a>
			</li>

			<li class="stack-cards__item js-stack-cards__item">
				<a href="/services/seo/" class="svc-card">
					<div class="svc-card-content">
						<div class="svc-card-text">
							<h3>SEO Optimization</h3>
							<p>On-page and technical SEO work to help your website show up better for the local searches that actually matter.</p>
						</div>
						<ul class="svc-tags">
							<li>Local SEO</li>
							<li>Technical</li>
							<li>Analytics</li>
						</ul>
					</div>
					<div class="svc-card-img">
						<img src="https://images.unsplash.com/photo-1542744173-8e7e53415bb0?auto=format&fit=crop&q=80&w=1000" alt="SEO Optimization" loading="lazy" />
					</div>
				</a>
			</li>

			<li class="stack-cards__item js-stack-cards__item">
				<a href="/services/tooling/" class="svc-card">
					<div class="svc-card-content">
						<div class="svc-card-text">
							<h3>Tooling</h3>
							<p>Useful business tools like forms, quote flows, dashboards, and automations that save time and cut down manual work.</p>
						</div>
						<ul class="svc-tags">
							<li>Forms</li>
							<li>Dashboards</li>
							<li>Automation</li>
						</ul>
					</div>
					<div class="svc-card-img">
						<img src="https://images.unsplash.com/photo-1551288049-bebda4e38f71?auto=format&fit=crop&q=80&w=1000" alt="Tooling" loading="lazy" />
					</div>
				</a>
			</li>

			<li class="stack-cards__item js-stack-cards__item">
				<a href="/services/ai/" class="svc-card">
					<div class="svc-card-content">
						<div class="svc-card-text">
							<h3>AI Workflows</h3>
							<p>Practical AI features for small businesses that want real utility, not gimmicks or overcomplicated systems.</p>
						</div>
						<ul class="svc-tags">
							<li>Chatbots</li>
							<li>Content</li>
							<li>Workflows</li>
						</ul>
					</div>
					<div class="svc-card-img">
						<img src="https://images.unsplash.com/photo-1677442136019-21780ecad995?auto=format&fit=crop&q=80&w=1000" alt="AI" loading="lazy" />
					</div>
				</a>
			</li>
		</ul>

		<div class="serving-bar">
			<span class="serving-label">Serving:</span>
			<div class="serving-pills">
				{locations.map((l) => (
					<a href={`/services/web-development/${l.slug}/`} class="location-pill">{l.city}, {l.regionLabel}</a>
				))}
			</div>
		</div>
	</section>

	<!-- HOW IT WORKS -->
	<section class="section slide-in-section" id="how-it-works">
		<img src="/paint-strikes.png" alt="" class="process-bg" />
		<div class="section-header slide-in-left">
			<span class="section-eyebrow">
				<svg class="eyebrow-icon" viewBox="0 0 120 120" fill="currentColor"><path d="M114.44 54.69H71.9l30.08-30.08a5.03 5.03 0 0 0 0-7.12 5.03 5.03 0 0 0-7.12 0L64.78 47.57V5.04c0-2.78-2.25-5.04-5.04-5.04S54.7 2.25 54.7 5.04v42.53L24.62 17.49a5.027 5.027 0 0 0-7.12 0 5.03 5.03 0 0 0 0 7.12l30.08 30.08H5.04C2.26 54.69 0 56.94 0 59.73s2.25 5.04 5.04 5.04h42.53L17.49 94.85a5.027 5.027 0 0 0 0 7.12 5.027 5.027 0 0 0 7.12 0l30.08-30.08v42.54c0 2.78 2.25 5.04 5.04 5.04s5.04-2.25 5.04-5.04V71.89l30.08 30.08a5.03 5.03 0 0 0 7.12 0 5.027 5.027 0 0 0 0-7.12L71.89 64.77h42.53c2.78 0 5.04-2.25 5.04-5.04s-2.25-5.04-5.04-5.04z"/></svg>
				How it works.
			</span>
			<h2 class="section-title">No agency runaround.</h2>
			<p class="section-desc">Straightforward process from start to finish. You always know where things stand.</p>
		</div>

		<div class="process-grid">
			<div class="process-step scale-in-child" style="--delay:0">
				<span class="step-number">01</span>
				<h4>You reach out</h4>
				<p>Tell me what you need. A quick message is all it takes.</p>
			</div>
			<div class="process-step scale-in-child" style="--delay:1">
				<span class="step-number">02</span>
				<h4>We scope it out</h4>
				<p>A quick call to figure out what you need and how it should work.</p>
			</div>
			<div class="process-step scale-in-child" style="--delay:2">
				<span class="step-number">03</span>
				<h4>Clear upfront price</h4>
				<p>You get a fixed price before anything starts. No surprises.</p>
			</div>
			<div class="process-step scale-in-child" style="--delay:3">
				<span class="step-number">04</span>
				<h4>I build it</h4>
				<p>I handle the work — design, code, SEO, the whole thing.</p>
			</div>
			<div class="process-step scale-in-child" style="--delay:4">
				<span class="step-number">05</span>
				<h4>You own it</h4>
				<p>You get a finished site you control. No lock-in. No subscriptions.</p>
			</div>
		</div>
	</section>

	<!-- TESTIMONIALS -->
	<section class="section slide-in-section testimonials-section" id="testimonials">
		<img src="/paint-splat.png" alt="" class="testimonials-bg" />
		<div class="section-header slide-in-left">
			<span class="section-eyebrow">
				<svg class="eyebrow-icon" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z" fill="#4285F4"/><path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/><path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18A10.96 10.96 0 0 0 1 12c0 1.77.42 3.45 1.18 4.93l3.66-2.84z" fill="#FBBC05"/><path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/></svg>
				Google Reviews.
			</span>
			<h2 class="section-title">Don't take my word for it.</h2>
			<p class="section-desc">All 5-star reviews on Google.</p>
		</div>

		<div class="reviews-grid">
			<div class="review-card scale-in-child" style="--delay:0">
				<div class="review-inner">
					<div class="review-head">
						<svg class="google-g" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z" fill="#4285F4"/><path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/><path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18A10.96 10.96 0 0 0 1 12c0 1.77.42 3.45 1.18 4.93l3.66-2.84z" fill="#FBBC05"/><path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/></svg>
						<div class="review-stars">
							<svg viewBox="0 0 24 24" fill="#FBBC05"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87L18.18 21 12 17.27 5.82 21 7 14.14l-5-4.87 6.91-1.01z"/></svg>
							<svg viewBox="0 0 24 24" fill="#FBBC05"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87L18.18 21 12 17.27 5.82 21 7 14.14l-5-4.87 6.91-1.01z"/></svg>
							<svg viewBox="0 0 24 24" fill="#FBBC05"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87L18.18 21 12 17.27 5.82 21 7 14.14l-5-4.87 6.91-1.01z"/></svg>
							<svg viewBox="0 0 24 24" fill="#FBBC05"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87L18.18 21 12 17.27 5.82 21 7 14.14l-5-4.87 6.91-1.01z"/></svg>
							<svg viewBox="0 0 24 24" fill="#FBBC05"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87L18.18 21 12 17.27 5.82 21 7 14.14l-5-4.87 6.91-1.01z"/></svg>
						</div>
					</div>
					<p class="review-text">"I was in need of help with my website design. I reached out to Tommy he had me up and going in 2 days. The website is phenomenal!"</p>
					<span class="review-name">Nicholas K.</span>
				</div>
			</div>

			<div class="review-card scale-in-child" style="--delay:1">
				<div class="review-inner">
					<div class="review-head">
						<svg class="google-g" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z" fill="#4285F4"/><path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/><path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18A10.96 10.96 0 0 0 1 12c0 1.77.42 3.45 1.18 4.93l3.66-2.84z" fill="#FBBC05"/><path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/></svg>
						<div class="review-stars">
							<svg viewBox="0 0 24 24" fill="#FBBC05"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87L18.18 21 12 17.27 5.82 21 7 14.14l-5-4.87 6.91-1.01z"/></svg>
							<svg viewBox="0 0 24 24" fill="#FBBC05"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87L18.18 21 12 17.27 5.82 21 7 14.14l-5-4.87 6.91-1.01z"/></svg>
							<svg viewBox="0 0 24 24" fill="#FBBC05"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87L18.18 21 12 17.27 5.82 21 7 14.14l-5-4.87 6.91-1.01z"/></svg>
							<svg viewBox="0 0 24 24" fill="#FBBC05"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87L18.18 21 12 17.27 5.82 21 7 14.14l-5-4.87 6.91-1.01z"/></svg>
							<svg viewBox="0 0 24 24" fill="#FBBC05"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87L18.18 21 12 17.27 5.82 21 7 14.14l-5-4.87 6.91-1.01z"/></svg>
						</div>
					</div>
					<p class="review-text">"Tom produced A++ quality for my bands website, was easy to work with, can't recommend him enough!"</p>
					<span class="review-name">Miles D.</span>
				</div>
			</div>

			<div class="review-card scale-in-child" style="--delay:2">
				<div class="review-inner">
					<div class="review-head">
						<svg class="google-g" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z" fill="#4285F4"/><path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/><path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18A10.96 10.96 0 0 0 1 12c0 1.77.42 3.45 1.18 4.93l3.66-2.84z" fill="#FBBC05"/><path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/></svg>
						<div class="review-stars">
							<svg viewBox="0 0 24 24" fill="#FBBC05"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87L18.18 21 12 17.27 5.82 21 7 14.14l-5-4.87 6.91-1.01z"/></svg>
							<svg viewBox="0 0 24 24" fill="#FBBC05"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87L18.18 21 12 17.27 5.82 21 7 14.14l-5-4.87 6.91-1.01z"/></svg>
							<svg viewBox="0 0 24 24" fill="#FBBC05"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87L18.18 21 12 17.27 5.82 21 7 14.14l-5-4.87 6.91-1.01z"/></svg>
							<svg viewBox="0 0 24 24" fill="#FBBC05"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87L18.18 21 12 17.27 5.82 21 7 14.14l-5-4.87 6.91-1.01z"/></svg>
							<svg viewBox="0 0 24 24" fill="#FBBC05"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87L18.18 21 12 17.27 5.82 21 7 14.14l-5-4.87 6.91-1.01z"/></svg>
						</div>
					</div>
					<p class="review-text">"I needed a simple but good looking website and didn't want to pay monthly fees or a crazy price. Tom is an excellent and quick web developer and made everything how I wanted. The price was super reasonable too!"</p>
					<span class="review-name">Chris V.</span>
				</div>
			</div>

			<div class="review-card scale-in-child" style="--delay:3">
				<div class="review-inner">
					<div class="review-head">
						<svg class="google-g" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z" fill="#4285F4"/><path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/><path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18A10.96 10.96 0 0 0 1 12c0 1.77.42 3.45 1.18 4.93l3.66-2.84z" fill="#FBBC05"/><path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/></svg>
						<div class="review-stars">
							<svg viewBox="0 0 24 24" fill="#FBBC05"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87L18.18 21 12 17.27 5.82 21 7 14.14l-5-4.87 6.91-1.01z"/></svg>
