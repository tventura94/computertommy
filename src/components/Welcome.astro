		gap: 0.75rem;
	}

	/* ═══════════════════════════════════════
	   Fade-in on scroll
	   ═══════════════════════════════════════ */
	.fade-in-child {
		opacity: 0;
		transform: translateY(24px);
		transition: opacity 1.15s cubic-bezier(0.22, 1, 0.36, 1), transform 1.15s cubic-bezier(0.22, 1, 0.36, 1);
		transition-delay: calc(var(--delay, 0) * 0.22s);
	}

	.fade-in-section.is-visible .fade-in-child {
		opacity: 1;
		transform: translateY(0);
	}

	/* Slide-in from left (header) */
	.slide-in-left {
		opacity: 0;
		transform: translateX(-60px);
		transition: opacity 0.7s ease, transform 0.7s ease;
	}

	.slide-in-section.is-visible .slide-in-left {
		opacity: 1;
		transform: translateX(0);
	}

	/* Scale-in (process step cards) */
	.scale-in-child {
		opacity: 0;
		transform: scale(0.85);
		transition: opacity 0.5s ease, transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
		transition-delay: calc(var(--delay, 0) * 0.1s + 0.3s);
	}

	.slide-in-section.is-visible .scale-in-child {
		opacity: 1;
		transform: scale(1);
	}

	/* ═══════════════════════════════════════
	   About (intro)
	   ═══════════════════════════════════════ */
	.about-text {
		font-family: var(--font-display);
		font-size: clamp(1.5rem, 4vw, 3rem);
		font-weight: 400;
		color: var(--text);
		line-height: 1.15;
		letter-spacing: 0.02em;
		text-transform: uppercase;
		margin: 0;
	}

	.about-text a {
		color: var(--accent);
		text-decoration: none;
		transition: opacity 0.2s;
	}

	.about-text a:hover {
		text-decoration: underline;
		opacity: 0.85;
	}

	/* ───────────── Bio decorations ───────────── */

	.bio-name {
		display: inline-block;
		color: var(--accent);
		transform: rotate(-2.5deg);
		transform-origin: 50% 100%;
		transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
		padding: 0 0.05em;
	}

	.bio-name:hover {
		transform: rotate(-5deg) scale(1.06);
	}

	.bio-pin {
		display: inline-flex;
		align-items: baseline;
		gap: 0.18em;
		white-space: nowrap;
		color: var(--accent);
	}

	.bio-pin-icon {
		width: 0.7em;
		height: 0.7em;
		flex-shrink: 0;
		align-self: center;
		color: var(--accent);
		transform-origin: 50% 100%;
		animation: bio-pin-bounce 2.6s ease-in-out infinite;
	}

	@keyframes bio-pin-bounce {
		0%, 100% { transform: translateY(0); }
		50% { transform: translateY(-0.18em); }
	}

	.bio-strike {
		position: relative;
		display: inline-block;
		color: var(--text-muted);
		transition: color 0.5s ease var(--strike-delay, 0.3s);
	}

	.bio-strike::after {
		content: "";
		position: absolute;
		left: -0.08em;
		right: -0.08em;
		top: 52%;
		height: 0.1em;
		background: var(--accent-pink);
		border-radius: 999px;
		transform: scaleX(0) rotate(-1.5deg);
		transform-origin: left center;
		transition: transform 0.65s cubic-bezier(0.65, 0, 0.35, 1) var(--strike-delay, 0.3s);
		pointer-events: none;
	}

	.fade-in-section.is-visible .bio-strike::after {
		transform: scaleX(1) rotate(-1.5deg);
	}

	.bio-circle {
		position: relative;
		display: inline-block;
		z-index: 1;
		padding: 0 0.18em;
		color: var(--text);
	}

	.bio-circle::before {
		content: "";
		position: absolute;
		inset: -0.05em -0.05em -0.1em -0.05em;
		border: 2.5px solid var(--accent-yellow);
		border-radius: 55% 45% 60% 40% / 50% 60% 45% 55%;
		transform: scale(0.6) rotate(-2deg);
		opacity: 0;
		transition:
			transform 0.55s cubic-bezier(0.34, 1.56, 0.64, 1) 0.7s,
			opacity 0.5s ease 0.7s;
		z-index: -1;
		pointer-events: none;
	}

	.fade-in-section.is-visible .bio-circle::before {
		transform: scale(1) rotate(-2deg);
		opacity: 1;
	}

	.bio-google {
		display: inline-block;
	}

	.bio-google__l {
		display: inline-block;
		color: var(--g-color, var(--text));
		opacity: 0;
		transform: translateY(0.4em) scale(0.7);
		transition:
			opacity 0.45s ease,
			transform 0.55s cubic-bezier(0.34, 1.56, 0.64, 1);
	}

	.fade-in-section.is-visible .bio-google__l {
		opacity: 1;
		transform: translateY(0) scale(1);
	}

	.bio-google__l:nth-child(1) { transition-delay: 0.85s; }
	.bio-google__l:nth-child(2) { transition-delay: 0.93s; }
	.bio-google__l:nth-child(3) { transition-delay: 1.01s; }
	.bio-google__l:nth-child(4) { transition-delay: 1.09s; }
	.bio-google__l:nth-child(5) { transition-delay: 1.17s; }
	.bio-google__l:nth-child(6) { transition-delay: 1.25s; }

	.bio-mark {
		position: relative;
		display: inline-block;
		z-index: 1;
		white-space: nowrap;
	}

	.bio-mark::before {
		content: "";
		position: absolute;
		left: -0.08em;
		right: -0.08em;
		bottom: 0.05em;
		height: 0.28em;
		background: var(--accent-yellow);
		border-radius: 2px;
		transform: scaleX(0) skewX(-3deg);
		transform-origin: left center;
		transition: transform 0.6s cubic-bezier(0.65, 0, 0.35, 1) var(--mark-delay, 0.5s);
		z-index: -1;
		pointer-events: none;
	}

	.fade-in-section.is-visible .bio-mark::before {
		transform: scaleX(1) skewX(-3deg);
	}

	.bio-trade {
		display: inline-block;
		color: var(--trade-color, var(--text));
		opacity: 0;
		transform: translateY(0.45em);
		transition:
			opacity 0.45s ease,
			transform 0.55s cubic-bezier(0.34, 1.56, 0.64, 1);
		transition-delay: var(--trade-delay, 1s);
	}

	.fade-in-section.is-visible .bio-trade {
		opacity: 1;
		transform: translateY(0);
	}

	@media (prefers-reduced-motion: reduce) {
		.bio-name,
		.bio-pin-icon,
		.bio-strike::after,
		.bio-circle::before,
		.bio-google__l,
		.bio-mark::before,
		.bio-trade {
			transition: none !important;
			animation: none !important;
			transform: none !important;
			opacity: 1 !important;
		}
	}

	/* ═══════════════════════════════════════
	   Services — CodyHouse stacking cards
	   ═══════════════════════════════════════ */
	.stack-cards {
		--stack-cards-gap: 1.25rem;
		--stack-cards-item-ratio: 3/1;
		list-style: none;
		padding: 0;
		margin: 0;
	}

	.stack-cards__item {
		position: sticky;
		top: 2rem;
		height: 0;
		padding-bottom: calc(100% / (var(--stack-cards-item-ratio)));
		transform-origin: center top;
	}

	.stack-cards__item > * {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
	}

	.svc-card {
		--svc-color: var(--accent);
		--svc-shadow: rgba(249, 115, 22, 0.35);
		position: relative;
		display: grid;
		grid-template-columns: 1fr;
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		overflow: hidden;
		text-decoration: none;
		color: inherit;
		height: 100%;
		box-shadow: 0 4px 30px rgba(0, 0, 0, 0.45);
		transition: border-color 0.3s ease, box-shadow 0.3s ease;
	}

	.svc-card::before {
		content: "";
		position: absolute;
		top: 0;
		left: 0;
		bottom: 0;
		width: 4px;
		background: var(--svc-color);
		z-index: 2;
		pointer-events: none;
	}

	.svc-card:hover {
		border-color: var(--svc-color);
		box-shadow: 0 24px 60px -16px var(--svc-shadow);
	}

	.svc-card--orange { --svc-color: var(--accent);        --svc-shadow: rgba(249, 115, 22, 0.45); }
	.svc-card--pink   { --svc-color: var(--accent-pink);   --svc-shadow: rgba(244, 114, 182, 0.45); }
	.svc-card--yellow { --svc-color: var(--accent-yellow); --svc-shadow: rgba(250, 204, 21, 0.45); }
	.svc-card--green  { --svc-color: var(--accent-green);  --svc-shadow: rgba(74, 222, 128, 0.45); }

	@media (min-width: 768px) {
		.svc-card {
			grid-template-columns: 1fr 1fr;
		}
	}

	@media (min-width: 1024px) {
		.svc-card {
			grid-template-columns: 1.4fr 1fr;
		}
	}

	.svc-card-content {
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		gap: 1rem;
		background: var(--surface);
		padding: 1.25rem 1.25rem 1.25rem 1.65rem;
	}

	@media (min-width: 768px) {
		.svc-card-content {
			padding: 2rem 2rem 2rem 2.5rem;
			gap: 1.25rem;
		}
	}

	.svc-card-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
	}

	.svc-mark {
		font-family: var(--font-display);
		font-size: 0.95rem;
		letter-spacing: 0.18em;
		color: var(--svc-color);
		text-transform: uppercase;
		line-height: 1;
	}

	.svc-icon {
		width: 44px;
		height: 44px;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		border-radius: 50%;
		background: var(--bg);
		border: 1.5px solid var(--svc-color);
		color: var(--svc-color);
		flex-shrink: 0;
		transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1), background 0.3s ease, color 0.3s ease;
	}

	.svc-icon svg {
		width: 22px;
		height: 22px;
	}

	.svc-card:hover .svc-icon {
		transform: rotate(-8deg) scale(1.06);
		background: var(--svc-color);
		color: #0b0b0f;
	}

	.svc-card-img {
		overflow: hidden;
		min-height: 220px;
		position: relative;
		background: #1a1a22;
	}

	@media (min-width: 768px) {
		.svc-card-img {
			min-height: 320px;
		}
	}

	.svc-card-img img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.7s ease, filter 0.5s ease;
		filter: saturate(0.9);
	}

	.svc-card:hover .svc-card-img img {
		transform: scale(1.05);
		filter: saturate(1.05);
	}

	.svc-card-text h3 {
		font-family: var(--font-display);
		font-size: clamp(2rem, 4vw, 3.5rem);
		font-weight: 400;
		margin: 0 0 0.85rem;
		letter-spacing: 0.02em;
		text-transform: uppercase;
		line-height: 1;
	}

	.svc-card-text p {
		color: var(--text-muted);
		font-size: clamp(1rem, 1.4vw, 1.2rem);
		line-height: 1.55;
		margin: 0;
		max-width: 560px;
	}

	.svc-card-foot {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem 1.25rem;
	}

	.svc-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		list-style: none;
		padding: 0;
		margin: 0;
	}

	.svc-tags li {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		padding: 0.4rem 0.85rem;
		border: 1px solid var(--border);
		border-radius: 999px;
		font-size: 0.85rem;
		color: var(--text-muted);
		background: var(--bg);
		transition: border-color 0.3s ease, color 0.3s ease;
	}

	.svc-tags li::before {
		content: "";
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: var(--svc-color);
		flex-shrink: 0;
	}

	.svc-card:hover .svc-tags li {
		border-color: var(--svc-color);
		color: var(--text);
	}

	.svc-cta {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-family: var(--font-display);
		font-size: 1.05rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--svc-color);
		line-height: 1;
		flex-shrink: 0;
	}

	.svc-cta svg {
		width: 18px;
		height: 18px;
		transition: transform 0.3s ease;
	}

	.svc-card:hover .svc-cta svg {
		transform: translateX(5px);
	}

	.process-bg {
		position: absolute;
		top: -10%;
		right: -15%;
		width: 130%;
		height: auto;
		opacity: 0;
		pointer-events: none;
		z-index: 0;
		mix-blend-mode: lighten;
		transform: scale(0.85) rotate(3deg);
		transition: opacity 1s ease, transform 1s ease;
	}

	.slide-in-section.is-visible .process-bg {
		opacity: 0.2;
		transform: scale(1) rotate(0deg);
	}

	/* ═══════════════════════════════════════
	   Process / How it works
	   ═══════════════════════════════════════ */
	.process-flow {
		--pf-pad-top: 4.25rem;
		list-style: none;
		padding: var(--pf-pad-top) 0 0;
		margin: 0;
		display: grid;
		grid-template-columns: repeat(5, 1fr);
		gap: 1.35rem;
		position: relative;
	}

	/* Dashed track that connects all the badges */
	.process-flow::before {
		content: "";
		position: absolute;
		top: calc(var(--pf-pad-top) - 1px);
		left: calc((100% / 5) / 2);
		right: calc((100% / 5) / 2);
		height: 2px;
		background-image: linear-gradient(
			to right,
			var(--border) 50%,
			transparent 50%
		);
		background-size: 14px 2px;
		background-repeat: repeat-x;
		transform-origin: left center;
		transform: scaleX(0);
		transition: transform 1.4s cubic-bezier(0.65, 0, 0.35, 1) 0.2s;
		z-index: 0;
		pointer-events: none;
	}

	.slide-in-section.is-visible .process-flow::before {
		transform: scaleX(1);
	}

	.process-step {
		--step-color: var(--accent);
		--step-shadow: rgba(249, 115, 22, 0.35);
		position: relative;
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		padding: 3.25rem 1.65rem 1.85rem;
		display: flex;
		flex-direction: column;
		gap: 0.55rem;
		text-align: left;
		transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
		overflow: visible;
		isolation: isolate;
	}

	.process-step::after {
		content: "";
		position: absolute;
		inset: 0;
		border-radius: inherit;
		background: radial-gradient(
			120% 80% at 0% 0%,
			var(--step-color) 0%,
			transparent 60%
		);
		opacity: 0;
		transition: opacity 0.4s ease;
		pointer-events: none;
		z-index: -1;
	}

	.process-step:hover {
		transform: translateY(-6px);
		border-color: var(--step-color);
		box-shadow: 0 18px 40px -16px var(--step-shadow);
	}

	.process-step:hover::after {
		opacity: 0.08;
	}

	/* Per-step accent colors */
	.step--orange { --step-color: var(--accent);        --step-shadow: rgba(249, 115, 22, 0.45); }
	.step--pink   { --step-color: var(--accent-pink);   --step-shadow: rgba(244, 114, 182, 0.45); }
	.step--yellow { --step-color: var(--accent-yellow); --step-shadow: rgba(250, 204, 21, 0.45); }
	.step--green  { --step-color: var(--accent-green);  --step-shadow: rgba(74, 222, 128, 0.45); }
	.step--purple { --step-color: var(--accent-purple); --step-shadow: rgba(167, 139, 250, 0.45); }

	/* Floating colored badge above each card */
	.step-badge {
		position: absolute;
		top: -30px;
		left: 50%;
		transform: translateX(-50%);
		width: 60px;
		height: 60px;
		border-radius: 50%;
		background: var(--step-color);
		color: #0b0b0f;
		display: flex;
		align-items: center;
		justify-content: center;
		box-shadow:
			0 0 0 8px var(--bg),
			0 12px 28px -8px var(--step-shadow);
		transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
		z-index: 2;
	}

	.process-step:hover .step-badge {
		transform: translateX(-50%) rotate(-8deg) scale(1.06);
	}

	.step-icon {
		width: 26px;
		height: 26px;
	}

	.step-number {
		font-family: var(--font-display);
		font-size: 1rem;
		font-weight: 400;
		color: var(--step-color);
		letter-spacing: 0.18em;
		line-height: 1;
		text-transform: uppercase;
		margin-top: 0.25rem;
	}

	.process-step h4 {
		font-size: 1.2rem;
		font-weight: 700;
		margin: 0;
		color: var(--text);
		letter-spacing: -0.01em;
	}

	.process-step p {
		color: var(--text-muted);
		font-size: 1rem;
		line-height: 1.55;
		margin: 0;
	}

	@media (min-width: 1280px) {
		#how-it-works.section {
			max-width: 1400px;
		}
		.process-flow {
			gap: 1.65rem;
		}
		.process-step {
			padding: 3.35rem 1.85rem 2rem;
		}
	}

	/* Tablet: 3 + 2 columns. Hide the dashed connector since it can't span rows cleanly. */
	@media (max-width: 900px) {
		.process-flow {
			grid-template-columns: repeat(3, 1fr);
			--pf-pad-top: 3.75rem;
			gap: 1rem;
		}
		.process-flow::before {
			display: none;
		}
		.process-step {
			padding: 3rem 1.35rem 1.65rem;
		}
		.process-step h4 {
			font-size: 1.1rem;
		}
		.process-step p {
			font-size: 0.95rem;
		}
	}

	/* Mobile: vertical timeline with badge on the left and a vertical dashed line */
	@media (max-width: 600px) {
		.process-flow {
			grid-template-columns: 1fr;
			padding: 0 0 0 2rem;
			gap: 1.25rem;
			position: relative;
		}
		.process-flow::before {
			display: block;
			top: 0;
			bottom: 0;
			left: calc(2rem - 1px);
			right: auto;
			width: 2px;
			height: auto;
			background-image: linear-gradient(
				to bottom,
				var(--border) 50%,
				transparent 50%
			);
			background-size: 2px 14px;
			background-repeat: repeat-y;
			transform-origin: top center;
			transform: scaleY(0);
			transition: transform 1.4s cubic-bezier(0.65, 0, 0.35, 1) 0.2s;
		}
		.slide-in-section.is-visible .process-flow::before {
			transform: scaleY(1);
		}
		.process-step {
			padding: 1.25rem 1.25rem 1.25rem 2.25rem;
		}
		.step-badge {
			top: 1.25rem;
			left: -2rem;
			transform: translateX(-50%);
			width: 48px;
			height: 48px;
		}
		.step-icon {
			width: 20px;
			height: 20px;
		}
		.process-step:hover {
			transform: translateX(4px);
		}
		.process-step:hover .step-badge {
			transform: translateX(-50%) rotate(-8deg) scale(1.06);
		}
	}

	/* ═══════════════════════════════════════
	   Works / Portfolio
	   ═══════════════════════════════════════ */
	.section--works {
		position: relative;
		overflow: hidden;
	}

	.section--works > .works-header,
	.section--works > .works-showcase,
	.section--works > .works-cta-card {
		position: relative;
		z-index: 1;
	}

	.section--works > .works-glow {
		position: absolute;
		pointer-events: none;
		z-index: 0;
		border-radius: 50%;
		filter: blur(110px);
		opacity: 0.18;
	}

	.section--works > .works-glow--a {
		top: -120px;
		left: -120px;
		width: 420px;
		height: 420px;
		background: var(--accent);
	}

	.section--works > .works-glow--b {
		bottom: -160px;
		right: -120px;
		width: 460px;
		height: 460px;
		background: var(--accent-purple);
		opacity: 0.14;
	}

	.works-header {
		max-width: 1100px;
		margin: 0 auto 3rem;
		padding-left: 1.5rem;
		padding-right: 1.5rem;
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 2rem;
	}

	.works-header-text {
		max-width: 760px;
	}

	.works-counter {
		display: flex;
		align-items: center;
		gap: 0.85rem;
		flex-shrink: 0;
		margin-top: -0.25rem;
	}

	.works-counter-num {
		font-family: var(--font-display);
		font-size: clamp(3.5rem, 8vw, 5.5rem);
		line-height: 0.85;
		letter-spacing: -0.02em;
		color: var(--accent);
		text-shadow: 0 0 32px color-mix(in srgb, var(--accent) 35%, transparent);
	}

	.works-counter-divider {
		width: 1px;
		height: 48px;
		background: var(--border);
	}

	.works-counter-label {
		font-family: var(--font-display);
		font-size: 0.95rem;
		letter-spacing: 0.16em;
		line-height: 1.15;
		text-transform: uppercase;
		color: var(--text-muted);
	}

	.works-showcase {
		max-width: 1100px;
		margin: 0 auto;
		padding-left: 1.5rem;
		padding-right: 1.5rem;
		display: grid;
		grid-template-columns: 1.55fr 1fr;
		grid-auto-rows: 1fr;
		gap: 1rem;
		min-height: 720px;
	}

	.work-feature {
		--card-accent: var(--accent);
		position: relative;
		display: flex;
		flex-direction: column;
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		overflow: hidden;
		text-decoration: none;
		color: inherit;
		isolation: isolate;
		transition:
			transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1),
			border-color 0.3s ease,
			box-shadow 0.4s ease;
	}

	.work-feature::after {
		content: '';
		position: absolute;
		inset: 0;
		border-radius: inherit;
		padding: 1.5px;
		background: linear-gradient(135deg, var(--card-accent), transparent 55%, var(--card-accent) 100%);
		-webkit-mask:
			linear-gradient(#fff 0 0) content-box,
			linear-gradient(#fff 0 0);
		-webkit-mask-composite: xor;
		        mask-composite: exclude;
		opacity: 0;
		transition: opacity 0.4s ease;
		pointer-events: none;
		z-index: 3;
	}

	.work-feature:hover {
		transform: translateY(-4px);
		border-color: transparent;
		box-shadow: 0 28px 64px -24px color-mix(in srgb, var(--card-accent) 55%, transparent);
	}

	.work-feature:hover::after {
		opacity: 1;
	}

	.work-feature--primary {
		grid-row: 1 / span 2;
	}

	.work-feature--secondary {
		flex-direction: row;
	}

	.work-feature-media {
		position: relative;
		overflow: hidden;
		background: #1a1a22;
		flex: 1 1 auto;
		min-height: 320px;
	}

	.work-feature--primary .work-feature-media {
		min-height: 440px;
	}

	.work-feature--secondary .work-feature-media {
		flex: 0 0 45%;
		min-height: 0;
		min-width: 0;
	}

	.work-feature-media img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.7s cubic-bezier(0.2, 0.8, 0.2, 1);
	}

	.work-feature-media--contain {
		background:
			radial-gradient(ellipse 80% 100% at 50% 50%, color-mix(in srgb, var(--card-accent) 12%, transparent), transparent 65%),
			#0f0f14;
	}

	.work-feature-media--contain img {
		object-fit: contain;
		padding: 1.25rem;
	}

	.work-feature--secondary .work-feature-media--contain img {
		padding: 0.75rem;
	}

	.work-feature-media iframe {
		position: absolute;
		top: 0;
		left: 0;
		width: 1280px;
		height: 800px;
		border: none;
		pointer-events: none;
		transform-origin: top left;
		transform: scale(0.35);
	}

	.work-feature--primary .work-feature-media iframe {
		transform: scale(0.5);
	}

	.work-feature:hover .work-feature-media img {
		transform: scale(1.06);
	}

	.work-feature-num {
		position: absolute;
		top: 1rem;
		left: 1.1rem;
		z-index: 2;
		font-family: var(--font-display);
		font-size: 2.75rem;
		line-height: 0.85;
		color: var(--card-accent);
		letter-spacing: -0.02em;
		text-shadow: 0 2px 18px rgba(0, 0, 0, 0.55);
		pointer-events: none;
	}

	.work-feature--primary .work-feature-num {
		top: 1.25rem;
		left: 1.5rem;
		font-size: 4.5rem;
	}

	.work-feature-overlay {
		position: absolute;
		inset: 0;
		z-index: 2;
		display: flex;
		align-items: flex-end;
		justify-content: flex-end;
		padding: 1.25rem;
		background: linear-gradient(180deg, transparent 45%, rgba(0, 0, 0, 0.6) 100%);
		opacity: 0;
		transition: opacity 0.35s ease;
	}

	.work-feature:hover .work-feature-overlay {
		opacity: 1;
	}

	.work-feature-cta {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.55rem 1rem;
		background: var(--card-accent);
		color: #fff;
		font-family: var(--font-display);
		font-size: 0.95rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		border-radius: 999px;
		transform: translateY(10px);
		transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
		box-shadow: 0 8px 24px -8px color-mix(in srgb, var(--card-accent) 60%, transparent);
	}

	.work-feature:hover .work-feature-cta {
		transform: translateY(0);
	}

	.work-feature-cta svg {
		width: 0.95em;
		height: 0.95em;
	}

	.work-feature-body {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		padding: 1.5rem;
		border-top: 1px solid var(--border);
		background:
			linear-gradient(180deg, transparent, color-mix(in srgb, var(--card-accent) 5%, transparent));
	}

	.work-feature--secondary .work-feature-body {
		flex: 1 1 0;
		border-top: 0;
		border-left: 1px solid var(--border);
		padding: 1.25rem 1.35rem;
		gap: 0.55rem;
		justify-content: center;
	}

	.work-feature-meta {
		display: flex;
		align-items: center;
		gap: 0.65rem;
		flex-wrap: wrap;
	}

	.work-feature-tag {
		font-family: var(--font);
		font-size: 0.7rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		padding: 0.3rem 0.65rem;
		border-radius: 999px;
		background: color-mix(in srgb, var(--card-accent) 14%, transparent);
		color: var(--card-accent);
		font-weight: 600;
		border: 1px solid color-mix(in srgb, var(--card-accent) 28%, transparent);
	}

	.work-feature-host {
		font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
		font-size: 0.72rem;
		letter-spacing: 0.02em;
		color: var(--text-muted);
		opacity: 0.85;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
		max-width: 100%;
	}

	.work-feature-title {
		font-family: var(--font-display);
		font-size: 1.85rem;
		font-weight: 400;
		text-transform: uppercase;
		letter-spacing: 0.02em;
		line-height: 1;
		margin: 0;
		display: inline-block;
		width: fit-content;
		background-image: linear-gradient(90deg, var(--card-accent), var(--card-accent));
		background-position: 0 100%;
		background-repeat: no-repeat;
		background-size: 0% 2px;
		padding-bottom: 4px;
		transition: background-size 0.45s cubic-bezier(0.2, 0.8, 0.2, 1);
	}

	.work-feature--primary .work-feature-title {
		font-size: clamp(2.25rem, 3.8vw, 3rem);
	}

	.work-feature:hover .work-feature-title {
		background-size: 100% 2px;
	}

	.work-feature-desc {
		color: var(--text-muted);
		font-size: 0.95rem;
		line-height: 1.5;
		margin: 0;
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.work-feature--secondary .work-feature-desc {
		-webkit-line-clamp: 2;
		font-size: 0.9rem;
	}

	.works-cta-card {
		max-width: 1100px;
		margin: 2.5rem auto 0;
		display: grid;
		grid-template-columns: 1fr auto;
		align-items: center;
		gap: 2rem;
		padding: 2.5rem 2.75rem;
		border: 1px solid var(--border);
		border-radius: var(--radius);
		position: relative;
		overflow: hidden;
		background:
			radial-gradient(ellipse 90% 120% at 0% 0%, color-mix(in srgb, var(--accent) 10%, transparent), transparent 55%),
			radial-gradient(ellipse 90% 120% at 100% 100%, color-mix(in srgb, var(--accent-purple) 9%, transparent), transparent 55%),
			repeating-linear-gradient(
				-45deg,
				transparent,
				transparent 8px,
				rgba(255, 255, 255, 0.03) 8px,
				rgba(255, 255, 255, 0.03) 9px
			);
	}

	.works-cta-text {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.works-cta-eyebrow {
		font-family: var(--font-display);
		font-size: 0.9rem;
		letter-spacing: 0.2em;
		color: var(--accent);
		text-transform: uppercase;
	}

	.works-cta-card h4 {
		font-family: var(--font-display);
		font-size: clamp(2rem, 5vw, 3.25rem);
		font-weight: 400;
		text-transform: uppercase;
		letter-spacing: 0.02em;
		margin: 0;
		line-height: 0.95;
	}

	.works-cta-card p {
		color: var(--text-muted);
		margin: 0;
		font-size: 1rem;
		line-height: 1.5;
		max-width: 50ch;
	}

	.works-cta-btn {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		padding: 0.95rem 1.6rem;
		background: var(--text);
		color: var(--bg);
		border: 1px solid var(--text);
		border-radius: 999px;
		font-family: var(--font);
		font-size: 0.95rem;
		font-weight: 500;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		text-decoration: none;
		transition: background 0.25s ease, color 0.25s ease, transform 0.2s ease, box-shadow 0.3s ease;
		white-space: nowrap;
	}

	.works-cta-btn svg {
		width: 1em;
		height: 1em;
		transition: transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
	}

	.works-cta-btn:hover {
		background: var(--accent);
		color: #fff;
		border-color: var(--accent);
		transform: translateY(-1px);
		box-shadow: 0 12px 28px -10px color-mix(in srgb, var(--accent) 55%, transparent);
	}

	.works-cta-btn:hover svg {
		transform: translateX(3px);
	}

	/* ═══════════════════════════════════════
	   Pricing
	   ═══════════════════════════════════════ */
	.pricing-section {
		position: relative;
		z-index: 1;
		max-width: 1320px;
		margin: 0 auto;
		padding: 5rem 2rem;
	}

	.pricing-header {
		max-width: 760px;
		margin: 0 auto 3rem;
		text-align: center;
	}

	.pricing-header .section-eyebrow {
		justify-content: center;
	}

	.pricing-header .section-desc {
		margin: 0 auto;
	}

	.plan-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1.25rem;
		align-items: stretch;
	}

	.plan-card {
		--plan-color: var(--accent);
		--plan-shadow: rgba(249, 115, 22, 0.35);
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		padding: 2rem;
		transition: border-color 0.3s ease, box-shadow 0.3s ease, transform 0.3s ease;
	}

	.plan-card::before {
		content: "";
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		height: 4px;
		background: var(--plan-color);
		border-radius: var(--radius) var(--radius) 0 0;
		pointer-events: none;
	}

	.plan-card:hover {
		border-color: var(--plan-color);
		box-shadow: 0 24px 60px -16px var(--plan-shadow);
	}

	.plan-card--orange { --plan-color: var(--accent);        --plan-shadow: rgba(249, 115, 22, 0.45); }
	.plan-card--green  { --plan-color: var(--accent-green);  --plan-shadow: rgba(74, 222, 128, 0.45); }
	.plan-card--purple { --plan-color: var(--accent-purple); --plan-shadow: rgba(167, 139, 250, 0.45); }

	.plan-card--featured {
		border-color: var(--plan-color);
		box-shadow: 0 24px 60px -16px var(--plan-shadow);
	}

	.plan-badge {
		position: absolute;
		top: -14px;
		left: 50%;
		transform: translateX(-50%);
		font-family: var(--font-display);
		font-size: 0.85rem;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		background: var(--plan-color);
		color: #0b0b0f;
		padding: 0.4rem 0.9rem;
		border-radius: 999px;
		box-shadow: 0 0 0 6px var(--bg);
		white-space: nowrap;
	}

	.plan-head {
		display: flex;
		flex-direction: column;
		gap: 0.65rem;
		padding-bottom: 1.25rem;
		border-bottom: 1px solid var(--border);
	}

	.plan-name {
		font-family: var(--font-display);
		font-size: 1.15rem;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--plan-color);
		line-height: 1;
	}

	.plan-price {
		display: flex;
		align-items: baseline;
		gap: 0.35rem;
	}

	.plan-price-amount {
		font-family: var(--font-display);
		font-size: clamp(2.75rem, 5vw, 3.75rem);
		font-weight: 400;
		color: var(--text);
		letter-spacing: 0.01em;
		line-height: 1;
	}

	.plan-price-cadence {
		font-size: 1.1rem;
		font-weight: 500;
		color: var(--text-muted);
		line-height: 1;
	}

	.plan-tagline {
		font-size: 0.98rem;
		color: var(--text-muted);
		line-height: 1.55;
		margin: 0;
	}

	.plan-includes {
		font-family: var(--font-display);
		font-size: 0.95rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--text);
		margin: 0;
	}

	.plan-features {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 0.7rem;
		flex: 1;
	}

	.plan-features li {
		position: relative;
		padding-left: 1.6rem;
		font-size: 0.96rem;
		line-height: 1.45;
		color: var(--text);
	}

	.plan-features li::before {
		content: "";
		position: absolute;
		left: 0;
		top: 0.32em;
		width: 14px;
		height: 14px;
		border-radius: 50%;
		background: var(--plan-color);
		opacity: 0.18;
	}

	.plan-features li::after {
		content: "";
		position: absolute;
		left: 4px;
		top: 0.55em;
		width: 6px;
		height: 3px;
		border-left: 2px solid var(--plan-color);
		border-bottom: 2px solid var(--plan-color);
		transform: rotate(-45deg);
	}

	.plan-cta {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
		padding: 0.95rem 1.25rem;
		border-radius: var(--radius);
		background: var(--plan-color);
		color: #0b0b0f;
		font-weight: 600;
		text-decoration: none;
		font-size: 1rem;
		letter-spacing: 0.01em;
		transition: transform 0.2s ease, box-shadow 0.2s ease, opacity 0.2s ease;
		margin-top: auto;
	}

	.plan-cta:hover {
		transform: translateY(-2px);
		box-shadow: 0 12px 28px -10px var(--plan-shadow);
		opacity: 0.95;
	}

	.plan-footnote {
		text-align: center;
		color: var(--text-muted);
		margin: 2rem 0 0;
		font-size: 0.95rem;
	}

	.plan-footnote a {
		color: var(--accent);
		font-weight: 600;
		text-decoration: none;
	}

	.plan-footnote a:hover {
		text-decoration: underline;
	}

	@media (min-width: 760px) {
		.plan-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (min-width: 1024px) {
		.plan-grid {
			grid-template-columns: repeat(3, 1fr);
			gap: 1.5rem;
		}

		.plan-card--featured {
			transform: translateY(-12px);
		}

		.plan-card--featured:hover {
			transform: translateY(-16px);
		}
	}

	/* ═══════════════════════════════════════
	   Why choose me
	   ═══════════════════════════════════════ */
	.why-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
		gap: 0.5rem;
	}

	.why-card {
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		padding: 2rem 1.75rem;
		display: flex;
		flex-direction: column;
		gap: 1rem;
		transition: border-color 0.3s, transform 0.2s;
	}

	.why-card:hover {
		border-color: rgba(255, 255, 255, 0.15);
		transform: translateY(-2px);
	}

	.why-icon {
		width: 2.5rem;
		height: 2.5rem;
	}

	.why-icon svg {
		width: 100%;
		height: 100%;
	}

	.why-icon--green {
		color: var(--accent-green);
	}

	.why-icon--purple {
		color: var(--accent-purple);
	}

	.why-icon--orange {
		color: var(--accent);
	}

	.why-card h4 {
		font-family: var(--font-display);
		font-size: 1.5rem;
		font-weight: 400;
		text-transform: uppercase;
		letter-spacing: 0.02em;
		margin: 0;
	}

	.why-card p {
		color: var(--text-muted);
		font-size: 1rem;
		line-height: 1.55;
		margin: 0;
	}

	/* ═══════════════════════════════════════
	   Testimonials / Reviews
	   ═══════════════════════════════════════ */
	#testimonials.section {
		max-width: 1320px;
		padding-left: 2rem;
		padding-right: 2rem;
	}

	.testimonials-section {
		position: relative;
	}

	.testimonials-glow {
		position: absolute;
		top: -8%;
		left: 50%;
		transform: translateX(-50%);
		width: min(100%, 920px);
		height: clamp(260px, 38vw, 420px);
		background:
			radial-gradient(ellipse 55% 45% at 30% 40%, rgba(66, 133, 244, 0.16), transparent 55%),
			radial-gradient(ellipse 45% 40% at 75% 35%, rgba(234, 67, 53, 0.1), transparent 50%),
			radial-gradient(ellipse 50% 42% at 55% 70%, rgba(251, 188, 5, 0.12), transparent 55%),
			radial-gradient(ellipse 38% 35% at 15% 75%, rgba(52, 168, 83, 0.1), transparent 50%);
		filter: blur(28px);
		opacity: 0.55;
		pointer-events: none;
		z-index: 0;
	}

	.testimonials-section > .section-header,
	.testimonials-section > .reviews-grid {
		position: relative;
		z-index: 2;
	}

	.testimonials-bg {
		position: absolute;
		top: -15%;
		left: -20%;
		width: 140%;
		height: auto;
		opacity: 0;
		pointer-events: none;
		z-index: 1;
		transform: scale(0.8) rotate(-5deg);
		transition: opacity 1.2s ease, transform 1.2s ease;
	}

	.slide-in-section.is-visible .testimonials-bg {
		opacity: 0.14;
		transform: scale(1) rotate(0deg);
	}

	.reviews-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
		gap: 1.25rem;
		background: transparent;
		padding: 0;
		border-radius: 0;
		overflow: visible;
		box-shadow: none;
	}

	.review-card {
		position: relative;
		height: 100%;
		min-height: 100%;
		background:
			linear-gradient(145deg, rgba(255, 255, 255, 0.05) 0%, var(--surface) 52%, var(--surface) 100%);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		box-shadow: 0 20px 50px rgba(0, 0, 0, 0.38);
		transition: transform 0.35s ease, border-color 0.35s ease, box-shadow 0.35s ease;
	}

	.review-card::before {
		content: "";
		position: absolute;
		left: 0;
		top: 1rem;
		bottom: 1rem;
		width: 3px;
		border-radius: 99px;
		background: linear-gradient(
			180deg,
			#4285f4 0%,
