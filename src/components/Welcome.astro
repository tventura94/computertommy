	<section class="section section--alt section--works" id="recent-work">
		<div class="works-glow works-glow--a" aria-hidden="true"></div>
		<div class="works-glow works-glow--b" aria-hidden="true"></div>

		<div class="works-header">
			<div class="works-header-text">
				<span class="section-eyebrow">
					<svg class="eyebrow-icon" viewBox="0 0 120 120" fill="currentColor"><path d="M114.44 54.69H71.9l30.08-30.08a5.03 5.03 0 0 0 0-7.12 5.03 5.03 0 0 0-7.12 0L64.78 47.57V5.04c0-2.78-2.25-5.04-5.04-5.04S54.7 2.25 54.7 5.04v42.53L24.62 17.49a5.027 5.027 0 0 0-7.12 0 5.03 5.03 0 0 0 0 7.12l30.08 30.08H5.04C2.26 54.69 0 56.94 0 59.73s2.25 5.04 5.04 5.04h42.53L17.49 94.85a5.027 5.027 0 0 0 0 7.12 5.027 5.027 0 0 0 7.12 0l30.08-30.08v42.54c0 2.78 2.25 5.04 5.04 5.04s5.04-2.25 5.04-5.04V71.89l30.08 30.08a5.03 5.03 0 0 0 7.12 0 5.027 5.027 0 0 0 0-7.12L71.89 64.77h42.53c2.78 0 5.04-2.25 5.04-5.04s-2.25-5.04-5.04-5.04z"/></svg>
					Recent work.
				</span>
				<h2 class="section-title">Latest projects</h2>
				<p class="section-desc">From ultra-fast landing pages to full business sites, here's some of what I've built recently.</p>
			</div>
			<div class="works-counter" aria-hidden="true">
				<span class="works-counter-num">03</span>
				<span class="works-counter-divider"></span>
				<span class="works-counter-label">Featured<br/>projects</span>
			</div>
		</div>

		<div class="works-showcase">
			{featuredWork.map((item, idx) => {
				const accents = ['var(--accent)', 'var(--accent-pink)', 'var(--accent-purple)'];
				const variant = idx === 0 ? 'primary' : 'secondary';
				const num = String(idx + 1).padStart(2, '0');
				return (
					<a class={`work-feature work-feature--${variant}`} style={`--card-accent: ${accents[idx % accents.length]};`} href={item.url} target="_blank" rel="noopener noreferrer">
						<div class={`work-feature-media${item.previewFit === 'contain' ? ' work-feature-media--contain' : ''}`}>
							{item.previewImage ? (
								<img src={item.previewImage} alt={item.title} loading="lazy" />
							) : (
								<iframe src={item.url} title={item.title} loading="lazy" sandbox="allow-scripts allow-same-origin"></iframe>
							)}
							<span class="work-feature-num">{num}</span>
							<div class="work-feature-overlay">
								<span class="work-feature-cta">
									<span>Visit site</span>
									<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="7" y1="17" x2="17" y2="7"/><polyline points="8 7 17 7 17 16"/></svg>
								</span>
							</div>
						</div>
						<div class="work-feature-body">
							<div class="work-feature-meta">
								<span class="work-feature-tag">{item.category}</span>
								<span class="work-feature-host">{item.url.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '')}</span>
							</div>
							<h3 class="work-feature-title">{item.title}</h3>
							<p class="work-feature-desc">{item.whatTheyNeeded}</p>
						</div>
					</a>
				);
			})}
