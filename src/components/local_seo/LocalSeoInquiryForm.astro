---
interface Props {
	idPrefix?: string;
	formName?: string;
	source?: string;
	submitLabel?: string;
}

const {
	idPrefix = 'seo-inquiry',
	formName = 'growth-local-seo',
	source = 'local-seo',
	submitLabel = 'Get a price for your market',
} = Astro.props;

const fields = [
	{
		name: 'business',
		id: `${idPrefix}-business`,
		label: 'Business type and service area',
		placeholder: 'Roofing in Asheville and Buncombe County',
		type: 'text' as const,
		autocomplete: 'organization',
	},
	{
		name: 'job_value',
		id: `${idPrefix}-job-value`,
		label: 'What a typical customer or job is worth to you',
		placeholder: '$8,000 roof replacement, $90 grooming visit, etc.',
		type: 'text' as const,
	},
	{
		name: 'current_leads',
		id: `${idPrefix}-leads`,
		label: 'Roughly how many leads are you getting now?',
		placeholder: 'A handful of calls a week, or almost none from Google',
		type: 'text' as const,
	},
	{
		name: 'marketing_spend',
		id: `${idPrefix}-spend`,
		label: 'What are you currently spending on marketing?',
		placeholder: '$1,200/mo on ads, or nothing yet',
		type: 'text' as const,
	},
];
---

<form
	class="seo-inquiry-form"
	name={formName}
	method="POST"
	data-netlify="true"
	netlify-honeypot="bot-field"
	action="/thank-you/"
>
	<input type="hidden" name="form-name" value={formName} />
	<input type="hidden" name="source" value={source} />
	<p class="hp-field">
		<label>
			Do not fill this in: <input name="bot-field" type="text" tabindex="-1" autocomplete="off" />
		</label>
	</p>

	{fields.map((field) => (
		<div class="form-field">
			<label for={field.id}>{field.label}</label>
			<input
				id={field.id}
				name={field.name}
				type={field.type}
				placeholder={field.placeholder}
				autocomplete={field.autocomplete}
				required
			/>
		</div>
	))}

	<div class="form-field">
		<label for={`${idPrefix}-goal`}>Where would you want to be in six months?</label>
		<textarea
			id={`${idPrefix}-goal`}
			name="six_month_goal"
			rows="3"
			placeholder="Booked solid in my main towns, ranking in the map pack, fewer slow weeks"
			required
		></textarea>
	</div>

	<div class="form-field">
		<label for={`${idPrefix}-email`}>
			Email <span class="field-hint">so I can send the quote</span>
		</label>
		<input
			id={`${idPrefix}-email`}
			name="email"
			type="email"
			autocomplete="email"
			placeholder="you@yourbusiness.com"
			required
		/>
	</div>

	<button type="submit" class="btn-submit">
		<span>{submitLabel}</span>
		<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
			<line x1="5" y1="12" x2="19" y2="12"></line>
			<polyline points="12 5 19 12 12 19"></polyline>
		</svg>
	</button>

	<p class="form-foot">
		Prefer to talk? Call <a href="tel:5083802013">508 380 2013</a> or email
		<a href="mailto:letsbuild@computertommy.com">letsbuild@computertommy.com</a>.
	</p>
</form>

<style>
	.seo-inquiry-form {
		display: flex;
		flex-direction: column;
		gap: 1.05rem;
	}

	.hp-field {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	.form-field {
		display: flex;
		flex-direction: column;
		gap: 0.45rem;
	}

	label {
		font-size: 0.92rem;
		font-weight: 600;
		letter-spacing: 0.01em;
		color: var(--text);
	}

	.field-hint {
		font-weight: 400;
		font-size: 0.86em;
		color: var(--text-muted);
	}

	input,
	textarea {
		width: 100%;
		box-sizing: border-box;
		border: 1px solid var(--border);
		border-radius: var(--radius-sm, 10px);
		background: color-mix(in srgb, var(--bg) 78%, #fff);
		color: var(--text);
		font: inherit;
		font-size: 1rem;
		padding: 0.9rem 1rem;
		outline: none;
		transition: border-color 0.2s, box-shadow 0.2s, background 0.2s;
	}

	textarea {
		resize: vertical;
		min-height: 6.5rem;
		line-height: 1.55;
	}

	input::placeholder,
	textarea::placeholder {
		color: var(--text-muted);
		opacity: 0.72;
	}

	input:hover,
	textarea:hover {
		border-color: color-mix(in srgb, var(--text-muted) 55%, var(--border));
	}

	input:focus,
	textarea:focus {
		border-color: var(--accent);
		box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 16%, transparent);
		background: color-mix(in srgb, var(--bg) 62%, #fff);
	}

	.btn-submit {
		width: 100%;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.55rem;
		border: 0;
		border-radius: var(--radius);
		background: var(--text);
		color: var(--bg);
		font: inherit;
		font-weight: 800;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		padding: 0.95rem 1.25rem;
		cursor: pointer;
		transition: transform 0.15s, background 0.25s, color 0.25s;
	}

	.btn-submit svg {
		width: 1.05em;
		height: 1.05em;
	}

	.btn-submit:hover {
		transform: translateY(-1px);
		background: var(--accent);
		color: #fff;
	}

	.form-foot {
		margin: 0.15rem 0 0;
		font-size: 0.92rem;
		color: var(--text-muted);
		line-height: 1.55;
		text-align: center;
	}

	.form-foot a {
		color: var(--text);
		font-weight: 700;
		text-decoration: none;
	}

	.form-foot a:hover {
		color: var(--accent);
	}
</style>
