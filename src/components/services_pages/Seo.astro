---
import '@fortawesome/fontawesome-free/css/all.min.css';
import astroLogo from '../../assets/computertommylogo.svg';
import background from '../../assets/background.svg';
import Breadcrumbs from '../Breadcrumbs.astro';
import ThemeToggleButton from '../ThemeToggleButton.astro';

const pillars = [
	{
		icon: 'fa-bullseye',
		color: 'orange',
		title: 'Keyword placement',
		body: 'I look at the searches that actually drive jobs in your town and target the ones with real intent. No vanity terms. No keywords that look good in a report and bring zero calls.',
	},
	{
		icon: 'fa-link',
		color: 'pink',
		title: 'Backlink placement',
		body: 'Where you have authority gaps, where your competitors are getting links, and where local connections actually move the needle. Real signals only.',
	},
	{
		icon: 'fa-list-check',
		color: 'yellow',
		title: 'Local citations',
		body: 'Get listed everywhere it counts and clean up the listings working against you. Consistent name, address, phone, and category across the platforms Google trusts.',
	},
	{
		icon: 'fa-location-dot',
		color: 'green',
		title: 'GBP optimization',
		body: 'Your Google Business Profile gets aligned with the website, posted to regularly, and tuned for the services and areas you care about most.',
	},
];

const grid: (number | string)[][] = [
	['20+', 16, 18, 17, 8, 7, 7],
	[18, 16, 15, 11, 7, 7, 7],
	[14, 11, 5, 4, 3, 5, 6],
	[10, 7, 2, 1, 2, 2, 4],
	[13, 4, 2, 2, 2, 3, 3],
	[12, 2, 5, 3, 3, 4, 4],
];

const rankClass = (rank: number | string) => {
	if (rank === '20+' || (typeof rank === 'number' && rank > 20)) return 'none';
	const n = typeof rank === 'number' ? rank : parseInt(String(rank), 10);
	if (n <= 3) return 'top';
	if (n <= 10) return 'mid';
	return 'low';
};

const cellW = 92;
const cellH = 78;
const startX = 50;
const startY = 70;
const dotR = 26;

const plans = [
	{
		key: 'care',
		color: 'orange',
		price: '$379',
		cadence: '/mo',
		name: 'Website Care',
		tagline: 'Keep the site healthy, fast, secure, and maintained. Not a growth SEO campaign.',
		cta: 'Start Website Care',
		bullets: [
			'Hosting',
			'Website maintenance',
			'Security',
			'Technical SEO',
			'Speed / Core Web Vitals',
			'Basic on-page fixes',
			'Monthly site health report',
		],
	},
	{
		key: 'growth',
		color: 'green',
		featured: true,
		price: '$997',
		cadence: '/mo',
		name: 'Local Growth',
		tagline: 'Full local SEO campaign for most service businesses. Website plus real monthly ranking work.',
		cta: 'Start Local Growth',
		bullets: [
			'Custom website built + hosted',
			'Everything in Website Care',
			'Google Business Profile optimization',
			'70+ business listings / citations',
			'1 new SEO service / location page per month',
			'4–5 GBP posts / month',
			'Review funnel + review responses',
			'Local rank tracking',
			'Keyword / competitor research',
			'Ongoing on-page SEO',
			'Internal linking / schema',
			'Local backlink / outreach work',
			'Monthly plain-English report',
		],
	},
	{
		key: 'custom',
		color: 'purple',
		price: "Let's Chat",
		cadence: '',
		name: 'Custom Growth',
		tagline: 'For businesses in competitive markets or with more complex SEO needs.',
		cta: "Let's Talk",
		bullets: [
			'Everything in Local Growth',
			'More content and service-area pages',
			'More aggressive backlink outreach',
			'Multi-location SEO',
			'Larger keyword / rank-tracking footprint',
			'Competitive market research',
			'Custom reporting and strategy',
			'Scope built around your market',
		],
	},
];
---

<div class="themed-subpage">
	<img class="bg-blur" src={background.src} alt="" fetchpriority="high" />
	<img src="/paint-splat.png" alt="" class="paint-strikes-bg" aria-hidden="true" />
	<main class="page">
		<section class="hero section">
			<div class="hero-nav">
				<a href="/" class="logo-link">
					<img src={astroLogo.src} width="115" height="48" alt="Computer Tommy Homepage" />
				</a>
				<div class="hero-nav-end">
					<ThemeToggleButton />
					<a href="/services/" class="btn-outline btn-small" aria-label="Back to services">
						<i class="fas fa-arrow-left"></i>
						<span>Services</span>
					</a>
				</div>
			</div>

			<div class="hero-content">
				<span class="section-eyebrow">Honest local SEO</span>
				<h1 class="hero-title">Local SEO that gets you ranking on Google in 3 months.</h1>
				<p class="hero-desc">
					I look at your local competition and tell you straight up how hard it'll be to beat them. Then I go after them on every front that matters: keyword placement, backlinks, local citations, Google Business Profile, and the pages on your site.
				</p>
				<p class="hero-desc hero-desc--tight">
					This isn't rocket science. It's persistence and dedication, run by one person who actually gives a damn about your business.
				</p>
				<div class="hero-actions">
					<a href="#plans" class="btn-solid">See plans</a>
					<a href="/contact/" class="btn-outline">Free local audit</a>
				</div>
			</div>

			<div class="crumbs-wrap">
				<Breadcrumbs
					variant="dark"
					items={[{ href: '/', label: 'Home' }, { href: '/services/', label: 'Services' }]}
					current="SEO"
				/>
			</div>
		</section>

		<section class="section pillars-section" aria-labelledby="pillars-heading">
			<div class="section-header">
				<span class="section-eyebrow">How we beat your competition</span>
				<h2 class="section-title" id="pillars-heading">Honest work, on every front.</h2>
				<p class="section-lead">
					I look at exactly what your competitors are doing and figure out what it'll actually take to outrank them. Every front gets attention. Nothing's left on autopilot.
				</p>
			</div>
			<div class="pillar-grid">
				{pillars.map((p) => (
					<article class:list={['pillar-card', `pillar-card--${p.color}`]}>
						<div class="pillar-icon" aria-hidden="true">
							<i class:list={['fas', p.icon]}></i>
						</div>
						<h3 class="pillar-title">{p.title}</h3>
						<p class="pillar-body">{p.body}</p>
					</article>
				))}
			</div>
		</section>

		<section class="section section-alt islands-section" aria-labelledby="islands-heading">
			<div class="islands-layout">
				<div class="section-header islands-copy">
					<span class="section-eyebrow">How Google actually works</span>
					<h2 class="section-title" id="islands-heading">Each page is its own experiment.</h2>
					<p class="islands-lead">
						Most people think Google grades your whole site as one thing. It doesn't. Google grades pages, and each page stands on its own. That's exactly why building the site right from the start matters so much. A clean foundation gives every page a real shot at ranking for what it needs to rank for.
					</p>
					<p class="islands-lead islands-lead--tight">
						So we treat every page like a little experiment. Target real local keywords, structure the page right, see what sticks. Once we know what's actually ranking, we double down. Those wins map out the next pages, the next keywords, and the next service areas. That's how we go from ranking for a few things to dominating locally.
					</p>
				</div>
				<div class="islands-visual" aria-hidden="true">
					<div class="island-card island-card--1">
						<span class="island-tag">Page 1</span>
						<span class="island-rank">Rank 2</span>
					</div>
					<div class="island-card island-card--2">
						<span class="island-tag">Page 2</span>
						<span class="island-rank">Rank 1</span>
					</div>
					<div class="island-card island-card--3">
						<span class="island-tag">Page 3</span>
						<span class="island-rank">Rank 4</span>
					</div>
					<div class="island-card island-card--4">
						<span class="island-tag">Page 4</span>
						<span class="island-rank">Rank 3</span>
					</div>
				</div>
			</div>
		</section>

		<section class="section connections-section" aria-labelledby="connections-heading">
			<div class="section-header">
				<span class="section-eyebrow">Backlinks that mean something</span>
				<h2 class="section-title" id="connections-heading">Real connections, not random links.</h2>
				<p class="section-lead">
					I don't go chase a hundred junk links. I go after links that actually matter and form real connections in your local market. Real businesses. Real authority. Real signals Google can trust.
				</p>
			</div>
			<div class="connections-grid">
				<article class="connection-card">
					<div class="connection-icon" aria-hidden="true">
						<i class="fas fa-handshake"></i>
					</div>
					<h3>Local relationships, not link farms</h3>
					<p>The backlinks I build come from real places: chambers, partner businesses, local press, trade orgs, suppliers. The kind of mentions Google trusts.</p>
				</article>
				<article class="connection-card">
					<div class="connection-icon" aria-hidden="true">
						<i class="fas fa-lightbulb"></i>
					</div>
					<h3>Local opportunities, surfaced for you</h3>
					<p>You're not just paying for SEO. When I find local business opportunities, partnerships, or events that fit your shop, I pass them along. Online wins plus word-of-mouth wins.</p>
				</article>
				<article class="connection-card">
					<div class="connection-icon" aria-hidden="true">
						<i class="fas fa-clock"></i>
					</div>
					<h3>Time back to your busy life</h3>
					<p>You hire someone you trust to handle this so you can stop fiddling with it at 9pm. I run the work. You get a clean update each month.</p>
				</article>
			</div>
		</section>

		<section class="section local-presence-section" aria-labelledby="local-presence-heading">
			<div class="presence-shell">
				<div class="presence-backdrop" aria-hidden="true"></div>
				<div class="presence-noise" aria-hidden="true"></div>
				<div class="presence-inner">
					<header class="presence-header">
						<div class="presence-header-row">
							<span class="presence-eyebrow">Reputation & listings</span>
							<ul class="presence-pills">
								<li class="presence-pill">70+ directories</li>
								<li class="presence-pill">5+ GBP posts / mo</li>
								<li class="presence-pill">Monthly review outreach</li>
							</ul>
						</div>
						<h2 class="presence-title" id="local-presence-heading">
							<span class="presence-title-line">Beyond your website.</span>
	
							<span class="presence-title-line presence-title-line--accent">
								On every signal Google actually reads.
							</span>
						</h2>
						<p class="presence-lead">
							Pages and backlinks matter. So does the rest of the picture: your Google Business Profile, fresh reviews, clean citations, and how you show up when someone searches your trade in your town. This block is the monthly machine behind that side of the work.
						</p>
					</header>

					<div class="presence-bento">
						<article class="presence-tile presence-tile--funnel">
							<span class="presence-idx" aria-hidden="true">01</span>
							<div class="presence-tile-head">
								<div class="presence-icon-wrap">
									<i class="fas fa-paper-plane" aria-hidden="true"></i>
								</div>
								<h3>Monthly review funnel</h3>
							</div>
							<p class="presence-tile-body">
								You hand us customer emails and phone numbers. Every month we run respectful outreach so more happy jobs turn into Google reviews, while you stay focused on the work, not the follow-ups.
							</p>
						</article>

						<article class="presence-tile presence-tile--posts">
							<span class="presence-idx" aria-hidden="true">02</span>
							<div class="presence-tile-head">
								<div class="presence-icon-wrap">
									<i class="fas fa-store" aria-hidden="true"></i>
								</div>
								<h3>Google Business posts</h3>
							</div>
							<p class="presence-tile-body">
								Five or more posts a month on your Profile: recent work, finished jobs, and photos that prove what you deliver before they even hit your site.
							</p>
						</article>

						<article class="presence-tile presence-tile--replies">
							<span class="presence-idx" aria-hidden="true">03</span>
							<div class="presence-tile-head">
								<div class="presence-icon-wrap">
									<i class="fas fa-comments" aria-hidden="true"></i>
								</div>
								<h3>Review responses</h3>
							</div>
							<p class="presence-tile-body">
								We answer new reviews for you, good or rough, in a steady voice that matches your shop so your Profile never looks abandoned.
							</p>
						</article>

						<article class="presence-tile presence-tile--dirs">
							<span class="presence-idx" aria-hidden="true">04</span>
							<div class="presence-tile-head presence-tile-head--inline">
								<div class="presence-icon-wrap">
									<i class="fas fa-map-location-dot" aria-hidden="true"></i>
								</div>
								<div>
									<h3>70+ directories &amp; local citations</h3>
									<p class="presence-tile-tag">Same NAP. Same categories. Everywhere that counts.</p>
								</div>
							</div>
							<p class="presence-tile-body">
								Listings on fifty or more trusted directories, cleaned and aligned so Google sees one consistent story: who you are, what you do, and where you show up.
							</p>
						</article>

						<article class="presence-tile presence-tile--scout">
							<span class="presence-idx" aria-hidden="true">05</span>
							<div class="presence-scout-grid">
								<div>
									<div class="presence-tile-head">
										<div class="presence-icon-wrap">
											<i class="fas fa-magnifying-glass-location" aria-hidden="true"></i>
										</div>
										<h3>Local opportunity scouting</h3>
									</div>
									<p class="presence-tile-body presence-tile-body--flush">
										We keep scanning your market for new angles: neighborhoods to own, services to push, seasonal spikes, and partnerships that fit your trade, then we bring the ideas straight to you.
									</p>
								</div>
								<div class="presence-scout-visual" aria-hidden="true">
									<span class="presence-ring"></span>
									<span class="presence-ring presence-ring--delay"></span>
									<span class="presence-dot"></span>
								</div>
							</div>
						</article>
					</div>
				</div>
			</div>
		</section>

		<section class="section section-alt geogrid-section" aria-labelledby="geogrid-heading">
			<div class="geogrid-layout">
				<div class="geogrid-copy">
					<span class="section-eyebrow">Where you actually rank</span>
					<h2 class="section-title" id="geogrid-heading">Every square mile, accounted for.</h2>
					<p class="section-lead">
						I can pull a street-level view of your local search area and tell you exactly where you're ranking, square mile by square mile. No guessing. No "you're up a little." Real numbers, real positions, real coverage.
					</p>
					<p class="section-lead section-lead--tight">
						You see what's working, where you're winning, and where there's room to grow. That's how we decide where to push next.
					</p>
				</div>
				<figure class="geogrid-figure">
					<div class="geogrid-frame">
						<svg
							class="geogrid"
							viewBox="0 0 700 540"
							role="img"
							aria-label="Local search rank grid showing positions across a service area"
						>
							<defs>
								<filter id="dotShadow" x="-50%" y="-50%" width="200%" height="200%">
									<feDropShadow dx="0" dy="2" stdDeviation="2.5" flood-opacity="0.28" />
								</filter>
							</defs>

							{/* Map base */}
							<rect width="700" height="540" class="map-base" />

							{/* Park / forest patches */}
							<path class="map-park" d="M -10 -10 L 250 -10 Q 240 70 180 100 Q 110 120 50 105 Q -5 90 -10 50 Z" />
							<path class="map-park" d="M 540 -10 L 720 -10 L 720 60 Q 660 80 600 70 Q 555 50 540 -10 Z" />
							<path class="map-park" d="M -10 280 Q 60 265 130 295 Q 110 370 60 385 Q -10 370 -10 320 Z" />
							<path class="map-park" d="M 200 470 Q 360 440 500 480 Q 480 540 320 545 Q 200 530 200 470 Z" opacity="0.85" />
							<path class="map-park" d="M 380 30 Q 460 50 480 110 Q 430 150 380 130 Q 340 100 380 30 Z" opacity="0.7" />

							{/* Water (river/lake on right) */}
							<path class="map-water" d="M 720 60 Q 640 130 660 220 Q 720 290 700 360 Q 720 460 720 540 L 720 60 Z" />
							<ellipse class="map-water" cx="650" cy="290" rx="42" ry="56" />
							<path class="map-water" d="M 0 380 Q 80 360 130 395 Q 100 430 50 425 Q 0 415 0 380 Z" opacity="0.85" />

							{/* Roads - draw shoulder beneath the white surface */}
							<g class="map-roads">
								<path class="road-shoulder" d="M -10 235 Q 180 215 350 245 Q 520 280 720 235" />
								<path class="road-surface" d="M -10 235 Q 180 215 350 245 Q 520 280 720 235" />
								<path class="road-shoulder" d="M 90 -10 Q 200 130 320 250 Q 440 360 580 540" />
								<path class="road-surface" d="M 90 -10 Q 200 130 320 250 Q 440 360 580 540" />
								<path class="road-shoulder road-shoulder--small" d="M -10 470 Q 200 440 400 470 Q 560 490 720 460" />
								<path class="road-surface road-surface--small" d="M -10 470 Q 200 440 400 470 Q 560 490 720 460" />
							</g>

							{/* Town labels */}
							<g class="map-labels">
								<text x="190" y="36">Weaverville</text>
								<text x="350" y="200">Asheville</text>
								<text x="600" y="180">Black Mountain</text>
								<text x="120" y="455">Arden</text>
								<text x="430" y="460">Fairview</text>
							</g>

							{/* Rank pins */}
							<g class="rank-dots" filter="url(#dotShadow)">
								{grid.flatMap((row, ri) =>
									row.map((rank, ci) => {
										const cx = startX + ci * cellW;
										const cy = startY + ri * cellH;
										const cls = rankClass(rank);
										const delay = (ri + ci) * 0.035;
										return (
											<g
												class:list={['rank-dot', `rank-dot--${cls}`]}
												style={`--cell-delay: ${delay}s; --cell-cx: ${cx}px; --cell-cy: ${cy}px;`}
											>
												<circle class="rank-dot__circle" cx={cx} cy={cy} r={dotR} />
												<text class="rank-dot__num" x={cx} y={cy + 1}>{rank}</text>
											</g>
										);
									})
								)}
							</g>
						</svg>
					</div>
					<figcaption class="geogrid-legend" aria-hidden="true">
						<span class="legend-item legend-item--top"><span class="legend-dot"></span>Top 3</span>
						<span class="legend-item legend-item--mid"><span class="legend-dot"></span>4 to 10</span>
						<span class="legend-item legend-item--low"><span class="legend-dot"></span>11 to 20</span>
						<span class="legend-item legend-item--none"><span class="legend-dot"></span>Not ranking</span>
					</figcaption>
				</figure>
			</div>
		</section>

		<section class="section plans-section" id="plans" aria-labelledby="plans-heading">
			<div class="section-header plans-header">
				<span class="section-eyebrow">Monthly plans</span>
				<h2 class="section-title" id="plans-heading">Pick your tier.</h2>
				<p class="section-lead">
					Website Care keeps the site healthy. Local Growth runs the full monthly campaign. Custom Growth is scoped for tougher markets.
				</p>
			</div>
			<div class="plan-grid">
				{plans.map((plan) => (
					<article class:list={['plan-card', `plan-card--${plan.color}`, plan.featured && 'plan-card--featured']}>
						{plan.featured && <span class="plan-badge">Most popular</span>}
						<header class="plan-head">
							<span class="plan-name">{plan.name}</span>
							<div class="plan-price">
								<span class:list={['plan-price-amount', !plan.cadence && 'plan-price-amount--text']}>{plan.price}</span>
								{plan.cadence && <span class="plan-price-cadence">{plan.cadence}</span>}
							</div>
							<p class="plan-tagline">{plan.tagline}</p>
						</header>
						<ul class="plan-features">
							{plan.bullets.map((b) => (
								<li>{b}</li>
							))}
						</ul>
						<a href={`/contact/?plan=${plan.key}`} class="plan-cta">{plan.cta} &rarr;</a>
					</article>
				))}
			</div>
			<p class="plans-foot">
				Not sure which fits? <a href="/contact/">Send a quick message</a> and I'll point you to the right one based on your market.
			</p>
		</section>

		<section class="section cta-section">
			<div class="cta-inner">
				<h2>Ready to start ranking in 3 months?</h2>
				<p class="cta-lead">
					I'll review your market, your competitors, your site, and your Google Business Profile. Then I'll show you a real path to rankings that turn into calls.
				</p>
				<a href="/contact/" class="btn-solid">Request a free local audit</a>
			</div>
		</section>
	</main>
</div>

<style>
	.bg-blur {
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		z-index: 0;
		filter: blur(120px);
		opacity: 0.16;
		pointer-events: none;
	}

	.paint-strikes-bg {
		position: fixed;
		left: 38%;
		top: 8%;
		width: min(230vw, 2400px);
		height: auto;
		max-width: none;
		z-index: 0;
		pointer-events: none;
		opacity: 0.18;
		mix-blend-mode: lighten;
		transform: translateX(-50%) rotate(-3deg);
	}

	.hero-nav-end {
		display: flex;
		align-items: center;
		gap: 0.65rem;
	}

	.page {
		position: relative;
		z-index: 1;
	}

	.section {
		max-width: 1200px;
		margin: 0 auto;
		padding: 4rem 1.5rem;
	}

	.section-alt {
		max-width: none;
		background: var(--surface);
	}

	.section-alt > * {
		max-width: 1200px;
		margin-left: auto;
		margin-right: auto;
	}

	.hero {
		padding-top: 2rem;
	}

	.hero-nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 2rem;
	}

	.logo-link {
		display: inline-flex;
		opacity: 0.92;
		text-decoration: none;
	}

	.logo-link:hover {
		opacity: 1;
	}

	.hero-content {
		max-width: 900px;
	}

	.section-eyebrow {
		display: inline-block;
		font-family: var(--font-display);
		font-size: 1.2rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--text-muted);
		margin-bottom: 0.5rem;
	}

	.hero-title,
	.section-title {
		font-family: var(--font-display);
		font-weight: 400;
		text-transform: uppercase;
		letter-spacing: 0.02em;
		margin: 0;
		word-wrap: break-word;
		overflow-wrap: break-word;
	}

	.hero-title {
		font-size: clamp(2.4rem, 8vw, 5.5rem);
		line-height: 0.95;
	}

	.section-title {
		font-size: clamp(2rem, 6vw, 4rem);
		line-height: 1;
	}

	.section-lead {
		color: var(--text-muted);
		font-size: clamp(1rem, 1.8vw, 1.2rem);
		line-height: 1.6;
		max-width: 720px;
		margin: 0.85rem 0 0;
	}

	.section-lead--tight {
		margin-top: 0.6rem;
	}

	.hero-desc {
		color: var(--text-muted);
		font-size: clamp(1rem, 2vw, 1.3rem);
		line-height: 1.55;
		max-width: 700px;
		margin: 1rem 0 1.5rem;
	}

	.hero-desc--tight {
		margin-top: -0.35rem;
	}

	.section-header {
		max-width: 760px;
		margin-bottom: 2.5rem;
	}

	.btn-solid,
	.btn-outline {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.55rem;
		padding: 0.78rem 1.6rem;
		border-radius: var(--radius);
		text-decoration: none;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.03em;
		font-size: 0.9rem;
		transition: background 0.25s, color 0.25s, border-color 0.25s, transform 0.15s;
	}

	.btn-solid {
		background: var(--text);
		color: var(--bg);
		border: 1px solid var(--text);
	}

	.btn-solid:hover {
		background: transparent;
		color: var(--text);
		transform: translateY(-1px);
	}

	.btn-outline {
		background: transparent;
		color: var(--text);
		border: 1px solid var(--border);
	}

	.btn-outline:hover {
		background: var(--text);
		color: var(--bg);
		border-color: var(--text);
		transform: translateY(-1px);
	}

	.btn-small {
		padding: 0.6rem 1rem;
		font-size: 0.86rem;
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}

	.crumbs-wrap {
		margin-top: 1.2rem;
		padding-top: 1rem;
		border-top: 1px solid var(--border);
	}

	/* ─────────────  Pillars (How we beat your competition)  ───────────── */
	.pillar-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
		gap: 1rem;
	}

	.pillar-card {
		--pillar-color: var(--accent);
		position: relative;
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		padding: 1.5rem 1.4rem 1.6rem;
		display: flex;
		flex-direction: column;
		gap: 0.85rem;
		overflow: hidden;
		transition: border-color 0.25s ease, transform 0.2s ease, box-shadow 0.25s ease;
	}

	.pillar-card::before {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		height: 3px;
		background: var(--pillar-color);
	}

	.pillar-card:hover {
		transform: translateY(-3px);
		border-color: var(--pillar-color);
		box-shadow: 0 18px 40px -18px rgba(0, 0, 0, 0.35);
	}

	.pillar-card--orange { --pillar-color: var(--accent); }
	.pillar-card--pink   { --pillar-color: var(--accent-pink); }
	.pillar-card--yellow { --pillar-color: var(--accent-yellow); }
	.pillar-card--green  { --pillar-color: var(--accent-green); }

	.pillar-icon {
		width: 48px;
		height: 48px;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		border-radius: 50%;
		border: 1.5px solid var(--pillar-color);
		color: var(--pillar-color);
		font-size: 1.2rem;
	}

	.pillar-title {
		font-family: var(--font-display);
		font-weight: 400;
		text-transform: uppercase;
		letter-spacing: 0.02em;
		font-size: 1.55rem;
		margin: 0;
		line-height: 1;
		color: var(--text);
	}

	.pillar-body {
		margin: 0;
		color: var(--text-muted);
		line-height: 1.55;
		font-size: 0.98rem;
	}

	/* ─────────────  Page islands  ───────────── */
	.islands-layout {
		display: grid;
		grid-template-columns: 1fr;
		gap: 2.5rem;
		align-items: center;
	}

	@media (min-width: 920px) {
		.islands-layout {
			grid-template-columns: 1.05fr 1fr;
		}
	}

	.islands-copy {
		margin-bottom: 0;
	}

	.islands-lead {
		color: var(--text-muted);
		font-size: clamp(1rem, 1.6vw, 1.15rem);
		line-height: 1.65;
		margin: 1rem 0 0;
		max-width: 600px;
	}

	.islands-lead--tight {
		margin-top: 0.85rem;
	}

	.islands-visual {
		position: relative;
		min-height: 360px;
		border-radius: var(--radius);
	}

	.island-card {
		position: absolute;
		background: var(--bg);
		border: 1px solid var(--border);
		border-radius: var(--radius-sm);
		padding: 0.9rem 1rem;
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		min-width: 130px;
		box-shadow: 0 14px 30px -14px rgba(0, 0, 0, 0.35);
		animation: island-bob 6s ease-in-out infinite;
	}

	.island-card::before {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		height: 3px;
		border-radius: var(--radius-sm) var(--radius-sm) 0 0;
		background: var(--isle-color);
	}

	.island-card--1 { top: 4%;  left: 4%;  --isle-color: var(--accent); animation-delay: 0s; transform: rotate(-3deg); }
	.island-card--2 { top: 8%;  right: 6%; --isle-color: var(--accent-green); animation-delay: -1.4s; transform: rotate(2.5deg); }
	.island-card--3 { bottom: 6%; left: 10%; --isle-color: var(--accent-yellow); animation-delay: -2.8s; transform: rotate(-2deg); }
	.island-card--4 { bottom: 4%; right: 4%; --isle-color: var(--accent-purple); animation-delay: -4.2s; transform: rotate(3deg); }

	@keyframes island-bob {
		0%, 100% { transform: translateY(0) rotate(var(--bob-rot, 0deg)); }
		50%       { transform: translateY(-10px) rotate(var(--bob-rot, 0deg)); }
	}

	.island-card--1 { --bob-rot: -3deg; }
	.island-card--2 { --bob-rot: 2.5deg; }
	.island-card--3 { --bob-rot: -2deg; }
	.island-card--4 { --bob-rot: 3deg; }

	.island-tag {
		font-family: var(--font-display);
		font-size: 0.95rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--isle-color);
	}

	.island-rank {
		font-size: 0.85rem;
		color: var(--text);
		font-weight: 600;
	}

	@media (prefers-reduced-motion: reduce) {
		.island-card {
			animation: none !important;
		}
	}

	/* ─────────────  Connections  ───────────── */
	.connections-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
		gap: 1rem;
	}

	.connection-card {
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		padding: 1.65rem 1.4rem;
		display: flex;
		flex-direction: column;
		gap: 0.85rem;
		transition: border-color 0.25s ease, transform 0.2s ease;
	}

	.connection-card:hover {
		transform: translateY(-3px);
		border-color: var(--accent);
	}

	.connection-icon {
		width: 44px;
		height: 44px;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		border-radius: 50%;
		background: var(--bg);
		border: 1.5px solid var(--accent);
		color: var(--accent);
		font-size: 1.1rem;
	}

	.connection-card h3 {
		font-family: var(--font-display);
		font-weight: 400;
		text-transform: uppercase;
		letter-spacing: 0.02em;
		font-size: 1.4rem;
		margin: 0;
		line-height: 1.05;
	}

	.connection-card p {
		margin: 0;
		color: var(--text-muted);
		line-height: 1.55;
		font-size: 0.98rem;
	}

	/* ─────────────  Local presence (GBP / reputation bento)  ───────────── */
	.local-presence-section {
		position: relative;
		padding-top: 4.5rem;
		padding-bottom: 4.5rem;
	}

	.presence-shell {
		position: relative;
		overflow: hidden;
		border-radius: calc(var(--radius) + 14px);
		padding: clamp(1.35rem, 3.2vw, 2.85rem);
		background:
			linear-gradient(165deg, rgba(255, 255, 255, 0.03), transparent 55%),
			linear-gradient(var(--surface), var(--surface)) padding-box,
			linear-gradient(
				118deg,
				color-mix(in srgb, var(--accent) 82%, transparent),
				color-mix(in srgb, var(--accent-pink) 75%, transparent),
				color-mix(in srgb, var(--accent-purple) 70%, transparent),
				color-mix(in srgb, var(--accent-green) 78%, transparent),
				color-mix(in srgb, var(--accent-yellow) 72%, transparent)
			)
			border-box;
		border: 1.5px solid transparent;
		box-shadow:
			0 0 0 1px rgba(255, 255, 255, 0.05) inset,
			0 44px 120px -52px rgba(0, 0, 0, 0.72);
	}

	.presence-backdrop {
		position: absolute;
		inset: -42% -28%;
		z-index: 0;
		pointer-events: none;
		opacity: 0.62;
	}

	.presence-backdrop::before {
		content: '';
		position: absolute;
		inset: 0;
		background: conic-gradient(
			from 210deg at 50% 48%,
			transparent 0deg,
			color-mix(in srgb, var(--accent) 22%, transparent) 55deg,
			transparent 115deg,
			color-mix(in srgb, var(--accent-purple) 20%, transparent) 185deg,
			transparent 245deg,
			color-mix(in srgb, var(--accent-green) 18%, transparent) 305deg,
			transparent 360deg
		);
		animation: presence-orbit 28s linear infinite;
	}

	.presence-noise {
		position: absolute;
		inset: 0;
		z-index: 1;
		pointer-events: none;
		opacity: 0.09;
		mix-blend-mode: overlay;
		background-image: radial-gradient(rgba(255, 255, 255, 0.11) 0.6px, transparent 0.7px);
		background-size: 3px 3px;
	}

	.presence-inner {
		position: relative;
		z-index: 2;
	}

	.presence-header {
		margin-bottom: clamp(1.75rem, 4vw, 2.75rem);
	}

	.presence-header-row {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 1rem 1.5rem;
	}

	.presence-eyebrow {
		display: inline-block;
		font-family: var(--font-display);
		font-size: 1.15rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--text-muted);
	}

	.presence-pills {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		justify-content: flex-end;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	@media (max-width: 560px) {
		.presence-pills {
			justify-content: flex-start;
		}
	}

	.presence-pill {
		font-family: var(--font-display);
		font-size: 0.92rem;
		letter-spacing: 0.07em;
		text-transform: uppercase;
		padding: 0.42rem 0.88rem;
		border-radius: 999px;
		border: 1px solid rgba(255, 255, 255, 0.12);
		background: rgba(0, 0, 0, 0.22);
		color: rgba(255, 255, 255, 0.82);
	}

	.presence-title {
		font-family: var(--font-display);
		font-weight: 400;
		text-transform: uppercase;
		letter-spacing: 0.02em;
		margin: 1.1rem 0 0;
		line-height: 0.96;
		font-size: clamp(2.15rem, 6.5vw, 4.75rem);
		display: flex;
		flex-direction: column;
		gap: 0.02em;
		max-width: 1000px;
	}

	.presence-title-line--accent {
		background: linear-gradient(
			92deg,
			var(--accent) 0%,
			var(--accent-pink) 34%,
			var(--accent-green) 68%,
			var(--accent-yellow) 100%
		);
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
	}

	.presence-lead {
		margin: 1.1rem 0 0;
		max-width: 46rem;
		color: var(--text-muted);
		font-size: clamp(1rem, 1.75vw, 1.18rem);
		line-height: 1.65;
	}

	.presence-bento {
		display: grid;
		gap: 1rem;
		grid-template-columns: 1fr;
	}

	.presence-tile {
		--tile-accent: var(--accent);
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 0.95rem;
		overflow: hidden;
		border-radius: calc(var(--radius) + 2px);
		padding: 1.45rem 1.3rem 1.5rem;
		background:
			linear-gradient(155deg, color-mix(in srgb, var(--tile-accent) 12%, transparent), transparent 48%),
			color-mix(in srgb, var(--surface) 94%, var(--bg));
		border: 1px solid rgba(255, 255, 255, 0.09);
		transition:
			transform 0.32s cubic-bezier(0.22, 1, 0.36, 1),
			border-color 0.32s ease,
			box-shadow 0.32s ease;
		animation: presence-rise 0.78s cubic-bezier(0.22, 1, 0.36, 1) both;
	}

	.presence-tile::before {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		height: 3px;
		background: linear-gradient(90deg, var(--tile-accent), color-mix(in srgb, var(--tile-accent) 15%, transparent));
		opacity: 0.95;
	}

	.presence-tile:hover {
		transform: translateY(-5px);
		border-color: color-mix(in srgb, var(--tile-accent) 48%, rgba(255, 255, 255, 0.12));
		box-shadow:
			0 26px 60px -28px rgba(0, 0, 0, 0.75),
			0 0 0 1px color-mix(in srgb, var(--tile-accent) 26%, transparent),
			0 0 48px -16px color-mix(in srgb, var(--tile-accent) 35%, transparent);
	}

	.presence-tile--funnel {
		--tile-accent: var(--accent-pink);
		animation-delay: 0.04s;
	}

	.presence-tile--posts {
		--tile-accent: var(--accent);
		animation-delay: 0.1s;
	}

	.presence-tile--replies {
		--tile-accent: var(--accent-purple);
		animation-delay: 0.16s;
	}

	.presence-tile--dirs {
		--tile-accent: var(--accent-green);
		animation-delay: 0.22s;
	}

	.presence-tile--scout {
		--tile-accent: var(--accent-yellow);
		animation-delay: 0.28s;
	}

	.presence-idx {
		position: absolute;
		top: 0.2rem;
		right: 0.65rem;
		font-family: var(--font-display);
		font-size: clamp(3.2rem, 9vw, 5rem);
		line-height: 0.88;
		letter-spacing: 0.03em;
		color: transparent;
		-webkit-text-stroke: 1px rgba(255, 255, 255, 0.16);
		opacity: 0.5;
		pointer-events: none;
	}

	.presence-tile-head {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.85rem;
		padding-right: clamp(3rem, 12vw, 5rem);
	}

	.presence-tile-head--inline {
		flex-direction: row;
		align-items: flex-start;
		gap: 1rem;
	}

	.presence-tile-head--inline > div:last-child {
		min-width: 0;
	}

	.presence-icon-wrap {
		width: 52px;
		height: 52px;
		flex-shrink: 0;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		border-radius: 14px;
		background: color-mix(in srgb, var(--tile-accent) 16%, var(--bg));
		border: 1px solid color-mix(in srgb, var(--tile-accent) 45%, transparent);
		color: var(--tile-accent);
		font-size: 1.22rem;
		box-shadow:
			0 0 32px color-mix(in srgb, var(--tile-accent) 32%, transparent),
			inset 0 1px 0 rgba(255, 255, 255, 0.07);
	}

	.presence-tile h3 {
		font-family: var(--font-display);
		font-weight: 400;
		text-transform: uppercase;
		letter-spacing: 0.03em;
		font-size: clamp(1.35rem, 2.8vw, 1.75rem);
		line-height: 1;
		margin: 0;
		color: var(--text);
	}

	.presence-tile-tag {
		margin: 0.35rem 0 0;
		font-size: 0.82rem;
		line-height: 1.45;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		font-weight: 600;
		color: color-mix(in srgb, var(--tile-accent) 70%, var(--text-muted));
	}

	.presence-tile-body {
		margin: 0;
		color: var(--text-muted);
		font-size: 0.98rem;
		line-height: 1.58;
	}

	.presence-tile-body--flush {
		margin-top: 0.15rem;
	}

	.presence-scout-grid {
		display: grid;
		gap: 1.5rem;
		align-items: center;
	}

	.presence-scout-visual {
		position: relative;
		width: min(200px, 100%);
		aspect-ratio: 1;
		margin: 0 auto;
	}

	.presence-ring {
		position: absolute;
		inset: 6%;
		border-radius: 50%;
		border: 1px dashed color-mix(in srgb, var(--tile-accent) 55%, transparent);
		animation: presence-pulse 5.2s ease-in-out infinite;
	}

	.presence-ring--delay {
		inset: 24%;
		animation-delay: -2.6s;
	}

	.presence-dot {
		position: absolute;
		inset: 0;
		width: 18px;
		height: 18px;
		margin: auto;
		border-radius: 50%;
		background: var(--tile-accent);
		box-shadow:
			0 0 0 6px color-mix(in srgb, var(--tile-accent) 22%, transparent),
			0 0 36px color-mix(in srgb, var(--tile-accent) 55%, transparent);
		animation: presence-glow 3.4s ease-in-out infinite;
	}

	@keyframes presence-orbit {
		to {
			transform: rotate(1turn);
		}
	}

	@keyframes presence-rise {
		from {
			opacity: 0;
			transform: translateY(26px) scale(0.97);
		}
		to {
			opacity: 1;
			transform: translateY(0) scale(1);
		}
	}

	@keyframes presence-pulse {
		0%,
		100% {
			transform: scale(1) rotate(0deg);
			opacity: 0.45;
		}
		50% {
			transform: scale(1.07) rotate(6deg);
			opacity: 0.95;
		}
	}

	@keyframes presence-glow {
		0%,
		100% {
			transform: scale(1);
			opacity: 1;
		}
		50% {
			transform: scale(1.14);
			opacity: 0.78;
		}
	}

	@media (min-width: 700px) and (max-width: 899px) {
		.presence-bento {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			grid-template-areas:
				'funnel funnel'
				'posts resp'
				'dirs dirs'
				'scout scout';
		}

		.presence-tile--funnel {
			grid-area: funnel;
		}

		.presence-tile--posts {
			grid-area: posts;
		}

		.presence-tile--replies {
			grid-area: resp;
		}

		.presence-tile--dirs {
			grid-area: dirs;
		}

		.presence-tile--scout {
			grid-area: scout;
		}
	}

	@media (min-width: 900px) {
		.presence-bento {
			grid-template-columns: repeat(4, minmax(0, 1fr));
			grid-template-rows: auto auto auto;
			grid-template-areas:
				'funnel funnel posts resp'
				'funnel funnel dirs dirs'
				'scout scout scout scout';
		}

		.presence-tile--funnel {
			grid-area: funnel;
			min-height: 100%;
		}

		.presence-tile--posts {
			grid-area: posts;
		}

		.presence-tile--replies {
			grid-area: resp;
		}

		.presence-tile--dirs {
			grid-area: dirs;
		}

		.presence-tile--scout {
			grid-area: scout;
		}

		.presence-scout-grid {
			grid-template-columns: 1fr minmax(140px, 18%);
			gap: 2rem;
		}

		.presence-scout-visual {
			margin: 0;
			width: 100%;
			max-width: none;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.presence-backdrop::before,
		.presence-ring,
		.presence-dot {
			animation: none !important;
		}

		.presence-tile {
			animation: none !important;
			opacity: 1;
		}
	}

	/* ─────────────  Geogrid map  ───────────── */
	.geogrid-layout {
		display: grid;
		grid-template-columns: 1fr;
		gap: 2.5rem;
		align-items: center;
	}

	@media (min-width: 920px) {
		.geogrid-layout {
			grid-template-columns: 1fr 1fr;
		}
	}

	.geogrid-figure {
		margin: 0;
		display: flex;
		flex-direction: column;
		align-items: stretch;
		gap: 1rem;
