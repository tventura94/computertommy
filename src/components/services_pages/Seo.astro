---
import '@fortawesome/fontawesome-free/css/all.min.css';
import astroLogo from '../../assets/computertommylogo.svg';
import background from '../../assets/background.svg';
import Breadcrumbs from '../Breadcrumbs.astro';
import ThemeToggleButton from '../ThemeToggleButton.astro';

type SeoServiceEntry = {
	slug: string;
	data: {
		h1?: string;
		heroSubtitle?: string;
	};
};

const { getCollection } = await import('astro:content');
const seoServices = (
	await (getCollection as unknown as (collection: string) => Promise<SeoServiceEntry[]>)('seo_services')
)
	.slice()
	.sort((a, b) => (a.data.h1 ?? a.slug).localeCompare(b.data.h1 ?? b.slug));

const slugIcon: Record<string, string> = {
	'technical-seo-audit': 'fa-search',
	'onpage-cleanup': 'fa-tags',
	'local-seo': 'fa-map-marker-alt',
	'speed-web-vitals': 'fa-tachometer-alt',
};

const seoCards = seoServices.map((s) => ({
	...s,
	icon: slugIcon[s.slug] ?? 'fa-file-lines',
}));

const whoFit = [
	'Local service providers who want the phone to ring and the quote form to fill, not another vague "visibility" report',
	'Owners who know competitors are showing up for the same jobs and want a clear picture of who ranks, why, and where the gaps are',
	'Teams ready to invest in the long game: steady on-page work, listings that match the site, and tracking that ties back to calls and submissions',
];

const needList = [
	'A keyword map tied to services and towns you actually want to work, not random traffic',
	'A competitor pass on the SERPs you care about: who owns the top spots, what their pages do, and what it would take to compete',
	'Pages and a Google Business Profile that tell the same story so nearby searches turn into calls or form fills',
	'Call and form tracking so I judge progress by leads you can answer, not vanity metrics alone',
];

const problemList = [
	'Thin or duplicate service pages that never match how people search in your market',
	'Competitors winning on clearer offers, better reviews, or faster mobile pages while you guess at "keywords"',
	'Agency dashboards that go up while real calls stay flat',
	'Technical mess under the hood: crawl issues, slow loads, or broken paths that quietly cap your ceiling',
];

const localStrategyCards = [
	{
		title: 'Competitor and SERP review',
		body: 'I look at who ranks for your money searches, what their pages include, and what Google is rewarding in your area right now. That sets a realistic target, not a fantasy.',
	},
	{
		title: 'Keywords and search intent',
		body: 'I map the phrases people use when they need your trade, by service and by location. The goal is qualified intent that leads to a call or a form, not traffic that bounces.',
	},
	{
		title: 'Growth gaps',
		body: 'I stack opportunities by impact: missing services on the site, weak headings, listing mismatches, speed issues, or trust gaps. You see what to fix first so effort matches return.',
	},
	{
		title: 'Calls and form submissions',
		body: 'Rankings and impressions matter because they should drive actions. I align reporting with what you sell: phone calls, quote requests, and booked jobs.',
	},
];

const focusAreas = [
	{
		title: 'On-page SEO',
		body: 'Titles, meta descriptions, headings, internal links, and page structure tuned to the keyword map and how you describe work on the ground.',
	},
	{
		title: 'Technical SEO',
		body: 'Indexing, sitemaps, robots, broken links, redirects, and templates fixed so Google can crawl the pages that should earn you leads.',
	},
	{
		title: 'Local SEO',
		body: 'Google Business Profile, categories, service areas, and on-site location language kept consistent so local intent lines up with you.',
	},
	{
		title: 'Performance',
		body: 'Speed and Core Web Vitals so mobile searchers hit a fast page, see proof fast, and tap call or submit without friction.',
	},
];

const processSteps = [
	{
		n: '01',
		title: 'Market and competitor snapshot',
		body: 'I review who shows up for your priority services and towns, what their pages offer, and where you are starting from on listings and the site.',
	},
	{
		n: '02',
		title: 'Keyword map and intent',
		body: 'I lock in the phrases and page types that should carry each service and area, then we agree what "winning" means for you in calls and forms.',
	},
	{
		n: '03',
		title: 'Foundations and crawl',
		body: 'Robots, sitemaps, redirects, broken links, and structural issues get fixed so authority and content updates can actually stick.',
	},
	{
		n: '04',
		title: 'On-page and local execution',
		body: 'I ship page updates, internal links, and listing alignment so your offer matches what people search and where you work.',
	},
	{
		n: '05',
		title: 'Measure leads, then iterate',
		body: 'I watch assisted calls, form submissions, and search trends, then refine pages and priorities. SEO that ranks without leads still gets reworked.',
	},
];

const soloPoints = [
	'You deal with one person. I do the audit, the plan, and the implementation when we agree on scope. No handoffs to a junior you never meet.',
	'I am upfront about cost, timeline, and what SEO can and cannot do before money changes hands. If your market is brutal, I say so.',
	'I do not sell "page one in thirty days" fairy tales. Local service SEO is a long game: competitors, reviews, links, content, and technical health all stack over time.',
	'If an agency pattern looks like a scam, I call it out: fake guarantees, recycled reports, mystery fees, or work that never touches your money pages. I would rather lose a deal than lie to you.',
];

const compareRows: { practical: string; generic: string }[] = [
	{ practical: 'Success tied to calls and form submissions you can verify', generic: 'Charts that look busy while your phone stays quiet' },
	{ practical: 'Competitor and keyword work grounded in your real market', generic: 'Generic keyword lists copied from every other client' },
	{ practical: 'Honest timelines for competitive local terms', generic: 'Guaranteed #1 rankings and pressure to sign tonight' },
	{ practical: 'One owner-operator accountable to you', generic: 'Sales rep, then a rotating cast, then silence' },
	{ practical: 'Plain scope and pricing you understand before work starts', generic: 'Long contracts and add-ons you did not ask for' },
	{ practical: 'Shipped fixes on your site and listings', generic: 'PDFs that sit in email while nothing changes' },
];

const faqItems = [
	{
		q: 'How is this different from a typical SEO agency?',
		a: 'It is one person, direct communication, and work aimed at leads you can answer. I audit your competition, map keywords to services and towns, and tie progress to calls and forms. No account-manager maze and no mystery about who is touching your site.',
	},
	{
		q: 'Do you guarantee #1 rankings?',
		a: 'No. Anyone who guarantees a position is not being straight with you. I focus on sustainable improvements, clear priorities, and metrics that map to booked work. Rankings move in competitive local markets when effort stacks over time.',
	},
	{
		q: 'Is SEO a one-time project?',
		a: 'You can get a lot from a focused audit and fix pass, but staying visible for high-value local searches is ongoing. Competitors keep publishing, earning reviews, and tuning pages. Consistent ranking usually means consistent effort, which I explain up front.',
	},
	{
		q: 'Will you write all new content for my site?',
		a: 'I tighten titles, headings, and service copy around the keyword map. Larger content pushes or new city pages can be scoped as their own phase when you are ready.',
	},
	{
		q: 'Can you work with my existing web developer?',
		a: 'Yes. I can hand off technical fixes or implement them when I also control the codebase. Either way, I keep changes coordinated so nothing breaks when we go for more calls and forms.',
	},
	{
		q: 'How long before we see more calls?',
		a: 'Some fixes help quickly, especially if technical or speed issues cap you today. Winning crowded searches can take months of stacked work. After the first competitor and keyword pass, you get a realistic picture of effort and timing, not a sales script.',
	},
];
---

<div class="themed-subpage">
	<img class="bg-blur" src={background.src} alt="" fetchpriority="high" />
	<img src="/paint-splat.png" alt="" class="paint-strikes-bg" aria-hidden="true" />
	<main class="page">
		<section class="hero section">
			<div class="hero-nav">
				<a href="/" class="logo-link">
					<img src={astroLogo.src} width="115" height="48" alt="Computer Tommy Homepage" />
				</a>
				<div class="hero-nav-end">
					<ThemeToggleButton />
					<a href="/services/" class="btn-outline btn-small" aria-label="Back to services">
						<i class="fas fa-arrow-left"></i>
						<span>Services</span>
					</a>
				</div>
			</div>

			<div class="hero-content">
				<span class="section-eyebrow">Local SEO for service providers</span>
				<h1 class="hero-title">More calls and quote forms from the searches that pay your crew.</h1>
				<p class="hero-desc">
					I audit your competition, map the keywords and intent that actually drive jobs in your towns, and find the gaps worth fixing first. Technical SEO, on-page work, and listings stay in service of one outcome: phone calls and form submissions you can count, not vanity charts.
				</p>
				<div class="hero-actions">
					<a href="/contact/" class="btn-solid">Request an SEO audit</a>
					<a href="/services/web-development/" class="btn-outline">Web development</a>
				</div>
			</div>

			<div class="crumbs-wrap">
				<Breadcrumbs
					variant="dark"
					items={[{ href: '/', label: 'Home' }, { href: '/services/', label: 'Services' }]}
					current="SEO"
				/>
			</div>
		</section>

		<section class="section" aria-labelledby="who-heading">
			<div class="section-header">
				<span class="section-eyebrow">Who this is for</span>
				<h2 class="section-title" id="who-heading">Local service providers who sell on trust and a full calendar.</h2>
				<p class="section-lead">
					If you run on dispatched jobs, estimates, and repeat customers, your website and listings should earn real leads. I focus on who is already winning in your market, which searches carry intent, and what it will take to turn rankings into calls and forms.
				</p>
			</div>

			<ul class="checklist who-list">
				{whoFit.map((line) => (
					<li>
						<i class="fas fa-check checklist-icon" aria-hidden="true"></i>
						<span>{line}</span>
					</li>
				))}
			</ul>

			<p class="trade-chips-label">Examples of trades I work with most:</p>
			<ul class="trade-chips">
				<li>HVAC and plumbing</li>
				<li>Remodeling and electrical</li>
				<li>Landscaping and grading</li>
				<li>Pressure washing and detailing</li>
				<li>Junk removal and property cleanup</li>
				<li>Other local trades</li>
			</ul>

			<div class="two-col">
				<div class="prose-block">
					<h3 class="prose-block-title">What your local funnel needs</h3>
					<ul class="prose-list">
						{needList.map((item) => (
							<li>{item}</li>
						))}
					</ul>
				</div>
				<div class="prose-block prose-block--accent">
					<h3 class="prose-block-title">Common problems I fix</h3>
					<ul class="prose-list">
						{problemList.map((item) => (
							<li>{item}</li>
						))}
					</ul>
				</div>
			</div>
		</section>

		<section class="section section-alt" aria-labelledby="map-heading">
			<div class="section-header">
				<span class="section-eyebrow">Local growth map</span>
				<h2 class="section-title" id="map-heading">Before I touch code, I look at the market.</h2>
				<p class="section-lead">
					Local SEO for trades is not a generic checklist. I start with competitors, keywords, and the gap between where you are today and where you want the phone to ring tomorrow.
				</p>
			</div>
			<div class="grid-cards">
				{localStrategyCards.map((c) => (
					<div class="info-card">
						<h3>{c.title}</h3>
						<p>{c.body}</p>
					</div>
				))}
			</div>
		</section>

		<section class="section" aria-labelledby="straight-heading">
			<div class="section-header">
				<span class="section-eyebrow">Straight talk</span>
				<h2 class="section-title" id="straight-heading">SEO is a long game. You deserve honesty about that.</h2>
			</div>
			<div class="opinion-card">
				<p>
					Consistent rankings for competitive local services take time: better pages, aligned listings, reviews, technical health, and sometimes links or content depth your competitors already have. Quick wins exist when something is broken, but owning a market is rarely a thirty-day project. I tell you the truth about effort and timeline up front, then measure success by calls and form submissions you can tie back to search, not by a dashboard that looks busy while your crew sits idle.
				</p>
			</div>
		</section>

		<section class="section section-alt" aria-labelledby="solo-heading">
			<div class="section-header">
				<span class="section-eyebrow">One person, no BS</span>
				<h2 class="section-title" id="solo-heading">Why working with me is different from a sketchy SEO shop.</h2>
				<p class="section-lead">
					I am one owner-operator, not a sales floor. You are not paying for a pitch deck and a revolving door of strangers. You get direct answers, clear scope, and work aimed at leads you can actually close.
				</p>
			</div>
			<ul class="solo-points">
				{soloPoints.map((pt) => (
					<li>{pt}</li>
				))}
			</ul>
		</section>

		<section class="section" aria-labelledby="services-heading">
			<div class="section-header">
				<span class="section-eyebrow">SEO services</span>
				<h2 class="section-title" id="services-heading">Pick a lane. Each has its own page and deliverables.</h2>
				<p class="section-lead">
					After we understand competitors and keywords, these are the levers I pull: technical crawl health, on-page structure, local listings, and speed. We can stack scopes so every hour ties back to calls and forms.
				</p>
			</div>
			<div class="seo-pillar-grid">
				{seoCards.map((s) => (
					<a class="seo-pillar-card" href={`/services/seo/${s.slug}/`}>
						<i class:list={['fas', s.icon, 'pillar-icon']} aria-hidden="true"></i>
						<h3>{s.data.h1 ?? s.slug}</h3>
						{s.data.heroSubtitle ? <p>{s.data.heroSubtitle}</p> : null}
						<span class="pillar-cta">View details</span>
					</a>
				))}
			</div>
		</section>

		<section class="section section-alt" aria-labelledby="process-heading">
			<div class="section-header">
				<span class="section-eyebrow">Process</span>
				<h2 class="section-title" id="process-heading">How I run a local SEO engagement.</h2>
				<p class="section-lead">
					Every phase ties to competitors, keywords, shipped fixes, and the calls or quote requests you care about. No black box.
				</p>
			</div>
			<div class="process-grid">
				{processSteps.map((step) => (
					<div class="process-step">
						<span class="step-number">{step.n}</span>
						<h4>{step.title}</h4>
						<p>{step.body}</p>
					</div>
				))}
			</div>
		</section>

		<section class="section" aria-labelledby="focus-heading">
			<div class="section-header">
				<span class="section-eyebrow">Coverage</span>
				<h2 class="section-title" id="focus-heading">What I optimize end to end.</h2>
				<p class="section-lead">
					Strategy points at competitors and keywords. Execution still has to nail the boring foundations so Google and real customers both trust the site.
				</p>
			</div>
			<div class="grid-cards">
				{focusAreas.map((f) => (
					<div class="info-card">
						<h3>{f.title}</h3>
						<p>{f.body}</p>
					</div>
				))}
			</div>
		</section>

		<section class="section section-alt" aria-labelledby="compare-heading">
			<div class="section-header">
				<span class="section-eyebrow">Comparison</span>
				<h2 class="section-title" id="compare-heading">Local lead SEO vs packages that rip you off.</h2>
				<p class="section-lead">
					If it sounds too good to be true, it is. Here is how I work instead.
				</p>
			</div>
			<div class="compare-wrap">
				<table class="compare-table">
					<thead>
						<tr>
							<th scope="col">How I work</th>
							<th scope="col">What I skip</th>
						</tr>
					</thead>
					<tbody>
						{compareRows.map((row) => (
							<tr>
								<td>{row.practical}</td>
								<td>{row.generic}</td>
							</tr>
						))}
					</tbody>
				</table>
			</div>
		</section>

		<section class="section faq-section" aria-labelledby="faq-heading">
			<div class="section-header">
				<span class="section-eyebrow">FAQ</span>
				<h2 class="section-title" id="faq-heading">Questions we hear a lot.</h2>
			</div>
			<dl class="faq-list">
				{faqItems.map((item) => (
					<div class="faq-item">
						<dt>{item.q}</dt>
						<dd>{item.a}</dd>
					</div>
				))}
			</dl>
		</section>

		<section class="section related-section" aria-labelledby="related-heading">
			<h2 class="section-title section-title--sm" id="related-heading">Related services</h2>
			<p class="related-lead">
				Strong local SEO still needs a site Google can crawl and that customers trust. If you need a new build or faster pages, pair this with{' '}
				<a href="/services/web-development/">web development</a>. For automation and internal tools, see{' '}
				<a href="/services/tooling/">tooling</a>.
			</p>
		</section>

		<section class="section cta-section">
			<div class="cta-inner">
				<h2>Ready for an honest local SEO guy?</h2>
			
				<a href="/contact/" class="btn-solid">Get in touch</a>
			</div>
		</section>
	</main>
</div>

<style>
	.bg-blur {
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		z-index: 0;
		filter: blur(120px);
		opacity: 0.16;
		pointer-events: none;
	}

	.paint-strikes-bg {
		position: fixed;
		left: 38%;
		top: 8%;
		width: min(230vw, 2400px);
		height: auto;
		max-width: none;
		z-index: 0;
		pointer-events: none;
		opacity: 0.2;
		mix-blend-mode: lighten;
		transform: translateX(-50%) rotate(-3deg);
	}

	.hero-nav-end {
		display: flex;
		align-items: center;
		gap: 0.65rem;
	}

	.page {
		position: relative;
		z-index: 1;
	}

	.section {
		max-width: 1100px;
		margin: 0 auto;
		padding: 4rem 1.5rem;
	}

	.section-alt {
		max-width: none;
		background: var(--surface);
	}

	.section-alt > * {
		max-width: 1100px;
		margin-left: auto;
		margin-right: auto;
	}

	.hero {
		padding-top: 2rem;
	}

	.hero-nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 2rem;
	}

	.logo-link {
		display: inline-flex;
		opacity: 0.92;
		text-decoration: none;
	}

	.logo-link:hover {
		opacity: 1;
	}

	.hero-content {
		max-width: 900px;
	}

	.section-eyebrow {
		display: inline-block;
		font-family: var(--font-display);
		font-size: 1.2rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--text-muted);
		margin-bottom: 0.5rem;
	}

	.hero-title,
	.section-title {
		font-family: var(--font-display);
		font-weight: 400;
		text-transform: uppercase;
		letter-spacing: 0.02em;
		margin: 0;
		word-wrap: break-word;
		overflow-wrap: break-word;
	}

	.hero-title {
		font-size: clamp(2.4rem, 8vw, 5.5rem);
		line-height: 0.95;
	}

	.section-title {
		font-size: clamp(2rem, 6vw, 4rem);
		line-height: 1;
	}

	.section-title--sm {
		font-size: clamp(1.6rem, 4vw, 2.5rem);
		margin-bottom: 0.65rem;
	}

	.section-lead {
		color: var(--text-muted);
		font-size: clamp(1rem, 1.8vw, 1.2rem);
		line-height: 1.6;
		max-width: 720px;
		margin: 0.75rem 0 0;
	}

	.hero-desc {
		color: var(--text-muted);
		font-size: clamp(1rem, 2vw, 1.3rem);
		line-height: 1.55;
		max-width: 700px;
		margin: 1rem 0 1.5rem;
	}

	.section-header {
		max-width: 760px;
		margin-bottom: 2rem;
	}

	.btn-solid,
	.btn-outline {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.55rem;
		padding: 0.78rem 1.6rem;
		border-radius: var(--radius);
		text-decoration: none;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.03em;
		font-size: 0.9rem;
		transition: background 0.25s, color 0.25s, border-color 0.25s, transform 0.15s;
	}

	.btn-solid {
		background: var(--text);
		color: var(--bg);
		border: 1px solid var(--text);
	}

	.btn-solid:hover {
		background: transparent;
		color: var(--text);
		transform: translateY(-1px);
	}

	.btn-outline {
		background: transparent;
		color: var(--text);
		border: 1px solid var(--border);
	}

	.btn-outline:hover {
		background: var(--text);
		color: var(--bg);
		border-color: var(--text);
		transform: translateY(-1px);
	}

	.btn-small {
		padding: 0.6rem 1rem;
		font-size: 0.86rem;
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}

	.crumbs-wrap {
		margin-top: 1.2rem;
		padding-top: 1rem;
		border-top: 1px solid var(--border);
	}

	.checklist {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 0.65rem;
		max-width: 52rem;
	}

	.checklist li {
		display: flex;
		gap: 0.75rem;
		align-items: flex-start;
		padding: 0.85rem 1rem;
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: var(--radius-sm);
		font-size: 0.98rem;
		line-height: 1.5;
		color: var(--text-muted);
	}

	.checklist-icon {
		color: var(--accent);
		margin-top: 0.15rem;
		flex-shrink: 0;
	}

	.who-list {
		margin-top: 0.5rem;
	}

	.trade-chips-label {
		font-size: 0.8rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--text-muted);
		margin: 2rem 0 0.65rem;
	}

	.trade-chips {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		list-style: none;
		padding: 0;
		margin: 0 0 2rem;
	}

	.trade-chips li {
		padding: 0.4rem 0.85rem;
		border-radius: 999px;
		border: 1px solid var(--border);
		background: var(--surface);
		font-size: 0.9rem;
		color: var(--text);
	}

	.two-col {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1rem;
		align-items: start;
	}

	.prose-block {
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		padding: 1.35rem 1.5rem;
	}

	.prose-block--accent {
