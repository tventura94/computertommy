---
import '@fortawesome/fontawesome-free/css/all.min.css';
import astroLogo from '../../assets/computertommylogo.svg';
import background from '../../assets/background.svg';
import Breadcrumbs from '../Breadcrumbs.astro';
import ThemeToggleButton from '../ThemeToggleButton.astro';

type SeoServiceEntry = {
	slug: string;
	data: {
		h1?: string;
		heroSubtitle?: string;
	};
};

const { getCollection } = await import('astro:content');
const seoServices = (
	await (getCollection as unknown as (collection: string) => Promise<SeoServiceEntry[]>)('seo_services')
)
	.slice()
	.sort((a, b) => (a.data.h1 ?? a.slug).localeCompare(b.data.h1 ?? b.slug));

const slugIcon: Record<string, string> = {
	'technical-seo-audit': 'fa-search',
	'onpage-cleanup': 'fa-tags',
	'local-seo': 'fa-map-marker-alt',
	'speed-web-vitals': 'fa-tachometer-alt',
};

const seoCards = seoServices.map((s) => ({
	...s,
	icon: slugIcon[s.slug] ?? 'fa-file-lines',
}));

const whoFit = [
	'Local service businesses that need more calls and quote requests, not random traffic from people who will never hire you',
	'Owners who want to know what competitors rank for, what pages they lean on, and what it actually takes to compete in their towns',
	'Teams ready for research-first SEO: market audit, realistic keyword targets, and work tied back to leads you can measure',
];

const localSeoMeansBullets = [
	'Which keywords have real local intent',
	'Which services deserve their own pages',
	'What your competitors are already targeting',
	'Where keyword difficulty is realistic',
	'How your Google Business Profile supports the website',
	'Where your site is losing leads because the design or offer is weak',
];

const approachBlocks = [
	{
		title: 'Local market and competitor audit',
		body: 'I review the businesses already ranking in your area, the pages they are using, the services they emphasize, and how strong their websites and profiles are. That gives us a real picture of what you are up against.',
	},
	{
		title: 'Keyword research and opportunity mapping',
		body: 'I look at search volume, keyword difficulty, service intent, and location intent to figure out what is worth targeting first. Some keywords look good on paper but will not bring leads. Some lower-volume terms are exactly the ones that drive calls. I build around the second type.',
	},
	{
		title: 'On-page SEO recommendations',
		body: 'Once the market is clear, I decide how the site should be structured. That includes service pages, title tags, headings, internal links, local relevance, and conversion-focused page layouts that make it easy for people to contact you.',
	},
	{
		title: 'Technical SEO and crawl health',
		body: 'I audit sites with Screaming Frog to catch crawl problems, broken links, indexation issues, metadata problems, thin pages, duplicate elements, redirect problems, and other technical issues that can hold rankings back.',
	},

];

const includedItems = [
	{
		title: 'Local SEO strategy',
		body: 'A research-driven plan based on your market, your services, and the keywords most likely to drive actual leads.',
	},
	{
		title: 'Keyword targeting',
		body: 'Keyword research using tools like Semrush, Ahrefs, Google Search Console, and Google Business Profile insights to identify realistic opportunities.',
	},
	{
		title: 'Competitor analysis',
		body: 'A review of what top competitors are targeting, how they structure their pages, where they are stronger, and where they are beatable.',
	},
	{
		title: 'On-page SEO',
		body: 'Titles, headings, service-page targeting, internal linking, local relevance, and page structure built around the market audit.',
	},
	{
		title: 'Technical SEO',
		body: 'Full crawl-based review with Screaming Frog to catch site issues that affect performance, indexing, or usability.',
	},
	{
		title: 'Google Business Profile optimization',
		body: 'Optimization recommendations so your Google Business Profile supports the website and helps reinforce local relevance.',
	},
	{
		title: 'Backlink recommendations',
		body: 'Clear recommendations from the audit on where authority gaps exist and what types of backlinks or citation opportunities make the most sense for your market.',
	},
	{
		title: 'SEO handoff guides',
		body: 'For one-time fee builds, guides so you can continue improving rankings after launch and understand how to maintain momentum.',
	},
];

const gbpBullets = [
	'Category alignment',
	'Service alignment',
	'Location and service area consistency',
	'Relevance between the site and GBP',
	'Opportunities to strengthen local trust signals',
	'Content and update recommendations where appropriate',
];

const oneTimeGuideBullets = [
	'How to keep pages optimized',
	'How to expand service or location targeting',
	'How to think about future content',
	'How to keep your GBP aligned',
	'What to monitor in Search Console',
	'Where authority gaps may need attention later',
];

const toolsList = ['Semrush', 'Ahrefs', 'Google Search Console', 'Google Business Profile', 'Screaming Frog'];

const faqItems = [
	{
		q: 'Do you guarantee rankings?',
		a: 'No. Nobody honest should. What I can do is give you a realistic picture of your market, show where the opportunities are, and improve the site and local presence around the searches that matter.',
	},
	{
		q: 'Do you only work with local service businesses?',
		a: 'That is the core focus. Local service companies have a very specific type of SEO problem, and that is the niche I build around.',
	},
	{
		q: 'Do you offer Google Business Profile optimization?',
		a: 'Yes. I treat GBP as part of the local SEO system, not as a separate afterthought.',
	},
	{
		q: 'Do backlinks matter for local SEO?',
		a: 'Sometimes yes, sometimes less than people think. It depends on the market. That is why I make backlink recommendations based on the audit instead of pushing the same answer to every client.',
	},
	{
		q: 'What if I only want a one-time website build?',
		a: 'That is fine. I provide SEO guides with one-time builds so you have direction after launch.',
	},
];
---

<div class="themed-subpage">
	<img class="bg-blur" src={background.src} alt="" fetchpriority="high" />
	<img src="/paint-splat.png" alt="" class="paint-strikes-bg" aria-hidden="true" />
	<main class="page">
		<section class="hero section">
			<div class="hero-nav">
				<a href="/" class="logo-link">
					<img src={astroLogo.src} width="115" height="48" alt="Computer Tommy Homepage" />
				</a>
				<div class="hero-nav-end">
					<ThemeToggleButton />
					<a href="/services/" class="btn-outline btn-small" aria-label="Back to services">
						<i class="fas fa-arrow-left"></i>
						<span>Services</span>
					</a>
				</div>
			</div>

			<div class="hero-content">
				<span class="section-eyebrow">Local SEO for service businesses</span>
				<h1 class="hero-title">More calls, more quote requests, and a website built around the searches that actually bring in work.</h1>
				<p class="hero-desc">
					I help local service businesses figure out what people in their market are searching, what competitors are ranking for, and what it will take to compete. Every SEO decision I make is tied back to one thing: getting the phone to ring.
				</p>
				<p class="hero-desc hero-desc--tight">
					I start with a local market audit, map the best keyword opportunities by service and location, review competitor pages and listings, and build from there. No vague SEO package. No empty ranking promises. Just a practical plan based on your market.
				</p>
				<div class="hero-actions">
					<a href="/contact/" class="btn-solid">Request an SEO audit</a>
					<a href="/services/web-development/" class="btn-outline">Web development</a>
				</div>
			</div>

			<div class="crumbs-wrap">
				<Breadcrumbs
					variant="dark"
					items={[{ href: '/', label: 'Home' }, { href: '/services/', label: 'Services' }]}
					current="SEO"
				/>
			</div>
		</section>

	

		<section class="section section-alt" aria-labelledby="local-seo-means-heading">
			<div class="section-header">
				<span class="section-eyebrow">What local SEO means here</span>
				<h2 class="section-title" id="local-seo-means-heading">SEO built for local service businesses</h2>
				<p class="section-lead">
					Local SEO is not the same as broad national SEO. If you run a service business, you do not need random traffic from people who will never call you. You need visibility for the searches that show buying intent in the towns and service areas you actually want to work in.
				</p>
			</div>
			<p class="seo-prose-intro">That means I look at:</p>
			<ul class="seo-prose-list">
				{localSeoMeansBullets.map((line) => (
					<li>{line}</li>
				))}
			</ul>
			<p class="seo-prose-outro">
				The goal is not just rankings. The goal is rankings that turn into calls.
			</p>
		</section>

		<section class="section" aria-labelledby="approach-heading">
			<div class="section-header">
				<span class="section-eyebrow">Strategy, then execution</span>
				<h2 class="section-title" id="approach-heading">How I approach local SEO</h2>
				<p class="section-lead">
					I do not start with guesses or generic keyword lists. Every project starts with a local audit so I can see what is happening in your actual market.
				</p>
			</div>
			<div class="grid-cards">
				{approachBlocks.map((c) => (
					<div class="info-card">
						<h3>{c.title}</h3>
						<p>{c.body}</p>
					</div>
				))}
			</div>
		</section>

		<section class="section section-alt" aria-labelledby="included-heading">
			<div class="section-header">
				<span class="section-eyebrow">Deliverables</span>
				<h2 class="section-title" id="included-heading">What is included</h2>
				<p class="section-lead">
					One system: research first, then recommendations and fixes tied to leads. Here is what that covers.
				</p>
			</div>
			<div class="grid-cards included-grid">
				{includedItems.map((item) => (
					<div class="info-card">
						<h3>{item.title}</h3>
						<p>{item.body}</p>
					</div>
				))}
			</div>
		</section>

		<section class="section" aria-labelledby="gbp-heading">
			<div class="section-header">
				<span class="section-eyebrow">Listings</span>
				<h2 class="section-title" id="gbp-heading">Google Business Profile optimization</h2>
			</div>
			<div class="seo-prose-block">
				<p>
					Your website and your Google Business Profile should support each other, not tell two different stories. I include Google Business Profile optimization as part of the local SEO process so your services, categories, descriptions, and service areas line up with what the website is targeting.
				</p>
				<p>That includes looking at:</p>
				<ul class="seo-prose-list seo-prose-list--compact">
					{gbpBullets.map((line) => (
						<li>{line}</li>
					))}
				</ul>
				<p class="seo-prose-outro seo-prose-outro--flush">
					A lot of local businesses treat the website and GBP as separate things. They should work together.
				</p>
			</div>
		</section>

		<section class="section section-alt" aria-labelledby="backlinks-heading">
			<div class="section-header">
				<span class="section-eyebrow">Authority</span>
				<h2 class="section-title" id="backlinks-heading">Backlink recommendations from the audit</h2>
			</div>
			<div class="seo-prose-block">
				<p>
					Not every market is won on on-page SEO alone. Some local spaces are light enough that better structure, better targeting, and a stronger GBP can move the needle. Others require stronger authority signals to compete. That is why I include backlink recommendations in my audits.
				</p>
				<p>
					I look at the competitive gap and tell you where links or citations may actually matter. That way you are not blindly buying junk links or wasting money on things that do nothing.
				</p>
				<p class="seo-prose-outro seo-prose-outro--flush">
					The point is not to pad a report with off-page SEO language. The point is to tell you what your market actually requires.
				</p>
			</div>
		</section>

		<section class="section" aria-labelledby="technical-heading">
			<div class="section-header">
				<span class="section-eyebrow">Performance</span>
				<h2 class="section-title" id="technical-heading">Technical SEO and speed matter</h2>
			</div>
			<div class="seo-prose-block">
				<p>
					A slow, messy website can kill rankings and conversions at the same time. I run technical and on-page audits through Screaming Frog and build websites with speed in mind from the start. I use Astro for builds, which helps keep sites lean, fast, and easier to optimize for performance.
				</p>
				<p>
					That means your site is built on a cleaner foundation, with less bloat and a better chance of loading quickly on mobile, which matters for both rankings and lead generation.
				</p>
				<p class="seo-prose-outro seo-prose-outro--flush">
					Fast sites do not just look better in a report. They make it easier for people to stay on the page and call.
				</p>
			</div>
		</section>

		<section class="section section-alt" aria-labelledby="guides-heading">
			<div class="section-header">
				<span class="section-eyebrow">One-time builds</span>
				<h2 class="section-title" id="guides-heading">SEO guides for one-time builds</h2>
			</div>
			<div class="seo-prose-block">
				<p>Not every client wants a monthly SEO engagement. For one-time fee website builds, I include SEO guides so you have a practical roadmap for what to do after launch. That can include:</p>
				<ul class="seo-prose-list seo-prose-list--compact">
					{oneTimeGuideBullets.map((line) => (
						<li>{line}</li>
					))}
				</ul>
				<p class="seo-prose-outro seo-prose-outro--flush">
					That way you are not left with a finished website and no idea how to keep moving forward.
				</p>
			</div>
		</section>

		<section class="section" aria-labelledby="tools-heading">
			<div class="section-header">
				<span class="section-eyebrow">Data, not guesses</span>
				<h2 class="section-title" id="tools-heading">Tools I use</h2>
				<p class="section-lead">
					I use industry-standard tools to audit performance, research keywords, and evaluate local competition. Tools are not the service by themselves, but they help me make decisions based on real data instead of assumptions.
				</p>
			</div>
			<ul class="tools-list">
				{toolsList.map((name) => (
					<li>{name}</li>
				))}
			</ul>
		</section>

		<section class="section section-alt" aria-labelledby="why-heading">
			<div class="section-header">
				<span class="section-eyebrow">Why this is different</span>
				<h2 class="section-title" id="why-heading">Why this approach is different</h2>
			</div>
			<div class="seo-prose-block">
				<p>
					A lot of SEO services sell dashboards, generic reports, and vague monthly activity. That is not how I work.
				</p>
				<p>
					I focus on local service businesses, I start with your actual market, and I build around the pages and searches most likely to bring in work. I am not interested in sending you vanity metrics that make things look active while your phone stays quiet.
				</p>
				<p class="seo-prose-outro seo-prose-outro--flush">
					My job is to help you make better local SEO decisions and turn that into more calls.
				</p>
			</div>
		</section>

		<section class="section" aria-labelledby="deep-dives-heading">
			<div class="section-header">
				<span class="section-eyebrow">Go deeper</span>
				<h2 class="section-title" id="deep-dives-heading">Service detail pages</h2>
				<p class="section-lead">
					Each focus area has its own page with specifics on deliverables and how it fits the larger plan.
				</p>
			</div>
			<div class="seo-pillar-grid">
				{seoCards.map((s) => (
					<a class="seo-pillar-card" href={`/services/seo/${s.slug}/`}>
						<i class:list={['fas', s.icon, 'pillar-icon']} aria-hidden="true"></i>
						<h3>{s.data.h1 ?? s.slug}</h3>
						{s.data.heroSubtitle ? <p>{s.data.heroSubtitle}</p> : null}
						<span class="pillar-cta">View details</span>
					</a>
				))}
			</div>
		</section>

		<section class="section faq-section" aria-labelledby="faq-heading">
			<div class="section-header">
				<span class="section-eyebrow">FAQ</span>
				<h2 class="section-title" id="faq-heading">Questions we hear a lot</h2>
			</div>
			<dl class="faq-list">
				{faqItems.map((item) => (
					<div class="faq-item">
						<dt>{item.q}</dt>
						<dd>{item.a}</dd>
					</div>
				))}
			</dl>
		</section>

		<section class="section related-section" aria-labelledby="related-heading">
			<h2 class="section-title section-title--sm" id="related-heading">Related services</h2>
			<p class="related-lead">
				Strong local SEO still needs a site Google can crawl and that customers trust. If you need a new build or faster pages, pair this with{' '}
				<a href="/services/web-development/">web development</a>. For automation and internal tools, see{' '}
				<a href="/services/tooling/">tooling</a>.
			</p>
		</section>

		<section class="section cta-section">
			<div class="cta-inner">
				<h2>Want an honest look at your local SEO?</h2>
				<p class="cta-lead">
					I will review your market, your competitors, your site structure, and where your biggest opportunities are. Then I will show you what is worth fixing first.
				</p>
				<a href="/contact/" class="btn-solid">Request an SEO audit</a>
			</div>
		</section>
	</main>
</div>

<style>
	.bg-blur {
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		z-index: 0;
		filter: blur(120px);
		opacity: 0.16;
		pointer-events: none;
	}

	.paint-strikes-bg {
		position: fixed;
		left: 38%;
		top: 8%;
		width: min(230vw, 2400px);
		height: auto;
		max-width: none;
		z-index: 0;
		pointer-events: none;
		opacity: 0.2;
		mix-blend-mode: lighten;
		transform: translateX(-50%) rotate(-3deg);
	}

	.hero-nav-end {
		display: flex;
		align-items: center;
		gap: 0.65rem;
	}

	.page {
		position: relative;
		z-index: 1;
	}

	.section {
		max-width: 1100px;
		margin: 0 auto;
		padding: 4rem 1.5rem;
	}

	.section-alt {
		max-width: none;
		background: var(--surface);
	}

	.section-alt > * {
		max-width: 1100px;
		margin-left: auto;
		margin-right: auto;
	}

	.hero {
		padding-top: 2rem;
	}

	.hero-nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 2rem;
	}

	.logo-link {
		display: inline-flex;
		opacity: 0.92;
		text-decoration: none;
	}

	.logo-link:hover {
		opacity: 1;
	}

	.hero-content {
		max-width: 900px;
	}

	.section-eyebrow {
		display: inline-block;
		font-family: var(--font-display);
		font-size: 1.2rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--text-muted);
		margin-bottom: 0.5rem;
	}

	.hero-title,
	.section-title {
		font-family: var(--font-display);
		font-weight: 400;
		text-transform: uppercase;
		letter-spacing: 0.02em;
		margin: 0;
		word-wrap: break-word;
		overflow-wrap: break-word;
	}

	.hero-title {
		font-size: clamp(2.4rem, 8vw, 5.5rem);
		line-height: 0.95;
	}

	.section-title {
		font-size: clamp(2rem, 6vw, 4rem);
		line-height: 1;
	}

	.section-title--sm {
		font-size: clamp(1.6rem, 4vw, 2.5rem);
		margin-bottom: 0.65rem;
	}

	.section-lead {
		color: var(--text-muted);
		font-size: clamp(1rem, 1.8vw, 1.2rem);
		line-height: 1.6;
		max-width: 720px;
		margin: 0.75rem 0 0;
	}

	.hero-desc {
		color: var(--text-muted);
		font-size: clamp(1rem, 2vw, 1.3rem);
		line-height: 1.55;
		max-width: 700px;
		margin: 1rem 0 1.5rem;
	}

	.hero-desc--tight {
		margin-top: -0.35rem;
	}

	.section-header {
		max-width: 760px;
		margin-bottom: 2rem;
	}

	.btn-solid,
	.btn-outline {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.55rem;
		padding: 0.78rem 1.6rem;
		border-radius: var(--radius);
		text-decoration: none;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.03em;
		font-size: 0.9rem;
		transition: background 0.25s, color 0.25s, border-color 0.25s, transform 0.15s;
	}

	.btn-solid {
		background: var(--text);
		color: var(--bg);
		border: 1px solid var(--text);
	}

	.btn-solid:hover {
		background: transparent;
		color: var(--text);
		transform: translateY(-1px);
	}

	.btn-outline {
		background: transparent;
		color: var(--text);
		border: 1px solid var(--border);
	}

	.btn-outline:hover {
		background: var(--text);
		color: var(--bg);
		border-color: var(--text);
		transform: translateY(-1px);
	}

	.btn-small {
		padding: 0.6rem 1rem;
		font-size: 0.86rem;
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}

	.crumbs-wrap {
		margin-top: 1.2rem;
		padding-top: 1rem;
		border-top: 1px solid var(--border);
	}

	.checklist {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 0.65rem;
		max-width: 52rem;
	}

	.checklist li {
		display: flex;
		gap: 0.75rem;
		align-items: flex-start;
		padding: 0.85rem 1rem;
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: var(--radius-sm);
		font-size: 0.98rem;
		line-height: 1.5;
		color: var(--text-muted);
	}

	.checklist-icon {
		color: var(--accent);
		margin-top: 0.15rem;
		flex-shrink: 0;
	}

	.who-list {
		margin-top: 0.5rem;
	}

	.trade-chips-label {
		font-size: 0.8rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--text-muted);
		margin: 2rem 0 0.65rem;
	}

	.trade-chips {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		list-style: none;
		padding: 0;
		margin: 0 0 2rem;
	}

	.trade-chips li {
		padding: 0.4rem 0.85rem;
		border-radius: 999px;
		border: 1px solid var(--border);
		background: var(--surface);
		font-size: 0.9rem;
		color: var(--text);
	}

	.seo-prose-intro {
		margin: 0 0 0.75rem;
		font-weight: 600;
		color: var(--text);
		font-size: 1rem;
	}

	.seo-prose-list {
		margin: 0 0 1.25rem;
		padding-left: 1.25rem;
		color: var(--text-muted);
		line-height: 1.65;
		max-width: 42rem;
	}

	.seo-prose-list li {
		margin-bottom: 0.45rem;
	}

	.seo-prose-list li:last-child {
