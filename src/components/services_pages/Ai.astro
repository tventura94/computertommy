---
import '@fortawesome/fontawesome-free/css/all.min.css';
import astroLogo from '../../assets/computertommylogo.svg';
import background from '../../assets/background.svg';
import Breadcrumbs from '../Breadcrumbs.astro';
import ThemeToggleButton from '../ThemeToggleButton.astro';

const whoFit = [
	'Local service businesses that want callers and texters handled faster without adding headcount',
	'Owners who want an AI agent on the phone, in SMS, or on the website with clear scripts and handoff rules',
	'Teams ready to connect LLMs to real tools: CRM fields, calendars, webhooks, ticketing, and your own data',
];

const capabilities = [
	{
		icon: 'fa-project-diagram',
		title: 'Applied AI pipelines',
		body: 'We design and build pipelines end to end: ingest, retrieval, tool calls, model steps, logging, retries, and human handoff when the case needs a person.',
	},
	{
		icon: 'fa-microchip',
		title: 'Modern LLMs',
		body: 'We work comfortably with current hosted models and APIs (for example OpenAI, Anthropic, Google Gemini, and others) and help you pick the right model for cost, speed, and quality.',
	},
	{
		icon: 'fa-robot',
		title: 'AI agents for your business',
		body: 'From single-channel helpers to multi-step agents: goals, tools, memory where it helps, and guardrails so the agent stays inside what you allow.',
	},
	{
		icon: 'fa-headset',
		title: 'Voice and voicemail AI agents',
		body: 'Automated AI voicemail and call flows that greet callers, qualify leads, capture job details, and route or schedule without losing the human option.',
	},
	{
		icon: 'fa-mobile-alt',
		title: 'Text agents',
		body: 'SMS agents for missed-call follow-up, appointment reminders, or scripted conversations that match your tone and escalate when needed.',
	},
	{
		icon: 'fa-comments',
		title: 'Chat agents',
		body: 'Website or portal chat that answers from your approved content, books or captures leads, and hands off cleanly to your team.',
	},
];

const useCases = [
	{
		title: 'After-hours calls for a contractor',
		body: 'An AI voicemail agent collects job type, ZIP, and urgency, then texts the homeowner a confirmation and notifies your on-call line for emergencies.',
	},
	{
		title: 'Missed-call text agent',
		body: 'When nobody picks up, an SMS agent sends a short reply with booking or estimate links and logs the lead in your sheet or CRM.',
	},
	{
		title: 'Website chat that books',
		body: 'A chat agent answers FAQs from your real pricing and service pages, then offers slots or a form so you stop losing mobile visitors.',
	},
	{
		title: 'Pipeline behind the scenes',
		body: 'Transcripts, tags, and summaries flow into Slack, HubSpot, GoHighLevel, or a database so dispatch and sales see one thread, not ten tabs.',
	},
];

const processSteps = [
	{
		n: '01',
		title: 'Define the agent and channels',
		body: 'Voice, SMS, chat, or all three. We lock goals, scripts, what it may promise, and when it must transfer to a human or voicemail.',
	},
	{
		n: '02',
		title: 'Design the AI pipeline',
		body: 'Steps, tools, retrieval, and model choices wired together so each request is traceable and you can change one piece without rebuilding everything.',
	},
	{
		n: '03',
		title: 'Integrate LLMs and providers',
		body: 'We connect the LLMs and telephony or messaging providers you need, with keys stored properly and fallbacks if an API is slow or down.',
	},
	{
		n: '04',
		title: 'Test like a real customer',
		body: 'Role-play calls, texts, and chats against your scenarios until tone, handoff, and data capture feel right for your market.',
	},
	{
		n: '05',
		title: 'Launch, monitor, improve',
		body: 'We go live with logging and simple dashboards so you can tune prompts, routing, and business rules as real traffic comes in.',
	},
];

const faqItems = [
	{
		q: 'Can you build an AI agent that answers my phones?',
		a: 'Yes. We can scope voicemail and call-routing agents that use modern speech and LLM backends, with scripts and escalation paths you approve. Compliance and carrier rules vary, so we plan that up front.',
	},
	{
		q: 'Which LLMs do you support?',
		a: 'We are comfortable with the major hosted APIs and models available today. The right choice depends on latency, cost, and whether you need voice, long context, or strict tool use.',
	},
	{
		q: 'How is this different from a generic chatbot widget?',
		a: 'We build applied pipelines and agents tied to your services, area, and tools. That means retrieval from your content, CRM or calendar actions, and behavior you can iterate on, not a one-size script.',
	},
	{
		q: 'What does a first agent or pipeline cost?',
		a: 'After a short scope call you get a fixed price for a defined channel or flow. Larger multi-channel programs split into phases so you can ship voice or SMS first, then add chat or back-office steps.',
	},
];
---

<div class="themed-subpage">
	<img class="bg-blur" src={background.src} alt="" fetchpriority="high" />
	<img src="/paint-splat.png" alt="" class="paint-strikes-bg" aria-hidden="true" />
	<main class="page">
		<section class="hero section">
			<div class="hero-nav">
				<a href="/" class="logo-link">
					<img src={astroLogo.src} width="115" height="48" alt="Computer Tommy Homepage" />
				</a>
				<div class="hero-nav-end">
					<ThemeToggleButton />
					<a href="/services/" class="btn-outline btn-small" aria-label="Back to services">
						<i class="fas fa-arrow-left"></i>
						<span>Services</span>
					</a>
				</div>
			</div>

			<div class="hero-content">
				<span class="section-eyebrow">Applied AI for service businesses</span>
				<h1 class="hero-title">AI pipelines and agents for calls, texts, and chat.</h1>
				<p class="hero-desc">
					We build applied AI: pipelines and agents on top of modern LLMs, wired into how you already work. That includes automated AI voicemail agents, SMS text agents, website chat agents, and anything that helps a local service business capture and qualify leads without drowning in busywork. For non-model automation and dashboards alone, see tooling and web development.
				</p>
				<div class="hero-actions">
					<a href="/contact/" class="btn-solid">Plan an AI agent or pipeline</a>
					<a href="/services/tooling/" class="btn-outline">Tooling and automation</a>
				</div>
			</div>

			<div class="crumbs-wrap">
				<Breadcrumbs
					variant="dark"
					items={[{ href: '/', label: 'Home' }, { href: '/services/', label: 'Services' }]}
					current="AI"
				/>
			</div>
		</section>

		<section class="section" aria-labelledby="who-heading">
			<div class="section-header">
				<span class="section-eyebrow">Who this is for</span>
				<h2 class="section-title" id="who-heading">Service businesses that want AI in the field, not in a slide deck.</h2>
				<p class="section-lead">
					We help you design and ship AI agents and pipelines using current LLMs and voice or messaging providers. You get clear behavior, handoff rules, and integrations your team can rely on. We are not here to train foundation models; we are here to put applied AI to work for calls, texts, chats, and back-office steps.
				</p>
			</div>
			<ul class="checklist who-list">
				{whoFit.map((line) => (
					<li>
						<i class="fas fa-check checklist-icon" aria-hidden="true"></i>
						<span>{line}</span>
					</li>
				))}
			</ul>
		</section>

		<section class="section section-alt" aria-labelledby="cap-heading">
			<div class="section-header">
				<span class="section-eyebrow">What we build</span>
				<h2 class="section-title" id="cap-heading">Applied AI, pipelines, and agents.</h2>
				<p class="section-lead">
					Everything below is work we can scope with you end to end: architecture, prompts, tools, telephony or SMS hooks, and launch support for local service companies.
				</p>
			</div>
			<div class="grid-cards">
				{capabilities.map((c) => (
					<div class="info-card">
						<i class:list={['fas', c.icon, 'icon']} aria-hidden="true"></i>
						<h3>{c.title}</h3>
						<p>{c.body}</p>
					</div>
				))}
			</div>
		</section>

		<section class="section" aria-labelledby="use-heading">
			<div class="section-header">
				<span class="section-eyebrow">Examples</span>
				<h2 class="section-title" id="use-heading">How service businesses use these agents.</h2>
			</div>
			<div class="examples-grid">
				{useCases.map((u) => (
					<article class="example-card">
						<h3>{u.title}</h3>
						<p>{u.body}</p>
					</article>
				))}
			</div>
		</section>

		<section class="section section-alt" aria-labelledby="process-heading">
			<div class="section-header">
				<span class="section-eyebrow">Process</span>
				<h2 class="section-title" id="process-heading">How we ship agents and pipelines.</h2>
			</div>
			<div class="process-grid">
				{processSteps.map((step) => (
					<div class="process-step">
						<span class="step-number">{step.n}</span>
						<h4>{step.title}</h4>
						<p>{step.body}</p>
					</div>
				))}
			</div>
		</section>

		<section class="section faq-section" aria-labelledby="faq-heading">
			<div class="section-header">
				<span class="section-eyebrow">FAQ</span>
				<h2 class="section-title" id="faq-heading">Straight answers.</h2>
			</div>
			<dl class="faq-list">
				{faqItems.map((item) => (
					<div class="faq-item">
						<dt>{item.q}</dt>
						<dd>{item.a}</dd>
					</div>
				))}
			</dl>
		</section>

		<section class="section cta-section">
			<div class="cta-inner">
				<h2>Want an AI agent on voice, SMS, or chat?</h2>
				<p class="cta-lead">
					Tell us what channel you want first and what a win looks like. We help with everything you need to create the agent, connect LLMs, and run a pipeline you can trust.
				</p>
				<a href="/contact/" class="btn-solid">Get in touch</a>
			</div>
		</section>
	</main>
</div>

<style>
	.bg-blur {
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		z-index: 0;
		filter: blur(120px);
		opacity: 0.16;
		pointer-events: none;
	}

	.paint-strikes-bg {
		position: fixed;
		left: 38%;
		top: 8%;
		width: min(230vw, 2400px);
		height: auto;
		max-width: none;
		z-index: 0;
		pointer-events: none;
		opacity: 0.2;
		mix-blend-mode: lighten;
		transform: translateX(-50%) rotate(-3deg);
	}

	.hero-nav-end {
		display: flex;
		align-items: center;
		gap: 0.65rem;
	}

	.page {
		position: relative;
		z-index: 1;
	}

	.section {
		max-width: 1100px;
		margin: 0 auto;
		padding: 4rem 1.5rem;
	}

	.section-alt {
		max-width: none;
		background: var(--surface);
	}

	.section-alt > * {
		max-width: 1100px;
		margin-left: auto;
		margin-right: auto;
	}

	.hero {
		padding-top: 2rem;
	}

	.hero-nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 2rem;
	}

	.logo-link {
		display: inline-flex;
		opacity: 0.92;
		text-decoration: none;
	}

	.logo-link:hover {
		opacity: 1;
	}

	.hero-content {
		max-width: 900px;
	}

	.section-eyebrow {
		display: inline-block;
		font-family: var(--font-display);
		font-size: 1.2rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--text-muted);
		margin-bottom: 0.5rem;
	}

	.hero-title,
	.section-title {
		font-family: var(--font-display);
		font-weight: 400;
		text-transform: uppercase;
		letter-spacing: 0.02em;
		margin: 0;
		word-wrap: break-word;
		overflow-wrap: break-word;
	}

	.hero-title {
		font-size: clamp(2.4rem, 8vw, 5.5rem);
		line-height: 0.95;
	}

	.section-title {
		font-size: clamp(2rem, 6vw, 4rem);
		line-height: 1;
	}

	.section-lead {
		color: var(--text-muted);
		font-size: clamp(1rem, 1.8vw, 1.2rem);
		line-height: 1.6;
		max-width: 720px;
		margin: 0.75rem 0 0;
	}

	.hero-desc {
		color: var(--text-muted);
		font-size: clamp(1rem, 2vw, 1.3rem);
		line-height: 1.55;
		max-width: 700px;
		margin: 1rem 0 1.5rem;
	}

	.section-header {
		max-width: 760px;
		margin-bottom: 2rem;
	}

	.btn-solid,
	.btn-outline {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.55rem;
		padding: 0.78rem 1.6rem;
		border-radius: var(--radius);
		text-decoration: none;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.03em;
		font-size: 0.9rem;
		transition: background 0.25s, color 0.25s, border-color 0.25s, transform 0.15s;
	}

	.btn-solid {
		background: var(--text);
		color: var(--bg);
		border: 1px solid var(--text);
	}

	.btn-solid:hover {
		background: transparent;
		color: var(--text);
		transform: translateY(-1px);
	}

	.btn-outline {
		background: transparent;
		color: var(--text);
		border: 1px solid var(--border);
	}

	.btn-outline:hover {
		background: var(--text);
		color: var(--bg);
		border-color: var(--text);
		transform: translateY(-1px);
	}

	.btn-small {
		padding: 0.6rem 1rem;
		font-size: 0.86rem;
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}

	.crumbs-wrap {
		margin-top: 1.2rem;
		padding-top: 1rem;
		border-top: 1px solid var(--border);
	}

	.checklist {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 0.65rem;
		max-width: 52rem;
	}

	.checklist li {
		display: flex;
		gap: 0.75rem;
		align-items: flex-start;
		padding: 0.85rem 1rem;
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: var(--radius-sm);
		font-size: 0.98rem;
		line-height: 1.5;
		color: var(--text-muted);
	}

	.checklist-icon {
		color: var(--accent);
		margin-top: 0.15rem;
		flex-shrink: 0;
	}

	.who-list {
		margin-top: 0.5rem;
	}

	.grid-cards {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
		gap: 0.7rem;
	}

	.info-card {
		background: var(--bg);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		padding: 1.35rem;
	}

	.info-card h3 {
		font-family: var(--font-display);
		text-transform: uppercase;
		font-weight: 400;
		font-size: 1.2rem;
		line-height: 1.15;
		margin: 0 0 0.5rem;
	}

	.info-card p {
		color: var(--text-muted);
		margin: 0;
		line-height: 1.55;
		font-size: 0.96rem;
	}

	.icon {
		color: var(--accent);
		font-size: 1.45rem;
		margin-bottom: 0.8rem;
		display: block;
	}

	.examples-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
		gap: 0.75rem;
	}

	.example-card {
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		padding: 1.35rem 1.5rem;
	}

	.example-card h3 {
		font-family: var(--font-display);
		font-weight: 400;
		text-transform: uppercase;
		letter-spacing: 0.02em;
		font-size: 1.15rem;
		margin: 0 0 0.6rem;
		line-height: 1.2;
	}

	.example-card p {
		margin: 0;
		color: var(--text-muted);
		font-size: 0.98rem;
		line-height: 1.6;
	}

	.process-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
		gap: 0.6rem;
	}

	.process-step {
		background: var(--bg);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		padding: 1.4rem;
	}

	.step-number {
		display: block;
		font-size: 1.8rem;
		font-weight: 800;
		color: var(--accent);
		letter-spacing: -0.03em;
		margin-bottom: 0.35rem;
		line-height: 1;
	}

	.process-step h4 {
		margin: 0 0 0.45rem;
		font-size: 1.02rem;
		font-weight: 700;
	}

	.process-step p {
		margin: 0;
		color: var(--text-muted);
		font-size: 0.95rem;
		line-height: 1.5;
	}

	.faq-list {
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.faq-item {
		border: 1px solid var(--border);
		border-radius: var(--radius);
		background: var(--surface);
		padding: 1.15rem 1.35rem;
	}

	.faq-item dt {
		font-weight: 700;
		font-size: 1.02rem;
		margin: 0 0 0.5rem;
		color: var(--text);
	}

	.faq-item dd {
		margin: 0;
		color: var(--text-muted);
		line-height: 1.55;
		font-size: 0.97rem;
	}

	.cta-section {
		text-align: center;
	}

	.cta-inner {
		max-width: 760px;
		margin: 0 auto;
		border: 1px solid var(--border);
		background: var(--surface);
		border-radius: var(--radius);
		padding: 2.2rem 1.5rem;
	}

	.cta-inner h2 {
		font-family: var(--font-display);
		font-weight: 400;
		text-transform: uppercase;
		letter-spacing: 0.02em;
		font-size: clamp(2rem, 6vw, 4rem);
		line-height: 1;
		margin: 0 0 0.75rem;
	}

	.cta-lead {
		margin: 0 auto 1.35rem;
		color: var(--text-muted);
		font-size: 1rem;
		line-height: 1.55;
		max-width: 520px;
	}

	@media (max-width: 768px) {
		.paint-strikes-bg {
			top: 4%;
			left: 36%;
			width: 290vw;
			transform: translateX(-50%) rotate(-2deg);
			opacity: 0.14;
		}

		.section {
			padding: 3rem 1rem;
		}

		.hero {
			padding-top: 1.4rem;
		}

		.hero-nav {
			margin-bottom: 1.3rem;
		}

		.hero-actions {
			flex-direction: column;
			align-items: stretch;
		}

		.btn-solid,
		.btn-outline {
			min-height: 46px;
		}

		.process-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
