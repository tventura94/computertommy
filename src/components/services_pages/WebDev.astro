	/* Inner column is --section-max-inner; max-width includes horizontal padding so it matches section-alt children */
	.section {
		--section-max-inner: 1100px;
		--section-pad-x: 1.5rem;
		box-sizing: border-box;
		width: 100%;
		max-width: calc(var(--section-max-inner) + 2 * var(--section-pad-x));
		margin: 0 auto;
		padding: 4rem var(--section-pad-x);
	}

	.section-alt {
		max-width: none;
		background: var(--surface);
	}

	.section-alt > * {
		max-width: var(--section-max-inner);
		margin-left: auto;
		margin-right: auto;
	}

	/* Cool slate + cyan/indigo wash (scoped: not other section-alt bands) */
	.process-section.section-alt {
		position: relative;
		isolation: isolate;
		overflow-x: clip;
		background:
			radial-gradient(ellipse 110% 95% at 100% -5%, rgba(34, 211, 238, 0.14) 0%, transparent 46%),
			radial-gradient(ellipse 95% 90% at -8% 108%, rgba(129, 140, 248, 0.16) 0%, transparent 52%),
			radial-gradient(ellipse 70% 55% at 55% 42%, rgba(56, 189, 248, 0.08) 0%, transparent 48%),
			linear-gradient(168deg, #12121f 0%, #14141f 42%, #0d0f18 100%);
		box-shadow:
			inset 0 1px 0 rgba(255, 255, 255, 0.05),
			inset 0 -1px 0 rgba(0, 0, 0, 0.35);
	}

	.process-section.section-alt > * {
		position: relative;
		z-index: 1;
	}

