---
import '@fortawesome/fontawesome-free/css/all.min.css';
import astroLogo from '../../assets/computertommylogo.svg';
import background from '../../assets/background.svg';
import Breadcrumbs from '../Breadcrumbs.astro';
import ThemeToggleButton from '../ThemeToggleButton.astro';
import { locations } from '../../data/locations';

const cityPageLinks = locations
	.slice()
	.sort((a, b) => a.city.localeCompare(b.city))
	.map((l) => ({ href: `/services/web-development/${l.slug}/`, label: `${l.city}, ${l.regionLabel}` }));

const includedItems = [
	'Custom 3 to 5 page build: homepage designed around your main offer plus service pages that match how people search',
	'Mobile-first layout, tap targets, and phone-first calls to action where they matter',
	'Contact and quote form setup plus click-to-call on key pages',
	'Fast static pages with clean HTML instead of heavy builder output',
	'Basic on-page local SEO: titles, headings, meta descriptions, and internal links Google can follow',
	'Service page structure built for local intent and room to add location pages later',
	'Metadata setup and sensible internal linking between related services',
	'Google Business Profile alignment so your site URL and important pages match what you list publicly',
	'Launch-ready site you own, with support so the site is crawlable and usable from day one',
];

const faqItems = [
	{
		q: 'How much does a small business website cost?',
		a: 'Most one to five page builds fall in a clear range after a short scope call. You get a fixed price before work starts, not a surprise invoice or a monthly builder fee.',
	},
	{
		q: 'Do I own the website after it is built?',
		a: 'Yes. You get a launch-ready site you control. No subscription lock-in to keep the site online, and no proprietary platform you cannot leave.',
	},
	{
		q: 'Can you rebuild my existing GoDaddy, Wix, or WordPress site?',
		a: 'Usually yes. We can migrate the message and structure onto fast, clean pages, or refresh the design while keeping what already works for you.',
	},
	{
		q: 'Do you write the copy?',
		a: 'We write or tighten copy around search intent and conversion: clear headlines, service descriptions, and calls to action. You approve everything before launch.',
	},
	{
		q: 'Will the site be optimized for local SEO?',
		a: 'The build includes basic on-page local SEO: service and area signals in titles and headings, internal links, and pages structured so Google can understand what you offer and where.',
	},
	{
		q: 'Can you build location pages later?',
		a: 'Yes. The first build is structured so we can add city or neighborhood pages when you are ready, without rebuilding the whole site.',
	},
];
---

<div class="themed-subpage">
	<img class="bg-blur" src={background.src} alt="" fetchpriority="high" />
	<img src="/paint-splat.png" alt="" class="paint-strikes-bg" aria-hidden="true" />
	<main class="page">
		<section class="hero section">
			<div class="hero-nav">
				<a href="/" class="logo-link">
					<img src={astroLogo.src} width="115" height="48" alt="Computer Tommy Homepage" />
				</a>
				<div class="hero-nav-end">
					<ThemeToggleButton />
					<a href="/services/" class="btn-outline btn-small" aria-label="Back to services">
						<i class="fas fa-arrow-left"></i>
						<span>Services</span>
					</a>
				</div>
			</div>

			<div class="hero-content">
				<span class="section-eyebrow">Web development for local service businesses</span>
				<h1 class="hero-title">Websites built for calls, quotes, and local search.</h1>
				<p class="hero-desc">
					One-time build for contractors and home service companies in Western NC. No builder subscription trap. Fast pages, clear offers, and structure that supports how people actually search for your work.
				</p>
				<div class="hero-actions">
					<a href="/contact/" class="btn-solid">Start your project</a>
					<a href="/portfolio/" class="btn-outline">View portfolio</a>
				</div>
			</div>

			<div class="crumbs-wrap">
				<Breadcrumbs
					variant="dark"
					items={[{ href: '/', label: 'Home' }, { href: '/services/', label: 'Services' }]}
					current="Web development"
				/>
			</div>
		</section>

		<section class="section" aria-labelledby="who-for-heading">
			<div class="section-header">
				<span class="section-eyebrow">Who this is for</span>
				<h2 class="section-title" id="who-for-heading">The trades we build for most.</h2>
				<p class="section-lead">
					We build websites for local service businesses that need more calls, cleaner branding, and a site that supports local SEO. That includes contractors, home service crews, solo operators, and small brands that live on phone calls, quote requests, and trust.
				</p>
			</div>

			<p class="trade-chips-label">Examples of who we work with:</p>
			<ul class="trade-chips">
				<li>Junk removal</li>
				<li>Pressure washing</li>
				<li>Grading and excavation</li>
				<li>Remodeling</li>
				<li>Landscaping</li>
				<li>Mobile detailing</li>
				<li>Plumbing and electrical</li>
				<li>HVAC and other home services</li>
			</ul>

			<div class="two-col">
				<div class="prose-block">
					<h3 class="prose-block-title">What those businesses usually need</h3>
					<ul class="prose-list">
						<li>A homepage that states the main offer in seconds, not paragraphs of filler</li>
						<li>Service pages that match how people search (by job type and sometimes by area)</li>
						<li>Phone-first actions: click-to-call, short forms, and obvious next steps on mobile</li>
						<li>Proof: photos, short testimonials, or project context so visitors feel safe hiring you</li>
						<li>Clean technical setup so Google can crawl the site and users are not waiting on bloated scripts</li>
					</ul>
				</div>
				<div class="prose-block prose-block--accent">
					<h3 class="prose-block-title">Common problems we fix</h3>
					<ul class="prose-list">
						<li>Old sites that look dated or break on small screens</li>
						<li>No clear call to action above the fold</li>
						<li>Slow builder sites with bloated code and generic templates</li>
						<li>Pages that do not target specific services or service areas</li>
						<li>Weak trust signals: cluttered layout, vague copy, or no proof of real work</li>
					</ul>
				</div>
			</div>
		</section>

		<section class="section section-alt" aria-labelledby="underperform-heading">
			<div class="section-header">
				<span class="section-eyebrow">Straight talk</span>
				<h2 class="section-title" id="underperform-heading">Why most local service websites underperform.</h2>
			</div>
			<div class="opinion-card">
				<p>
					Most small business websites fail for simple reasons: they look dated, bury the phone number, use weak headlines, and treat every visitor the same. A strong local service site explains the offer fast, makes trust easy, and guides people toward calling or requesting a quote. It also needs enough structure for Google to understand what service you offer and where you offer it. We build with that outcome in mind, not generic agency slides.
				</p>
			</div>
		</section>

		<section class="section" aria-labelledby="included-heading">
			<div class="section-header">
				<span class="section-eyebrow">Deliverables</span>
				<h2 class="section-title" id="included-heading">What is included in a web development build.</h2>
				<p class="section-lead">
					Concrete items you can expect on a typical local service site. Scope adjusts if you need fewer pages or a larger build.
				</p>
			</div>
			<ul class="checklist">
				{includedItems.map((item) => (
					<li>
						<i class="fas fa-check checklist-icon" aria-hidden="true"></i>
						<span>{item}</span>
					</li>
				))}
			</ul>
		</section>

		<section class="section section-alt" aria-labelledby="local-process-heading">
			<div class="section-header">
				<span class="section-eyebrow">Local SEO websites</span>
				<h2 class="section-title" id="local-process-heading">How we build local business websites.</h2>
				<p class="section-lead">
					Every step ties to the outcome: more qualified traffic and easier contact from people in your market.
				</p>
			</div>
			<div class="process-grid process-grid--local">
				<div class="process-step">
					<span class="step-number">01</span>
					<h4>Main service, main city first</h4>
					<p>We lock in what you sell first and where you want to win first, so the site hierarchy matches real search behavior.</p>
				</div>
				<div class="process-step">
					<span class="step-number">02</span>
					<h4>Pages that deserve to rank</h4>
					<p>We structure the site around pages that earn traffic: core services, proof, and contact paths, not endless thin pages.</p>
				</div>
				<div class="process-step">
					<span class="step-number">03</span>
					<h4>Copy for intent and conversion</h4>
					<p>Headlines and body copy speak to what someone typed or tapped for, not filler that could apply to any business.</p>
				</div>
				<div class="process-step">
					<span class="step-number">04</span>
					<h4>Fast HTML and internal links</h4>
					<p>Clean markup, fast loads, and sensible internal linking so users and crawlers both see a clear picture of your services.</p>
				</div>
				<div class="process-step">
					<span class="step-number">05</span>
					<h4>Launch ready for Google and customers</h4>
					<p>We launch with metadata, forms, and calls to action in place so the site is usable and crawlable from day one.</p>
				</div>
			</div>
		</section>

		<section class="section" aria-labelledby="types-heading">
			<div class="section-header">
				<span class="section-eyebrow">Site types</span>
				<h2 class="section-title" id="types-heading">What we can build for service businesses.</h2>
			</div>
			<div class="grid-cards">
				<div class="info-card">
					<h3>Core business sites</h3>
					<p>Multi-page sites for companies that need home, services, about, and contact with room to grow.</p>
				</div>
				<div class="info-card">
					<h3>Service-heavy layouts</h3>
					<p>When you offer several distinct jobs, we give each one a clear page instead of one long wall of text.</p>
				</div>
				<div class="info-card">
					<h3>Landing pages</h3>
					<p>Focused pages for ads, seasonal offers, or a single high-intent service.</p>
				</div>
				<div class="info-card">
					<h3>Solo operator brands</h3>
					<p>Compact sites for owner-led crews who need credibility and a phone number in the right places.</p>
				</div>
			</div>
		</section>

		<section class="section section-alt" aria-labelledby="compare-heading">
			<div class="section-header">
				<span class="section-eyebrow">Comparison</span>
				<h2 class="section-title" id="compare-heading">Custom-coded site vs website builder.</h2>
			</div>
			<div class="compare-wrap">
				<table class="compare-table">
					<thead>
						<tr>
							<th scope="col">Custom build</th>
							<th scope="col">Builder site</th>
						</tr>
					</thead>
					<tbody>
						<tr>
							<td>Cleaner, purpose-built code</td>
							<td>Often bloated template output</td>
						</tr>
						<tr>
							<td>You own the site</td>
							<td>Subscription and platform lock-in</td>
						</tr>
						<tr>
							<td>Better performance control</td>
							<td>Limited control over speed and structure</td>
						</tr>
						<tr>
							<td>Structure tuned for local SEO</td>
							<td>Generic layouts that compete with thousands of similar sites</td>
						</tr>
						<tr>
							<td>Easier to tailor to trades and offers</td>
							<td>One-size blocks that bury your differentiators</td>
						</tr>
					</tbody>
				</table>
			</div>
		</section>

		<section class="section faq-section" aria-labelledby="faq-heading">
			<div class="section-header">
				<span class="section-eyebrow">FAQ</span>
				<h2 class="section-title" id="faq-heading">Questions we hear a lot.</h2>
			</div>
			<dl class="faq-list">
				{faqItems.map((item) => (
					<div class="faq-item">
						<dt>{item.q}</dt>
						<dd>{item.a}</dd>
					</div>
				))}
			</dl>
		</section>

		<section class="section location-note-section" aria-labelledby="city-pages-heading">
			<h2 class="visually-hidden" id="city-pages-heading">City-specific pages</h2>
			<p class="location-note">
				<strong>City and neighborhood detail</strong> lives on dedicated location pages (local references, market context, and why hire you there). This page stays focused on the service, deliverables, and process.
			</p>
			<ul class="city-link-list">
				{cityPageLinks.map((link) => (
					<li>
						<a href={link.href}>{link.label}</a>
					</li>
				))}
			</ul>
		</section>

		<section class="section cta-section">
			<div class="cta-inner">
				<h2>Ready to get your site built right?</h2>
				<a href="/contact/" class="btn-solid">Get started now</a>
			</div>
		</section>
	</main>
</div>

<style>
	.bg-blur {
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		z-index: 0;
		filter: blur(120px);
		opacity: 0.16;
		pointer-events: none;
	}

	.paint-strikes-bg {
		position: fixed;
		left: 38%;
		top: 8%;
		width: min(230vw, 2400px);
		height: auto;
		max-width: none;
		z-index: 0;
		pointer-events: none;
		opacity: 0.2;
		mix-blend-mode: lighten;
		transform: translateX(-50%) rotate(-3deg);
	}

	.hero-nav-end {
		display: flex;
		align-items: center;
		gap: 0.65rem;
	}

	.page {
		position: relative;
		z-index: 1;
	}

	.section {
		max-width: 1100px;
		margin: 0 auto;
		padding: 4rem 1.5rem;
	}

	.section-alt {
		max-width: none;
		background: var(--surface);
	}

	.section-alt > * {
		max-width: 1100px;
		margin-left: auto;
		margin-right: auto;
	}

	.hero {
		padding-top: 2rem;
	}

	.hero-nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 2rem;
	}

	.logo-link {
		display: inline-flex;
		opacity: 0.92;
		text-decoration: none;
	}

	.logo-link:hover {
		opacity: 1;
	}

	.hero-content {
		max-width: 900px;
	}

	.section-eyebrow {
		display: inline-block;
		font-family: var(--font-display);
		font-size: 1.2rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--text-muted);
		margin-bottom: 0.5rem;
	}

	.hero-title,
	.section-title {
		font-family: var(--font-display);
		font-weight: 400;
		text-transform: uppercase;
		letter-spacing: 0.02em;
		margin: 0;
	}

	.hero-title {
		font-size: clamp(2.4rem, 8vw, 5.5rem);
		line-height: 0.95;
	}

	.section-title {
		font-size: clamp(2rem, 6vw, 4rem);
		line-height: 1;
	}

	.section-lead {
		color: var(--text-muted);
		font-size: clamp(1rem, 1.8vw, 1.2rem);
		line-height: 1.6;
		max-width: 720px;
		margin: 0.75rem 0 0;
	}

	.hero-desc {
		color: var(--text-muted);
		font-size: clamp(1rem, 2vw, 1.3rem);
		line-height: 1.55;
		max-width: 700px;
		margin: 1rem 0 1.5rem;
	}

	.section-header {
		max-width: 760px;
		margin-bottom: 2rem;
	}

	.btn-solid,
	.btn-outline {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.55rem;
		padding: 0.78rem 1.6rem;
		border-radius: var(--radius);
		text-decoration: none;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.03em;
		transition: background 0.25s, color 0.25s, border-color 0.25s, transform 0.15s;
	}

	.btn-solid {
		background: var(--text);
		color: var(--bg);
		border: 1px solid var(--text);
	}

	.btn-solid:hover {
		background: transparent;
		color: var(--text);
		transform: translateY(-1px);
	}

	.btn-outline {
		background: transparent;
		color: var(--text);
		border: 1px solid var(--border);
	}

	.btn-outline:hover {
		background: var(--text);
		color: var(--bg);
		border-color: var(--text);
		transform: translateY(-1px);
	}

	.btn-small {
		padding: 0.6rem 1rem;
		font-size: 0.86rem;
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}

	.crumbs-wrap {
		margin-top: 1.2rem;
		padding-top: 1rem;
		border-top: 1px solid var(--border);
	}

	.trade-chips-label {
		font-size: 0.8rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--text-muted);
		margin: 0 0 0.65rem;
	}

	.trade-chips {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		list-style: none;
		padding: 0;
		margin: 0 0 2rem;
	}

	.trade-chips li {
		padding: 0.4rem 0.85rem;
		border-radius: 999px;
		border: 1px solid var(--border);
		background: var(--surface);
		font-size: 0.9rem;
		color: var(--text);
	}

	.two-col {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1rem;
		align-items: start;
	}

	.prose-block {
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		padding: 1.35rem 1.5rem;
	}

	.prose-block--accent {
		border-color: rgba(249, 115, 22, 0.35);
		background: rgba(249, 115, 22, 0.06);
	}

	.prose-block-title {
		font-family: var(--font-display);
		font-size: 1.35rem;
		font-weight: 400;
		text-transform: uppercase;
		letter-spacing: 0.02em;
		margin: 0 0 0.85rem;
	}

	.prose-list {
		margin: 0;
		padding-left: 1.15rem;
		color: var(--text-muted);
		line-height: 1.55;
	}

	.prose-list li {
		margin-bottom: 0.5rem;
	}

	.prose-list li:last-child {
		margin-bottom: 0;
	}

	.opinion-card {
		max-width: 820px;
		border: 1px solid var(--border);
		border-radius: var(--radius);
		padding: 1.5rem 1.75rem;
		background: var(--bg);
	}

	.opinion-card p {
		margin: 0;
		font-size: clamp(1.02rem, 1.6vw, 1.15rem);
		line-height: 1.65;
		color: var(--text-muted);
	}

	.checklist {
		list-style: none;
		padding: 0;
		margin: 0 0 1.5rem;
		display: flex;
		flex-direction: column;
		gap: 0.65rem;
	}

	.checklist li {
		display: flex;
		gap: 0.75rem;
		align-items: flex-start;
		padding: 0.85rem 1rem;
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: var(--radius-sm);
		font-size: 0.98rem;
		line-height: 1.5;
		color: var(--text-muted);
	}

	.checklist-icon {
		color: var(--accent);
		margin-top: 0.15rem;
		flex-shrink: 0;
	}

	.grid-cards {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
		gap: 0.7rem;
	}

	.info-card {
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		padding: 1.35rem;
	}

	.info-card h3 {
		font-family: var(--font-display);
		text-transform: uppercase;
		font-weight: 400;
		font-size: 1.35rem;
		margin: 0 0 0.5rem;
	}

	.info-card p {
		color: var(--text-muted);
		margin: 0;
		line-height: 1.55;
	}

	.process-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
		gap: 0.6rem;
	}

	.process-grid--local {
		grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
	}

	.process-step {
		background: var(--bg);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		padding: 1.4rem;
	}

	.step-number {
		display: block;
		font-size: 1.8rem;
		font-weight: 800;
		color: var(--accent);
		letter-spacing: -0.03em;
		margin-bottom: 0.35rem;
	}

	.process-step h4 {
		margin: 0 0 0.45rem;
		font-size: 1.02rem;
		font-weight: 700;
	}

	.process-step p {
		margin: 0;
		color: var(--text-muted);
		font-size: 0.95rem;
		line-height: 1.5;
	}

	.compare-wrap {
		overflow-x: auto;
		border-radius: var(--radius);
		border: 1px solid var(--border);
	}

	.compare-table {
		width: 100%;
		border-collapse: collapse;
		font-size: 0.95rem;
		min-width: 520px;
	}

	.compare-table th,
	.compare-table td {
		padding: 0.85rem 1rem;
		text-align: left;
		vertical-align: top;
		border-bottom: 1px solid var(--border);
	}

	.compare-table th {
		font-family: var(--font-display);
		text-transform: uppercase;
		letter-spacing: 0.04em;
		font-size: 1.1rem;
		font-weight: 400;
		background: var(--bg);
		color: var(--text);
	}

	.compare-table tbody tr:last-child th,
	.compare-table tbody tr:last-child td {
		border-bottom: none;
	}

	.compare-table td {
		color: var(--text-muted);
		width: 50%;
	}

	.compare-table tbody tr:nth-child(even) td,
	.compare-table tbody tr:nth-child(even) th {
		background: rgba(0, 0, 0, 0.15);
	}

	.faq-list {
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.faq-item {
		border: 1px solid var(--border);
		border-radius: var(--radius);
		background: var(--surface);
		padding: 1.15rem 1.35rem;
	}

	.faq-item dt {
		font-weight: 700;
		font-size: 1.05rem;
		margin: 0 0 0.5rem;
		color: var(--text);
	}

