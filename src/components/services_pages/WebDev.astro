	.logo-carousel-section {
		padding-top: 2.25rem;
		padding-bottom: 3rem;
	}

	.logo-carousel-eyebrow {
		margin: 0 0 1.5rem;
		font-family: var(--font-display);
		font-size: clamp(0.95rem, 2.2vw, 1.2rem);
		font-weight: 800;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--accent);
		text-align: center;
	}

	.logo-carousel-viewport {
		overflow: hidden;
	}

	.logo-carousel-track {
		display: flex;
		width: max-content;
		animation: logo-carousel-marquee 55s linear infinite;
		will-change: transform;
	}

	.logo-carousel-group {
		display: flex;
		flex-wrap: nowrap;
		align-items: center;
		gap: clamp(2rem, 5vw, 4.5rem);
		padding-right: clamp(2rem, 5vw, 4.5rem);
	}

	.logo-carousel-item {
		display: flex;
		align-items: center;
		justify-content: center;
		flex: 0 0 auto;
		text-decoration: none;
		opacity: 0.92;
		transition: opacity 0.2s;
	}

	.logo-carousel-item:hover {
		opacity: 1;
	}

	.logo-carousel-item:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 6px;
		border-radius: 4px;
	}

	.logo-carousel-item img {
		display: block;
		width: auto;
		height: auto;
		max-height: clamp(56px, 9vw, 96px);
		max-width: min(240px, 32vw);
		object-fit: contain;
		object-position: center;
	}

	@keyframes logo-carousel-marquee {
		to {
			transform: translateX(-50%);
		}
