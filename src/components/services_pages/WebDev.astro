---
import '@fortawesome/fontawesome-free/css/all.min.css';
import astroLogo from '../../assets/computertommylogo.svg';
import background from '../../assets/background.svg';
import Breadcrumbs from '../Breadcrumbs.astro';
import ThemeToggleButton from '../ThemeToggleButton.astro';
import { businessLogos } from '../../data/businessLogos';
import { webdevTradePhotos } from '../../data/webdevTrades';

const deliverableFeature = {
	title: 'A 1 to 10 page site built for how people hire you.',
	desc: 'One to ten pages, custom to you. Homepage centers your main offer, with service pages shaped around real search intent instead of filler.',
};

const deliverablePillars = [
	{
		icon: 'fa-bullseye',
		title: 'Conversion',
		bullets: [
			'Mobile-first layout and tap targets where the phone is the sales floor.',
			'Click-to-call and quote paths placed where people actually decide.',
			'Short contact and quote forms so visitors finish instead of bouncing.',
		],
	},
	{
		icon: 'fa-chart-line',
		title: 'SEO foundation',
		bullets: [
			'Titles, headings, and metadata Google can read without guessing.',
			'Internal links that connect services instead of orphaning them.',
			'Page hierarchy ready when you want city or neighborhood pages.',
		],
	},
	{
		icon: 'fa-bolt',
		title: 'Performance',
		bullets: [
			'Fast, clean codebase. Pages load fast and stay easy for Google to read.',
			'No bloated builder output stealing speed before the first real headline.',
		],
	},
	{
		icon: 'fa-rocket',
		title: 'Launch setup',
		bullets: [
			'Launch-ready and yours. No platform lock-in to stay online.',
			'Goes live structured to be usable, crawlable, and ready to grow.',
			'Google Business Profile alignment so listings and URLs line up.',
		],
	},
];

const buildProcessSteps: {
	num: string;
	title: string;
	body: string;
	paymentNote?: string;
}[] = [
	{
		num: '01',
		title: 'Learn the business',
		body: 'First I get clear on what you do, where the business is stuck, what services matter most, and what a win actually looks like. That gives the project direction before any design starts.',
	},
	{
		num: '02',
		title: 'Audit the local market',
		body: 'Then I look at your area, your competitors, local search results, and how similar businesses are positioning themselves. From that, I build a plan of attack around structure, priorities, and what the site needs to compete.',
	},
	{
		num: '03',
		title: 'Review the plan together',
		body: 'I bring that plan back to you so we can go over it, adjust anything needed, and make sure we agree on the direction before the build starts.',
	},
	{
		num: '04',
		title: 'Deposit paid, build begins',
		body: 'Once we are aligned, the first payment is made and I start designing the site. If I cannot build you something you are happy with, you get your money back.',
		paymentNote: 'Deposit locks your start date. Balance is due at launch after you approve the site.',
	},
	{
		num: '05',
		title: 'Design revision loop',
		body: 'We go back and forth on the design until it feels right. The goal is not to force a template on you. The goal is to land on something clear, credible, and worth putting in front of customers.',
	},
	{
		num: '06',
		title: 'Copy, keywords, and positioning',
		body: 'Once the design is locked in, I refine the copy, do keyword research, study what is working for competitors, and tighten the messaging so the site lines up with real search behavior and real buyers.',
	},
	{
		num: '07',
		title: 'Technical SEO and performance',
		body: 'After the content is in place, I go through the technical side: headings, metadata, internal links, crawlability, page speed, mobile behavior, and the rest of the details that make the site usable and search-friendly.',
	},
	{
		num: '08',
		title: 'Final approval and launch',
		body: 'When everything looks right and runs right, the remaining balance is paid and the site is ready to deploy.',
		paymentNote: 'You sign off before anything goes live. No launch until you say it is ready.',
	},
];

const underperformProblems = [
	{
		icon: 'fa-image',
		title: 'Weak first impression',
		desc: 'Outdated design, awkward spacing, and weak trust signals before anyone scrolls.',
	},
	{
		icon: 'fa-route',
		title: 'Poor conversion path',
		desc: 'Hidden phone number, soft call to action, and no obvious next step on mobile.',
	},
	{
		icon: 'fa-comments',
		title: 'Generic messaging',
		desc: 'Copy that tries to say everything and does not land anywhere specific.',
	},
	{
		icon: 'fa-map-marked-alt',
		title: 'No local SEO structure',
		desc: 'Pages and headings do not help Google map what you do to where you do it.',
	},
];

const faqItems = [
	{
		q: 'How much does a small business website cost?',
		a: 'Most one to five page builds fall in a clear range after a short scope call. You get a fixed price before work starts, not a surprise invoice or a monthly builder fee.',
	},
	{
		q: 'Do I own the website after it is built?',
		a: 'Yes. You get a launch-ready site you control. No subscription lock-in to keep the site online, and no proprietary platform you cannot leave.',
	},
	{
		q: 'Can you rebuild my existing GoDaddy, Wix, or WordPress site?',
		a: 'Usually yes. We can migrate the message and structure onto fast, clean pages, or refresh the design while keeping what already works for you.',
	},
	{
		q: 'Do you write the copy?',
		a: 'We write or tighten copy around search intent and conversion: clear headlines, service descriptions, and calls to action. You approve everything before launch.',
	},
	{
		q: 'Will the site be optimized for local SEO?',
		a: 'The build includes basic on-page local SEO: service and area signals in titles and headings, internal links, and pages structured so Google can understand what you offer and where.',
	},
	{
		q: 'Can you build location pages later?',
		a: 'Yes. The first build is structured so we can add city or neighborhood pages when you are ready, without rebuilding the whole site.',
	},
];
---

<div class="themed-subpage">
	<img class="bg-blur" src={background.src} alt="" fetchpriority="high" />
	<img src="/paint-splat.png" alt="" class="paint-strikes-bg" aria-hidden="true" />
	<main class="page">
		<section class="hero section">
			<div class="hero-nav">
				<a href="/" class="logo-link">
					<img src={astroLogo.src} width="115" height="48" alt="Computer Tommy Homepage" />
				</a>
				<div class="hero-nav-end">
					<ThemeToggleButton />
					<a href="/services/" class="btn-outline btn-small" aria-label="Back to services">
						<i class="fas fa-arrow-left"></i>
						<span>Services</span>
					</a>
				</div>
			</div>

			<div class="hero-content">
				<span class="section-eyebrow">Web development for local service businesses</span>
				<h1 class="hero-title">Websites built for calls, quotes, and local search.</h1>
				<p class="hero-desc">
					One-time build for contractors and home service companies in Western NC. No builder subscription trap. Fast pages, clear offers, and structure that supports how people actually search for your work.
				</p>
				<div class="hero-actions">
					<a href="/contact/" class="btn-solid">Start your project</a>
					<a href="/portfolio/" class="btn-outline">View portfolio</a>
				</div>
			</div>

			<div class="crumbs-wrap">
				<Breadcrumbs
					variant="dark"
					items={[{ href: '/', label: 'Home' }, { href: '/services/', label: 'Services' }]}
					current="Web development"
				/>
			</div>
		</section>

		{businessLogos.length > 0 && (
			<section class="section logo-carousel-section" aria-labelledby="social-proof-heading">
				<h2 class="visually-hidden" id="social-proof-heading">Recent client sites</h2>
				<p class="logo-carousel-eyebrow">Trusted businesses we have built for</p>
				<div class="logo-carousel-viewport">
					<div class="logo-carousel-track">
						<div class="logo-carousel-group">
							{businessLogos.map((item) => (
								<a
									class="logo-carousel-item"
									href={item.href}
									target="_blank"
									rel="noopener noreferrer"
									aria-label={`${item.title} website`}
								>
									<img
										src={item.logo.src}
										width={item.logo.width ?? 200}
										height={item.logo.height ?? 48}
										alt=""
										loading="lazy"
										decoding="async"
									/>
								</a>
							))}
						</div>
						<div class="logo-carousel-group" aria-hidden="true">
							{businessLogos.map((item) => (
								<a
									class="logo-carousel-item"
									href={item.href}
									tabindex="-1"
									target="_blank"
									rel="noopener noreferrer"
								>
									<img
										src={item.logo.src}
										width={item.logo.width ?? 200}
										height={item.logo.height ?? 48}
										alt=""
										loading="lazy"
										decoding="async"
									/>
								</a>
							))}
						</div>
					</div>
				</div>
			</section>
		)}

		<section class="section who-for-section" aria-labelledby="who-for-heading">
			<div class="section-header">
				<span class="section-eyebrow">Who this is for</span>
				<h2 class="section-title" id="who-for-heading">The trades we build for most.</h2>
				<p class="section-lead">
					We build websites for local service businesses that need more calls, cleaner branding, and a site that supports local SEO. That includes contractors, home service crews, solo operators, and small brands that live on phone calls, quote requests, and trust.
				</p>
			</div>

			<div class="who-for-visual" aria-labelledby="who-for-examples-heading">
				<p class="who-for-visual-heading" id="who-for-examples-heading">Examples of who we work with</p>
				<div class="who-for-mosaic-wrap">
					<div class="who-for-mosaic">
						{webdevTradePhotos.map((trade, i) => (
							<figure class:list={['who-for-card', `who-for-card--${i + 1}`]}>
								<img
									class="who-for-card-img"
									src={trade.image.src}
									width={trade.image.width}
									height={trade.image.height}
									alt={trade.alt}
									loading="lazy"
									decoding="async"
									fetchpriority="low"
									sizes="(max-width: 380px) 42vw, (max-width: 520px) 38vw, (max-width: 768px) 34vw, (max-width: 900px) 28vw, 280px"
								/>
								<figcaption class="who-for-card-label">{trade.title}</figcaption>
							</figure>
						))}
					</div>
				</div>
			</div>

			<p class="trade-chips-label trade-chips-label--more">More trades and service types:</p>
			<ul class="trade-chips">
				<li>Junk removal</li>
				<li>Pressure washing</li>
				<li>Grading and excavation</li>
				<li>Remodeling</li>
				<li>Landscaping</li>
				<li>Mobile detailing</li>
				<li>Plumbing and electrical</li>
				<li>HVAC and other home services</li>
			</ul>

			<div class="two-col two-col--who-need">
				<div class="prose-block prose-block--needs">
					<h3 class="prose-block-title">What those businesses usually need</h3>
					<ul class="prose-list prose-list--scan">
						<li>
							<i class="fas fa-check-circle prose-scan-icon prose-scan-icon--needs" aria-hidden="true"></i>
							<div class="prose-scan-body">
								<strong>Homepage that sells fast.</strong>
								<span class="prose-scan-detail">Main offer in seconds, not filler paragraphs.</span>
							</div>
						</li>
						<li>
							<i class="fas fa-check-circle prose-scan-icon prose-scan-icon--needs" aria-hidden="true"></i>
							<div class="prose-scan-body">
								<strong>Service pages for real searches.</strong>
								<span class="prose-scan-detail">By job type and sometimes by area.</span>
							</div>
						</li>
						<li>
							<i class="fas fa-check-circle prose-scan-icon prose-scan-icon--needs" aria-hidden="true"></i>
							<div class="prose-scan-body">
								<strong>Phone-first actions.</strong>
								<span class="prose-scan-detail">Click-to-call, short forms, obvious next steps on mobile.</span>
							</div>
						</li>
						<li>
							<i class="fas fa-check-circle prose-scan-icon prose-scan-icon--needs" aria-hidden="true"></i>
							<div class="prose-scan-body">
								<strong>Proof people can trust.</strong>
								<span class="prose-scan-detail">Photos, testimonials, or real project context.</span>
							</div>
						</li>
						<li>
							<i class="fas fa-check-circle prose-scan-icon prose-scan-icon--needs" aria-hidden="true"></i>
							<div class="prose-scan-body">
								<strong>Clean technical base.</strong>
								<span class="prose-scan-detail">Crawlable pages without bloated script stacks.</span>
							</div>
						</li>
					</ul>
				</div>
				<div class="prose-block prose-block--pain">
					<p class="prose-block-eyebrow">What we hear most</p>
					<h3 class="prose-block-title prose-block-title--pain">Common problems we fix</h3>
					<ul class="prose-list prose-list--scan prose-list--pain">
						<li>
							<i class="fas fa-exclamation-circle prose-scan-icon prose-scan-icon--pain" aria-hidden="true"></i>
							<div class="prose-scan-body">
								<strong>Looks dated or breaks on mobile.</strong>
								<span class="prose-scan-detail">Layouts that quietly lose leads.</span>
							</div>
						</li>
						<li>
							<i class="fas fa-exclamation-circle prose-scan-icon prose-scan-icon--pain" aria-hidden="true"></i>
							<div class="prose-scan-body">
								<strong>No clear CTA above the fold.</strong>
								<span class="prose-scan-detail">Visitors leave without a next step.</span>
							</div>
						</li>
						<li>
							<i class="fas fa-exclamation-circle prose-scan-icon prose-scan-icon--pain" aria-hidden="true"></i>
							<div class="prose-scan-body">
								<strong>Slow builder bloat.</strong>
								<span class="prose-scan-detail">Heavy code and generic templates.</span>
							</div>
						</li>
						<li>
							<i class="fas fa-exclamation-circle prose-scan-icon prose-scan-icon--pain" aria-hidden="true"></i>
							<div class="prose-scan-body">
								<strong>Thin or vague pages.</strong>
								<span class="prose-scan-detail">Nothing that ranks for specific services or towns.</span>
							</div>
						</li>
						<li>
							<i class="fas fa-exclamation-circle prose-scan-icon prose-scan-icon--pain" aria-hidden="true"></i>
							<div class="prose-scan-body">
								<strong>Weak trust signals.</strong>
								<span class="prose-scan-detail">Clutter, vague copy, or no proof of real work.</span>
							</div>
						</li>
					</ul>
				</div>
			</div>
		</section>

		<section class="section section-alt underperform-section" aria-labelledby="underperform-heading">
			<div class="underperform-layout">
				<div class="underperform-intro">
					<span class="section-eyebrow">Straight talk</span>
					<h2 class="section-title underperform-heading" id="underperform-heading">
						Why most local service websites underperform.
					</h2>
					<p class="underperform-deck">A lot of them fail in the same predictable ways.</p>
				</div>
				<ul class="underperform-stack" role="list">
					{underperformProblems.map((item) => (
						<li class="underperform-card">
							<div class="underperform-card-icon" aria-hidden="true">
								<i class:list={['fas', item.icon]}></i>
							</div>
							<div class="underperform-card-body">
								<h3 class="underperform-card-title">{item.title}</h3>
								<p class="underperform-card-desc">{item.desc}</p>
							</div>
						</li>
					))}
				</ul>
			</div>
		</section>

		<section class="section deliverables-section" aria-labelledby="included-heading">
			<div class="section-header">
				<span class="section-eyebrow">Deliverables</span>
				<h2 class="section-title" id="included-heading">What is included in a web development build.</h2>
				<p class="section-lead deliverables-lead">
					What you actually get in a typical build, and why each block earns its place. Scope tightens or grows once we align on the pages you need.
				</p>
			</div>

			<article class="deliverable-feature-card" aria-labelledby="deliverable-feature-title">
				<div class="deliverable-feature-accent" aria-hidden="true"></div>
				<div class="deliverable-feature-inner">
					<p class="deliverable-feature-eyebrow">Core scope</p>
					<h3 class="deliverable-feature-title" id="deliverable-feature-title">{deliverableFeature.title}</h3>
					<p class="deliverable-feature-desc">{deliverableFeature.desc}</p>
				</div>
			</article>

			<div class="deliverable-pillars">
				{deliverablePillars.map((pillar) => (
					<article class="deliverable-pillar">
						<div class="deliverable-pillar-head">
							<div class="deliverable-pillar-icon" aria-hidden="true">
								<i class:list={['fas', pillar.icon]}></i>
							</div>
							<h3 class="deliverable-pillar-title">{pillar.title}</h3>
						</div>
						<ul class="deliverable-pillar-list">
							{pillar.bullets.map((line) => (
								<li>{line}</li>
							))}
						</ul>
					</article>
				))}
			</div>
		</section>

		<section class="section section-alt process-section" aria-labelledby="build-process-heading">
			<div class="section-header process-section__header">
				<span class="section-eyebrow">Process</span>
				<h2 class="section-title" id="build-process-heading">From discovery to launch.</h2>
				<p class="section-lead process-section__lead">
					A practical build process shaped around your business, your market, and what actually needs to happen to get the site live.
				</p>
			</div>
			<ol class="process-timeline">
				{buildProcessSteps.map((step) => (
					<li class="process-timeline-item">
						<div class="process-timeline-marker">
							<span class="process-timeline-num">{step.num}</span>
						</div>
						<div class="process-timeline-body">
							<h3 class="process-timeline-title">{step.title}</h3>
							<p class="process-timeline-desc">{step.body}</p>
							{step.paymentNote && <p class="process-payment-note">{step.paymentNote}</p>}
						</div>
					</li>
				))}
			</ol>
		</section>

		<section class="section site-types-section" aria-labelledby="types-heading">
			<div class="section-header">
				<span class="section-eyebrow">Site types</span>
				<h2 class="section-title" id="types-heading">What we can build for service businesses.</h2>
			</div>
			<div class="grid-cards grid-cards--site-types">
				<div class="info-card info-card--site-type">
					<h3>Core business sites</h3>
					<p>Multi-page sites for companies that need home, services, about, and contact with room to grow.</p>
				</div>
				<div class="info-card info-card--site-type">
					<h3>Service-heavy layouts</h3>
					<p>When you offer several distinct jobs, we give each one a clear page instead of one long wall of text.</p>
				</div>
				<div class="info-card info-card--site-type">
					<h3>Landing pages</h3>
					<p>Focused pages for ads, seasonal offers, or a single high-intent service.</p>
				</div>
				<div class="info-card info-card--site-type">
					<h3>Solo operator brands</h3>
					<p>Compact sites for owner-led crews who need credibility and a phone number in the right places.</p>
				</div>
			</div>
		</section>

		<section class="section section-alt" aria-labelledby="compare-heading">
			<div class="section-header">
				<span class="section-eyebrow">Comparison</span>
				<h2 class="section-title" id="compare-heading">Custom-coded site vs website builder.</h2>
			</div>
			<div class="compare-wrap">
				<table class="compare-table">
					<thead>
						<tr>
							<th scope="col">Custom build</th>
							<th scope="col">Builder site</th>
						</tr>
					</thead>
					<tbody>
						<tr>
							<td>Cleaner, purpose-built code</td>
							<td>Often bloated template output</td>
						</tr>
						<tr>
							<td>You own the site</td>
							<td>Subscription and platform lock-in</td>
						</tr>
						<tr>
							<td>Better performance control</td>
							<td>Limited control over speed and structure</td>
						</tr>
						<tr>
							<td>Structure tuned for local SEO</td>
							<td>Generic layouts that compete with thousands of similar sites</td>
						</tr>
						<tr>
							<td>Easier to tailor to trades and offers</td>
							<td>One-size blocks that bury your differentiators</td>
						</tr>
					</tbody>
				</table>
			</div>
		</section>

		<section class="section faq-section" aria-labelledby="faq-heading">
			<div class="section-header">
				<span class="section-eyebrow">FAQ</span>
				<h2 class="section-title" id="faq-heading">Questions we hear a lot.</h2>
			</div>
			<dl class="faq-list">
				{faqItems.map((item) => (
					<div class="faq-item">
						<dt>{item.q}</dt>
						<dd>{item.a}</dd>
					</div>
				))}
			</dl>
		</section>

		<section class="section cta-section">
			<div class="cta-inner">
				<h2>Ready to get your site built right?</h2>
				<a href="/contact/" class="btn-solid">Get started now</a>
			</div>
		</section>
	</main>
</div>

<script>
	function initProcessStepReveal() {
		const section = document.querySelector('.process-section');
		if (!section) return;

		if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

		const items = Array.from(section.querySelectorAll('.process-timeline-item'));
		if (!items.length) return;

		const markAlreadyVisible = () => {
			const mark = window.innerHeight * 0.88;
			for (const el of items) {
				const r = el.getBoundingClientRect();
				if (r.top < mark && r.bottom > -12) el.classList.add('process-timeline-item--visible');
			}
		};

		markAlreadyVisible();
		section.classList.add('process-section--reveal');

		const obs = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (!entry.isIntersecting) continue;
					entry.target.classList.add('process-timeline-item--visible');
					obs.unobserve(entry.target);
				}
			},
			{ root: null, rootMargin: '0px 0px -10% 0px', threshold: [0, 0.1] }
		);

		for (const el of items) {
			if (!el.classList.contains('process-timeline-item--visible')) obs.observe(el);
		}
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initProcessStepReveal, { once: true });
	} else {
		initProcessStepReveal();
	}
</script>

<style>
	.bg-blur {
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		z-index: 0;
		filter: blur(120px);
		opacity: 0.16;
		pointer-events: none;
	}

	.paint-strikes-bg {
		position: fixed;
		left: 38%;
		top: 8%;
		width: min(230vw, 2400px);
		height: auto;
		max-width: none;
		z-index: 0;
		pointer-events: none;
		opacity: 0.2;
		mix-blend-mode: lighten;
		transform: translateX(-50%) rotate(-3deg);
	}

