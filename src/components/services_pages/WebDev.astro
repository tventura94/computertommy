	@media (prefers-reduced-motion: reduce) {
		.logo-carousel-track {
			animation: none;
			will-change: auto;
		}

		.logo-carousel-viewport {
			mask-image: none;
			overflow-x: auto;
			overflow-y: hidden;
			-webkit-overflow-scrolling: touch;
			scrollbar-width: thin;
		}

		.logo-carousel-group:last-child {
			display: none;
		}

		.logo-carousel-group {
			flex-wrap: wrap;
			justify-content: center;
			padding-right: 0;
			row-gap: 0.75rem;
